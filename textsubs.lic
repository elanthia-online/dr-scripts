# quiet
=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#textsubs
=end

no_pause_all
no_kill_all

# The text substitution catalog and the engine that applies it to game lines.
#
# The script's entry point stages a fresh, empty Registry on every start,
# fills it (the shit list, private_textsubs, then the built-in subs Catalog
# reads from data/base-textsubs.yaml, after which prefer_private gives a
# private key the catalog also has its private value back), installs it
# whole, and only then registers a 'textsub' DownstreamHook (persist: false,
# so Lich removes it when the script ends, and priority hook_priority, so it
# runs after every default-priority hook) that hands every server line to
# apply while a front end is attached. Until the install, apply serves the
# empty catalog the class body installed when the start evaluated it. The
# script then waits in watch, which ends it once that hook is gone or a newer
# start has superseded it, and which hands it the guild whenever DRStats
# reports another one, so the catalog is built again, into a Registry of its
# own, and installed whole by reinstall, which keeps the subs other scripts
# added since the start and leaves out those apply dropped.
#
# Lich evaluates this class body inside Lich::Common on every start, and the
# class itself persists for the session, so it defines no constants but its
# nested classes: re-running the body would warn "already initialized
# constant" for any other. Re-running it installs an empty Registry, drops
# any staging and ends every earlier run (see watch); the generation count
# carries over and counts that swap once (see generation).
class TextSubs
  # An ordered catalog of substitutions: a Regexp key and the gsub replacement
  # it applies. A key added again keeps its first position and takes the last
  # value, exactly as a Hash does.
  #
  # A key may also carry a gate: words one of which a line must hold before
  # the engine runs the key's regex at all. The gate is a promise about the
  # pattern, that it cannot match a line holding none of the words, so it
  # saves time and never changes a result. The coin-comma keys carry one:
  # their lookahead needs Kronar, Dokora or Lirum, and without the gate they
  # scan from every digit to the end of the line.
  #
  # Readers never see the entries themselves, only a frozen snapshot of them,
  # as the entries change while others read: through add and add_change, from
  # whichever script calls them, and through drop, from the game thread the
  # hook runs on.
  #
  # A Registry also keeps the changes made to it once its catalog was built:
  # each key given to add_change, and each key drop took out. replay hands
  # them on to a catalog built again, so a sub another script added stays and
  # a sub that raised stays off.
  # Two writers at once can lose one @version increment between them. That is
  # still safe: each writer changes the entries before it reads @version, so a
  # reader that sees the bumped number copies both changes, and a copy cached
  # under the old number holds more than that number says and is rebuilt.
  #
  # @example
  #   registry = TextSubs::Registry.new
  #   registry.add(/cat/, 'dog')
  #   registry.add(/c/, 'k')
  #   registry.add(/cat/, 'lion')
  #   registry.snapshot # => {/cat/=>"lion", /c/=>"k"} (frozen)
  # @example A gated key
  #   registry.add(/\d+(?=.*Kronar)/, '\&!', requires_any: ['Kronar'])
  #   registry.gates # => {/\d+(?=.*Kronar)/=>["Kronar"]} (frozen)
  class Registry
    # Checks a gate's shape. The words have to be ASCII: the engine looks for
    # them in binary game lines, and include? raises on a non-ASCII String
    # there.
    #
    # @param words [Object] a requires_any value
    # @return [nil]
    # @raise [ArgumentError] unless words is nil or a non-empty list of
    #   non-empty ASCII Strings
    def self.check_requires_any(words)
      return if words.nil?
      return if words.is_a?(Array) && !words.empty? && words.all? { |word| word.is_a?(String) && !word.empty? && word.ascii_only? }

      raise ArgumentError, "requires_any must be a non-empty list of non-empty ASCII words, not #{words.inspect}"
    end

    # @return [Registry] an empty registry
    def initialize
      @entries = {}
      @gates = {}
      @version = 0
      @snapshot = nil
      @indexed = nil
      @changes = {}
    end

    # Adds one substitution, or gives a key already present its new value in
    # the position it already holds. The gate goes the same way as the value:
    # the last add of a key sets it, or drops it when it has none.
    #
    # @param key [Regexp] the pattern
    # @param result [String] the gsub replacement; the registry keeps a frozen
    #   copy, so changing the caller's String later does not reach it
    # @param requires_any [Array<String>, nil] words one of which a line must
    #   hold for key to match it (see the class comment); kept as a frozen copy
    # @return [String] result, as given
    # @raise [ArgumentError] when key is not a Regexp or requires_any is
    #   malformed; the registry is left as it was
    def add(key, result, requires_any: nil)
      raise ArgumentError, "TextSubs::Registry keys are Regexps, not #{key.class}" unless key.is_a?(Regexp)

      self.class.check_requires_any(requires_any)
      @entries[key] = result.dup.freeze
      if requires_any
        @gates[key] = requires_any.map { |word| word.dup.freeze }.freeze
      else
        @gates.delete(key)
      end
      @version += 1
      result
    end

    # Adds one substitution as add does, and records it as a change made after
    # the catalog was built, so replay gives it to a catalog built again.
    # TextSubs.add and TextSubs.elanthipedia write through it; the catalog's
    # own subs go through add.
    #
    # @param key [Regexp] the pattern
    # @param result [String] the gsub replacement (a frozen copy is kept)
    # @param requires_any [Array<String>, nil] the key's gate, as for add (the
    #   change records the frozen copy add keeps, so later edits to the
    #   caller's list or words do not reach it)
    # @return [String] result, as given
    # @raise [ArgumentError] as add does; nothing is added or recorded
    # @example
    #   registry.add_change(/cat/, 'dog')
    #   registry.changes # => {/cat/=>[:add, "dog", nil]} (frozen)
    def add_change(key, result, requires_any: nil)
      add(key, result, requires_any: requires_any)
      record(key, [:add, @entries[key], @gates[key]].freeze)
      result
    end

    # Removes one entry and its gate, but only while key still holds value:
    # a key given a new value since value was read keeps it. The engine uses
    # it to put away an entry that raised, so another add of the key since is
    # left alone, and so is the next caller once the first one has removed it.
    # The removal is recorded as a change (see changes).
    #
    # @param key [Regexp] the pattern
    # @param value [Object] the value the caller read for key; compared by
    #   identity, as the registry hands out its own frozen copies
    # @return [Boolean] true when the entry was removed, false when key is not
    #   held or holds another value (the registry is then left as it was)
    # @example
    #   registry.add(/cat/, 'dog')
    #   registry.drop(/cat/, registry.snapshot[/cat/]) # => true
    #   registry.drop(/cat/, nil)                      # => false
    def drop(key, value)
      return false unless @entries.key?(key) && @entries[key].equal?(value)

      remove(key)
      true
    end

    # The changes made through add_change and drop, the last one for each
    # key, with the added keys in the order they took their places here.
    #
    # @return [Hash{Regexp=>Array}] frozen, down to each change, its result
    #   and its gate words: key => [:add, result, requires_any] or [:drop];
    #   empty for a catalog nothing has changed since it was built
    def changes
      @changes.dup.freeze
    end

    # Makes the changes another Registry recorded here too, in order: each
    # added key is added (taking its value over any the catalog gave it, in
    # the place it holds), each dropped key is removed whether or not this
    # catalog has it, and all of them are recorded, so a catalog built after
    # this one keeps them as well.
    #
    # A key this catalog built keeps its catalog place even when the
    # recorded add followed a drop, so a built-in key a script re-added after
    # apply dropped it runs last until a rebuild and in its catalog place
    # after one (see record).
    #
    # @param changes [Hash{Regexp=>Array}] what #changes returned
    # @return [Registry] self
    # @example Carry the changes over to a catalog built again
    #   rebuilt.replay(installed.changes)
    def replay(changes)
      changes.each do |key, (kind, result, requires_any)|
        kind == :add ? add_change(key, result, requires_any: requires_any) : remove(key)
      end
      self
    end

    # The entries as they stand, in order, as a frozen Hash. The same Hash
    # comes back until the next add or drop, so a reader calling once per
    # line copies the catalog only after it changes.
    #
    # @return [Hash{Regexp=>String}] frozen, with frozen values
    def snapshot
      cached[1]
    end

    # The gated keys and their words, from the same copy as snapshot.
    #
    # A reader that calls snapshot and then gates, with an add in between,
    # gets gates newer than the entries. That is safe: a gate for a key the
    # entries do not hold selects nothing, a gate the add gave a key they do
    # hold is a promise about that same pattern, and a gate the add dropped
    # only makes the engine run a regex it could have skipped.
    #
    # @return [Hash{Regexp=>Array<String>}] frozen, with frozen word lists;
    #   empty when no key is gated
    def gates
      cached[2]
    end

    # The snapshot and a TokenIndex over exactly its keys and gates, both from
    # the same copy, so the index never misses a key the snapshot holds. The
    # index is built the first time it is asked for after an add or drop, not
    # on every add: the entry point adds ~1,600 subs and then asks once.
    #
    # @return [Array(Hash{Regexp=>String}, TextSubs::TokenIndex)] frozen
    #   [snapshot, index]
    # @example
    #   registry.add(/cat/, 'dog')
    #   subs, index = registry.indexed_snapshot
    #   TextSubs::Engine.apply(subs, +'The cat.', index: index) # => "The dog."
    def indexed_snapshot
      copy = cached
      memo = @indexed
      return memo[1] if memo && memo[0].equal?(copy)

      pair = [copy[1], TokenIndex.new(copy[1].keys, copy[2])].freeze
      @indexed = [copy, pair].freeze
      pair
    end

    private

    # Takes key and its gate out, held or not, and records the drop.
    #
    # @param key [Regexp] the pattern
    # @return [void]
    def remove(key)
      @entries.delete(key)
      @gates.delete(key)
      @version += 1
      record(key, [:drop].freeze)
    end

    # Keeps change as the last one for key. A drop moves the key to the end,
    # and so does an add after a drop, as the add appends it to the catalog
    # again; an add after an add keeps the place, as add does. The order is
    # the order the keys took here: replay gives a key the catalog built
    # again its catalog place, wherever it stands in the log.
    #
    # @param key [Regexp] the pattern
    # @param change [Array] [:add, result, requires_any] or [:drop]
    # @return [void]
    def record(key, change)
      @changes.delete(key) unless change.first == :add && @changes.dig(key, 0) == :add
      @changes[key] = change
    end

    # The version is read before the entries are copied: an add that lands in
    # between leaves a copy that holds more than its version says, which is
    # thrown away on the next call, never one that holds less.
    #
    # @return [Array(Integer, Hash, Hash)] frozen [version, entries, gates]
    def cached
      version = @version
      copy = @snapshot
      return copy if copy && copy.first == version

      @snapshot = [version, @entries.dup.freeze, @gates.dup.freeze].freeze
    end
  end

  # One lock, kept across starts like the generation, so a start's class body
  # and every stage, unstage, install, reinstall and store_key (every write),
  # of this run or another, take turns: each checks the staging (or the run)
  # and changes it in one step, with no step of another thread in between.
  #
  # @@run is the Registry the latest start staged, which stands for that
  # start (see current_run?). The class body sets it to nil, as a start that
  # re-runs it supersedes every run before it even before it stages.
  @@lock = Mutex.new unless defined?(@@lock)
  @@lock.synchronize do
    @@registry = Registry.new
    @@staged = nil
    @@run = nil
    @@generation = defined?(@@generation) ? @@generation + 1 : 0
  end

  # The catalog, in the order its keys were first added.
  #
  # @return [Hash{Regexp=>String}] a frozen snapshot of the installed Registry:
  #   each key and the gsub replacement it applies
  def self.subs
    @@registry.snapshot
  end

  # How many times the catalog has changed this session. install and clear
  # count once each, and so does a sub that apply drops because it raised.
  # Every writer (add, elanthipedia and add_catalog; see store_key) counts
  # once per key it writes to the installed catalog, and
  # not at all while a Registry is staged (see stage): install counts that
  # whole catalog once, when it swaps it in.
  #
  # The class body sets the count to 0 the first time it runs in a session.
  # Every later start runs it again, which installs an empty catalog, and
  # that swap counts once like any other install, after the empty catalog is
  # in. So the count only rises: two starts never leave the same number on two
  # different catalogs, and a cache keyed on it that outlives a restart
  # rebuilds as soon as the class body has emptied the catalog, not only once
  # the new catalog is installed.
  #
  # The count rises only after the change is visible in subs, so a reader on
  # another thread that sees a new generation also sees the catalog it counts.
  # A cache keyed on the generation should read it before it reads subs: if a
  # change lands in between, the cache holds a newer catalog under an older
  # number and rebuilds on the next call, never the other way round.
  #
  # The hook thread counts a drop while a script may count an add, so two
  # changes at once can count as one. The rule above still holds: both changes
  # are in subs before either is counted, so the number they share is never
  # older than the catalog a reader sees with it.
  #
  # @return [Integer] 0 until the catalog first changes in this session
  def self.generation
    @@generation
  end

  # Makes registry the catalog that every writer (add, elanthipedia and
  # add_catalog; see store_key), subs and apply use, in one assignment, so a
  # reader sees either the old Registry or the new one, never a mix of the
  # two. It swaps the catalog in first and counts the change after, the same
  # order store_key keeps, so the generation never runs ahead of subs. The
  # swap is only as complete as registry is, so the entry point fills a staged
  # Registry (see stage) and installs it once every key is in: a hook still
  # registered while it builds, such as the one of a run that is being
  # stopped, applies the installed catalog, never a part of the new one. On a
  # start in Lich that installed catalog is the empty one the class body has
  # just put in, so such a hook passes every line through untouched until
  # install. Installing the staged Registry ends the staging, so every writer
  # writes to it as the installed catalog from then on.
  # Once the hook runs, a catalog built again (for a guild DRStats learns
  # later) is filled first and handed to reinstall, which installs it whole.
  #
  # install keeps none of the changes the Registry it replaces recorded
  # (see Registry#changes): the new catalog is exactly registry.
  #
  # A Registry this thread staged is installed only while it is still the one
  # staged. Once a newer start has staged its own (';force textsubs' while
  # this one builds), or its class body has dropped the staging, install
  # refuses it and returns nil: that start's catalog comes next, so this one,
  # however complete, never replaces it. A Registry this thread did not stage
  # (a fresh one, as clear installs) is installed whatever is staged.
  #
  # An add that runs on another thread just before install swaps the catalog
  # lands in the Registry being replaced.
  #
  # @param registry [TextSubs::Registry] the catalog to use from now on
  # @return [TextSubs::Registry, nil] registry, or nil when it is a Registry
  #   this thread staged that is no longer the one staged; then the installed
  #   catalog and the generation are left as they were
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; the
  #   installed catalog and the generation are left as they were
  # @example Start over with an empty catalog
  #   TextSubs.install(TextSubs::Registry.new)
  # @example How the entry point installs its build, and ends if a newer start superseded it
  #   exit unless TextSubs.install(new_catalog)
  def self.install(registry)
    check_registry(registry, 'install')
    @@lock.synchronize { swap_in(registry) }
  end

  # The step install and reinstall share, for a caller that holds @@lock:
  # refuses a Registry this thread staged that is no longer the one staged,
  # else swaps registry in, ends its staging and counts one generation.
  #
  # @param registry [TextSubs::Registry] the catalog to use from now on
  # @return [TextSubs::Registry, nil] registry, or nil when it was refused
  def self.swap_in(registry)
    if registry.equal?(own_build)
      bind_build(nil)
      return nil unless registry.equal?(@@staged)
    end
    @@registry = registry
    @@staged = nil if registry.equal?(@@staged)
    @@generation += 1
    registry
  end
  private_class_method :swap_in

  # Makes every writer (add, elanthipedia and add_catalog; see store_key)
  # write to registry, which is not installed, so a catalog can be built while
  # subs and apply go on using the installed one. install(registry) swaps it
  # in whole and ends the staging. A sub another script adds meanwhile goes
  # into registry too, so the swap keeps it.
  #
  # Staging another Registry replaces the first one. A start that dies before
  # it installs its staged Registry ends the staging with unstage, so the adds
  # of other scripts reach the installed catalog again.
  #
  # registry is also this thread's own build until this thread installs or
  # unstages it: the adds made on this thread go into it even after another
  # thread stages a Registry of its own, or a start's class body drops the
  # staging. So when two starts overlap (';force textsubs' while one builds),
  # neither one's keys reach the other's catalog, and none reaches the
  # installed one; install then refuses the superseded build (see install).
  #
  # registry also stands for the start that staged it from then on: that
  # start is the current run (see current_run?) until a newer start re-runs
  # the class body or stages a Registry of its own.
  #
  # @param registry [TextSubs::Registry] the catalog to build
  # @return [TextSubs::Registry] registry
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; nothing
  #   is staged
  # @example How the entry point builds the catalog on a start
  #   catalog = TextSubs.stage(TextSubs::Registry.new)
  #   TextSubs.add('You feel fine', 'You feel FINE') # into catalog; subs is unchanged
  #   TextSubs.install(catalog)
  def self.stage(registry)
    check_registry(registry, 'stage')
    @@lock.synchronize do
      bind_build(registry)
      @@run = registry
      @@staged = registry
    end
  end

  # Whether run still stands for the latest start: the Registry that start
  # staged (see stage), while no newer start has re-run the class body or
  # staged a Registry of its own since. A run that is not current must stop,
  # as the newer start owns the catalog and the 'textsub' hook name: watch
  # returns, and reinstall refuses its catalog.
  #
  # @param run [TextSubs::Registry, nil] the Registry a start staged, or nil
  #   for a caller that is no start (it is never superseded)
  # @return [Boolean] true when run is nil or the latest start's Registry
  def self.current_run?(run)
    run.nil? || run.equal?(@@run)
  end
  private_class_method :current_run?

  # Ends the staging of registry without installing it, for a build that did
  # not finish: every writer (add, elanthipedia and add_catalog; see
  # store_key) writes to the installed catalog again, and the keys registry
  # holds, a sub another script added meanwhile among them, are dropped with
  # it. A partial catalog is never installed. When registry is not the one
  # staged (it was installed, or another Registry was staged since), the
  # staging is left as it is, so a run that ends late cannot end the staging
  # of a newer start: the check and the change are one step under the lock.
  # Either way registry stops being this thread's own build.
  #
  # @param registry [TextSubs::Registry] the Registry the caller staged
  # @return [Boolean] true when it ended the staging, false when registry was
  #   not staged
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; the
  #   staging is left as it was
  # @example How the entry point ends its staging when the script dies early
  #   catalog = TextSubs.stage(TextSubs::Registry.new)
  #   before_dying { TextSubs.unstage(catalog) }
  def self.unstage(registry)
    check_registry(registry, 'unstage')
    @@lock.synchronize do
      bind_build(nil) if registry.equal?(own_build)
      return false unless registry.equal?(@@staged)

      @@staged = nil
      true
    end
  end

  # The Registry this thread staged and has neither installed nor unstaged
  # since (see stage). It lives in a thread variable, so it ends with the
  # thread: a run that dies mid-build leaves nothing behind.
  #
  # @return [TextSubs::Registry, nil] this thread's own build, if any
  def self.own_build
    Thread.current.thread_variable_get(:textsubs_build)
  end

  # Makes registry this thread's own build, or ends it when given nil.
  #
  # @param registry [TextSubs::Registry, nil] the build, or nil
  # @return [TextSubs::Registry, nil] registry
  def self.bind_build(registry)
    Thread.current.thread_variable_set(:textsubs_build, registry)
  end
  private_class_method :own_build, :bind_build

  # Installs registry, a catalog built again (for a guild DRStats learns
  # later), once the changes made to the installed catalog since it was built
  # are replayed onto it: a sub another script added with add or elanthipedia
  # is kept, with its value, and a sub apply dropped for raising stays off
  # until textsubs restarts. registry is filled before the swap, so the hook
  # sees the old catalog or the new one, whole.
  #
  # The changes are read once, before the swap: an add that runs on another
  # thread in between lands in the Registry being replaced, and is lost.
  #
  # Given run, the Registry the calling start staged (see stage), it installs
  # registry only while that start is still the current run (see
  # current_run?), checked in the same step as the swap: a run that a
  # ';force textsubs' superseded while it built this catalog never puts it
  # over the newer start's.
  #
  # @param registry [TextSubs::Registry] the catalog built again, not installed
  # @param run [TextSubs::Registry, nil] the calling start's staged Registry,
  #   or nil to install whatever start is current
  # @return [TextSubs::Registry, nil] registry, now installed, or nil when a
  #   newer start superseded run; then the installed catalog and the
  #   generation are left as they were
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; nothing
  #   is replayed or installed
  # @example The entry point, when the guild changes
  #   TextSubs.reinstall(fill_catalog.call(TextSubs::Registry.new, new_guild), run: new_catalog)
  def self.reinstall(registry, run: nil)
    check_registry(registry, 'reinstall')
    rebuilt = registry.replay(@@registry.changes)
    @@lock.synchronize { swap_in(rebuilt) if current_run?(run) }
  end

  # Refuses anything but a TextSubs::Registry, naming the public method that
  # was given it.
  #
  # @param registry [Object] what install, stage, unstage or reinstall was given
  # @param caller_name [String] the method's name, for the message
  # @return [nil]
  # @raise [ArgumentError] unless registry is a TextSubs::Registry
  def self.check_registry(registry, caller_name)
    return if registry.is_a?(Registry)

    raise ArgumentError, "TextSubs.#{caller_name} needs a TextSubs::Registry, not #{registry.class}"
  end
  private_class_method :check_registry

  # Empties the catalog by installing a fresh Registry.
  #
  # @return [Hash] the new, empty catalog (frozen)
  def self.clear
    install(Registry.new)
    subs
  end

  # Adds one substitution. A target already in the catalog keeps its place and
  # takes the new result. The sub is kept when the catalog is built again for
  # a new guild (see reinstall).
  #
  # @param target [String] regex source; it is compiled as is, not escaped
  # @param result [String] the gsub replacement, so '\1' refers to a capture
  #   group of the target
  # @return [String] result
  # @raise [RegexpError] when target is not valid regex source
  # @example
  #   TextSubs.add('You feel fine', 'You feel FINE')
  def self.add(target, result)
    store(target, result, change: true)
  end

  # Rewrites one server line with every key that matches it.
  #
  # Only the keys the installed Registry's TokenIndex names for the line are
  # tried. The first line after the catalog changes (a start, or an add from
  # another script) builds the index anew, so a key added at any time is
  # tried from the next line on.
  #
  # A sub that raises (a nil or Integer value, a UTF-8 key on a line with
  # high bytes, a regex timeout) is dropped from the catalog until textsubs
  # restarts (a catalog built again for a new guild leaves it out too, see
  # reinstall) and reported once, and the line goes on through the other
  # keys: an error that left the hook would make Lich remove the hook, and
  # every sub with it.
  #
  # @param line [String] a server line, as the DownstreamHook receives it
  # @return [String] the same String, rewritten in place
  # @raise [FrozenError] when a key matches a frozen line
  # @example After TextSubs.add('fine', 'FINE')
  #   TextSubs.apply(+"You feel fine.\r\n") # => "You feel FINE.\r\n"
  # @example After TextSubs.add('foo', nil)
  #   TextSubs.apply(+'foo') # => "foo", reports the sub once and drops it
  def self.apply(line)
    subs, index = @@registry.indexed_snapshot
    Engine.apply(subs, line, index: index, on_error: ->(key, error) { drop(key, subs[key], error) })
  end

  # Takes a sub that raised out of the installed catalog, and says so, once:
  # only the call that removes it reports it, so a key that already went, or
  # was given a new value since the line began, is neither removed nor
  # reported again.
  #
  # It answers to the hook's thread, where Script.current is nil, so it
  # names textsubs itself instead of echoing.
  #
  # @param key [Regexp] the key that raised
  # @param value [Object] its value in the snapshot the line ran through
  # @param error [StandardError] what it raised
  # @return [Boolean] whether this call removed it
  def self.drop(key, value, error)
    return false unless @@registry.drop(key, value)

    @@generation += 1
    respond "[textsubs: the sub #{key.source.inspect} raised #{error.class} (#{error.message}) " \
            'and is off until textsubs restarts; fix or remove it where it was added, usually private_textsubs]'
    true
  end
  private_class_method :drop

  # The priority the 'textsub' hook is registered at. Lich runs downstream
  # hooks in descending priority, equal priorities in the order they were
  # first registered, and a hook added without one gets 0. At -100, every
  # default-priority hook that reads or squelches lines sees the raw server
  # text before textsubs rewrites it, whether its script started before or
  # after textsubs, and a restart of textsubs cannot change that.
  #
  # @return [Integer] -100
  # @example The entry point
  #   DownstreamHook.add('textsub', action, persist: false, priority: TextSubs.hook_priority)
  def self.hook_priority
    -100
  end

  # Waits for DRStats to know the guild, as the catalog's guild sections and
  # its guild spell list link need it: DRStats.guild is nil until DRInfomon's
  # login commands have had INFO parsed, and textsubs often starts before
  # that, from autostart.
  #
  # It stops waiting as soon as the guild is known, or DRInfomon says its
  # login commands are done (they skip INFO on a login while dead, so the
  # guild stays nil until a later INFO), or timeout seconds have gone by.
  # A guild still not known then is said once, with the likely reason: a
  # login while dead when DRInfomon is done, else that DRInfomon had not
  # finished in time. watch rebuilds the catalog when the guild turns up
  # later.
  #
  # @param timeout [Numeric] the most seconds to wait
  # @param interval [Numeric] seconds between checks
  # @return [String, nil] the guild, or nil when it is still not known
  # @example At the start of the entry point
  #   guild = TextSubs.await_guild # => "Bard"
  def self.await_guild(timeout: 10, interval: 0.5)
    waited = 0
    until DRStats.guild || DRInfomon.startup_complete? || waited >= timeout
      pause(interval)
      waited += interval
    end
    # Read once more: INFO may land between the guild check and the
    # startup check above.
    guild = DRStats.guild
    unless guild
      reason = if DRInfomon.startup_complete?
                 'a login while dead skips INFO'
               else
                 "DRInfomon had not finished its login commands after #{timeout} seconds"
               end
      echo "DRStats does not know your guild yet (#{reason}), so the guild subs and the " \
           'guild spell list link are off for now; textsubs adds them by itself once your guild is known.'
    end
    guild
  end

  # Keeps the script alive exactly as long as its hook is registered, so
  # ;list and Script.running?('textsubs') tell the truth: Lich removes a
  # hook that raises (and another script may remove it by name), and a
  # script still running without its hook would never be restarted by the
  # helpers that start textsubs only when it is not running.
  #
  # Given run, it also returns once a newer start has superseded that run
  # (';force textsubs'; see current_run?): the hook name then belongs to the
  # newer start, so the name alone would keep the old run waiting, and
  # rebuilding, for good.
  #
  # The script reads no game lines itself, so it stops Lich from buffering
  # them for it, then checks the hook list every interval seconds. Lich
  # kills the script during a pause as it would during any wait.
  #
  # With a block, each check also compares DRStats.guild with the guild the
  # catalog was built for, and on a change yields the new guild, on the
  # script's own thread, before it pauses: the block builds the catalog
  # again. A guild that changes back and forth between two checks is seen as
  # it is at the second one.
  #
  # @param hook [String] the DownstreamHook name to watch
  # @param script [#want_downstream=] the running script
  # @param interval [Numeric] seconds between checks
  # @param guild [String, nil] the guild the installed catalog was built for
  # @param run [TextSubs::Registry, nil] the Registry the calling start
  #   staged (see stage), or nil to watch the hook alone
  # @yieldparam new_guild [String, nil] what DRStats.guild reports now
  # @return [nil] once hook is no longer registered, or run is superseded,
  #   after saying which
  # @example The last lines of the entry point
  #   TextSubs.watch('textsub', guild: guild, run: new_catalog) do |new_guild|
  #     TextSubs.reinstall(fill_catalog.call(TextSubs::Registry.new, new_guild), run: new_catalog)
  #   end # returns when the hook goes or a newer start takes over, ending the script
  def self.watch(hook, script: Script.current, interval: 5, guild: DRStats.guild, run: nil)
    script.want_downstream = false
    while (registered = DownstreamHook.list.include?(hook)) && current_run?(run)
      if block_given? && DRStats.guild != guild
        guild = DRStats.guild
        yield guild
      end
      pause(interval)
    end
    if registered
      echo 'A newer textsubs has started, so this one stops here and leaves the subs to it.'
    else
      echo "The '#{hook}' hook is gone, so nothing is substituted any more and textsubs stops here " \
           "(a '--- Lich: DownstreamHook:' line above says why, if it raised). Start it again with ;textsubs."
    end
    nil
  end

  # The matching engine behind TextSubs.apply, kept apart from the catalog so
  # it can run on any ordered Hash of keys.
  class Engine
    # Selects every key that matches the ORIGINAL line, then runs gsub! for each
    # selected key, in insertion order, on the line as it changes. A key that
    # only matches after an earlier key rewrote the line does not fire, and a
    # selected key that no longer matches changes nothing.
    #
    # Only the keys the TokenIndex names for the line are tried, so a line
    # costs a handful of regexes instead of one per key. The index leaves out
    # only keys that cannot match the line, and a gated key whose words the
    # line holds none of: the gate is trusted, not checked, so a key gated on
    # a word it does not need would miss lines it matches.
    #
    # Selection uses match?, which builds no MatchData and sets no $~: nothing
    # reads the match, only whether there is one.
    #
    # @param subs [Hash{Regexp=>String}] ordered keys and their replacements
    # @param line [String] the line to rewrite
    # @param gates [Hash{Regexp=>Array<String>}, nil] gated keys of subs and
    #   their words (Registry#gates); a gate for a key subs does not hold is
    #   ignored. Only for the one-off path: an index already holds its gates.
    # @param index [TextSubs::TokenIndex, nil] an index over exactly the keys
    #   of subs and their gates; nil builds one for this call, which parses
    #   every key, so a caller that runs many lines through one catalog
    #   passes it (Registry#indexed_snapshot)
    # @param on_error [#call, nil] called with the key and the StandardError
    #   when matching or applying one key raises; that key then counts as not
    #   matching and the line goes on through the rest. nil lets the error
    #   out. Errors that are the caller's, not the key's, always get out: a
    #   FrozenError (the line is frozen) and the KeyError below.
    # @return [String] the same String, rewritten in place; a key that raised
    #   left it as it was before that key
    # @raise [ArgumentError] when both gates and index are given, since the
    #   gates would be silently ignored
    # @raise [FrozenError] when a key matches a frozen line
    # @raise [KeyError] when index names a key subs does not hold
    # @raise [StandardError] whatever a key raised, when on_error is nil
    # @example
    #   TextSubs::Engine.apply({ /cat/ => 'dog', /dog/ => 'bird' }, +'The cat.') # => "The dog."
    # @example A gate the line does not meet
    #   TextSubs::Engine.apply({ /\d+/ => '#' }, +'7 coins', gates: { /\d+/ => ['Kronar'] }) # => "7 coins"
    # @example A key that raises, set aside
    #   TextSubs::Engine.apply({ /cat/ => nil, /The/ => 'A' }, +'The cat.', on_error: ->(key, error) { warn key.source })
    #   # => "A cat.", after warning "cat"
    def self.apply(subs, line, gates: nil, index: nil, on_error: nil)
      raise ArgumentError, 'pass gates: or index:, not both: an index already holds its gates' if gates && index

      index ||= TokenIndex.new(subs.keys, gates || {})
      matches = index.candidates(line).select { |key| attempt(key, on_error) { key.match?(line) } }
      matches.each do |key|
        replacement = subs.fetch(key)
        attempt(key, on_error) { line.gsub!(key, replacement) }
      end
      line
    end

    # Runs one key's step, handing an error it raises to on_error.
    #
    # @param key [Regexp] the key the step runs
    # @param on_error [#call, nil] see apply
    # @yieldreturn [Object] the step's result
    # @return [Object, false] the block's result, or false once on_error has
    #   taken the error
    # @raise [StandardError] the error, when on_error is nil or it is a
    #   FrozenError
    def self.attempt(key, on_error)
      yield
    rescue FrozenError
      raise
    rescue StandardError => e
      raise unless on_error

      on_error.call(key, e)
      false
    end
    private_class_method :attempt
  end

  # Picks, for a line, the keys that could match it, so the engine runs a
  # handful of regexes per line instead of every key of the catalog.
  #
  # Each key gets one tier from TokenIndex::Pattern (most selective first):
  # - :words, words: a matching line holds one of the words as a whole token;
  # - :prefix / :suffix, three letters: a token of the line starts (ends)
  #   with them;
  # - :trigram, three letters: a token of the line holds them;
  # - :include, a literal of three or more characters, none three letters in
  #   a row: the line holds it;
  # - :always: the key is checked on every line.
  # A token is a maximal run of ASCII letters, A-Z and a-z, of the line as it
  # came, before any key rewrote it.
  #
  # The index only ever leaves out a key that cannot match the line: each
  # tier is a promise Pattern proves from the regex source, and a pattern it
  # cannot read in full is checked always. A key with a requires_any gate (see
  # Registry) is also left out when the line holds none of its words.
  #
  # @example
  #   index = TextSubs::TokenIndex.new([/You feel fine/, /\d+ coins/, /.+/])
  #   index.candidates('You feel fine.') # => [/You feel fine/, /.+/]
  #   index.candidates('7 coins')        # => [/\d+ coins/, /.+/]
  class TokenIndex
    # The tier one key goes in; see the class comment.
    #
    # @param key [Regexp]
    # @return [Array(Symbol, Object)] frozen [tier, value]: [:words,
    #   Array<String>], [:prefix, String], [:suffix, String], [:trigram,
    #   String], [:include, String], or [:always]
    # @example
    #   TextSubs::TokenIndex.tier(/You feel (fine|good)\./) # => [:words, ["feel"]]
    #   TextSubs::TokenIndex.tier(/(?i)fine/)               # => [:always]
    def self.tier(key)
      Pattern.new(key).tier
    end

    # @param keys [Array<Regexp>] the catalog's keys, in insertion order
    # @param gates [Hash{Regexp=>Array<String>}] gated keys and their words
    #   (Registry#gates); a gate for a key not in keys is ignored
    # @return [TokenIndex] frozen
    def initialize(keys, gates = {})
      @keys = keys.dup.freeze
      @always = []
      @included = []
      @gates = {}
      @tables = { words: {}, prefix: {}, suffix: {}, trigram: {} }
      @keys.each_with_index { |key, position| file(key, position, gates[key]) }
      [@always, @included, @gates, *@tables.values].each(&:freeze)
      @tables.freeze
      freeze
    end

    # The keys that may match line, in insertion order. Every key that
    # matches line is among them, unless its gate leaves it out.
    #
    # @param line [String] the line as it came; not changed
    # @return [Array<Regexp>]
    # @raise [ArgumentError] when line is a String with invalid bytes for its
    #   encoding, as Regexp#match? would
    def candidates(line)
      found = @always.dup
      @included.each { |position, literal| found << position if line.include?(literal) }
      line.scan(/[A-Za-z]+/).uniq.each { |token| collect(found, token) }
      found.uniq!
      found.sort!
      found.reject! { |position| (words = @gates[position]) && words.none? { |word| line.include?(word) } } unless @gates.empty?
      found.map! { |position| @keys[position] }
    end

    private

    # @param key [Regexp]
    # @param position [Integer] its place in insertion order
    # @param gate [Array<String>, nil] its requires_any words
    # @return [void]
    def file(key, position, gate)
      @gates[position] = gate if gate
      tier, value = self.class.tier(key)
      case tier
      when :words then value.each { |word| slot(:words, word) << position }
      when :include then @included << [position, value].freeze
      when :always then @always << position
      else slot(tier, value) << position
      end
    end

    # @param table [Symbol] :words, :prefix, :suffix or :trigram
    # @param token [String]
    # @return [Array<Integer>] the positions filed under token, created empty
    def slot(table, token)
      @tables[table].fetch(token) { @tables[table][token] = [] }
    end

    # Adds the positions every table files under token, or a piece of it.
    #
    # @param found [Array<Integer>] positions so far; appended to
    # @param token [String] one token of the line
    # @return [void]
    def collect(found, token)
      words, prefix, suffix, trigram = @tables.values_at(:words, :prefix, :suffix, :trigram)
      (hit = words[token]) && found.concat(hit)
      return if token.size < 3

      (hit = prefix[token[0, 3]]) && found.concat(hit)
      (hit = suffix[token[-3, 3]]) && found.concat(hit)
      return if trigram.empty?

      0.upto(token.size - 3) { |at| (hit = trigram[token[at, 3]]) && found.concat(hit) }
    end

    # Reads one regex source and proves what text a match of it must hold.
    # It is a whitelist: anything it does not fully understand (options and
    # inline flags, a non-ASCII source, back-references and subexpression
    # calls, an escape it does not know, a nested or POSIX class, a {n}? or
    # {n}+ suffix, comments, conditionals) makes the key :always.
    #
    # The source is read into a mandatory path of symbols: [:lit, char] for a
    # literal character, :N for one or more characters none of which is a
    # letter, :B for a zero-width edge whose far side is no letter (^ $ \b \A
    # \z \Z), and :A for anything else (possibly letters, possibly empty).
    # Lookarounds are zero-width and dropped from the path; a letter run on
    # the path with :N, :B or a literal non-letter on both sides is a whole
    # token of any matching line.
    #
    # @example
    #   TextSubs::TokenIndex::Pattern.new(/^Roundtime: \d+ sec/).tier # => [:words, ["Roundtime"]]
    class Pattern
      # @return [Array<String>] the alphanumeric escapes a character class may
      #   hold, frozen; each stands for exactly one character
      def self.class_escapes
        %w[d s w h D S W H n t r f v e a].freeze
      end

      # @param key [Regexp]
      # @return [Pattern]
      def initialize(key)
        @key = key
        @source = key.source
        @chars = @source.chars
        @at = 0
      end

      # @return [Array(Symbol, Object)] frozen; see TokenIndex.tier
      def tier
        found = catch(:bail) do
          throw :bail unless (@key.options & ~(Regexp::NOENCODING | Regexp::FIXEDENCODING)).zero? && @source.ascii_only?

          alternatives = parse
          alternatives.size == 1 ? sequence_tier(alternatives.first) : any_of_tier(alternatives)
        end
        (found || [:always]).freeze
      end

      private

      # @param items [Array<Array>] the source's one top-level alternative
      # @return [Array(Symbol, Object), nil] its tier, nil for :always
      def sequence_tier(items)
        sets = []
        path = [:A, *flatten(items, sets), :A]
        words = words_of(path)
        sets.unshift([words.max_by(&:size)]) unless words.empty?
        best = sets.min_by { |set| [set.size, -set.map(&:size).min] }
        return [:words, best.freeze] if best

        edge_tier(path) || literal_tier(path)
      end

      # @param alternatives [Array<Array>] two or more top-level alternatives
      # @return [Array(Symbol, Object), nil] [:words, set] when every one
      #   holds a whole word
      def any_of_tier(alternatives)
        per = alternatives.map { |items| words_of([:A, *flatten(items, []), :A]) }
        [:words, per.flatten.uniq.freeze] if per.none?(&:empty?)
      end

      # The longest letter run of three or more with an edge on one side: a
      # token of the line starts (left edge) or ends (right edge) with it.
      #
      # @param path [Array] a padded path
      # @return [Array(Symbol, String), nil]
      def edge_tier(path)
        best = nil
        letter_runs(path).each do |first, last|
          run = path[first..last].map(&:last).join
          next if run.size < 3 || (best && best[2] >= run.size)

          if first.positive? && nonletter?(path[first - 1]) then best = [:prefix, run[0, 3], run.size]
          elsif nonletter?(path[last + 1]) then best = [:suffix, run[-3, 3], run.size]
          end
        end
        best&.first(2)
      end

      # The longest run of consecutive literal characters, when it is three
      # or more long: its first three letters in a row, else the run itself.
      #
      # @param path [Array] a padded path
      # @return [Array(Symbol, String), nil]
      def literal_tier(path)
        literal = path.chunk_while { |a, b| a.is_a?(Array) && b.is_a?(Array) }
                      .select { |run| run.first.is_a?(Array) }
                      .map { |run| run.map(&:last).join }
                      .max_by(&:size)
        return nil unless literal && literal.size >= 3

        trigram = literal[/[A-Za-z]{3}/]
        trigram ? [:trigram, trigram] : [:include, literal.freeze]
      end

      # @param path [Array]
      # @return [Array<Array(Integer, Integer)>] [first, last] indexes of each
      #   maximal run of literal letters in path
      def letter_runs(path)
        runs = []
        path.each_with_index do |symbol, at|
          next unless letter?(symbol)

          if runs.last && runs.last[1] == at - 1 then runs.last[1] = at
          else runs << [at, at]
          end
        end
        runs
      end

      # Letter runs with a non-letter on both sides: whole tokens.
      #
      # @param path [Array]
      # @return [Array<String>]
      def words_of(path)
        letter_runs(path).filter_map do |first, last|
          path[first..last].map(&:last).join if first.positive? && nonletter?(path[first - 1]) && nonletter?(path[last + 1])
        end
      end

      # @param symbol [Object] a path symbol
      # @return [Boolean] whether it is a literal ASCII letter
      def letter?(symbol)
        return false unless symbol.is_a?(Array)

        code = symbol[1].ord
        (65..90).cover?(code) || (97..122).cover?(code) # A-Z, a-z
      end

      # @param symbol [Object, nil] a path symbol, or nil past either end
      # @return [Boolean] whether it is certainly no letter: :N, :B or a
      #   literal non-letter
      def nonletter?(symbol)
        symbol == :N || symbol == :B || (symbol.is_a?(Array) && !letter?(symbol))
      end

      # Flattens one alternative's items into its mandatory path, and adds to
      # sets the word sets of each group of alternatives on it that must
      # match once: a matching line holds one word of each such set.
      #
      # @param items [Array<Array(Object, Integer, Numeric)>] [atom, min, max]
      # @param sets [Array<Array<String>>] appended to
      # @return [Array] the path
      def flatten(items, sets)
        path = []
        items.each_with_index do |(atom, min, max), at|
          if min.zero?
            path << :A
          elsif atom.is_a?(Array) && atom.first == :group
            path.concat(group_path(atom[1], max, path.last, items[at + 1], sets))
          elsif atom == :look
            next
          elsif max == 1
            path << atom
          else
            path << (nonletter?(atom) ? :N : :A)
          end
        end
        path
      end

      # The path of a group that must match at least once. A group of
      # alternatives that matches exactly once adds to sets the words one of
      # which each alternative holds, judged with the symbols on either side.
      #
      # @param alternatives [Array<Array>] the group's alternatives
      # @param max [Numeric] its quantifier's upper bound
      # @param left [Object, nil] the path symbol before it
      # @param right_item [Array, nil] the item after it
      # @param sets [Array<Array<String>>] appended to
      # @return [Array] the path
      def group_path(alternatives, max, left, right_item, sets)
        return flatten(alternatives.first, sets) if max == 1 && alternatives.size == 1

        if max == 1
          right = right_item && right_item[1] >= 1 && simple(right_item[0]) || :A
          per = alternatives.map { |items| words_of([left || :A, *flatten(items, []), right]) }
          sets << per.flatten.uniq if per.none?(&:empty?)
        end
        [alternatives.all? { |items| nonletter_only?(items) } ? :N : :A]
      end

      # @return [Object, nil] atom when it is one path symbol, else nil
      def simple(atom)
        atom if atom == :N || atom == :B || (atom.is_a?(Array) && atom.first == :lit)
      end

      # @param items [Array<Array>] one alternative's items
      # @return [Boolean] whether it matches one or more characters, none a letter
      def nonletter_only?(items)
        !items.empty? && items.all? { |atom, min, _| min >= 1 && (atom == :N || (atom.is_a?(Array) && atom.first == :lit && !letter?(atom))) }
      end

      # --- the parser: [atom, min, max] items, atoms [:lit, c], :N, :A, :B,
      # :look and [:group, alternatives]; anything unknown throws :bail.

      # @return [String, nil] the character at the read position
      def peek
        @chars[@at]
      end

      # @return [Array<Array>] the alternatives of the whole source
      def parse
        alternatives = parse_alternatives
        throw :bail unless @at == @chars.size
        alternatives
      end

      # @return [Array<Array>] alternatives up to the next ) or the end
      def parse_alternatives
        alternatives = [parse_sequence]
        while peek == '|'
          @at += 1
          alternatives << parse_sequence
        end
        alternatives
      end

      # @return [Array<Array>] the items of one alternative
      def parse_sequence
        items = []
        until sequence_end?
          atom = parse_atom
          min, max = parse_quantifier
          throw :bail if (atom == :look || atom == :B) && (min != 1 || max != 1)
          items << [atom, min, max]
        end
        items
      end

      # @return [Array(Integer, Numeric)] the [min, max] of the quantifier
      #   at the read position, [1, 1] when there is none
      def parse_quantifier
        bounds = case peek
                 when '?' then [0, 1]
                 when '*' then [0, Float::INFINITY]
                 when '+' then [1, Float::INFINITY]
                 when '{' then return parse_interval
                 else return [1, 1]
                 end
        @at += 1
        @at += 1 if peek == '?' || peek == '+' # lazy or possessive
        bounds
      end

      # Ruby reads a ? or + after an interval unlike after ?, * or + (x{2}?
      # is an optional x{2}), so neither is consumed here: parse_atom bails
      # on it.
      #
      # @return [Array(Integer, Numeric)] the [min, max] of {n}, {n,}, {,m}
      #   or {n,m}
      def parse_interval
        interval = /\G\{(\d*)(,?)(\d*)\}/.match(@source, @at)
        throw :bail unless interval && !(interval[1].empty? && interval[3].empty?)
        @at += interval[0].size
        low = interval[1].to_i
        high = if interval[2].empty? then low
               elsif interval[3].empty? then Float::INFINITY
               else interval[3].to_i
               end
        [low, high]
      end

      # @return [Boolean] whether the sequence being read ends here
      def sequence_end?
        case peek
        when '|', ')', nil then true
        else false
        end
      end

      # A quantifier where an atom should start bails, which also catches a
      # quantifier stacked on another (Ruby's {n}? and {n}+, or a+?+).
      #
      # @return [Object] the atom at the read position
      def parse_atom
        char = peek
        case char
        when '\\' then parse_escape
        when '[' then parse_class
        when '(' then parse_group
        when ')', '*', '+', '?', '{' then throw :bail
        when '.' then step(:A)
        when '^', '$' then step(:B)
        else step([:lit, char])
        end
      end

      # @return [Array, Symbol] [:group, alternatives], or :look for a
      #   lookaround
      def parse_group
        @at += 1
        rest = @source[@at, 4]
        if rest.start_with?('?:', '?>') then @at += 2
        elsif (name = /\G\?<[A-Za-z_]\w*>/.match(@source, @at)) then @at += name[0].size
        elsif rest.start_with?('?=', '?!', '?<=', '?<!')
          @at += rest.start_with?('?<') ? 3 : 2
          parse_alternatives
          close_group
          return :look
        elsif rest.start_with?('?') then throw :bail # (?i) (?x) (?#...) (?~...) (?(cond)...)
        end
        alternatives = parse_alternatives
        close_group
        [:group, alternatives]
      end

      # @return [void]
      def close_group
        throw :bail unless peek == ')'
        @at += 1
      end

      # @return [Object] the atom a backslash escape reads as
      def parse_escape
        char = @chars[@at + 1]
        throw :bail unless char
        @at += 2
        return [:lit, char] unless char.match?(/[0-9A-Za-z]/)

        case char
        when 'd', 's', 'W', 'n', 't', 'r', 'f', 'v', 'e', 'a' then :N
        when 'b', 'A', 'z', 'Z' then :B
        when 'D', 'S', 'w', 'h', 'H' then :A
        else throw :bail # back-references, \k \g \x \u \c \C \M \p \R \X \K \G \B, octal
        end
      end

      # Moves past the one character just read.
      #
      # @param atom [Object] what it reads as
      # @return [Object] atom
      def step(atom)
        @at += 1
        atom
      end

      # A class is :N when each member is a plain non-letter character, \d or
      # \s, with no range, else :A; a negated class is :A.
      #
      # @return [Symbol] :N or :A
      def parse_class
        @at += 1
        negated = peek == '^'
        @at += 1 if negated
        members = []
        until peek == ']' && !members.empty?
          member = class_member
          members << member
          @at += member.size
        end
        @at += 1
        return :A if negated || members.each_cons(2).any? { |pair| pair == ['&', '&'] }
        return :A if members.each_index.any? { |at| members[at] == '-' && at.positive? && at < members.size - 1 }

        members.all? { |member| nonletter_member?(member) } ? :N : :A
      end

      # @return [String] the next member of a class: one character, or a
      #   backslash and the character it escapes
      def class_member
        char = peek
        throw :bail if char.nil? || char == '[' || char == ']'
        return char unless char == '\\'

        member = @chars[@at, 2].join
        throw :bail if member.size < 2 || (member[1].match?(/[0-9A-Za-z]/) && !self.class.class_escapes.include?(member[1]))
        member
      end

      # @return [Boolean] whether a class member only ever matches a non-letter
      def nonletter_member?(member)
        return true if member == '\\d' || member == '\\s'

        member.size == 2 ? !member[1].match?(/[0-9A-Za-z]/) : !letter?([:lit, member])
      end
    end
  end

  # What a catalog section's `when:` gate is checked against: the guild and
  # the character settings at the time the catalog is built, so the catalog
  # itself never reads DRStats or get_settings.
  #
  # A gate is nil (always holds) or a Hash with one or more of these keys,
  # every one of which must hold:
  # - 'guilds' [Array<String>]: the guild is one of them;
  # - 'not_guilds' [Array<String>]: the guild is known and none of them;
  # - 'setting' [String]: that setting is set (neither nil nor false);
  # - 'setting_off' [String]: that setting is nil or false.
  #
  # The guild is nil until DRStats has read INFO, which a login while dead
  # skips. Neither guild key holds then: a section for some guilds, or for
  # all but some, is wrong for a character whose guild may be any of them.
  #
  # @example
  #   context = TextSubs::Context.new(guild: 'Bard', settings: OpenStruct.new(herb_textsubs: true))
  #   context.allows?('guilds' => ['Bard'], 'setting' => 'herb_textsubs') # => true
  #   context.allows?('not_guilds' => ['Bard'])                          # => false
  # @example While DRStats does not know the guild
  #   TextSubs::Context.new(guild: nil, settings: OpenStruct.new).allows?('not_guilds' => ['Thief']) # => false
  class Context
    # @return [Array<String>] every guild DRStats can report, frozen
    def self.guilds
      ['Barbarian', 'Bard', 'Cleric', 'Commoner', 'Empath', 'Moon Mage', 'Necromancer', 'Paladin',
       'Ranger', 'Thief', 'Trader', 'Warrior Mage'].freeze
    end

    # @return [Array<String>] the keys a gate may hold, frozen
    def self.gate_keys
      %w[guilds not_guilds setting setting_off].freeze
    end

    # Checks that a gate has the shape the class comment describes, so a typo
    # in a key, a guild name or a setting name fails the load instead of
    # quietly turning a section off.
    #
    # @param gate [Hash, nil] a section's `when:` value
    # @return [nil]
    # @raise [ArgumentError] naming what is wrong with the gate
    def self.check_gate(gate)
      return if gate.nil?
      raise ArgumentError, "'when' must be a mapping, not #{gate.class}" unless gate.is_a?(Hash)
      raise ArgumentError, "'when' is empty; leave it out for a section every character gets" if gate.empty?

      unknown = gate.keys - gate_keys
      raise ArgumentError, "unknown 'when' key(s) #{unknown.map(&:inspect).join(', ')}; it takes #{gate_keys.join(', ')}" unless unknown.empty?

      gate.each { |key, value| key.start_with?('setting') ? check_setting(key, value) : check_guilds(key, value) }
      nil
    end

    # @param key [String] 'guilds' or 'not_guilds'
    # @param names [Object] the gate's value for key
    # @return [nil]
    # @raise [ArgumentError] unless names is a non-empty list of known guilds
    def self.check_guilds(key, names)
      raise ArgumentError, "'when' #{key} must be a non-empty list of guild names" unless names.is_a?(Array) && !names.empty? && names.all?(String)

      unknown = names - guilds
      raise ArgumentError, "'when' #{key} names unknown guild(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?
    end

    # @param key [String] 'setting' or 'setting_off'
    # @param name [Object] the gate's value for key
    # @return [nil]
    # @raise [ArgumentError] unless name is a non-empty String
    def self.check_setting(key, name)
      raise ArgumentError, "'when' #{key} must be a setting name" unless name.is_a?(String) && !name.empty?
    end
    private_class_method :check_guilds, :check_setting

    # @param guild [String, nil] what DRStats.guild reports, nil while it is
    #   not known
    # @param settings [#[]] the character settings (get_settings), read by name
    # @return [Context]
    def initialize(guild:, settings:)
      @guild = guild
      @settings = settings
    end

    # @return [String, nil] the guild the catalog is built for, nil when it
    #   is not known
    attr_reader :guild

    # @param gate [Hash, nil] a section's `when:` value
    # @return [Boolean] whether every condition of the gate holds; a guild
    #   condition never does while the guild is nil
    # @raise [ArgumentError] when the gate is malformed (see check_gate)
    def allows?(gate)
      self.class.check_gate(gate)
      return true if gate.nil?

      gate.all? do |key, value|
        case key
        when 'guilds' then value.include?(guild)
        when 'not_guilds' then !guild.nil? && !value.include?(guild)
        when 'setting' then setting?(value)
        else !setting?(value)
        end
      end
    end

    private

    # @param name [String] a settings key
    # @return [Boolean] true unless the setting is nil or false
    def setting?(name)
      @settings[name] ? true : false
    end
  end

  # Turns the data of data/base-textsubs.yaml into the ordered list of subs a
  # character gets. It is pure: it reads only the data and a Context, never a
  # file, a setting or DRStats, and it changes neither.
  #
  # Schema 1 is the mapping under the file's top-level `textsubs:` key:
  #   schema: 1
  #   sections:
  #     - name: 'Necromancer butchery'   # unique
  #       when:                          # optional, see Context
  #         guilds: ['Necromancer']
  #       kind: 'pairs'                  # optional, 'pairs' by default
  #       requires_any: ['Kronar']       # optional, see Registry
  #       subs:
  #         - ['regex source', 'gsub replacement']
  #
  # requires_any gates every sub of the section: a line holding none of the
  # words skips their regexes. It must only name words each pattern needs.
  #
  # The other kind, 'guild_spells_link', is the one sub whose replacement
  # names the character's guild. Its fields are pattern, preresult, prelink,
  # poslink and posresult, and it expands to
  #   [pattern, preresult + TextSubs.wiki_link(prelink + guild page + poslink, guild) + posresult]
  # or to no sub at all while the guild is not known, as a link to no guild
  # would only drop the guild's name from the line.
  #
  # Sections run in file order and subs in list order; both orders are kept,
  # because two subs that match the same line apply in that order. Every key
  # is checked, so an unknown key, kind or guild name fails the whole load.
  class Catalog
    # @return [Integer] the schema this script reads
    def self.schema
      1
    end

    # @return [Hash{String=>Array<String>}] each section kind and the fields
    #   it needs, all frozen
    def self.kinds
      { 'pairs'             => %w[subs].freeze,
        'guild_spells_link' => %w[pattern preresult prelink poslink posresult].freeze }.freeze
    end

    # @return [Array<String>] the keys every kind of section may hold, frozen
    def self.section_keys
      %w[name when kind requires_any].freeze
    end

    # The subs data gives a character, in order, as regex source: the same
    # subs as keyed_entries, each key given by its source. add_catalog stores
    # keyed_entries; this stays public as the plain-data view of a catalog,
    # whose sources compare with == and print as the YAML writes them, for
    # checking a data/custom copy from ;e or a tool, and for the specs.
    #
    # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs');
    #   nil when the file is missing or did not parse
    # @param context [TextSubs::Context] the guild and settings to gate on
    # @return [Array<Array(String, String, Hash)>] [regex source, replacement,
    #   meta] for each sub, where meta is a frozen { section: name }, plus
    #   requires_any: words when the section has a gate
    # @raise [ArgumentError] naming the first problem found anywhere in data,
    #   including in sections context does not select
    # @example
    #   data = { 'schema' => 1, 'sections' => [{ 'name' => 'all', 'subs' => [['fine', 'FINE']] }] }
    #   TextSubs::Catalog.entries(data, context) # => [['fine', 'FINE', { section: 'all' }]]
    def self.entries(data, context)
      keyed_entries(data, context).map { |key, replacement, meta| [key.source, replacement, meta] }
    end

    # The subs data gives a character, in order, each with its key compiled.
    # Checking the data compiles every pattern, those of the sections context
    # does not select too, and each selected sub reuses the Regexp that check
    # compiled, so storing a sub compiles nothing: each pattern the data
    # lists is compiled once, in the check. A source the data lists more than
    # once is compiled once per listing, and every sub with that source gets
    # the last of those Regexps (all eql?, so the key is the same).
    # Regexp.new keeps the source it is given, and a key compiled from source
    # with Regexp.new is eql? to /#{source}/, the key TextSubs.add stores. check
    # freezes each key, as /#{source}/ is frozen, so a key in TextSubs.subs
    # cannot be changed whichever writer stored it.
    #
    # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs');
    #   nil when the file is missing or did not parse
    # @param context [TextSubs::Context] the guild and settings to gate on
    # @return [Array<Array(Regexp, String, Hash)>] [key, replacement, meta]
    #   for each sub, where the key is frozen and meta is a frozen
    #   { section: name }, plus requires_any: words when the section has a gate
    # @raise [ArgumentError] naming the first problem found anywhere in data,
    #   including in sections context does not select
    # @example
    #   data = { 'schema' => 1, 'sections' => [{ 'name' => 'all', 'subs' => [['fine', 'FINE']] }] }
    #   TextSubs::Catalog.keyed_entries(data, context) # => [[/fine/, 'FINE', { section: 'all' }]]
    def self.keyed_entries(data, context)
      sections, keys = check(data)
      # check has validated every gate already, so allows? checks each one a
      # second time. That is deliberate: allows? is public and stays safe on
      # its own, and the repeat costs nothing at catalog size.
      sections.select { |section| context.allows?(section['when']) }
              .flat_map { |section| expand(section, context) }
              .map { |source, replacement, meta| [keys.fetch(source), replacement, meta] }
    end

    # @param data [Object] the `textsubs:` value
    # @return [Array(Array<Hash>, Hash{String=>Regexp})] its sections, every
    #   one checked, and every pattern in them compiled, by its source
    # @raise [ArgumentError] naming the first problem found
    def self.check(data)
      raise ArgumentError, "no 'textsubs:' mapping (the file is missing or did not parse)" unless data.is_a?(Hash)

      unknown = data.keys - %w[schema sections]
      raise ArgumentError, "unknown top-level key(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?
      raise ArgumentError, "schema #{data['schema'].inspect}, but this textsubs.lic reads schema #{schema}" unless data['schema'] == schema

      sections = data['sections']
      raise ArgumentError, "'sections' must be a non-empty list" unless sections.is_a?(Array) && !sections.empty?

      keys = sections.each_with_index.flat_map { |section, index| check_section(section, index) }
      names = sections.map { |section| section['name'] }
      repeated = names.tally.select { |_, count| count > 1 }.keys
      raise ArgumentError, "section name(s) used more than once: #{repeated.map(&:inspect).join(', ')}" unless repeated.empty?

      [sections, keys.to_h { |key| [key.source, key] }]
    end

    # @param section [Object] one element of 'sections'
    # @param index [Integer] its position, for the message
    # @return [Array<Regexp>] its patterns, compiled, in order
    # @raise [ArgumentError] naming the section and what is wrong with it
    def self.check_section(section, index)
      raise ArgumentError, 'is not a mapping' unless section.is_a?(Hash)
      raise ArgumentError, "has no 'name'" unless section['name'].is_a?(String) && !section['name'].empty?

      kind = section.fetch('kind', 'pairs')
      fields = kinds[kind]
      raise ArgumentError, "has unknown kind #{kind.inspect}; kinds are #{kinds.keys.join(', ')}" unless fields

      unknown = section.keys - section_keys - fields
      raise ArgumentError, "has unknown key(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?

      missing = fields - section.keys
      raise ArgumentError, "has no #{missing.join(', ')}" unless missing.empty?

      Context.check_gate(section['when'])
      Registry.check_requires_any(section['requires_any'])
      kind == 'pairs' ? check_pairs(section['subs']) : check_link(section)
    rescue ArgumentError => e
      label = section.is_a?(Hash) && section['name'].is_a?(String) ? " (#{section['name']})" : ''
      raise ArgumentError, "section #{index + 1}#{label} #{e.message}"
    end

    # @param subs [Object] a pairs section's 'subs'
    # @return [Array<Regexp>] the patterns, compiled, in order
    # @raise [ArgumentError] unless subs is a non-empty list of
    #   [pattern, replacement] String pairs whose patterns compile
    def self.check_pairs(subs)
      raise ArgumentError, "'subs' must be a non-empty list" unless subs.is_a?(Array) && !subs.empty?

      subs.each_with_index.map do |pair, index|
        unless pair.is_a?(Array) && pair.size == 2 && pair.all?(String)
          raise ArgumentError, "sub #{index + 1} must be a ['pattern', 'replacement'] pair of quoted strings, not #{pair.inspect}"
        end

        check_pattern(pair.first)
      end
    end

    # @param section [Hash] a guild_spells_link section
    # @return [Array<Regexp>] its one pattern, compiled
    # @raise [ArgumentError] unless every field is a String and the pattern compiles
    def self.check_link(section)
      kinds['guild_spells_link'].each do |field|
        raise ArgumentError, "'#{field}' must be a quoted string, not #{section[field].inspect}" unless section[field].is_a?(String)
      end
      [check_pattern(section['pattern'])]
    end

    # @param pattern [String] regex source
    # @return [Regexp] the pattern, compiled and frozen, as a Regexp literal is
    # @raise [ArgumentError] when it does not compile
    def self.check_pattern(pattern)
      Regexp.new(pattern).freeze
    rescue RegexpError => e
      raise ArgumentError, "pattern #{pattern.inspect} does not compile: #{e.message}"
    end

    # @param section [Hash] a checked section
    # @param context [TextSubs::Context]
    # @return [Array<Array(String, String, Hash)>] its subs; none for a
    #   guild_spells_link section while the guild is nil
    def self.expand(section, context)
      meta = { section: section['name'], requires_any: section['requires_any'] }.compact.freeze
      return section['subs'].map { |pattern, replacement| [pattern, replacement, meta] } unless section['kind'] == 'guild_spells_link'

      guild = context.guild
      return [] if guild.nil?

      link = TextSubs.wiki_link(section['prelink'] + guild.tr(' ', '_') + section['poslink'], guild)
      [[section['pattern'], section['preresult'] + link + section['posresult'], meta]]
    end
    private_class_method :check, :check_section, :check_pairs, :check_link, :check_pattern, :expand
  end

  # Parsers for the subs a character's own settings and files give. Each is
  # pure: it takes what the entry point read and returns what it can use
  # (PrivateSubs also returns a warning for each entry it skips), and never
  # opens a file or reads a setting itself.
  module Sources
    # The <checkname>_shit.list file integrate_shit_list_with_textsubs reads:
    # one player a line, the name first, then optionally a comma and a note.
    # Each name tags the player wherever the game names them, 'Bob' becoming
    # 'Bob (SL)'.
    #
    # @example
    #   names = TextSubs::Sources::ShitList.names(StringIO.new("bob,stole my kill\n\nqUIMBLE\n"))
    #   # => ["Bob", "Quimble"]
    #   TextSubs::Sources::ShitList.sub(names.first) # => ["\\bBob\\b", "Bob (SL)"]
    class ShitList
      # The names in a shit-list file, in order. A line with no name (blank,
      # only spaces, or a note after an empty name) gives none: its name
      # would compile to a pattern that matches the end of every line or
      # between every two characters of it.
      #
      # Each line is read as bytes (ASCII-8BIT), the way game lines arrive,
      # so a hand-edited byte that is not UTF-8 cannot raise and end the
      # script before any sub is installed, and a UTF-8 byte order mark a
      # Windows editor puts at the start is dropped rather than left in
      # front of the first name.
      #
      # @param io [#each_line] the open file
      # @return [Array<String>] frozen: each name stripped and capitalized,
      #   in ASCII-8BIT
      def self.names(io)
        io.each_line.filter_map do |line|
          name = line.b.delete_prefix(byte_order_mark).split(',', 2).first.to_s.strip
          name.capitalize.freeze unless name.empty?
        end.freeze
      end

      # The UTF-8 byte order mark, as bytes.
      #
      # @return [String] frozen
      def self.byte_order_mark
        [0xEF, 0xBB, 0xBF].pack('C*').freeze
      end
      private_class_method :byte_order_mark

      # The sub that tags one name. The name is matched as plain text, so a
      # regex character in it stands for itself, and as a whole word, so
      # 'Bob' tags neither 'Bobby' nor 'McBob'. (A name that starts or ends
      # with a character other than a letter, digit or underscore then only
      # matches next to one; player names are letters.)
      #
      # @param name [String] one of names
      # @return [Array(String, String)] frozen [regex source, gsub replacement]
      def self.sub(name)
        ["\\b#{Regexp.escape(name)}\\b", "#{name} (SL)"].freeze
      end
    end

    # The private_textsubs setting: a mapping of 'regex source': 'gsub
    # replacement' a player writes in their YAML. A key may also be a
    # !ruby/regexp, which YAML gives as a Regexp: it keeps its flags, so
    # !ruby/regexp /you feel fine/i matches in any case.
    #
    # Regexp#== compares the i, m and x flags, so a key with any of them is
    # never the built-in key of the same source (see TextSubs.prefer_private):
    # both are in the catalog and both run on a line, the private one first.
    # A key with none of them is that built-in key, and the private value
    # replaces the built-in one. That includes /text/n: on an ASCII-only
    # source /n gives the same Regexp as the flagless key (== and #hash
    # agree), so it is treated as that key, not as one of its own.
    #
    # A String key and a !ruby/regexp key of the same source with none of
    # i, m or x are the same pattern, so only the first of them is used and
    # the other is skipped, saying so; the catalog could hold only one of
    # them anyway.
    #
    # Every message names a key as the player wrote it (see label): a String
    # in double quotes as it is, with no escaping, and a Regexp as /text/flags.
    #
    # @example
    #   TextSubs::Sources::PrivateSubs.entries('You feel fine' => 'You feel FINE', 'Bob' => nil)
    #   # => [[[/You feel fine/, "You feel FINE", "\"You feel fine\""]],
    #   #     ["private_textsubs \"Bob\" is skipped: its replacement is empty (nil) ..."]]
    # @example A !ruby/regexp key
    #   TextSubs::Sources::PrivateSubs.entries(/you feel fine/i => 'MINE')
    #   # => [[[/you feel fine/i, "MINE", "/you feel fine/i"]], []]
    # @example The same pattern twice
    #   TextSubs::Sources::PrivateSubs.entries('fine' => 'A', /fine/ => 'B')
    #   # => [[[/fine/, "A", "\"fine\""]],
    #   #     ["private_textsubs /fine/ is skipped: it is the same pattern as \"fine\", which is used instead."]]
    class PrivateSubs
      # The match timeout of every private key, so one runaway pattern cannot
      # stall the game thread: the engine drops a key that times out. It is
      # lich-5's own timeout for user regexes, which every Lich from the
      # 5.23.0 floor (dependency.lic) defines.
      #
      # @return [Float] seconds (1.0 as lich-5 ships it)
      def self.regex_timeout
        Lich::Common::UserDefs::REGEX_TIMEOUT_SECONDS
      end

      # The entries of a private_textsubs value that can be used, in order,
      # and why each other one cannot. A key whose replacement is not a
      # String would raise on the first line it matched, and one that is not
      # valid regex source would end the script at load, so neither is added.
      #
      # @param value [Object] the private_textsubs setting: a Hash, or nil
      #   when it is unset (base.yaml leaves it empty); its keys are regex
      #   source (String) or Regexp
      # @return [Array(Array<Array(Regexp, String, String)>, Array<String>)]
      #   frozen [entries, warnings]: each entry a key compiled with
      #   regex_timeout (a Regexp key with its own flags), its replacement and
      #   the key's name (see label: "text" or /text/i), no two entries with
      #   the same key; each warning one sentence naming a skipped key
      # @example A setting that is not a mapping
      #   TextSubs::Sources::PrivateSubs.entries(nil)   # => [[], []]
      #   TextSubs::Sources::PrivateSubs.entries('Bob') # => [[], ["private_textsubs is a String, not a mapping ..."]]
      def self.entries(value)
        entries = []
        warnings = []
        if value.is_a?(Hash)
          value.each do |source, replacement|
            reason = problem(source, replacement)
            key, reason = compile(source) unless reason
            reason ||= duplicate(entries, key)
            if reason
              warnings << "private_textsubs #{label(source)} is skipped: #{reason}."
            else
              entries << [key, replacement, label(source)].freeze
            end
          end
        elsif !value.nil?
          warnings << "private_textsubs is #{article(value)}, not a mapping of 'old text': 'new text'; it is ignored."
        end
        [entries.freeze, warnings.freeze].freeze
      end

      # @param source [Object] a private_textsubs key
      # @param replacement [Object] its value
      # @return [String, nil] why the pair cannot be used, before compiling
      def self.problem(source, replacement)
        return "it is #{article(source)}, not a quoted string; quote it in your YAML" unless source.is_a?(String) || source.is_a?(Regexp)
        return 'an empty pattern matches between every two characters of every line' if pattern(source).first.empty?
        return "its replacement is empty (nil); write '' to delete the text it matches" if replacement.nil?
        unless replacement.is_a?(String)
          return "its replacement #{replacement.inspect} is #{article(replacement)}, not a quoted string; quote the replacement in your YAML"
        end

        nil
      end

      # @param source [String, Regexp] regex source, or a Regexp whose source
      #   and flags the key takes
      # @return [Array(Regexp, nil), Array(nil, String)] [key, nil], or
      #   [nil, why it does not compile]
      def self.compile(source)
        [Regexp.new(*pattern(source), timeout: regex_timeout), nil]
      rescue RegexpError => e
        [nil, "it is not a valid regex (#{e.message})"]
      end

      # @param entries [Array<Array(Regexp, String, String)>] the entries
      #   kept so far
      # @param key [Regexp] a compiled key
      # @return [String, nil] why key cannot be used when an earlier entry
      #   has the same key (Regexp#==, as the catalog Hash compares keys)
      def self.duplicate(entries, key)
        earlier = entries.assoc(key)
        "it is the same pattern as #{earlier.last}, which is used instead" if earlier
      end

      # A key's name in a message, as the player wrote it: a String key in
      # double quotes with no escaping, so 'a(\d)' reads "a(\d)" and not
      # Ruby's "a(\\d)"; a Regexp key as /text/flags (Regexp#inspect, which
      # does not escape its source either); any other key as Ruby shows it.
      #
      # @param source [Object] a private_textsubs key
      # @return [String]
      # @example
      #   TextSubs::Sources::PrivateSubs.send(:label, 'a(\d)') # prints "a(\d)"
      #   TextSubs::Sources::PrivateSubs.send(:label, /a/i)     # => "/a/i"
      #   TextSubs::Sources::PrivateSubs.send(:label, 12)       # => "12"
      def self.label(source)
        source.is_a?(String) ? "\"#{source}\"" : source.inspect
      end

      # The regex source and flags a key stands for, the one place a Regexp
      # key and a String key are told apart: a Regexp gives its own, a String
      # is the source itself with no flags.
      #
      # @param source [String, Regexp] a private_textsubs key
      # @return [Array(String, Integer)] [regex source, Regexp options]
      # @example
      #   TextSubs::Sources::PrivateSubs.send(:pattern, /a b/ix) # => ["a b", 3]
      #   TextSubs::Sources::PrivateSubs.send(:pattern, 'a b')   # => ["a b", 0]
      def self.pattern(source)
        source.is_a?(Regexp) ? [source.source, source.options] : [source, 0]
      end

      # @param value [Object]
      # @return [String] its class with an indefinite article
      def self.article(value)
        name = value.class.name
        "#{name.match?(/\A[AEIOU]/) ? 'an' : 'a'} #{name}"
      end
      private_class_method :problem, :compile, :duplicate, :label, :pattern, :article
    end
  end

  # Whether any front end receives game output right now. It mirrors lich-5's
  # Game#client_write_targets: a non-empty detachable client registry, else the
  # legacy single detachable client, else the primary client ($_CLIENT_, nil
  # under --without-frontend). Lich runs the downstream hooks before it picks
  # those targets, so with none of them no client receives a rewritten line;
  # only the hooks after this one would see it.
  #
  # The defaults read the Lich globals on every call: a detachable client can
  # attach or leave at any time, so the hook asks once per line.
  #
  # @param registry [#empty?, nil] the detachable client registry
  #   (Lich::Common::DetachableClientRegistry)
  # @param detachable [Object, nil] the legacy primary detachable client
  # @param client [Object, nil] the primary front end client
  # @return [Boolean] true when at least one front end is attached
  # @example On a character started with --without-frontend and no detachable client
  #   TextSubs.client_attached? # => false
  def self.client_attached?(registry: $_DETACHABLE_CLIENT_REGISTRY_, detachable: $_DETACHABLE_CLIENT_, client: $_CLIENT_)
    return true if registry && !registry.empty?
    return true if detachable

    client ? true : false
  end

  # Links text to the Elanthipedia page of the same name, with underscores
  # between the words (MikeLC 2/15/2025; thanks to Tysong for the "how to
  # hyperlink" help).
  #
  # Kept as public API for players' own scripts: the built-in catalog no
  # longer calls it, as data/base-textsubs.yaml stores each link already
  # expanded into a [pattern, replacement] pair.
  #
  # The key is three capture groups, (pretext)(text)(postext), so the context
  # around the text can be matched and put back. pretext, text and postext
  # build the key: they are regex source, compiled unescaped. preresult,
  # posresult, prelink, poslink and text are gsub replacement text, so \0 to
  # \9, \&, \`, \', \+ and \\ in them are substitutions; any other
  # backslash stays as written. \k<name> is one too, but the key's three
  # groups have no name, so it raises IndexError on the hook thread unless
  # pretext or postext names that group; a named group also stops the three
  # plain groups from capturing, so \1 to \3 then count named groups only.
  # text is the one argument that is both, so a regex escape in it (such as
  # \s) matches in the key but shows verbatim in the link and the page name,
  # while a substitution in it (such as \&) is replaced in both.
  #
  # @param text [String] the text to link; also the page name, spaces turned
  #   into underscores
  # @param pretext [String] context before the text, capture group 1
  # @param postext [String] context after the text, capture group 3
  # @param prelink [String] prefix of the page path, for a page outside the
  #   root namespace (such as 'Category:')
  # @param poslink [String] suffix of the page path, for a page whose name goes
  #   on past the text (such as '_spellbook')
  # @param preresult [String] replacement before the link; the default '\1'
  #   puts back what pretext matched
  # @param posresult [String] replacement after the link; the default '\3'
  #   puts back what postext matched (group 2 is the text itself)
  # @return [String] the replacement it stored
  # @example Link a spellbook heading to its category page
  #   TextSubs.elanthipedia('Fae Arts', '^', ':', 'Category:', '_spellbook')
  #   # "Fae Arts:" becomes
  #   # <a href="https://elanthipedia.play.net/Category:Fae_Arts_spellbook">Fae Arts</a>:
  def self.elanthipedia(text, pretext = '', postext = '', prelink = '', poslink = '', preresult = '\1', posresult = '\3')
    target = "(#{pretext})" + "(#{text})" + "(#{postext})"
    hyperlink = prelink + text.gsub(" ", "_") + poslink
    result = preresult + wiki_link(hyperlink, text) + posresult
    store(target, result, change: true)
  end

  # The anchor tag that links text to an Elanthipedia page, shared by
  # elanthipedia and the catalog's guild spell list link.
  #
  # @param page [String] the page path after the site root, used as is
  # @param text [String] what the link shows
  # @return [String] the <a href="...">text</a> markup
  # @example
  #   TextSubs.wiki_link('Category:Bard_spells', 'Bard')
  #   # => "<a href=\"https://elanthipedia.play.net/Category:Bard_spells\">Bard</a>"
  def self.wiki_link(page, text)
    "<a href=\"https://elanthipedia.play.net/#{page}\">#{text}</a>"
  end

  # Where get_data('textsubs') reads a user's own copy of the catalog: a file
  # in data/custom replaces the shipped data/base-textsubs.yaml wholesale.
  #
  # @param script_dir [String] Lich's SCRIPT_DIR
  # @return [String, nil] the path of data/custom/base-textsubs.yaml when that
  #   file exists, else nil
  def self.catalog_override(script_dir)
    path = File.join(script_dir, 'data', 'custom', 'base-textsubs.yaml')
    File.file?(path) ? path : nil
  end

  # Adds the built-in subs the catalog data gives the character, in order,
  # each under the key Catalog.keyed_entries compiled while it checked the
  # data, so no pattern is compiled a second time, and each with its
  # section's requires_any gate. Data that cannot be used adds nothing at
  # all, never part of a catalog, and the caller shows the message this
  # returns: the script then runs with the private_textsubs and shit-list
  # subs alone.
  #
  # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs')
  # @param context [TextSubs::Context] the guild and settings to gate on
  # @param file [String] the file the data came from, named in the message
  # @param registry [TextSubs::Registry] where the subs go; write_target
  #   unless build passes the Registry it fills
  # @return [String, nil] nil once every sub is added, else the one message
  #   that says why none was
  # @example A file left over from an older dr-scripts
  #   TextSubs.add_catalog({ 'schema' => 0 }, context, file: 'data/base-textsubs.yaml')
  #   # => "No built-in subs: data/base-textsubs.yaml cannot be used (schema 0, ...). ..."
  def self.add_catalog(data, context, file:, registry: write_target)
    entries = Catalog.keyed_entries(data, context)
  rescue ArgumentError => e
    "No built-in subs: #{file} cannot be used (#{e.message}). This textsubs.lic needs a 'textsubs:' mapping " \
      "with schema: #{Catalog.schema}; update dr-scripts, or fix or remove a copy in data/custom. " \
      'Only private_textsubs and shit-list subs are active.'
  else
    entries.each { |key, replacement, meta| store_key(key, replacement, requires_any: meta[:requires_any], registry: registry) }
    nil
  end

  # Fills registry with a character's whole catalog, in the order the subs
  # take their places: the shit-list names, the private_textsubs entries, the
  # built-in subs data gives for context, and then each private value a
  # built-in sub replaced given back (prefer_private).
  #
  # The entry point never fills the installed catalog: on a start registry
  # is the staged Registry (see stage), and when watch has the catalog built
  # again for a new guild it is one of its own, while the hook goes on
  # applying the old one. Its subs count no generation until install swaps it
  # in.
  #
  # @param registry [TextSubs::Registry] the catalog to fill
  # @param shit_list [Array<String>] names from Sources::ShitList.names
  # @param private_subs [Array<Array(Regexp, String, String)>] the entries of
  #   Sources::PrivateSubs.entries
  # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs')
  # @param context [TextSubs::Context] the guild and settings to gate on
  # @param file [String] the file data came from, for add_catalog's message
  # @return [Array<String>] what to tell the player, in order: why no
  #   built-in sub was added, if none was, then prefer_private's warnings
  # @example Build the catalog for a guild DRStats has just learned
  #   registry = TextSubs::Registry.new
  #   TextSubs.build(registry, shit_list: [], private_subs: [], data: data, context: context, file: file) # => []
  #   TextSubs.reinstall(registry)
  def self.build(registry, shit_list:, private_subs:, data:, context:, file:)
    shit_list.each { |name| store(*Sources::ShitList.sub(name), registry: registry) }
    add_private(private_subs, registry: registry)
    problem = add_catalog(data, context, file: file, registry: registry)
    [problem, *prefer_private(private_subs, registry: registry)].compact
  end

  # Adds the private_textsubs entries, in order. They go in ahead of the
  # built-in catalog, so each keeps the first position its key gets; a key the
  # catalog adds again takes the built-in value until prefer_private gives it
  # back.
  #
  # @param entries [Array<Array(Regexp, String, String)>] the entries of
  #   Sources::PrivateSubs.entries
  # @param registry [TextSubs::Registry] where they go (see add_catalog)
  # @return [Array<Array(Regexp, String, String)>] entries
  def self.add_private(entries, registry: write_target)
    entries.each { |key, replacement| store_key(key, replacement, registry: registry) }
  end

  # Gives each private key whose value a later add replaced (a built-in sub
  # with the same regex source) its private replacement back, in the place
  # the key already holds. A private sub is the player's own choice, so it
  # wins over the shipped one. The key keeps the gate the built-in gave it:
  # a gate is a promise about the pattern (see Registry), and the pattern is
  # the same, so the private value is spared the regex on lines the gate
  # rules out just as the built-in one was. It reads and writes the catalog
  # being built: the staged Registry on a start (see stage).
  #
  # @param entries [Array<Array(Regexp, String, String)>] the entries
  #   add_private added: key, replacement and the key's name (see
  #   Sources::PrivateSubs.label: "text" unescaped, or /text/flags)
  # @param registry [TextSubs::Registry] the catalog they were added to (see
  #   add_catalog)
  # @return [Array<String>] one warning per key given back, naming it by
  #   that name; empty when no key was replaced, or only by the same text
  # @example After add_private([[/You feel fine/, 'MINE', '"You feel fine"']]) and a built-in add of 'You feel fine'
  #   TextSubs.prefer_private([[/You feel fine/, 'MINE', '"You feel fine"']])
  #   # => ["private_textsubs \"You feel fine\" is also a built-in sub; your replacement is used instead of the built-in one."]
  def self.prefer_private(entries, registry: write_target)
    entries.filter_map do |key, replacement, name|
      catalog = registry.snapshot
      next if !catalog.key?(key) || catalog[key] == replacement

      store_key(key, replacement, requires_any: registry.gates[key], registry: registry)
      "private_textsubs #{name} is also a built-in sub; your replacement is used instead of the built-in one."
    end
  end

  # Compiles target unescaped and hands the key to store_key, for add,
  # elanthipedia and the shit-list names build adds, whose subs are regex
  # source.
  #
  # None of them gives a gate: only the catalog data sets one, through
  # add_catalog, so add keeps its two arguments.
  #
  # @param target [String] regex source, compiled unescaped
  # @param result [String] the gsub replacement
  # @param registry [TextSubs::Registry] the catalog to write (see store_key)
  # @param change [Boolean] whether to record the sub as a change (see
  #   store_key)
  # @return [String] result
  # @raise [RegexpError] when target is not valid regex source; the catalog
  #   and the generation are left as they were
  def self.store(target, result, registry: write_target, change: false)
    store_key(/#{target}/, result, registry: registry, change: change)
  end

  # The one writer of a catalog: add and elanthipedia reach it through store,
  # and add_catalog, add_private and prefer_private call it straight, as their
  # keys are compiled already (a private key with its timeout). It writes one
  # key to registry, write_target unless the caller names one, and counts it
  # under the lock, so no stage, unstage or install of another thread lands
  # between the write and the count. A key written to the installed catalog
  # then counts one generation, so a call is one key and one generation per sub
  # and the generation never runs ahead of the catalog; a key written to a
  # Registry that is not installed (staged, this thread's own build, or built
  # again for a new guild) is not in subs yet and counts none, as install
  # counts that whole catalog once, when it swaps it in.
  #
  # @param key [Regexp] the pattern
  # @param result [String] the gsub replacement
  # @param requires_any [Array<String>, nil] the key's gate (see Registry)
  # @param registry [TextSubs::Registry] the catalog to write; write_target
  #   by default
  # @param change [Boolean] true for add and elanthipedia, whose subs come
  #   from other scripts once the catalog is built: the Registry records
  #   them (Registry#add_change) so reinstall keeps them
  # @return [String] result
  # @raise [ArgumentError] when key is not a Regexp or requires_any is
  #   malformed; the catalog and the generation are left as they were
  def self.store_key(key, result, requires_any: nil, registry: write_target, change: false)
    @@lock.synchronize do
      if change
        registry.add_change(key, result, requires_any: requires_any)
      else
        registry.add(key, result, requires_any: requires_any)
      end
      @@generation += 1 if registry.equal?(@@registry)
    end
    result
  end

  # The catalog being built, which an add writes: this thread's own build
  # while it has one (see stage), else the staged Registry while there is
  # one, else the installed one.
  #
  # @return [TextSubs::Registry]
  def self.write_target
    own_build || @@staged || @@registry
  end
  private_class_method :store, :store_key, :write_target
end

settings = get_settings

# Waits a few seconds at most, before the catalog is built, for DRStats to
# know the guild the guild sections are chosen by.
guild = TextSubs.await_guild

# Shit list players, tagged wherever the game names them.
shit_list_names = []
if settings.integrate_shit_list_with_textsubs && File.file?("#{checkname}_shit.list")
  shit_list_names = File.open("#{checkname}_shit.list", 'r') { |file| TextSubs::Sources::ShitList.names(file) }
end

# A private_textsubs entry that cannot be used is skipped, saying why, so one
# bad line of YAML neither ends the script here nor drops a sub later.
private_subs, private_warnings = TextSubs::Sources::PrivateSubs.entries(settings.private_textsubs)
private_warnings.each { |warning| echo warning }
### SPELLBOOK PROJECT - MikeLC 2/15/2025 ###
#
# Creates elanthipedia weblinks for the spells and spellbooks
# as long as it is in column-formatted mode.
#
# Also links the spells in your Active Spells Windows, creating
# links for spells on your person (since they are not always in
# your spellbook).
#
# In your YAML, set... 'textsubs_spell_links: true'
#
# *NOTE* If spellmonitor.lic is called before textsubs.lic, no issues.
#
#        If spellmonitor.lic is called after textsubs.lic, will break
#        buff-watcher.lic, causing it to not register active spells on
#        your person.
#
#		In-Game Fix: Kill and restart 'textsubs.lic'.
#		    ;k textsubs
#           ;textsubs
#
#        Autostart Fix: Ensure textsubs is the last script on the list.
#			;e stop_autostart('textsubs')
#			;e autostart('textsubs')
#

# The built-in subs live in data/base-textsubs.yaml (or a copy in
# data/custom, which get_data reads instead). When that data cannot be used,
# none of it is added and the script says so once.
catalog_override = TextSubs.catalog_override(SCRIPT_DIR)
if catalog_override
  echo "Reading the built-in subs from #{catalog_override}, which replaces data/base-textsubs.yaml " \
       "(it must be a 'textsubs:' mapping with schema: #{TextSubs::Catalog.schema})."
end
catalog_data = get_data('textsubs').textsubs
catalog_file = catalog_override || File.join(SCRIPT_DIR, 'data', 'base-textsubs.yaml')

# Fills registry with every sub a character of for_guild gets, from the
# inputs read above, and shows what TextSubs.build has to say about them that
# an earlier fill has not said already: a rebuild for a new guild repeats
# only the warnings that guild brings.
shown_messages = []
fill_catalog = lambda do |registry, for_guild|
  context = TextSubs::Context.new(guild: for_guild, settings: settings)
  messages = TextSubs.build(registry, shit_list: shit_list_names, private_subs: private_subs, data: catalog_data,
                                      context: context, file: catalog_file)
  (messages - shown_messages).each { |message| echo message }
  shown_messages |= messages
  registry
end

# Every start builds its catalog from nothing: a restart with other settings
# keeps none of the keys the run before it added. The catalog is built in a
# staged Registry and installed whole once it is complete. Lich has already
# re-run the class body, which installed an empty catalog, so a hook of the
# run before that is still registered passes every line through untouched
# until then, never applying a part of the new catalog. The 'textsub' hook is
# registered after that, so with no older hook a line that arrives while the
# catalog is built passes through untouched too. A build that raises ends the
# staging when the script dies, so the adds of other scripts reach the
# installed catalog again; the partial catalog is never installed. Once the
# catalog is installed, unstage changes nothing. A start that overlaps this
# one (';force textsubs' while it builds) has a Registry of its own, and
# install refuses this run's once the newer start has staged (it returns
# nil), so this run then ends here, before it registers a hook.
new_catalog = TextSubs.stage(TextSubs::Registry.new)
before_dying { TextSubs.unstage(new_catalog) }
exit unless TextSubs.install(fill_catalog.call(new_catalog, guild))

action = proc do |client_string|
  # Headless: nobody would see the rewrite, so skip every key.
  next client_string unless TextSubs.client_attached?

  TextSubs.apply(client_string)
end

# persist: false hands the cleanup to Lich, which removes the hook when this
# script ends, and only if this script still owns it: a newer textsubs that
# re-registered 'textsub' keeps its hook when an older one dies. The priority
# runs it after every default-priority hook (see TextSubs.hook_priority).
DownstreamHook.add('textsub', action, persist: false, priority: TextSubs.hook_priority)

# Runs until the hook is gone, then ends the script, so restart helpers see
# that textsubs is no longer running; a newer start (';force textsubs') ends
# it too, as new_catalog then no longer stands for the current run. When
# DRStats reports another guild (INFO after a login while dead), the catalog
# is built again for it, whole, while the hook goes on applying the old one,
# and then swapped in with the subs other scripts added since the start, and
# without those dropped, unless a newer start took over during the build.
TextSubs.watch('textsub', guild: guild, run: new_catalog) do |new_guild|
  if TextSubs.reinstall(fill_catalog.call(TextSubs::Registry.new, new_guild), run: new_catalog)
    echo "Your guild is now #{new_guild || 'not known'}, so textsubs has built its subs again for it."
  end
end
