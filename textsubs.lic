# quiet
=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#textsubs
=end

no_pause_all
no_kill_all

# The text substitution catalog and the engine that applies it to game lines.
#
# The script's entry point stages a fresh, empty Registry on every start,
# fills it through add (the shit list, private_textsubs, then the built-in
# subs Catalog reads from data/base-textsubs.yaml), installs it whole, and only
# then registers a 'textsub' DownstreamHook (persist: false, so Lich removes it
# when the script ends) that hands every server line to apply while a front
# end is attached. Until the install, apply serves the empty catalog the class
# body installed when the start evaluated it.
#
# Lich evaluates this class body inside Lich::Common on every start, and the
# class itself persists for the session, so it defines no constants but its
# nested classes: re-running the body would warn "already initialized
# constant" for any other. Re-running it installs an empty Registry and drops
# any staging; the generation count carries over and counts that swap once
# (see generation).
class TextSubs
  # An ordered catalog of substitutions: a Regexp key and the gsub replacement
  # it applies. A key added again keeps its first position and takes the last
  # value, exactly as a Hash does.
  #
  # One thread writes a Registry while others may read it, so readers never
  # see the entries themselves, only a frozen snapshot of them.
  #
  # @example
  #   registry = TextSubs::Registry.new
  #   registry.add(/cat/, 'dog')
  #   registry.add(/c/, 'k')
  #   registry.add(/cat/, 'lion')
  #   registry.snapshot # => {/cat/=>"lion", /c/=>"k"} (frozen)
  class Registry
    # @return [Registry] an empty registry
    def initialize
      @entries = {}
      @version = 0
      @snapshot = nil
    end

    # Adds one substitution, or gives a key already present its new value in
    # the position it already holds.
    #
    # @param key [Regexp] the pattern
    # @param result [String] the gsub replacement; the registry keeps a frozen
    #   copy, so changing the caller's String later does not reach it
    # @return [String] result, as given
    # @raise [ArgumentError] when key is not a Regexp
    def add(key, result)
      raise ArgumentError, "TextSubs::Registry keys are Regexps, not #{key.class}" unless key.is_a?(Regexp)

      @entries[key] = result.dup.freeze
      @version += 1
      result
    end

    # The entries as they stand, in order, as a frozen Hash. The same Hash
    # comes back until the next add, so a reader calling once per line copies
    # the catalog only after it changes.
    #
    # The version is read before the entries are copied: an add that lands in
    # between leaves a snapshot that holds more than its version says, which
    # is thrown away on the next call, never one that holds less.
    #
    # @return [Hash{Regexp=>String}] frozen, with frozen values
    def snapshot
      version = @version
      cached = @snapshot
      return cached.last if cached && cached.first == version

      entries = @entries.dup.freeze
      @snapshot = [version, entries].freeze
      entries
    end
  end

  # One lock, kept across starts like the generation, so a start's class body
  # and every stage, unstage, install and store, of this run or another, take
  # turns: each checks the staging and changes it in one step, with no step of
  # another thread in between.
  @@lock = Mutex.new unless defined?(@@lock)
  @@lock.synchronize do
    @@registry = Registry.new
    @@staged = nil
    @@generation = defined?(@@generation) ? @@generation + 1 : 0
  end

  # The catalog, in the order its keys were first added.
  #
  # @return [Hash{Regexp=>String}] a frozen snapshot of the installed Registry:
  #   each key and the gsub replacement it applies
  def self.subs
    @@registry.snapshot
  end

  # How many times the catalog has changed this session. install and clear
  # count once each. add and elanthipedia count once when they write the
  # installed catalog, and not at all while a Registry is staged (see stage):
  # install counts that whole catalog once, when it swaps it in.
  #
  # The class body sets the count to 0 the first time it runs in a session.
  # Every later start runs it again, which installs an empty catalog, and
  # that swap counts once like any other install, after the empty catalog is
  # in. So the count only rises: two starts never leave the same number on two
  # different catalogs, and a cache keyed on it that outlives a restart
  # rebuilds as soon as the class body has emptied the catalog, not only once
  # the new catalog is installed.
  #
  # The count rises only after the change is visible in subs, so a reader on
  # another thread that sees a new generation also sees the catalog it counts.
  # A cache keyed on the generation should read it before it reads subs: if a
  # change lands in between, the cache holds a newer catalog under an older
  # number and rebuilds on the next call, never the other way round.
  #
  # @return [Integer] 0 until the catalog first changes in this session
  def self.generation
    @@generation
  end

  # Makes registry the catalog that add, elanthipedia, subs and apply use, in
  # one assignment, so a reader sees either the old Registry or the new one,
  # never a mix of the two. It swaps the catalog in first and counts the
  # change after, the same order store keeps, so the generation never runs
  # ahead of subs. The swap is only as complete as registry is, so the entry
  # point fills a staged Registry (see stage) and installs it once every key
  # is in: a hook still registered while it builds, such as the one of a run
  # that is being stopped, applies the installed catalog, never a part of the
  # new one. On a start in Lich that installed catalog is the empty one the
  # class body has just put in, so such a hook passes every line through
  # untouched until install. Installing the staged Registry ends the staging,
  # so add and elanthipedia write to it as the installed catalog from then on.
  #
  # A Registry this thread staged is installed only while it is still the one
  # staged. Once a newer start has staged its own (';force textsubs' while
  # this one builds), or its class body has dropped the staging, install
  # refuses it and returns nil: that start's catalog comes next, so this one,
  # however complete, never replaces it. A Registry this thread did not stage
  # (a fresh one, as clear installs) is installed whatever is staged.
  #
  # An add that runs on another thread just before install swaps the catalog
  # lands in the Registry being replaced.
  #
  # @param registry [TextSubs::Registry] the catalog to use from now on
  # @return [TextSubs::Registry, nil] registry, or nil when it is a Registry
  #   this thread staged that is no longer the one staged; then the installed
  #   catalog and the generation are left as they were
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; the
  #   installed catalog and the generation are left as they were
  # @example Start over with an empty catalog
  #   TextSubs.install(TextSubs::Registry.new)
  # @example How the entry point installs its build, and ends if a newer start superseded it
  #   exit unless TextSubs.install(new_catalog)
  def self.install(registry)
    check_registry(registry, 'install')
    @@lock.synchronize do
      if registry.equal?(own_build)
        bind_build(nil)
        return nil unless registry.equal?(@@staged)
      end
      @@registry = registry
      @@staged = nil if registry.equal?(@@staged)
      @@generation += 1
    end
    registry
  end

  # Makes add and elanthipedia write to registry, which is not installed, so a
  # catalog can be built while subs and apply go on using the installed one.
  # install(registry) swaps it in whole and ends the staging. A sub another
  # script adds meanwhile goes into registry too, so the swap keeps it.
  #
  # Staging another Registry replaces the first one. A start that dies before
  # it installs its staged Registry ends the staging with unstage, so the adds
  # of other scripts reach the installed catalog again.
  #
  # registry is also this thread's own build until this thread installs or
  # unstages it: the adds made on this thread go into it even after another
  # thread stages a Registry of its own, or a start's class body drops the
  # staging. So when two starts overlap (';force textsubs' while one builds),
  # neither one's keys reach the other's catalog, and none reaches the
  # installed one; install then refuses the superseded build (see install).
  #
  # @param registry [TextSubs::Registry] the catalog to build
  # @return [TextSubs::Registry] registry
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; nothing
  #   is staged
  # @example How the entry point builds the catalog on a start
  #   catalog = TextSubs.stage(TextSubs::Registry.new)
  #   TextSubs.add('You feel fine', 'You feel FINE') # into catalog; subs is unchanged
  #   TextSubs.install(catalog)
  def self.stage(registry)
    check_registry(registry, 'stage')
    @@lock.synchronize do
      bind_build(registry)
      @@staged = registry
    end
  end

  # Ends the staging of registry without installing it, for a build that did
  # not finish: add and elanthipedia write to the installed catalog again, and
  # the keys registry holds, a sub another script added meanwhile among them,
  # are dropped with it. A partial catalog is never installed. When registry
  # is not the one staged (it was installed, or another Registry was staged
  # since), the staging is left as it is, so a run that ends late cannot end
  # the staging of a newer start: the check and the change are one step under
  # the lock. Either way registry stops being this thread's own build.
  #
  # @param registry [TextSubs::Registry] the Registry the caller staged
  # @return [Boolean] true when it ended the staging, false when registry was
  #   not staged
  # @raise [ArgumentError] when registry is not a TextSubs::Registry; the
  #   staging is left as it was
  # @example How the entry point ends its staging when the script dies early
  #   catalog = TextSubs.stage(TextSubs::Registry.new)
  #   before_dying { TextSubs.unstage(catalog) }
  def self.unstage(registry)
    check_registry(registry, 'unstage')
    @@lock.synchronize do
      bind_build(nil) if registry.equal?(own_build)
      return false unless registry.equal?(@@staged)

      @@staged = nil
      true
    end
  end

  # The Registry this thread staged and has neither installed nor unstaged
  # since (see stage). It lives in a thread variable, so it ends with the
  # thread: a run that dies mid-build leaves nothing behind.
  #
  # @return [TextSubs::Registry, nil] this thread's own build, if any
  def self.own_build
    Thread.current.thread_variable_get(:textsubs_build)
  end

  # Makes registry this thread's own build, or ends it when given nil.
  #
  # @param registry [TextSubs::Registry, nil] the build, or nil
  # @return [TextSubs::Registry, nil] registry
  def self.bind_build(registry)
    Thread.current.thread_variable_set(:textsubs_build, registry)
  end
  private_class_method :own_build, :bind_build

  # Refuses anything but a TextSubs::Registry, naming the public method that
  # was given it.
  #
  # @param registry [Object] what install, stage or unstage was given
  # @param caller_name [String] the method's name, for the message
  # @return [nil]
  # @raise [ArgumentError] unless registry is a TextSubs::Registry
  def self.check_registry(registry, caller_name)
    return if registry.is_a?(Registry)

    raise ArgumentError, "TextSubs.#{caller_name} needs a TextSubs::Registry, not #{registry.class}"
  end
  private_class_method :check_registry

  # Empties the catalog by installing a fresh Registry.
  #
  # @return [Hash] the new, empty catalog (frozen)
  def self.clear
    install(Registry.new)
    subs
  end

  # Adds one substitution. A target already in the catalog keeps its place and
  # takes the new result.
  #
  # @param target [String] regex source; it is compiled as is, not escaped
  # @param result [String] the gsub replacement, so '\1' refers to a capture
  #   group of the target
  # @return [String] result
  # @raise [RegexpError] when target is not valid regex source
  # @example
  #   TextSubs.add('You feel fine', 'You feel FINE')
  def self.add(target, result)
    store(target, result)
  end

  # Rewrites one server line with every key that matches it.
  #
  # @param line [String] a server line, as the DownstreamHook receives it
  # @return [String] the same String, rewritten in place
  # @raise [FrozenError] when a key matches a frozen line
  # @example After TextSubs.add('fine', 'FINE')
  #   TextSubs.apply(+"You feel fine.\r\n") # => "You feel FINE.\r\n"
  def self.apply(line)
    Engine.apply(subs, line)
  end

  # The matching engine behind TextSubs.apply, kept apart from the catalog so
  # it can run on any ordered Hash of keys.
  class Engine
    # Selects every key that matches the ORIGINAL line, then runs gsub! for each
    # selected key, in insertion order, on the line as it changes. A key that
    # only matches after an earlier key rewrote the line does not fire, and a
    # selected key that no longer matches changes nothing.
    #
    # @param subs [Hash{Regexp=>String}] ordered keys and their replacements
    # @param line [String] the line to rewrite
    # @return [String] the same String, rewritten in place
    # @raise [FrozenError] when a key matches a frozen line
    # @example
    #   TextSubs::Engine.apply({ /cat/ => 'dog', /dog/ => 'bird' }, +'The cat.') # => "The dog."
    def self.apply(subs, line)
      matches = subs.select { |key, _| key =~ line }
      matches.each { |target, result| line.gsub!(target, result) }
      line
    end
  end

  # What a catalog section's `when:` gate is checked against: the guild and
  # the character settings at the time the catalog is built, so the catalog
  # itself never reads DRStats or get_settings.
  #
  # A gate is nil (always holds) or a Hash with one or more of these keys,
  # every one of which must hold:
  # - 'guilds' [Array<String>]: the guild is one of them;
  # - 'not_guilds' [Array<String>]: the guild is none of them;
  # - 'setting' [String]: that setting is set (neither nil nor false);
  # - 'setting_off' [String]: that setting is nil or false.
  #
  # @example
  #   context = TextSubs::Context.new(guild: 'Bard', settings: OpenStruct.new(herb_textsubs: true))
  #   context.allows?('guilds' => ['Bard'], 'setting' => 'herb_textsubs') # => true
  #   context.allows?('not_guilds' => ['Bard'])                          # => false
  class Context
    # @return [Array<String>] every guild DRStats can report, frozen
    def self.guilds
      ['Barbarian', 'Bard', 'Cleric', 'Commoner', 'Empath', 'Moon Mage', 'Necromancer', 'Paladin',
       'Ranger', 'Thief', 'Trader', 'Warrior Mage'].freeze
    end

    # @return [Array<String>] the keys a gate may hold, frozen
    def self.gate_keys
      %w[guilds not_guilds setting setting_off].freeze
    end

    # Checks that a gate has the shape the class comment describes, so a typo
    # in a key, a guild name or a setting name fails the load instead of
    # quietly turning a section off.
    #
    # @param gate [Hash, nil] a section's `when:` value
    # @return [nil]
    # @raise [ArgumentError] naming what is wrong with the gate
    def self.check_gate(gate)
      return if gate.nil?
      raise ArgumentError, "'when' must be a mapping, not #{gate.class}" unless gate.is_a?(Hash)
      raise ArgumentError, "'when' is empty; leave it out for a section every character gets" if gate.empty?

      unknown = gate.keys - gate_keys
      raise ArgumentError, "unknown 'when' key(s) #{unknown.map(&:inspect).join(', ')}; it takes #{gate_keys.join(', ')}" unless unknown.empty?

      gate.each { |key, value| key.start_with?('setting') ? check_setting(key, value) : check_guilds(key, value) }
      nil
    end

    # @param key [String] 'guilds' or 'not_guilds'
    # @param names [Object] the gate's value for key
    # @return [nil]
    # @raise [ArgumentError] unless names is a non-empty list of known guilds
    def self.check_guilds(key, names)
      raise ArgumentError, "'when' #{key} must be a non-empty list of guild names" unless names.is_a?(Array) && !names.empty? && names.all?(String)

      unknown = names - guilds
      raise ArgumentError, "'when' #{key} names unknown guild(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?
    end

    # @param key [String] 'setting' or 'setting_off'
    # @param name [Object] the gate's value for key
    # @return [nil]
    # @raise [ArgumentError] unless name is a non-empty String
    def self.check_setting(key, name)
      raise ArgumentError, "'when' #{key} must be a setting name" unless name.is_a?(String) && !name.empty?
    end
    private_class_method :check_guilds, :check_setting

    # @param guild [String, nil] what DRStats.guild reports
    # @param settings [#[]] the character settings (get_settings), read by name
    # @return [Context]
    def initialize(guild:, settings:)
      @guild = guild
      @settings = settings
    end

    # @return [String, nil] the guild the catalog is built for
    attr_reader :guild

    # @param gate [Hash, nil] a section's `when:` value
    # @return [Boolean] whether every condition of the gate holds
    # @raise [ArgumentError] when the gate is malformed (see check_gate)
    def allows?(gate)
      self.class.check_gate(gate)
      return true if gate.nil?

      gate.all? do |key, value|
        case key
        when 'guilds' then value.include?(guild)
        when 'not_guilds' then !value.include?(guild)
        when 'setting' then setting?(value)
        else !setting?(value)
        end
      end
    end

    private

    # @param name [String] a settings key
    # @return [Boolean] true unless the setting is nil or false
    def setting?(name)
      @settings[name] ? true : false
    end
  end

  # Turns the data of data/base-textsubs.yaml into the ordered list of subs a
  # character gets. It is pure: it reads only the data and a Context, never a
  # file, a setting or DRStats, and it changes neither.
  #
  # Schema 1 is the mapping under the file's top-level `textsubs:` key:
  #   schema: 1
  #   sections:
  #     - name: 'Necromancer butchery'   # unique
  #       when:                          # optional, see Context
  #         guilds: ['Necromancer']
  #       kind: 'pairs'                  # optional, 'pairs' by default
  #       subs:
  #         - ['regex source', 'gsub replacement']
  #
  # The other kind, 'guild_spells_link', is the one sub whose replacement
  # names the character's guild. Its fields are pattern, preresult, prelink,
  # poslink and posresult, and it expands to
  #   [pattern, preresult + TextSubs.wiki_link(prelink + guild page + poslink, guild) + posresult]
  #
  # Sections run in file order and subs in list order; both orders are kept,
  # because two subs that match the same line apply in that order. Every key
  # is checked, so an unknown key, kind or guild name fails the whole load.
  class Catalog
    # @return [Integer] the schema this script reads
    def self.schema
      1
    end

    # @return [Hash{String=>Array<String>}] each section kind and the fields
    #   it needs, all frozen
    def self.kinds
      { 'pairs'             => %w[subs].freeze,
        'guild_spells_link' => %w[pattern preresult prelink poslink posresult].freeze }.freeze
    end

    # @return [Array<String>] the keys every kind of section may hold, frozen
    def self.section_keys
      %w[name when kind].freeze
    end

    # The subs data gives a character, in order.
    #
    # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs');
    #   nil when the file is missing or did not parse
    # @param context [TextSubs::Context] the guild and settings to gate on
    # @return [Array<Array(String, String, Hash)>] [regex source, replacement,
    #   meta] for each sub, where meta is a frozen { section: name }
    # @raise [ArgumentError] naming the first problem found anywhere in data,
    #   including in sections context does not select
    # @example
    #   data = { 'schema' => 1, 'sections' => [{ 'name' => 'all', 'subs' => [['fine', 'FINE']] }] }
    #   TextSubs::Catalog.entries(data, context) # => [['fine', 'FINE', { section: 'all' }]]
    def self.entries(data, context)
      check(data).select { |section| context.allows?(section['when']) }
                 .flat_map { |section| expand(section, context) }
    end

    # @param data [Object] the `textsubs:` value
    # @return [Array<Hash>] its sections, every one checked
    # @raise [ArgumentError] naming the first problem found
    def self.check(data)
      raise ArgumentError, "no 'textsubs:' mapping (the file is missing or did not parse)" unless data.is_a?(Hash)

      unknown = data.keys - %w[schema sections]
      raise ArgumentError, "unknown top-level key(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?
      raise ArgumentError, "schema #{data['schema'].inspect}, but this textsubs.lic reads schema #{schema}" unless data['schema'] == schema

      sections = data['sections']
      raise ArgumentError, "'sections' must be a non-empty list" unless sections.is_a?(Array) && !sections.empty?

      sections.each_with_index { |section, index| check_section(section, index) }
      names = sections.map { |section| section['name'] }
      repeated = names.tally.select { |_, count| count > 1 }.keys
      raise ArgumentError, "section name(s) used more than once: #{repeated.map(&:inspect).join(', ')}" unless repeated.empty?

      sections
    end

    # @param section [Object] one element of 'sections'
    # @param index [Integer] its position, for the message
    # @return [nil]
    # @raise [ArgumentError] naming the section and what is wrong with it
    def self.check_section(section, index)
      raise ArgumentError, 'is not a mapping' unless section.is_a?(Hash)
      raise ArgumentError, "has no 'name'" unless section['name'].is_a?(String) && !section['name'].empty?

      kind = section.fetch('kind', 'pairs')
      fields = kinds[kind]
      raise ArgumentError, "has unknown kind #{kind.inspect}; kinds are #{kinds.keys.join(', ')}" unless fields

      unknown = section.keys - section_keys - fields
      raise ArgumentError, "has unknown key(s) #{unknown.map(&:inspect).join(', ')}" unless unknown.empty?

      missing = fields - section.keys
      raise ArgumentError, "has no #{missing.join(', ')}" unless missing.empty?

      Context.check_gate(section['when'])
      kind == 'pairs' ? check_pairs(section['subs']) : check_link(section)
      nil
    rescue ArgumentError => e
      label = section.is_a?(Hash) && section['name'].is_a?(String) ? " (#{section['name']})" : ''
      raise ArgumentError, "section #{index + 1}#{label} #{e.message}"
    end

    # @param subs [Object] a pairs section's 'subs'
    # @return [nil]
    # @raise [ArgumentError] unless subs is a non-empty list of
    #   [pattern, replacement] String pairs whose patterns compile
    def self.check_pairs(subs)
      raise ArgumentError, "'subs' must be a non-empty list" unless subs.is_a?(Array) && !subs.empty?

      subs.each_with_index do |pair, index|
        unless pair.is_a?(Array) && pair.size == 2 && pair.all?(String)
          raise ArgumentError, "sub #{index + 1} must be a ['pattern', 'replacement'] pair of quoted strings, not #{pair.inspect}"
        end

        check_pattern(pair.first)
      end
      nil
    end

    # @param section [Hash] a guild_spells_link section
    # @return [nil]
    # @raise [ArgumentError] unless every field is a String and the pattern compiles
    def self.check_link(section)
      kinds['guild_spells_link'].each do |field|
        raise ArgumentError, "'#{field}' must be a quoted string, not #{section[field].inspect}" unless section[field].is_a?(String)
      end
      check_pattern(section['pattern'])
    end

    # @param pattern [String] regex source
    # @return [nil]
    # @raise [ArgumentError] when it does not compile
    def self.check_pattern(pattern)
      Regexp.new(pattern)
      nil
    rescue RegexpError => e
      raise ArgumentError, "pattern #{pattern.inspect} does not compile: #{e.message}"
    end

    # @param section [Hash] a checked section
    # @param context [TextSubs::Context]
    # @return [Array<Array(String, String, Hash)>] its subs
    def self.expand(section, context)
      meta = { section: section['name'] }.freeze
      return section['subs'].map { |pattern, replacement| [pattern, replacement, meta] } unless section['kind'] == 'guild_spells_link'

      guild = context.guild.to_s
      link = TextSubs.wiki_link(section['prelink'] + guild.tr(' ', '_') + section['poslink'], guild)
      [[section['pattern'], section['preresult'] + link + section['posresult'], meta]]
    end
    private_class_method :check, :check_section, :check_pairs, :check_link, :check_pattern, :expand
  end

  # Whether any front end receives game output right now. It mirrors lich-5's
  # Game#client_write_targets: a non-empty detachable client registry, else the
  # legacy single detachable client, else the primary client ($_CLIENT_, nil
  # under --without-frontend). Lich runs the downstream hooks before it picks
  # those targets, so with none of them no client receives a rewritten line;
  # only the hooks after this one would see it.
  #
  # The defaults read the Lich globals on every call: a detachable client can
  # attach or leave at any time, so the hook asks once per line.
  #
  # @param registry [#empty?, nil] the detachable client registry
  #   (Lich::Common::DetachableClientRegistry)
  # @param detachable [Object, nil] the legacy primary detachable client
  # @param client [Object, nil] the primary front end client
  # @return [Boolean] true when at least one front end is attached
  # @example On a character started with --without-frontend and no detachable client
  #   TextSubs.client_attached? # => false
  def self.client_attached?(registry: $_DETACHABLE_CLIENT_REGISTRY_, detachable: $_DETACHABLE_CLIENT_, client: $_CLIENT_)
    return true if registry && !registry.empty?
    return true if detachable

    client ? true : false
  end

  # Links text to the Elanthipedia page of the same name, with underscores
  # between the words (MikeLC 2/15/2025; thanks to Tysong for the "how to
  # hyperlink" help).
  #
  # The key is three capture groups, (pretext)(text)(postext), so the context
  # around the text can be matched and put back. pretext, text and postext
  # build the key: they are regex source, compiled unescaped. preresult,
  # posresult, prelink, poslink and text are gsub replacement text, so \0 to
  # \9, \&, \`, \', \+ and \\ in them are substitutions; any other
  # backslash stays as written. \k<name> is one too, but the key's three
  # groups have no name, so it raises IndexError on the hook thread unless
  # pretext or postext names that group; a named group also stops the three
  # plain groups from capturing, so \1 to \3 then count named groups only.
  # text is the one argument that is both, so a regex escape in it (such as
  # \s) matches in the key but shows verbatim in the link and the page name,
  # while a substitution in it (such as \&) is replaced in both.
  #
  # @param text [String] the text to link; also the page name, spaces turned
  #   into underscores
  # @param pretext [String] context before the text, capture group 1
  # @param postext [String] context after the text, capture group 3
  # @param prelink [String] prefix of the page path, for a page outside the
  #   root namespace (such as 'Category:')
  # @param poslink [String] suffix of the page path, for a page whose name goes
  #   on past the text (such as '_spellbook')
  # @param preresult [String] replacement before the link; the default '\1'
  #   puts back what pretext matched
  # @param posresult [String] replacement after the link; the default '\3'
  #   puts back what postext matched (group 2 is the text itself)
  # @return [String] the replacement it stored
  # @example Link a spellbook heading to its category page
  #   TextSubs.elanthipedia('Fae Arts', '^', ':', 'Category:', '_spellbook')
  #   # "Fae Arts:" becomes
  #   # <a href="https://elanthipedia.play.net/Category:Fae_Arts_spellbook">Fae Arts</a>:
  def self.elanthipedia(text, pretext = '', postext = '', prelink = '', poslink = '', preresult = '\1', posresult = '\3')
    target = "(#{pretext})" + "(#{text})" + "(#{postext})"
    hyperlink = prelink + text.gsub(" ", "_") + poslink
    result = preresult + wiki_link(hyperlink, text) + posresult
    store(target, result)
  end

  # The anchor tag that links text to an Elanthipedia page, shared by
  # elanthipedia and the catalog's guild spell list link.
  #
  # @param page [String] the page path after the site root, used as is
  # @param text [String] what the link shows
  # @return [String] the <a href="...">text</a> markup
  # @example
  #   TextSubs.wiki_link('Category:Bard_spells', 'Bard')
  #   # => "<a href=\"https://elanthipedia.play.net/Category:Bard_spells\">Bard</a>"
  def self.wiki_link(page, text)
    "<a href=\"https://elanthipedia.play.net/#{page}\">#{text}</a>"
  end

  # Where get_data('textsubs') reads a user's own copy of the catalog: a file
  # in data/custom replaces the shipped data/base-textsubs.yaml wholesale.
  #
  # @param script_dir [String] Lich's SCRIPT_DIR
  # @return [String, nil] the path of data/custom/base-textsubs.yaml when that
  #   file exists, else nil
  def self.catalog_override(script_dir)
    path = File.join(script_dir, 'data', 'custom', 'base-textsubs.yaml')
    File.file?(path) ? path : nil
  end

  # Adds the built-in subs the catalog data gives the character, in order,
  # through add. Data that cannot be used adds nothing at all, never part of a
  # catalog, and the caller shows the message this returns: the script then
  # runs with the private_textsubs and shit-list subs alone.
  #
  # @param data [Hash, nil] the `textsubs:` value of get_data('textsubs')
  # @param context [TextSubs::Context] the guild and settings to gate on
  # @param file [String] the file the data came from, named in the message
  # @return [String, nil] nil once every sub is added, else the one message
  #   that says why none was
  # @example A file left over from an older dr-scripts
  #   TextSubs.add_catalog({ 'schema' => 0 }, context, file: 'data/base-textsubs.yaml')
  #   # => "No built-in subs: data/base-textsubs.yaml cannot be used (schema 0, ...). ..."
  def self.add_catalog(data, context, file:)
    entries = Catalog.entries(data, context)
  rescue ArgumentError => e
    "No built-in subs: #{file} cannot be used (#{e.message}). This textsubs.lic needs a 'textsubs:' mapping " \
      "with schema: #{Catalog.schema}; update dr-scripts, or fix or remove a copy in data/custom. " \
      'Only private_textsubs and shit-list subs are active.'
  else
    entries.each { |source, replacement, _meta| add(source, replacement) }
    nil
  end

  # The one writer of the catalog, shared by add and elanthipedia: it writes
  # write_target, under the lock, so no stage, unstage or install of another
  # thread lands between choosing the Registry and counting the key. A key
  # written to the installed catalog counts one generation, after it is
  # written, so the generation never runs ahead of the catalog; a key written
  # to a staged Registry or this thread's own build is not in subs yet and
  # counts none, as install counts that whole catalog once, when it swaps it
  # in.
  #
  # @param target [String] regex source, compiled unescaped
  # @param result [String] the gsub replacement
  # @return [String] result
  # @raise [RegexpError] when target is not valid regex source; the catalog
  #   and the generation are left as they were
  def self.store(target, result)
    key = /#{target}/
    @@lock.synchronize do
      registry = write_target
      registry.add(key, result)
      @@generation += 1 if registry.equal?(@@registry)
    end
    result
  end

  # The Registry an add writes: this thread's own build while it has one
  # (see stage), else the staged Registry while there is one, else the
  # installed one.
  #
  # @return [TextSubs::Registry]
  def self.write_target
    own_build || @@staged || @@registry
  end
  private_class_method :store, :write_target
end

settings = get_settings

# Every start builds its catalog from nothing: a restart with other settings
# keeps none of the keys the run before it added. The catalog is built in a
# staged Registry and installed whole once it is complete. Lich has already
# re-run the class body, which installed an empty catalog, so a hook of the
# run before that is still registered passes every line through untouched
# until then, never applying a part of the new catalog. The 'textsub' hook is
# registered after that, at the end of the script, so with no older hook a
# line that arrives while the catalog is built passes through untouched too.
# A build that raises ends the staging when the script dies, so the adds of
# other scripts reach the installed catalog again; the partial catalog is
# never installed. Once the catalog is installed, unstage changes nothing.
# A start that overlaps this one (';force textsubs' while it builds) has a
# Registry of its own: the adds of each run go only into its own (see
# TextSubs.stage), and install refuses this run's once the newer start has
# staged, so this run then ends before it registers a hook.
new_catalog = TextSubs.stage(TextSubs::Registry.new)
before_dying { TextSubs.unstage(new_catalog) }

# Put shit list players in textsubs
if settings.integrate_shit_list_with_textsubs && File.file?("#{checkname}_shit.list")
  File.open("#{checkname}_shit.list", 'r') do |file|
    file.each do |line|
      name = line.split(',').first.capitalize
      TextSubs.add(name.to_s, "#{name} (SL)")
    end
  end
end

unless settings.private_textsubs.empty?
  settings.private_textsubs.each do |k, v|
    TextSubs.add(k, v)
  end
end
### SPELLBOOK PROJECT - MikeLC 2/15/2025 ###
#
# Creates elanthipedia weblinks for the spells and spellbooks
# as long as it is in column-formatted mode.
#
# Also links the spells in your Active Spells Windows, creating
# links for spells on your person (since they are not always in
# your spellbook).
#
# In your YAML, set... 'textsubs_spell_links: true'
#
# *NOTE* If spellmonitor.lic is called before textsubs.lic, no issues.
#
#        If spellmonitor.lic is called after textsubs.lic, will break
#        buff-watcher.lic, causing it to not register active spells on
#        your person.
#
#		In-Game Fix: Kill and restart 'textsubs.lic'.
#		    ;k textsubs
#           ;textsubs
#
#        Autostart Fix: Ensure textsubs is the last script on the list.
#			;e stop_autostart('textsubs')
#			;e autostart('textsubs')
#

# The built-in subs live in data/base-textsubs.yaml (or a copy in
# data/custom, which get_data reads instead). When that data cannot be used,
# none of it is added and the script says so once.
catalog_override = TextSubs.catalog_override(SCRIPT_DIR)
if catalog_override
  echo "Reading the built-in subs from #{catalog_override}, which replaces data/base-textsubs.yaml " \
       "(it must be a 'textsubs:' mapping with schema: #{TextSubs::Catalog.schema})."
end
catalog_problem = TextSubs.add_catalog(get_data('textsubs').textsubs, TextSubs::Context.new(guild: DRStats.guild, settings: settings),
                                       file: catalog_override || File.join(SCRIPT_DIR, 'data', 'base-textsubs.yaml'))
echo catalog_problem if catalog_problem

# nil when a newer start superseded this one: it installs its catalog and
# registers its hook, so this run ends here (see TextSubs.install).
exit unless TextSubs.install(new_catalog)

action = proc do |client_string|
  # Headless: nobody would see the rewrite, so skip every key.
  next client_string unless TextSubs.client_attached?

  TextSubs.apply(client_string)
end

# persist: false hands the cleanup to Lich, which removes the hook when this
# script ends, and only if this script still owns it: a newer textsubs that
# re-registered 'textsub' keeps its hook when an older one dies.
DownstreamHook.add('textsub', action, persist: false)

clear until script.gets.nil?
