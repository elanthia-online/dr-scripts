=begin
  Watches arena NPCs for telegraphed attacks and responds with the matching
  evasive maneuver (pedal, bob, duck, jump, lean, cower). Pauses combat-trainer
  while a watch is in progress and unpauses it once the maneuver is set.
=end

# WATCH reply naming the dodge, e.g. "..., you could try to duck down!". The
# bput returns just the dodge verb. Only matches the game's own line (no quote
# before the advice, which other players' speech and ESP always have), and
# only whole words. Covers the "back pedal" and "prepare to jump" wordings.
ARENA_WATCH_DODGE = /^[^"]*?you could try to (?:back |prepare to )?\K(?:pedal|bob|duck|jump|lean|cower)\b/

# WATCH replies that end the watch without a dodge; each returns just the
# message text and only matches the game's own line.
ARENA_WATCH_DONE = [/^[^"]*?\KWatch out for whom/, /^[^"]*?\Kmay not be the best use of your time/, /^[^"]*?\KYou've already spotted the .* intentions/].freeze

# Any other game line ends the WATCH bput at once, as before, but not another
# player's speech or ESP line, so the real reply is not passed over.
ARENA_WATCH_OTHER = /^(?!\[[^\]]+\]\[[^\]]+\] |[A-Z][\w'-]* (?:says|asks|exclaims|whispers|yells)\b)./

# The opponent to WATCH: the first live room creature whose noun is not an
# ignored arena NPC, addressed by id ("#123"). A creature with no noun yet is
# skipped, since it could be an ignored NPC. Falls back to the first
# non-ignored noun from DRRoom.npcs when no such creature is known.
# Nil when only ignored NPCs are present.
def arena_target(ignore_npcs)
  ignored = ignore_npcs.map(&:downcase)
  opponent = Lich::DragonRealms::Creature.in_room(:not_dead).find do |creature|
    creature.id && creature.noun && !ignored.include?(creature.noun.downcase)
  end
  return "##{opponent.id}" if opponent

  DRRoom.npcs.find { |npc| !ignored.include?(npc.downcase) }
end

def mainloop
  ignore_npcs = %w[Usdiwi Servant Traumatologist Usdiwi]
  npcs = DRRoom.npcs - ignore_npcs
  arena_watch_timer = nil

  loop do
    watch_complete = false
    if npcs != DRRoom.npcs - ignore_npcs

      while !DRRoom.npcs.empty? && watch_complete == false
        pause_script('combat-trainer')
        if arena_watch_timer.nil?
          arena_watch_timer = Time.new
        elsif (elapsed_time = Time.new - arena_watch_timer)
          DRC.message("Elapsed Time: #{elapsed_time}")
        end

        target = arena_target(ignore_npcs)
        if target.nil?
          unpause_script('combat-trainer')
          break
        end

        waitrt?
        case DRC.bput("watch #{target}", ARENA_WATCH_DODGE, *ARENA_WATCH_DONE, ARENA_WATCH_OTHER)
        when 'pedal'
          DRC.bput('pedal', 'You set yourself up to back pedal')
          watch_complete = true
        when 'bob'
          DRC.bput('bob', 'You set yourself up to bob')
          watch_complete = true
        when 'duck'
          DRC.bput('duck', 'You set yourself up to duck')
          watch_complete = true
        when 'jump'
          DRC.bput('jump', 'You set yourself up to jump')
          watch_complete = true
        when 'lean'
          DRC.bput('lean', 'You set yourself up to lean')
          watch_complete = true
        when 'cower'
          DRC.bput('cower', 'You set yourself up to cower')
          watch_complete = true
        when *ARENA_WATCH_DONE
          watch_complete = true
        end

        unpause_script('combat-trainer') if watch_complete
      end

    end
    npcs = DRRoom.npcs - ignore_npcs
    pause 0.1
  end
end

mainloop
