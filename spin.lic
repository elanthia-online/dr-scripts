=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#spin
=end

class Spin
  # Wheel problems the game reports while spinning, and the command that
  # fixes each one. Every problem line arrives before the step's Roundtime
  # line, so the first pattern DRC.bput matches is the problem, if any.
  WHEEL_FIXES = {
    /shade/i                                                  => 'clean wheel',
    /twist\b|Individual strands of the fiber begin twisting/i => 'turn wheel',
    /bunch|slide/i                                            => 'push wheel'
  }.freeze

  # A step that went through: the game's Roundtime line ends every spin and
  # every fix.
  STEP_DONE = /Roundtime/i.freeze

  # Unanswered or unrecognised replies in a row before spin gives up.
  MAX_UNMATCHED = 3

  # Commands sent to the wheel before spin gives up on finishing the spool.
  # The first heavy silk spool in Mahtra's log took 10 spins and 5 fixes.
  MAX_STEPS = 100

  def initialize
    arg_definitions = [
      [
        { name: 'material', options: %w[silk cotton linen wool burlap], description: 'fiber to spin' },
        { name: 'weight', options: %w[fine thin average thick heavy yarn], optional: true, description: 'Thickness, defaults to heavy' }
      ]
    ]
    args = parse_args(arg_definitions)

    # cost: the price of one bundle, in kronars (the shop asks the same price
    # in its own currency: 135 Dokoras for silk in Shard, 1104:30056).
    mat_data = {
      'silk'   => { name: 'silk', index: 1, cost: 187, count: 14 },
      'cotton' => { name: 'cotton', index: 2, cost: 185, count: 8 },
      'linen'  => { name: 'linen', index: 3, cost: 167, count: 8 },
      'wool'   => { name: 'wool', index: 4, cost: 133, count: 8 },
      'burlap' => { name: 'burlap', index: 5, cost: 201, count: 4 }
    }

    data = mat_data[args.material]
    stop("Unknown fiber '#{args.material}'. Choose one of: #{mat_data.keys.join(', ')}.") unless data
    @settings = get_settings
    @hometown = DRCC.crafting_hometown(@settings)
    @bag = @settings.crafting_container
    @bag_items = @settings.crafting_items_in_container
    @belt = @settings.outfitting_belt
    stock_room = get_data('crafting')['tailoring'].dig(@hometown, 'stock-room')
    stop("No outfitting society stock room is known for #{@hometown || 'your crafting town'}.") unless stock_room
    stop('Could not empty your hands before buying fiber.') unless DRCI.stow_hands
    # The scissors come out before any money is spent, so missing scissors
    # stop the run before it buys fiber it cannot cut.
    @scissors = data[:name] == 'silk'
    stop('Could not get your scissors for the silk cut.') if @scissors && !DRCC.get_crafting_item('scissors', @bag, @bag_items, @belt, true)
    # The shop prices each bundle in its own currency, rounded up (187
    # kronars is 135 Dokoras, 1104:30056), so the bundle price is converted
    # before it is multiplied.
    currency = DRCM.town_currency(@hometown)
    copper = DRCM.convert_currency(data[:cost], 'kronars', currency, 0) * data[:count]
    stop_with_scissors("Could not get #{copper} copper #{currency} for the fiber.") unless DRCM.ensure_copper_on_hand(copper, @settings, @hometown)

    data[:count].times do |index|
      stop_with_scissors("The shop did not sell bundle #{index + 1} of #{data[:count]}; any bought so far are in your hands.") unless DRCT.order_item(stock_room, data[:index]) =~ /takes some coins/i
      if index == 0 && data[:name] == 'silk'
        stop_with_scissors('Could not mark the fiber for cutting; it is in your hands.') unless DRC.bput('mark my fibers at 10', /mark it for cutting/i, /^What were you/i) =~ /mark it for cutting/i
        stop_with_scissors('Could not cut the fiber; it is in your hands.') unless DRC.bput('cut my fibers with my scissors', /You carefully cut off/i, /^What were you/i) =~ /You carefully cut off/i
        @bag = "other #{@bag}" unless DRCC.stow_crafting_item('scissors', @bag, @belt)
        @scissors = false
      elsif index > 0
        stop('Could not combine the fiber bundles; they are in your hands.') unless DRC.bput('combine my fiber', /You combine/i, /^What were you/i) =~ /You combine/i
      end
    end

    stop("Could not reach a spinning wheel in #{@hometown}.") unless DRCC.find_wheel(@hometown)

    @product = args.weight == 'yarn' ? 'yarn' : 'thread'
    stop('Could not put the fiber on the wheel.') unless DRC.bput('put fiber on wheel', /You carefully wrap/i, /^What were you/i) =~ /You carefully wrap/i
    stop("Could not set the wheel to #{args.weight || 'heavy'}.") unless DRC.bput("adjust wheel to #{args.weight || 'heavy'}", /You adjust the wheel/i, /^What were you/i) =~ /You adjust the wheel/i

    spin_until_done

    fput("stow my #{spool_in_hand}")
  end

  private

  # Spins the wheel, fixing each problem the game reports, until the spool is
  # in hand.
  #
  # @return [void]
  # @raise [SystemExit] after {MAX_UNMATCHED} unrecognised replies in a row,
  #   or {MAX_STEPS} commands without a spool
  def spin_until_done
    command = 'spin wheel'
    unmatched = 0
    MAX_STEPS.times do
      waitrt?
      reply = DRC.bput(command, *WHEEL_FIXES.keys, STEP_DONE)
      waitrt?
      return if spool_in_hand

      fix = WHEEL_FIXES.find { |problem, _| problem.match?(reply) }&.last
      if fix || STEP_DONE.match?(reply)
        unmatched = 0
        command = fix || 'spin wheel'
      else
        unmatched += 1
        stop("The wheel did not answer '#{command}' #{MAX_UNMATCHED} times in a row.") if unmatched >= MAX_UNMATCHED
      end
    end
    stop("No spool after #{MAX_STEPS} commands to the wheel.")
  end

  # The finished spool, as a hand shows it ('silk thread', 'wool yarn').
  # Something else in a hand, such as a book a background script picked up,
  # is not a spool.
  #
  # @return [String, nil] the spool's name, or nil when neither hand holds one
  def spool_in_hand
    [DRC.left_hand, DRC.right_hand].compact.find { |held| held.split.last == @product }
  end

  # Puts the scissors back when they are still out, then stops.
  #
  # @param message [String] what went wrong
  # @return [void]
  # @raise [SystemExit] always
  def stop_with_scissors(message)
    DRCC.stow_crafting_item('scissors', @bag, @belt) if @scissors
    stop(message)
  end

  # Tells the player why spin stopped, then stops.
  #
  # @param message [String] what went wrong
  # @return [void]
  # @raise [SystemExit] always
  def stop(message)
    Lich::Messaging.msg('bold', "spin: #{message}")
    exit
  end
end

Spin.new
