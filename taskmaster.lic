=begin
  YAML SETTINGS(all optional but the first)
  task_loot_bag: bagname
  task_no_repair: true/false # skip repairing tools entirely
  task_self_repair: true/false # use own brush and oil for repairs
  task_get_tools_on_completion: true/false # If you want taskmaster to pickup any remaining tools in the repair shop. Useful if you're using clerk-tools after each task
  task_use_boost: true/false # use boost to eliminate task cooldowns, useful if you have a few and you're doing a lot of tasks
  task_cooldown_poll: 15 # seconds between asks while the taskmaster makes you wait (minimum 3)
  task_boosts: [task, haste] # boosts to use. task: BOOST TASK when a task is on cooldown (same as task_use_boost). haste: keep BOOST HASTE (1 hour, roundtimes -1 second) running between tasks
  task_keep_list: list of items to keep. See default in base.yaml
  task_junk_list: list of items to throw away; everything else is kept. When set (non-empty) it replaces task_keep_list, so a prize nobody has listed yet is kept rather than binned
  task_slack_keepers: true/false # send a Slack message (slack_username) for each keeper
  task_unpack_keepers: true/false # put a keeper's item (not its sack) in task_loot_bag and bin the empty sack
  task_bin_leftover_stock: true/false # after each Zasele task is handed in, bin her leftover stock and offcuts from the crafting bag into worn_trashcan (needs worn_trashcan; not in marathon, which carries its stock between tasks)
  task_crafting_room: <room number> # Room to craft in. Ensure it meets specifications for tooling required...
  task_before_scripts: ['restock'] # scripts (with any arguments) to run before asking for each task, while the previous task's cooldown runs
  task_copper_floor: 20000 # before each task, if you carry less copper (Kronars) than this, exchange foreign coins and withdraw up to task_copper_target
  task_copper_target: 110000
  task_hometown: Crossing # town other scripts (sew, restock) treat as your hometown while a task runs; unset leaves hometown alone
  task_rock_room: 793 # room where Dorhum's spongestone and splashstone tasks forage rocks (none can be had on Andreshlew)
  task_shell_room: 793 # room where Dorhum's glow shell tasks forage shells
  task_cancel_foreign_tasks: true/false # a run never works another taskmaster's task; with this it cancels one it finds open, waits out the 10-minute cooldown a cancel brings, then goes back to its own taskmaster. Off: it stops, saying whose task it is and how to finish or cancel it
  enchanting_room: <room number> # Dorhum's tasks enchant in task_crafting_room, else here; with neither, where they stand if you carry a brazier, else at a Crossing brazier room. Outside tasks, enchanting uses enchanting_room as before
  ## Dorhum's tasks need task_loot_bag set to a container other than crafting_container: his finished items keep the base item's noun (a spongestone is still a rock) and wait there apart from the unworked ones. A task stops before buying anything if task_loot_bag already holds that noun, since the hand-in would give those first ##
  ## For Dorhum's tasks make task_crafting_room a room of your own (a private forge): each finished item is picked up off the floor by its noun, so another rock or shell lying there could be taken instead. A rented room's notice is read before enchanting and the rental renewed when under ten minutes are left ##
  crafting_items_in_container: ['oil', 'glue'] # list of items you might have duplicates of in other bags, but which you only want drawn from crafting bag
  crafting_container: bagname
   ## Important: set default stow to the same bag as your crafting bag (tools are still stowed that way when task_no_repair is set, and so is anything else in hand when the task instructions are read) ##
=end

class TaskMaster
  # Printed (bold) each time taskmaster starts, so a log shows which copy ran.
  VERSION = '2026.11.04.2'

  # Stock base => [stock name, room to order it in]. restock tops up cloth,
  # leather, yarn and thread for marathon runs; thread is the cotton spool
  # (stock-name cotton in base-crafting.yaml).
  STACKMAP = {
    'leather' => ['rat', 16667], 'cloth' => ['burlap', 16667], 'stack' => ['deer', 8864], 'ingot' => ['bronze', 8775],
    'stone' => ['alabaster', 8864], 'yarn' => ['wool', 16667], 'lumber' => ['balsa', 8864], 'thread' => ['cotton', 16667]
  }.freeze

  # Search rooms for the taskmasters, in the order find_npc walks them.
  ROOMS = [16_145, 16_146, 16_148, 16_150, 16_153, 16_154, 16_147, 16_276, 16_277, 16_278, 16_290, 16_291, 16_292, 16_293, 16_295, 16_296, 16_294, 16_159, 16_161, 16_166, 16_169].freeze

  # Tools each taskmaster's tasks need, for ;taskmaster <npc> tools.
  TOOLS = {
    'poltu'   => ['forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'bradyn'  => ['bone saw', 'chisels', 'wood shaper', 'rasp', 'carving knife', 'drawknife', 'forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'zasele'  => ['knitting needles', 'sewing needles', 'awl', 'slickstone', 'yardstick', 'scissors'],
    'dorhum'  => ['brazier', 'burin', 'augmenting loop', 'mana fount', 'imbuement rod (or the Imbue spell)'],
    'shaping' => ['wood shaper', 'rasp', 'carving knife', 'drawknife']
  }.freeze

  # Arguments for parse_args: the npc and finish/find/tools/repeat, or one
  # of the other modes.
  ARG_DEFINITIONS = [
    [
      { name: 'npc', options: %w[poltu bradyn zasele dorhum], variable: true, description: "Task npc's name, in full" },
      { name: 'finish', regex: /^finish/, optional: true, description: 'Finishes a task you\'re already on' },
      { name: 'find', regex: /^find/i, optional: true, description: 'Seeks out the taskmaster, then exits' },
      { name: 'tools', regex: /^tools/i, optional: true, description: 'Spits out a list of the tools you need for a given npc\'s tasks' },
      { name: 'repeat', regex: /^repeat/i, optional: true, description: 'Repeat tasks for a given taskmaster' }
    ],
    [
      { name: 'reset_output', regex: /^reset_output/i, optional: true, description: 'Clears prize window' },
      { name: 'pickup', regex: /^pickup/i, optional: true, description: 'Picks up any tools left at Rangu for repair' },
      { name: 'cycle', regex: /^cycle/i, optional: true, description: 'Cycles through each taskmaster randomly and completes their task' },
      { name: 'marathon', regex: /^marathon/i, optional: true, description: 'stocks up and runs zasele tasks, repairs during restock' },
      { name: 'loot_history', regex: /^loot_history/i, optional: true, description: 'Prints out saved sack contents history, potentially scrollish' },
      { name: 'script_summary', optional: true, description: 'Completes Hollows Eve tasks for the crafting taskmasters on the island' }
    ]
  ].freeze

  # Reads the settings and sets up state. Does not parse arguments or send
  # anything to the game -- call {#run} to start.
  #
  # @note Adds the "wrap-up" flag (the taskmaster's "Finish your tasks."
  #   call) and seeds UserVars.taskmaster_sacks, which persists across runs.
  # @return [void]
  def initialize
    @settings = get_settings
    @rooms = ROOMS
    configure_loot_filter
    @bag = @settings.crafting_container
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb
    @bin_leftover_stock = @settings.task_bin_leftover_stock
    @bag_items = @settings.crafting_items_in_container
    @lootbag = @settings.task_loot_bag || 'backpack'
    @gem = @settings.gem_pouch_adjective
    @cube = @settings.cube_armor_piece
    @no_repair = @settings.task_no_repair
    @anvil_town = @settings.crafting_hometown || "Crossing"
    @self_repair = @settings.task_self_repair
    @pickup_tools = @settings.task_get_tools_on_completion
    configure_boosts
    @crafting_room = @settings.task_crafting_room
    @cooldown_poll = cooldown_poll_seconds
    configure_copper
    @before_scripts = Array(@settings.task_before_scripts)
    @task_hometown = @settings.task_hometown
    @rock_room = @settings.task_rock_room || DEFAULT_ROCK_ROOM
    @shell_room = @settings.task_shell_room || DEFAULT_SHELL_ROOM
    @cancel_foreign_tasks = @settings.task_cancel_foreign_tasks

    @stockdata = get_data('crafting')['stock']
    @stackmap = STACKMAP
    Flags.add("wrap-up", /^You say, "Finish your tasks."/)
    UserVars.taskmaster_sacks ||= { 'zasele' => [], 'bradyn' => [], 'poltu' => [], 'dorhum' => [] }
  end

  # Makes task_hometown the hometown every script in this session sees
  # (sew, restock, ...) while taskmaster runs, through dependency's
  # shift_hometown, which lich-5 applies to hometown in get_settings. The
  # town is resolved to its canonical name with DRC.get_town_name, so
  # 'cross' or 'crossing' become 'Crossing'; lich-5's hometown lookups are
  # case-sensitive on the canonical names. A name that matches no town is
  # reported and hometown is left alone. The previous override, if another
  # script set one, is kept so that restore_hometown can put it back when
  # taskmaster stops. Does nothing when task_hometown is unset.
  #
  # @return [void]
  # @note $HOMETOWN is global to the Lich session, so background scripts
  #   that read settings while a task runs see the same town.
  def shift_to_task_hometown
    name = @task_hometown.to_s.strip
    return if name.empty?

    town = DRC.get_town_name(name)
    unless town
      DRC.message("task_hometown '#{name}' does not match any town; leaving your hometown alone. Use a town name such as Crossing.")
      return
    end

    TaskMaster.saved_hometown = { value: $HOMETOWN, town: town }
    shift_hometown(town)
  end

  class << self
    # The hometown override in place before shift_to_task_hometown (:value),
    # and the town taskmaster set (:town), wrapped in a Hash so a nil
    # override can be told apart from "nothing saved".
    #
    # @return [Hash{Symbol => String, nil}, nil]
    attr_accessor :saved_hometown

    # Puts back the hometown override taskmaster replaced, from before_dying,
    # which also runs on exit and when the script is killed. If something
    # else changed the override while taskmaster ran, that change is left in
    # place rather than overwritten.
    #
    # @return [void]
    def restore_hometown
      return unless saved_hometown

      if $HOMETOWN == saved_hometown[:town]
        previous = saved_hometown[:value]
        previous ? shift_hometown(previous) : clear_hometown
      end
      self.saved_hometown = nil
    end
  end

  # Runs the mode the arguments ask for. The one-shot modes exit; cycle and
  # the plain modes go on to the task loop.
  #
  # @param args [OpenStruct] parsed arguments (npc, finish, find, tools,
  #   repeat, reset_output, pickup, cycle, marathon, loot_history)
  # @return [void]
  # @raise [SystemExit] after the one-shot modes, marathon, and finish (which
  #   goes on to run_tasks instead when it cancelled another taskmaster's
  #   task), or from run_tasks
  def run(args = parse_args(ARG_DEFINITIONS))
    DRC.message("taskmaster version #{VERSION}")
    shift_to_task_hometown
    @npc = args.npc
    @marathon = args.marathon
    if args.find
      find_npc(@rooms, @npc)
      exit
    elsif args.tools
      list_tools
    elsif args.finish
      finish_task_in_progress
    elsif args.reset_output
      _respond("<clearStream id='Task Master'/>")
      exit
    elsif args.cycle
      @npc = ['poltu', 'bradyn', 'zasele'].sample
    elsif args.loot_history
      print_loot_history
    elsif args.pickup
      tool_pickup if DRCI.exists?("rangu ticket")
      exit
    elsif @marathon
      run_marathon
    end

    run_tasks(args)
  end

  # Lists the tools the named taskmaster's tasks need, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def list_tools
    DRC.message("Tools required:")
    TOOLS[@npc.downcase].each do |tool|
      DRC.message("#{tool}")
    end
    exit
  end

  # Prints the saved sack history for each taskmaster, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def print_loot_history
    ['poltu', 'bradyn', 'zasele', 'dorhum'].each do |npc|
      DRC.message("Sack history for Taskmaster #{npc.capitalize}:")
      Array(UserVars.taskmaster_sacks[npc]).each do |sack|
        DRC.message(sack)
      end
    end
    exit
  end

  # resume_task exits once the task is handed in. When the task was another
  # taskmaster's and had to be cancelled, this returns and the run carries
  # on asking its own taskmaster for a task.
  #
  # @return [void]
  # @raise [SystemExit] from resume_task
  def finish_task_in_progress
    reconcile_hands
    catch(FOREIGN_TASK_CANCELLED) { resume_task }
  end

  # Copper, haste and the before scripts, run ahead of asking for each task.
  #
  # @return [void]
  def prepare_for_task
    top_up_copper
    refresh_haste
    run_before_scripts
  end

  # One task, or with repeat or cycle one after another until the wrap-up
  # call. cycle picks a new taskmaster after each task.
  #
  # @param args [OpenStruct] parsed arguments; reads cycle and repeat
  # @return [void]
  # @raise [SystemExit] from get_task (a task already in progress is finished
  #   by resume_task) or complete_task (nothing left to hand in, or the
  #   taskmaster can't be found)
  def run_tasks(args)
    reconcile_hands
    loop do
      @dispose, @remainder = [false, false]
      prepare_for_task
      item, count, volume_per_item, base, type = get_task
      tool_pickup if !@self_repair && DRCI.exists?("rangu ticket") # picks up any tools that you dropped off previous and stows them appropriately
      send(@npc.to_sym, item, count, volume_per_item, base, type)
      complete_task(item, count)
      break if Flags['wrap-up']

      if args.cycle
        @npc = ['poltu', 'bradyn', 'zasele'].sample
        next
      end
      break unless args.repeat
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket") # if indicated, and you have tickets, picks up any tools you may have dropped off previously, all disciplines
  end

  # Zasele tasks until the wrap-up call, restocking (and repairing) only when
  # the stock runs short, then exits.
  #
  # @return [void]
  # @raise [SystemExit] after the wrap-up call
  def run_marathon
    @npc = 'zasele'
    reconcile_hands
    restock
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    loop do
      prepare_for_task
      item, count, volume_per_item, base, type = get_task
      unless check_stock(count * volume_per_item, type, base)
        repair(@settings.outfitting_tools, @settings.outfitting_belt) unless @no_repair
        restock
        tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
        find_npc(@rooms, @npc)
      end
      tailor_item(item, count, base, type)
      complete_task(item, count)
      break if Flags['wrap-up']
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket")
    exit
  end

  # Cleans up what a crash or disconnect left in hand before starting: a
  # reward sack is sorted, and an unfinished tailoring item made from the
  # stock taskmaster buys for Zasele is finished where the character stands
  # (sewing works in any room) with sew's resume mode, then put in the
  # crafting bag for the turn-in. Any other unfinished item is the player's
  # and is left alone. Knitting is not resumed: the work sits on the needles
  # and does not show in the hand.
  #
  # @return [void]
  def reconcile_hands
    waitrt?
    DRC.fix_standing
    sort_sack(nil) if held_items.any? { |held| held =~ /\bwoven sack\b/ }
    return unless @npc == 'zasele'

    unfinished = held_items.grep(/\bunfinished\b/)
    piece = unfinished.find { |held| task_piece?(held) }
    (unfinished - [piece]).each do |held|
      DRC.message("Leaving your #{held} alone: taskmaster only finishes the burlap, rat-pelt and wool pieces from its own tasks.")
    end
    return unless piece

    noun = piece.split.last
    DRC.wait_for_script_to_complete('sew', ['resume', noun])
    # Judge the result by the hand text: DRCI.in_hands?(noun) also matches
    # the unfinished piece, since the noun is the same.
    if held_items.any? { |held| task_piece?(held) }
      discard_unfinished(noun)
    elsif held_items.any? { |held| held =~ /\b#{Regexp.escape(noun)}\b/i }
      DRCC.stow_crafting_item(noun, @bag, nil)
    end
  end

  # An unfinished piece of the cloth, leather or yarn taskmaster buys for
  # Zasele's tasks (burlap, rat-pelt, wool).
  #
  # @param held [String] a hand's text, e.g. "coil of unfinished burlap reinforced rope"
  # @return [Boolean]
  def task_piece?(held)
    materials = @stackmap.values_at('cloth', 'leather', 'yarn').map(&:first)
    held.match?(/\bunfinished\b/) && held.match?(/\b(?:#{Regexp.union(materials)})\b/)
  end

  # sew could not finish the piece. Throws it away so it never reaches the
  # crafting bag, where the turn-in would pick it up, and stows any tool sew
  # left in hand so the next task starts with free hands. Not exiting: the
  # next start would try the same resume and stop again.
  #
  # @param noun [String] the unfinished item's noun
  # @return [void]
  def discard_unfinished(noun)
    DRC.message("sew could not finish your unfinished #{noun}. Throwing it away and starting a new task.")
    DRCI.dispose_trash(noun, @worn_trashcan, @worn_trashcan_verb)
    held_items.reject { |held| held =~ /\bunfinished\b/ }.each do |held|
      DRCC.stow_crafting_item(held, @bag, @settings.outfitting_belt)
    end
  end

  # What is in either hand, right first.
  #
  # @return [Array<String>] the hands' text, empty hands left out
  def held_items
    [DRC.right_hand, DRC.left_hand].compact
  end

  # A new task is offered about 30 seconds after a turn-in, so the poll
  # interval decides how much of each wait is lost past that point.
  MIN_COOLDOWN_POLL = 3

  # Seconds between asks while the taskmaster makes you wait:
  # task_cooldown_poll, 15 by default, never below MIN_COOLDOWN_POLL.
  #
  # @return [Integer]
  def cooldown_poll_seconds
    [(@settings.task_cooldown_poll || 15).to_i, MIN_COOLDOWN_POLL].max
  end

  # Runs each task_before_scripts entry ("script arg arg") to completion. They
  # run before asking for a task, so they overlap the taskmaster's cooldown
  # after the previous turn-in instead of adding to the task.
  #
  # @return [void]
  def run_before_scripts
    @before_scripts.each do |entry|
      name, *script_args = entry.to_s.split
      next unless name

      DRC.wait_for_script_to_complete(name, script_args)
    end
  end

  # Either a keep list (keep matches, bin the rest) or a junk list (bin
  # matches, keep the rest). Entries may be strings or regexps. A missing or
  # empty junk list falls back to the keep list; a missing keep list keeps
  # nothing, as before.
  #
  # @return [void]
  def configure_loot_filter
    junk = Array(@settings.task_junk_list)
    if junk.empty?
      @junk_regex = nil
      @keeplist_regex = Regexp.union(Array(@settings.task_keep_list))
    else
      @junk_regex = Regexp.union(junk)
    end
    @slack_keepers = @settings.task_slack_keepers
    register_slackbot(@settings.slack_username) if @slack_keepers
    @unpack_keepers = @settings.task_unpack_keepers
  end

  # An unreadable or empty look is never a keeper, so a failed LOOK cannot
  # fill the loot bag with empty sacks in junk-list mode.
  #
  # @param contents [String, nil] the LOOK IN reply for the reward sack
  # @return [Boolean] true to keep the sack
  def keeper?(contents)
    return false if contents.to_s.strip.empty?
    return !contents.match?(@junk_regex) if @junk_regex

    contents.match?(@keeplist_regex)
  end

  # How long one Minor Haste boost lasts.
  HASTE_SECONDS = 3600
  # How long to wait before asking again after an answer that was neither an
  # activation nor a lack of credits, or no answer at all.
  # November 2025 logs (Hollow Eve, 21 characters, ~49,000 BOOST HASTE sends)
  # only ever show those two replies (besides "...wait" in roundtime). Each activation spent exactly one credit
  # (BOOST listings before and after agree). With haste running and no credits
  # left, the game gives the no-credits line, not an "already active" one.
  # BOOST HASTE with haste running and credits left never happened, so whether
  # it restarts the hour and spends a credit is unknown; the stored expiry
  # keeps that to at most one credit when the expiry is lost.
  HASTE_RECHECK_SECONDS = 600
  # BOOST HASTE reply when a credit was spent.
  HASTE_ACTIVATED = /You've activated the Minor Haste boost/
  # BOOST HASTE reply with no credits left.
  HASTE_NO_CREDITS = /You don't have enough credits for the Minor Haste boost/

  # Reads task_boosts (and the older task_use_boost, which means the task
  # boost) into @boosts, and arms the one task boost per run in @boost.
  #
  # @return [void]
  def configure_boosts
    @boosts = Array(@settings.task_boosts).map { |boost| boost.to_s.downcase }
    @boosts |= ['task'] if @settings.task_use_boost
    @boost = @boosts.include?('task')
  end

  # Keeps BOOST HASTE running. Its expiry is kept in UserVars because t2 can
  # start this script once per task, so the hour outlives any single run.
  # Out of credits costs one command per task and picks up new credits by
  # itself.
  #
  # @note The expiry lives in UserVars.taskmaster_haste_expires, which
  #   persists across runs, since t2 relaunches this script for each task.
  # @return [void]
  def refresh_haste
    return unless @boosts.include?('haste')
    return if Time.now.to_i < UserVars.taskmaster_haste_expires.to_i

    case DRC.bput('boost haste', HASTE_ACTIVATED, HASTE_NO_CREDITS, /Minor Haste/)
    when HASTE_ACTIVATED
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_SECONDS
    when HASTE_NO_CREDITS
      nil
    else
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_RECHECK_SECONDS
    end
  end

  # Reads task_copper_floor (20000 by default) and task_copper_target
  # (110000 by default, never below the floor).
  #
  # @return [void]
  def configure_copper
    @copper_floor = @settings.task_copper_floor || 20_000
    @copper_target = [@settings.task_copper_target || 110_000, @copper_floor].max
  end

  # One WEALTH check per task. Only when below the floor does this walk to the
  # bank, exchanging any foreign coins from reward sacks on the way, and refill
  # to the target, so most tasks need no trip. The per-purchase
  # ensure_copper_on_hand calls stay as a guard for tasks that cost more than
  # the floor; they only walk when short.
  #
  # @return [void]
  def top_up_copper
    return if DRCM.wealth("Crossing") >= @copper_floor

    exchange_coins
    DRCM.ensure_copper_on_hand(@copper_target, @settings, "Crossing")
  end

  # Walks to the Crossing exchange and changes every other currency into
  # Kronars, such as the coins from reward sacks.
  #
  # @return [void]
  def exchange_coins
    DRCT.walk_to(get_data('town')["Crossing"]['exchange']['id'])
    DRC.release_invisibility
    exchange_to = get_data('town')["Crossing"]['currency']
    $CURRENCIES
      .reject { |currency| currency =~ /#{exchange_to}/i }
      .each { |currency| fput("exchange all #{currency} for #{exchange_to}") }
  end

  # Marathon restock: tops up burlap cloth and rat leather to 100 yards, and
  # wool yarn and cotton thread to 400, plus pins, paying from the copper
  # float.
  #
  # @return [void]
  def restock
    info = get_data('crafting')['tailoring']["Crossing"]
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, nil, 40)
    need = {}
    cost = 0
    ['cloth', 'leather'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (100 - current) / 10)
      else
        need.store(stock, 10)
      end
      cost += need[stock] * @stockdata[@stackmap[stock].first]['stock-value']
    end
    ['yarn', 'thread'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (400 - current) / 100)
      else
        need.store(stock, 4)
      end
      cost += need[stock] * @stockdata[stock]['stock-value']
    end
    return if cost == 0

    top_up_copper
    DRCM.ensure_copper_on_hand(cost + 8000, @settings, "Crossing")
    ## now we have a hash with stock=># to order, and cash on hand
    need.each do |stock, number|
      next unless number > 0

      DRCT.walk_to(16667)
      DRCC.get_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, @bag_items, nil) if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
      number.times do
        DRCT.order_item(@stackmap[stock].last, (stock == 'yarn' || stock == 'thread') ? @stockdata[stock]['stock-number'] : @stockdata[@stackmap[stock].first]['stock-number'])
        DRC.bput("combine #{stock}", /you (combine|must)/i)
      end
      DRCC.stow_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, nil)
    end
  end

  # Whether the crafting bag holds enough of a stock for a task.
  #
  # @param needed [Integer] yards the task needs
  # @param type [String] stock name, e.g. 'burlap'
  # @param base [String] stock base, e.g. 'cloth'
  # @return [Boolean] false when none is carried or it is short
  def check_stock(needed, type, base)
    return false unless DRCI.exists?("#{type} #{base}")

    /(\d+)/ =~ DRC.bput("count my #{type} #{base}", /^You count out (\d+) yards of material/)
    if Regexp.last_match(1).to_i >= needed
      true
    else
      false
    end
  end

  # Leftover pieces trash throws away at most, so a reply it doesn't expect
  # (full hands, a timeout) can't keep it walking to the bin forever.
  TRASH_CAP = 100

  # Throws away what a task leaves over: with @remainder set, every leftover
  # ingot or piece of stock in the crafting bag.
  #
  # @param item [String] item noun, unused
  # @param base [String] stock base; ingots go to a different bin
  # @param type [String] metal of leftover ingots
  # @return [void]
  def trash(_item, base, type)
    return unless @remainder

    if base == 'ingot'
      dispose_leftovers("#{type} #{base}", 793)
    else
      dispose_leftovers("#{@stackmap[base].first} #{base}", 14886)
    end
  end

  # Takes each piece of stock out of the crafting bag and disposes of it in
  # the given room, until the bag has none left or TRASH_CAP pieces are gone.
  #
  # @param stock [String] e.g. 'burlap cloth' or 'bronze ingot'
  # @param room [Integer] room with the bin
  # @return [void]
  def dispose_leftovers(stock, room)
    TRASH_CAP.times do
      reply = DRC.bput("get my #{stock} from my #{@bag}", "You get", "You are already", "You're already", "What were you")
      break unless reply =~ /You get|You are already|You're already/

      DRCT.dispose(stock, room)
    end
  end

  # Works one of Poltu's metal tasks.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def poltu(item, count, volume_per_item, base, type)
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # Works one of Bradyn's tasks: carving stone or bone, shaping wood, or
  # forging metal like Poltu.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer, String] volumes per item, or 'boulder' for stone
  # @param base [String] stock base: 'stone', 'stack', 'lumber' or 'ingot'
  # @param type [String] stock name, e.g. 'alabaster', 'deer', 'balsa' or 'bronze'
  # @return [void]
  def bradyn(item, count, volume_per_item, base, type)
    if base == 'stone'
      buy_rocks(count)
      carve_stone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'stack'
      buy_stackables(item, count, volume_per_item, base)
      carve_bone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'lumber'
      buy_stackables(item, count, volume_per_item, base)
      shape_item(item, count, base, type)
      # base.yaml names the shaping toolset shaping_tools; engineering_tools is the
      # older key, kept as a fallback the same way clerk-tools resolves it.
      repair(@settings.shaping_tools || @settings.engineering_tools || [], @settings.engineering_belt)
      trash(item, base, type)
      return
    end
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # A Poltu or Bradyn metal task: buy the metal, forge the items, send the
  # forging tools for repair and throw away any metal left over.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def forge_metal_task(item, count, volume_per_item, base, type)
    type = buy_metal(count, volume_per_item, type)
    forge_item(item, count, type)
    repair(@settings.forging_tools, @settings.forging_belt)
    trash(item, base, type)
  end

  # Buys the metal for a forging task and returns the metal to forge with.
  # Items of exactly one ingot each need no smelting; anything else gets
  # enough bronze ingots for the whole task, or one steel ingot for small
  # items, and sets @remainder so trash throws away what is left.
  #
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param type [String] the task's metal, used for one-ingot-per-item tasks
  # @return [String] the metal to forge with: 'steel' or type
  def buy_metal(count, volume_per_item, type)
    if volume_per_item == 10 # exactly one ingot per item, so no scrap, no smelting
      type = 'steel'
      buy_ingots(count, type)
    elsif volume_per_item == 5 # exactly one bronze ingot per item
      buy_ingots(count, type)
    elsif count * volume_per_item > 100
      @remainder = true
      bingots(3)
    elsif count * volume_per_item > 50
      @remainder = (count * volume_per_item) % 100 > 0 ? true : false
      bingots(2)
    elsif volume_per_item < 5
      type = 'steel'
      @remainder = true
      buy_ingots(1, type)
    else # 50 volumes or less in all, more than 5 per item
      @remainder = true
      bingots(1)
    end
    type
  end

  # Works one of Zasele's tasks: knitting yarn, or sewing cloth or leather.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] yards per item
  # @param base [String] stock base: 'cloth', 'leather' or 'yarn'
  # @param type [String] stock name, e.g. 'burlap'
  # @return [void]
  def zasele(item, count, volume_per_item, base, type)
    if base == 'yarn'
      buy_yarn(item, count, volume_per_item, base)
      toolset = ["knitting needles"]
    else
      buy_stackables(item, count, volume_per_item, base)
      toolset = @settings.outfitting_tools
    end
    tailor_item(item, count, base, type)
    repair(toolset, @settings.outfitting_belt)
    # When bin_task_stock will bin the leftover stock after the hand-in,
    # there is no walk to the bin room now.
    trash(item, base, type) unless bins_task_stock?
  end

  # Dorhum's items, keyed by the task item's noun, as far as the Hollow Eve
  # 2026 runs show them. :noun is the noun the finished item is handed in by,
  # which is its base item's: a spongestone is made from "a foraged rock" and
  # is still a rock; a virga wand from "a finished stone, bone or wood wand or
  # rod" and is still the wand it was made from; a splashstone from "a
  # foraged rock" and is still a rock; a glow shell from "a foraged shell"
  # and is still that shell (sea, snail, asarwuden... all with the noun
  # shell). All four were handed in by these nouns in live runs (2026-11-03
  # and 2026-11-04). Spongestones and splashstones are both rocks, which is
  # why a task stops when task_loot_bag already holds its noun
  # (check_loot_bag_clear). :base is the method that gets the base items.
  # Any other item pauses the script.
  DORHUM_ITEMS = {
    'spongestone' => { noun: 'rock', base: :forage_rocks },
    'splashstone' => { noun: 'rock', base: :forage_rocks },
    'wand'        => { noun: 'wand', base: :buy_wands },
    'shell'       => { noun: 'shell', base: :forage_shells }
  }.freeze

  # Where Dorhum's rock tasks (spongestones, splashstones) forage rocks unless task_rock_room says
  # otherwise: The Crossing, Town Green Southeast, where FORAGE ROCK finds one
  # rock a time ("You manage to find a rock."). On Andreshlew FORAGE gets "You
  # survey the area and realize that any foraging efforts would be futile."
  DEFAULT_ROCK_ROOM = 793
  # Where Dorhum's glow shell tasks forage shells unless task_shell_room says
  # otherwise: FORAGE SHELL finds shells at The Crossing, Town Green
  # Southeast, as FORAGE ROCK finds rocks there (tested in game, 2026-11-03),
  # though the map tags only Cape of Storms, Path (712, 713) for shells.
  DEFAULT_SHELL_ROOM = 793
  # The wand on the steel crate in the Crossing enchanting supplies, 125
  # Kronars. TAP calls it "a redwood wand", but the game knows it only as a
  # wand: "buy redwood wand" gets "You can't order anything here." and
  # "tap my redwood wand" finds nothing, while "buy wand" gets "You decide to
  # purchase the wand, and pay the sales clerk 125 Kronars." (2026-11-03).
  SUPPLIES_WAND = 'wand'
  # A sigil on Dorhum's instructions and how many each item takes:
  # "(1) primary sigil (congruence)". The plural is accepted, though only
  # (1) has been seen.
  INSTRUCTION_SIGIL = /\((?<count>\d+)\) (?:primary|secondary) sigils? \((?<sigil>[\w-]+)\)/
  # The game's lines when an enchant is finished, caught by a Flag to tell a
  # finished item in hand from an unworked one enchant left there when it
  # stopped. enchant.lic's enchant-complete flag takes these three and also
  # "You collect the <item> and place it at your feet", left out here because
  # it matches the fount's line too. Every item in the Dorhum runs ended with
  # the first.
  ENCHANTED_FLAG = 'taskmaster-enchanted'
  # The completion lines ENCHANTED_FLAG catches.
  ENCHANTED = Regexp.union(
    /^(?:<[^>]*>|[^"<])*?With the enchanting process completed, you believe it is safe to collect your things once more/,
    /^(?:<[^>]*>|[^"<])*?With the enchantment complete/i,
    /^(?:<[^>]*>|[^"<])*?With enchanting complete/i
  )

  # Works one of Dorhum's enchanting tasks: buys the sigil-scrolls, makes
  # sure the fount has a use for every item, gets the base items, then enchants
  # each item with enchant's instructions mode and puts it in task_loot_bag
  # for the hand-in, and finally deals with the enchanting tools.
  #
  # @param item [String] the task item's noun, e.g. 'spongestone'
  # @param count [Integer] how many to make
  # @param sigils [Array<String>] the instructions' sigils, one entry per
  #   sigil used on each item
  # @return [void]
  def dorhum(item, count, sigils, _base = nil, _type = nil)
    check_loot_bag
    recipe = dorhum_recipe(item)
    check_loot_bag_clear(recipe[:noun]) unless @loot_bag_checked
    ensure_tools(dorhum_tools, 'enchanting')
    buy_sigils(sigils, count)
    # Next door to the sigil-scrolls, before the walk to the base items.
    DRCC.fount(artificing_info['tool-room'], 1, artificing_info['fount'], count, @bag, @bag_items, @settings.enchanting_belt)
    send(recipe[:base], count)
    go_to_enchanting_room
    enchant_items(item, recipe[:noun], count)
    repair(dorhum_repair_tools, @settings.enchanting_belt)
  end

  # DORHUM_ITEMS' entry for the item. An item taskmaster does not know how
  # to make pauses the script with a message, then stops when unpaused.
  #
  # @param item [String] the task item's noun
  # @return [Hash] :noun and :base
  # @raise [SystemExit] for an unknown item
  def dorhum_recipe(item)
    DORHUM_ITEMS[item] || pause_for_unknown_item("taskmaster does not know how to make Dorhum's #{item}s yet.")
  end

  # Whether two container names may be the same bag: the same noun, and
  # either a bare noun ("put my rock in my backpack" finds a "sturdy
  # backpack" too) or an adjective in common. Names may use DR's dot form,
  # "travel.pack"; "travel.pack" and "traveler's.pack" are two bags.
  #
  # @param one [String, nil]
  # @param other [String, nil]
  # @return [Boolean]
  def same_container?(one, other)
    *one_adjectives, one_noun = one.to_s.downcase.split(/[\s.]+/).reject(&:empty?)
    *other_adjectives, other_noun = other.to_s.downcase.split(/[\s.]+/).reject(&:empty?)
    return false unless one_noun && one_noun == other_noun

    one_adjectives.empty? || other_adjectives.empty? || !(one_adjectives & other_adjectives).empty?
  end

  # A resumed Dorhum task may start with a base item in hand, left there when
  # an earlier run stopped. Nothing says it was finished (a finished one goes
  # straight to task_loot_bag), so it goes back with the unworked ones rather
  # than being handed in.
  #
  # @param item [String] the task item's noun
  # @return [void]
  def set_aside_held_base(item)
    return unless @npc == 'dorhum'

    noun = hand_in_noun(item)
    DRCC.stow_crafting_item(noun, @bag, nil) if DRCI.in_hands?(noun)
  end

  # A rough fragile mana fount from the enchanting tools, should DRCC.fount
  # need a new one: "You can purchase a rough fragile mana fount for 312
  # Kronars." (2026-11-03).
  FOUNT_PRICE = 312

  # RUMMAGE /C in a container, whose reply lists what is like the word:
  # "You rummage through a heavy silk duffel bag looking for something
  # similar to "pins" and see some sepia pins, some sepia pins and some sepia
  # pins."
  #
  # @param container [String]
  # @param word [String]
  # @return [String] the reply
  def rummage(container, word)
    DRC.bput("rummage /C #{word} in my #{container}", /^You rummage .*/, /That would accomplish nothing/)
  end

  # How many items a RUMMAGE reply lists whose name ends in `name`: a "rock"
  # but not a "rock marble deed" (a Dorhum reward) or the quoted word.
  #
  # @param contents [String] a rummage reply
  # @param name [String] e.g. 'rock', 'decay sigil-scroll'
  # @return [Integer]
  def count_listed(contents, name)
    contents.to_s.scan(/ #{Regexp.escape(name)}(?=,| and |\.)/).size
  end

  # The hand-in gives whatever item of the task's noun it finds in
  # task_loot_bag first. One there before this task has made any is not this
  # task's: left from another task (a spongestone and a splashstone are both
  # rocks), not taken at the hand-in, or the player's own. So the run stops
  # before buying anything rather than hand those in. A resume runs it right
  # after handing in the finished items it found; dorhum then skips it.
  #
  # @param noun [String] the finished items' noun
  # @return [void]
  # @raise [SystemExit] when task_loot_bag holds any
  def check_loot_bag_clear(noun)
    held = count_listed(rummage(@lootbag, noun), noun)
    @loot_bag_checked = true
    return if held.zero?

    DRC.message("#{@lootbag} already holds #{held} #{noun}#{held == 1 ? '' : 's'} that this task has not made or could not hand in: left from another task, not taken at the hand-in, or your own. The hand-in would give those first. Move them out of #{@lootbag}, then start again.")
    exit
  end

  # Dorhum's finished items keep their base item's noun, so they must wait
  # in a different container from the unworked ones: with task_loot_bag
  # the same container as the crafting bag (it is 'backpack' when unset), a
  # GET for the next base item could take a finished one, and a hand-in an
  # unworked one. Two names are taken for one container when same_container?
  # says so.
  #
  # @return [void]
  # @raise [SystemExit] when task_loot_bag is the crafting bag
  def check_loot_bag
    return unless same_container?(@lootbag, @bag)

    DRC.message("Dorhum's tasks need task_loot_bag (#{@lootbag}) to be a container other than your crafting bag (#{@bag}): his finished items keep the base item's noun (a spongestone is still a rock). Stopping.")
    exit
  end

  # @param reason [String]
  # @return [void]
  # @raise [SystemExit] once unpaused
  def pause_for_unknown_item(reason)
    DRC.message("#{reason} Pausing; make them yourself, or kill the script. Unpausing stops it.")
    pause_script
    exit
  end

  # The enchanting tools a Dorhum task needs on hand before anything is
  # bought: enchanting_tools less the fount (DRCC.fount buys one); your own
  # brazier only when enchanting in a set room that is not a public brazier
  # room (with neither room set, a free brazier room is found); and the
  # imbue rod enchant falls back to. With an Imbue spell in waggle_sets
  # enchant casts it and never waves a rod, so no rod is needed then.
  #
  # @return [Array<String>]
  def dorhum_tools
    tools = Array(@settings.enchanting_tools).reject { |tool| tool =~ /fount|brazier/ }
    tools.reject! { |tool| tool =~ /wand|rod/ } if imbue_spell?
    tools << own_brazier if needs_own_brazier?
    tools << imbue_tool unless imbue_spell? || tools.any? { |tool| tool =~ /wand|rod/ }
    tools
  end

  # @return [Boolean] whether the room Dorhum's items are enchanted in may
  #   have no brazier: a set room that is not one of the towns' public
  #   brazier rooms (the artificing brazier-rooms in the crafting data)
  def needs_own_brazier?
    room = task_enchanting_room
    room ? !public_brazier_rooms.include?(room.to_i) : false
  end

  # @return [Array<Integer>] every town's public brazier rooms
  def public_brazier_rooms
    get_data('crafting')['artificing'].values.flat_map { |town| Array(town['brazier-rooms']) }
  end

  # The imbue rod (or wand) from enchanting_tools, as enchant finds it.
  #
  # @return [String]
  def imbue_tool
    Array(@settings.enchanting_tools).find { |tool| tool =~ /wand|rod/ } || 'rod'
  end

  # @return [Boolean] whether enchant will cast Imbue instead of waving a rod
  def imbue_spell?
    waggle_sets = @settings.waggle_sets
    waggle_sets.respond_to?(:dig) && waggle_sets.dig('imbue', 'Imbue') ? true : false
  end

  # The enchanting tools that go for repair after a Dorhum task: all but the
  # fount, which wears out by use and which Rangu turns away ("They only
  # have so many uses and then you must buy another.").
  #
  # @return [Array<String>]
  def dorhum_repair_tools
    Array(@settings.enchanting_tools).reject { |tool| tool =~ /fount/ }
  end

  # Makes sure the tools are on you before money is spent on a task: any
  # missing are asked of the society clerk (;clerk-tools <discipline> get),
  # and any still missing stop the run with their names, rather than buying
  # supplies and spending an instructions use on an item that cannot be made.
  # Tools left with Rangu were already collected before the task started.
  #
  # @param tools [Array<String>] tool names as in the settings
  # @param discipline [String] clerk-tools toolset, e.g. 'enchanting'
  # @return [void]
  # @raise [SystemExit] when a tool cannot be found
  def ensure_tools(tools, discipline)
    missing = missing_tools(tools)
    return if missing.empty?

    DRC.message("Missing #{missing.join(', ')}; asking the #{discipline} clerk.")
    DRCI.stow_hands
    DRC.wait_for_script_to_complete('clerk-tools', [discipline, 'get'])
    missing = missing_tools(missing)
    return if missing.empty?

    DRC.message("Can't find #{missing.join(', ')}: not on you, and the #{discipline} clerk didn't have it. Stopping before buying anything.")
    exit
  end

  # @param tools [Array<String>]
  # @return [Array<String>] the tools neither in hand nor anywhere TAP finds them
  def missing_tools(tools)
    Array(tools).compact.reject { |tool| DRCI.in_hands?(tool) || DRCI.exists?(tool) }
  end

  # Carries amount copper (Kronars), from the bank when short, or stops.
  #
  # @param amount [Integer]
  # @return [void]
  # @raise [SystemExit] when the bank cannot cover it
  def afford(amount)
    return if DRCM.ensure_copper_on_hand(amount, @settings, "Crossing")

    DRCI.stow_hands
    DRC.message("Out of money: #{amount} Kronars (copper) needed and the Crossing bank could not cover it. Stopping before buying anything more.")
    exit
  end

  # Whether the item reaches a hand within a few seconds: buy_item returns on
  # "You decide to purchase the wand...", and the hand only updates with the
  # next line, "The sales clerk hands you your wand." (log 2).
  #
  # @param noun [String]
  # @return [Boolean]
  def held_soon?(noun)
    10.times do
      return true if DRCI.in_hands?(noun)

      pause 0.3
    end
    false
  end

  # A purchase that did not go through (not enough coins, or the shop could
  # not be reached) stops the run before the supplies run short mid-task.
  #
  # @param what [String] e.g. 'a decay sigil-scroll'
  # @raise [SystemExit] always
  def stop_buying(what)
    DRCI.stow_hands
    DRC.message("Could not buy #{what}. Stopping.")
    exit
  end

  # The Crossing enchanting society's rooms and stock numbers.
  #
  # @return [Hash]
  def artificing_info
    get_data('crafting')['artificing']['Crossing']
  end

  # Reads Dorhum's instructions for their sigils (the read costs no use), then
  # stows them.
  #
  # @param item [String] the task item's noun
  # @param count [Integer] how many are owed
  # @return [Array(String, Integer, Array<String>)] item, count and sigils,
  #   each sigil once per scroll an item takes
  # @raise [SystemExit] when no sigil can be read off them
  def read_enchanting_instructions(item, count)
    lines = Lich::Util.issue_command("read my #{item} instructions", /Instructions for crafting/)
    sigils = Array(lines).flat_map do |line|
      line.gsub(/<[^>]+>/, '').scan(INSTRUCTION_SIGIL).flat_map { |count, sigil| [sigil] * count.to_i }
    end
    stow_instructions(item)
    pause_for_unknown_item("No sigils could be read off the #{item} instructions.") if sigils.empty?
    DRC.message("Each #{item} needs #{sigils.join(' and ')} sigils")
    return item, count, sigils
  end

  # Orders the sigil-scrolls the task needs (one per sigil per item, less any
  # already carried) from the Crossing enchanting supplies, into the crafting
  # bag.
  #
  # @param sigils [Array<String>] one entry per sigil used on each item
  # @param count [Integer] items to make
  # @return [void]
  def buy_sigils(sigils, count)
    needs = sigils.tally.transform_values { |per_item| per_item * count }
    carried = rummage(@bag, 'sigil-scroll')
    needs.each_key do |sigil|
      pause_for_unknown_item("No #{sigil} sigil-scroll in the crafting data.") unless @stockdata["#{sigil} sigil-scroll"]
      needs[sigil] -= count_listed(carried, "#{sigil} sigil-scroll")
    end
    cost = needs.sum { |sigil, needed| [needed, 0].max * @stockdata["#{sigil} sigil-scroll"]['stock-value'] }
    afford(cost + FOUNT_PRICE + 7500) if cost.positive? # a fount if it is used up, 5 gold for the next task, 2500 for repairs
    needs.each do |sigil, needed|
      needed.times do
        bought = DRCT.order_item(artificing_info['stock-room'], @stockdata["#{sigil} sigil-scroll"]['stock-number'])
        stop_buying("a #{sigil} sigil-scroll") if bought.to_s.empty?
        DRCC.stow_crafting_item('sigil-scroll', @bag, nil)
      end
    end
  end

  # Buys a wand from the steel crate for each virga wand still to make, less
  # any wands already in the crafting bag. DRCT.buy_item takes the crate's
  # "You decide to purchase" reply.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @note Every wand in the crafting bag counts, so an imbue wand kept there
  #   (rather than a rod) would be taken for an unworked one.
  def buy_wands(count)
    needed = count - DRCI.count_items_in_container(SUPPLIES_WAND, @bag)
    return unless needed.positive?

    afford(needed * 125 + 7500)
    needed.times do
      DRCT.buy_item(artificing_info['stock-room'], SUPPLIES_WAND)
      # buy_item returns nothing useful after "You decide to purchase", so
      # the hand says whether the wand was bought.
      stop_buying('a wand') unless held_soon?(SUPPLIES_WAND)
      DRCC.stow_crafting_item(SUPPLIES_WAND, @bag, nil)
    end
  end

  # A rock for each spongestone or splashstone still to make, foraged at task_rock_room.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_rocks(count)
    forage_base('rock', @rock_room, 'task_rock_room', count)
  end

  # A shell for each glow shell still to make, foraged at task_shell_room.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_shells(count)
    forage_base('shell', @shell_room, 'task_shell_room', count)
  end

  # Forages one base item per item still to make (less any carried) in the
  # room, into the crafting bag.
  #
  # @param noun [String] what FORAGE looks for, e.g. 'rock'
  # @param room [Integer, String] where to forage
  # @param setting [String] the setting that names the room, for the stop message
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_base(noun, room, setting, count)
    needed = count - DRCI.count_items_in_container(noun, @bag)
    return unless needed.positive?

    DRCT.walk_to(room)
    needed.times do
      unless DRC.forage?(noun)
        DRC.message("Could not forage a #{noun} at room #{room}, stopping. Set #{setting} to a room where #{noun}s can be found.")
        exit
      end
      DRCC.stow_crafting_item(noun, @bag, nil)
    end
  end

  # The room set for enchanting during a task: task_crafting_room, the room
  # every task crafts in, else enchanting_room. Outside tasks, enchanting
  # (craft, workorders) goes on using enchanting_room; only taskmaster reads
  # this.
  #
  # @return [Integer, String, nil] nil when neither is set
  def task_enchanting_room
    @crafting_room || @settings.enchanting_room
  end

  # Goes where Dorhum's items are enchanted: task_enchanting_room. With
  # neither room set, stays put when a brazier is carried (enchanting works
  # anywhere with your own), else finds a free brazier room in Crossing.
  #
  # @return [void]
  def go_to_enchanting_room
    room = task_enchanting_room
    return DRCT.walk_to(room) if room
    return if DRCI.exists?(own_brazier)

    DRCC.find_enchanting_room('Crossing')
  end

  # The brazier from enchanting_tools, as enchant finds it.
  #
  # @return [String]
  def own_brazier
    Array(@settings.enchanting_tools).find { |tool| tool =~ /brazier/ } || 'brazier'
  end

  # A rented room's notice (Mahtra's private forge, task_crafting_room 16936):
  # "[It will expire Thu Dec  3 20:58:13 ET 2026.]", in US Eastern time.
  RENTAL_EXPIRES = /^\[It will expire \w+ (?<month>\w+)\s+(?<day>\d+) (?<hour>\d+):(?<min>\d+):(?<sec>\d+) ET (?<year>\d+)\.\]/
  # READ NOTICE where there is none: the room is not rented.
  RENTAL_NO_NOTICE = [/^I could not find/, /^What were you referring to/].freeze
  # The sentry's warning, ten minutes before the rental ends (2026-11-02, with
  # 18:58:13 ET on the notice): "[You have less than 10 minutes remaining.  If
  # you wish to renew your rental, simply MARK NOTICE to signal the sentry.]"
  RENTAL_WARNING = /^(?:<[^>]*>)*\[You have less than 10 minutes remaining\.\s+If you wish to renew your rental/
  RENTAL_WARNING_FLAG = 'taskmaster-rental-warning'
  # MARK NOTICE that went through: "[Your private forge rental has been
  # extended until Thu Dec  3 00:56:41 ET 2026.]" (an hour per mark).
  RENTAL_EXTENDED = /^\[Your private forge rental has been extended until/
  # Minutes left on the notice under which the rental is renewed before
  # enchanting, the margin the sentry's warning gives too.
  RENTAL_RENEW_MINUTES = 10
  MONTHS = %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec].freeze

  # Reads the notice of task_crafting_room, if it has one, and renews the
  # rental when it ends within RENTAL_RENEW_MINUTES, as sew does in a
  # rented room: when it runs out, the game moves you out and drops on the
  # ground whatever is not a tool, the item on the brazier too.
  #
  # @return [Boolean] whether the room is rented
  def check_rental
    reply = DRC.bput('read notice', RENTAL_EXPIRES, *RENTAL_NO_NOTICE)
    match = RENTAL_EXPIRES.match(reply)
    return false unless match

    renew_rental if rental_minutes_left(match) < RENTAL_RENEW_MINUTES
    true
  end

  # @param match [MatchData] RENTAL_EXPIRES on the notice
  # @param now [Time]
  # @return [Float] minutes until the rental ends
  def rental_minutes_left(match, now = Time.now)
    month = MONTHS.index(match[:month]) + 1
    year = match[:year].to_i
    day = match[:day].to_i
    expires = Time.new(year, month, day, match[:hour].to_i, match[:min].to_i, match[:sec].to_i, eastern_offset(year, month, day))
    (expires - now) / 60
  end

  # US Eastern time's UTC offset on a date: daylight time from the second
  # Sunday of March to the first Sunday of November.
  #
  # @return [String] '-04:00' or '-05:00'
  def eastern_offset(year, month, day)
    sunday = ->(mon, nth) { (((7 - Time.utc(year, mon, 1).wday) % 7) + 1) + (7 * (nth - 1)) }
    daylight = case month
               when 4..10 then true
               when 3 then day >= sunday.call(3, 2)
               when 11 then day < sunday.call(11, 1)
               else false
               end
    daylight ? '-04:00' : '-05:00'
  end

  # MARK NOTICE, an hour more. A reply other than the extension stops the
  # run between items, before the rental can end under an enchant.
  #
  # @return [void]
  # @raise [SystemExit] when the rental was not extended
  def renew_rental
    Flags.reset(RENTAL_WARNING_FLAG)
    reply = DRC.bput('mark notice', RENTAL_EXTENDED, /^You don't have enough/, *RENTAL_NO_NOTICE)
    return if RENTAL_EXTENDED.match?(reply)

    DRC.message("Could not renew the rental of room #{@crafting_room}#{reply.empty? ? '' : " (#{reply})"}; stopping before it runs out.")
    exit
  end

  # Enchants each item with `enchant instructions` and puts it in
  # task_loot_bag. An item the game did not finish (enchant stopped and
  # said why) stops the task, leaving everything where it is. In a rented
  # task_crafting_room the rental is checked first and renewed between items
  # once the sentry warns it is nearly up.
  #
  # @param item [String] the task item's noun, naming the instructions
  # @param noun [String] the finished item's noun (its base item's)
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when an enchant did not finish, a finished item
  #   would not go in task_loot_bag (it is trashed first), or the rental
  #   could not be renewed
  def enchant_items(item, noun, count)
    Flags.add(ENCHANTED_FLAG, ENCHANTED)
    Flags.add(RENTAL_WARNING_FLAG, RENTAL_WARNING)
    rented = @crafting_room ? check_rental : false
    count.times do
      renew_rental if rented && Flags[RENTAL_WARNING_FLAG]
      Flags.reset(ENCHANTED_FLAG)
      DRC.wait_for_script_to_complete('enchant', ['instructions', item, noun])
      unless Flags[ENCHANTED_FLAG] && DRCI.in_hands?(noun)
        # An unworked base item enchant left in hand (it stopped before the
        # brazier) goes back with the others, not to the hand-in.
        DRCC.stow_crafting_item(noun, @bag, nil) if DRCI.in_hands?(noun)
        DRC.message("enchant did not finish a #{noun} for the #{item}s; stopping.")
        exit
      end
      next if DRCI.put_away_item?(noun, @lootbag)

      # Kept, it would end up among the unworked base items on the next
      # start, so it goes in the trash; the task is short one, which the
      # next start makes again.
      where = trash_refused(noun) ? 'it went in the trash' : 'it is still in your hand'
      DRC.message("The finished #{noun} would not go in #{@lootbag}, so #{where}. Make room in #{@lootbag}, then start again. Stopping.")
      exit
    end
    DRC.message("#{count} #{item}s completed")
  ensure
    Flags.delete(ENCHANTED_FLAG)
    Flags.delete(RENTAL_WARNING_FLAG)
  end

  # Taskmasters wander, but between turn-ins they are usually back in the
  # room they were last seen in. Search from there outwards along the room
  # list, and remember where each one was found. Kept in UserVars because t2
  # can start this script once per task.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param npc [String] taskmaster name, lower case
  # @note UserVars.taskmaster_last_seen persists across runs.
  # @return [void]
  def find_npc(rooms, npc)
    UserVars.taskmaster_last_seen ||= {}
    search_order(rooms, UserVars.taskmaster_last_seen[npc]).each do |room_id|
      break if DRRoom.npcs.include?(npc.capitalize)

      DRCT.walk_to(room_id)
    end
    UserVars.taskmaster_last_seen[npc] = Room.current.id if DRRoom.npcs.include?(npc.capitalize)
  end

  # The room list starting at start_room and alternating outwards from it
  # (start, next, previous, two on, two back, ...), or the list unchanged when
  # start_room is not in it.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param start_room [Integer, nil] where the taskmaster was last seen
  # @return [Array<Integer>] every room, once
  def search_order(rooms, start_room)
    start = rooms.index(start_room)
    return rooms unless start

    order = [rooms[start]]
    (1...rooms.size).each do |step|
      order << rooms[start + step] if start + step < rooms.size
      order << rooms[start - step] if start - step >= 0
    end
    order
  end

  # The task journal entry. "So far, you have returned N" is optional so an
  # entry printed without it still parses as nothing returned.
  # The game names the taskmaster first: "Zasele has asked you to craft some
  # items ... In particular, she wanted you to craft a reinforced rope and
  # indicated that 5 would suffice." Groups: taskmaster (when named), item,
  # how many, how many returned.
  TASK_JOURNAL = /(?:(\w+) has asked you to craft .*?)?wanted you to craft (.*) and indicated that (\d+) would suffice\.(?:\s+So far, you have returned (\d+))?/
  # The taskmasters this script works for.
  TASKMASTERS = %w[poltu bradyn zasele dorhum].freeze
  # TASK reply when not on a task.
  NOT_ON_TASK = /^You are not currently on a task/
  # The materials line of READ INSTRUCTIONS: the stock and its volume, or
  # the size of rock for stone.
  INSTRUCTION_MATERIALS = /(cloth|bone|stone|yarn|wood|leather|metal).* \(((\d+) .*|boulder|large rock|small rock|stone|pebble)\)/

  # Reads the task just accepted, or the one in progress, and its
  # instructions.
  #
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count still owed, volume per item ('boulder' for stone), base
  #   and type
  # @raise [SystemExit] when not on a task
  def finish
    item, count = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    read_instructions(item, count)
  end

  # Reads the task journal and returns the item noun and how many are still
  # owed, or nil when not on a task. Notes the taskmaster the journal names
  # in @task_giver (nil when it names none).
  #
  # @return [Array(String, Integer), nil] item noun and how many are owed
  def read_task
    entry = DRC.bput("task", TASK_JOURNAL, NOT_ON_TASK)
    match = TASK_JOURNAL.match(entry)
    return nil unless match

    @task_giver = match[1]&.downcase
    item = match[2].split.last
    @task_item = item
    remaining = [match[3].to_i - match[4].to_i, 0].max
    DRC.message("Making #{remaining} #{item}s")
    return item, remaining
  end

  # Reads the item's instructions for its material and volume, then stows
  # them, returning everything the worker methods need.
  #
  # @param item [String] item noun
  # @param count [Integer] how many are owed
  # @note An unrecognised materials line leaves base nil; Lich's nil patch
  #   then makes type nil instead of raising.
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count, volume per item ('boulder' for stone), base and type
  def read_instructions(item, count)
    return read_enchanting_instructions(item, count) if @npc == 'dorhum'

    case DRC.bput("read my #{item} instructions", INSTRUCTION_MATERIALS)
    when /(cloth|bone|yarn|wood|leather|metal).* \(((\d+) .*)\)/
      base = Regexp.last_match(1)
      volume_per_item = Regexp.last_match(3).to_i
      base = base.sub('bone', 'stack').sub('metal', 'ingot').sub('wood', 'lumber')
      DRC.message("Each #{item} requires #{volume_per_item} volumes")
    when /stone .* \((\w+)\)/
      volume_per_item = 'boulder'
      base = 'stone'
      DRC.message("Using a boulder for each #{item}")
    end
    stow_instructions(item)
    type = @stackmap[base].first
    return item, count, volume_per_item, base, type
  end

  # Turn-in reply while more items are owed.
  TURN_IN_MORE_NEEDED = /(\d+) more (?:are|is) needed/
  # READ INSTRUCTIONS line giving the uses left.
  INSTRUCTION_USES = /They have only (\d+) uses? remaining/

  # Finishes a task already in progress, for instance after a crash or a
  # reconnect: hand in any finished items already in the bag, make sure the
  # instructions have a use for every item still owed (asking the taskmaster
  # only when they don't, since replacements are limited), then make and hand
  # in the rest.
  #
  # @return [void]
  # @raise [SystemExit] always: when not on a task, when the banked items
  #   finish it, or after the last item is handed in
  def resume_task
    @dispose, @remainder = [false, false]
    item, owed = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    check_task_giver
    set_aside_held_base(item)
    owed = turn_in_banked(item, owed)
    exit if owed.zero?

    # Before new instructions or a bank trip: anything of the task's noun
    # still in the loot bag now was not taken at the hand-in.
    check_loot_bag_clear(hand_in_noun(item)) if @npc == 'dorhum'

    ensure_instructions(item, owed)
    item, count, volume_per_item, base, type = read_instructions(item, owed)
    refresh_haste
    top_up_copper
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    send(@npc.to_sym, item, count, volume_per_item, base, type)
    complete_task(item, count)
    exit
  end

  # The task in progress may be another taskmaster's (";taskmaster zasele"
  # while on one of Dorhum's tasks, say). A run never works another
  # taskmaster's task: its items, tools and hand-in are theirs, and a
  # character set up for one craft may not be for another. So it says whose
  # task it is and how to clear it, and stops. With task_cancel_foreign_tasks
  # it cancels that task instead, waits out the cooldown a cancel brings,
  # and goes back to asking its own taskmaster.
  #
  # @return [void]
  # @raise [SystemExit] when the journal names another taskmaster and
  #   task_cancel_foreign_tasks is off
  # @raise [UncaughtThrowError] never: with task_cancel_foreign_tasks, throws
  #   FOREIGN_TASK_CANCELLED, caught in get_task and finish_task_in_progress
  def check_task_giver
    giver = @task_giver
    return if giver.nil? || giver == @npc

    cancel_foreign_task(giver) if @cancel_foreign_tasks
    DRC.message("#{another_taskmasters_task_message(giver)} Or set task_cancel_foreign_tasks to have taskmaster cancel such tasks itself.")
    exit
  end

  # @param giver [String] the taskmaster the journal names
  # @return [String] whose task it is, and how to finish or cancel it
  def another_taskmasters_task_message(giver)
    name = giver.capitalize
    finish = TASKMASTERS.include?(giver) ? "Finish it with ;taskmaster #{giver}" : "#{name} is not a taskmaster this script does, so finish it yourself"
    "You are on a task for #{name}, not #{@npc.capitalize}. #{finish}, or cancel it with ASK #{giver.upcase} FOR TASK CANCEL (taskmasters then refuse you for about ten minutes)."
  end

  # A taskmaster's refusal after a task was cancelled, sent as two lines:
  # "Word has traveled.  You are unreliable.  Perhaps I'll give" /
  # "you a chance a little later." (Zasele, 2026-11-03), so the older
  # one-line "give you a chance a little later" never matched it.
  TASK_UNRELIABLE = /You are unreliable/
  # Unknown replies in a row to ASK FOR TASK before get_task stops.
  MAX_UNKNOWN_TASK_REPLIES = 3

  # Thrown (and caught in get_task and finish_task_in_progress) once another
  # taskmaster's task has been cancelled, so the run goes back to asking its
  # own taskmaster.
  FOREIGN_TASK_CANCELLED = :taskmaster_foreign_task_cancelled
  # The taskmaster's replies to ASK <taskmaster> FOR TASK CANCEL (Dorhum,
  # 2026-11-03): the first asks to confirm within fifteen seconds, the second
  # cancels, and with no task there is nothing to cancel. They are speech
  # ('Researcher Dorhum says, "Very well, I see that you no longer wish to
  # assist me."'), so cancel_reply matches them only after the taskmaster's
  # name; a player saying the words does not count.
  TASK_CANCEL_CONFIRM = 'ask me again within fifteen seconds'
  TASK_CANCELLED = 'I see that you no longer wish to assist me'
  TASK_CANCEL_NONE = 'You do not currently have a task'
  # How long taskmasters call you unreliable after a cancel: about ten
  # minutes, the figure players go by, and what Mahtra's log shows (cancel
  # 18:45:30, refused until 18:54:47, offered a task at 18:56:00).
  CANCEL_COOLDOWN_SECONDS = 600

  # Cancels another taskmaster's task (task_cancel_foreign_tasks), waits out
  # the cooldown a cancel brings, and sends the run back to asking its own
  # taskmaster.
  #
  # @param giver [String] the taskmaster whose task it is
  # @return [void]
  # @raise [UncaughtThrowError] never: throws FOREIGN_TASK_CANCELLED, caught
  #   in get_task and finish_task_in_progress
  # @raise [SystemExit] when the cancel does not go through
  def cancel_foreign_task(giver)
    cancel_task(giver, @task_item)
    DRC.message("Waiting #{CANCEL_COOLDOWN_SECONDS / 60} minutes: after a cancel, taskmasters call you unreliable for about that long.")
    pause CANCEL_COOLDOWN_SECONDS
    throw FOREIGN_TASK_CANCELLED
  end

  # Cancels the task with ASK <giver> FOR TASK CANCEL, asked twice as the
  # game wants, then throws its instructions away and clears its
  # replacement record.
  #
  # @param giver [String] the taskmaster whose task it is
  # @param item [String, nil] the task item's noun, for the instructions
  # @return [void]
  # @raise [SystemExit] when the cancel does not go through
  def cancel_task(giver, item)
    DRC.message("You are on a task for #{giver.capitalize}, not #{@npc.capitalize}: cancelling it (task_cancel_foreign_tasks).")
    DRCI.stow_hands
    find_npc(@rooms, giver)
    confirm, cancelled, none = [TASK_CANCEL_CONFIRM, TASK_CANCELLED, TASK_CANCEL_NONE].map { |text| cancel_reply(giver, text) }
    asks = 0
    reply = ''
    while asks < 2
      asks += 1
      reply = DRC.bput("ask #{giver} for task cancel", confirm, cancelled, none)
      break unless reply.match?(confirm)
    end
    unless reply.match?(cancelled) || reply.match?(none)
      DRC.message("Could not cancel #{giver.capitalize}'s task#{reply.empty? ? '' : " (#{reply})"}. Stopping.")
      exit
    end
    DRCT.dispose("#{item} instructions", nil, @worn_trashcan, @worn_trashcan_verb) if item
    forget_replacement(giver)
  end

  # @param giver [String] the taskmaster
  # @param text [String] one of the TASK_CANCEL_* replies
  # @return [Regexp] the reply, said by the taskmaster: its name, then
  #   "says," before the quote
  def cancel_reply(giver, text)
    /^[^"]*\b#{Regexp.escape(giver)}\b[^"]*says, "[^"]*#{Regexp.escape(text)}/i
  end

  # Hands in finished items already in the bag and returns how many are still
  # owed, or 0 once the task is complete (its reward sack sorted and the task
  # closed out by task_handed_in). A give that misses a wandering taskmaster is
  # retried (give_item). A reply bput did not know is given again, as in
  # complete_task; after MAX_UNKNOWN_GIVE_REPLIES of them in a row the item
  # goes back in the bag and the hand-in stops.
  #
  # @param item [String] item noun
  # @param owed [Integer] how many are owed before the hand-in
  # @return [Integer] how many are still owed, 0 once the task is done
  # @raise [SystemExit] from give_item after repeated misses
  def turn_in_banked(item, owed)
    unknown_replies = 0
    loop do
      case give_item(item)
      when nil
        break
      when /hands you a/
        sort_sack(item)
        fput('dump junk')
        task_handed_in(item)
        return 0
      when TURN_IN_MORE_NEEDED
        owed = Regexp.last_match(1).to_i
        unknown_replies = 0
      when GIVE_NOT_ENCHANTED
        trash_unenchanted(item, Regexp.last_match(0))
        unknown_replies = 0
      else
        unknown_replies += 1
        next if unknown_replies < MAX_UNKNOWN_GIVE_REPLIES

        DRCC.stow_crafting_item(hand_in_noun(item), hand_in_bag, nil)
        break
      end
    end
    owed
  end

  # Leaves the item's instructions in hand, asking the taskmaster for a fresh
  # set only when no usable set is carried: none at all, or one with fewer
  # uses than items owed (each item takes one study). Sets written for
  # someone else are thrown away on the way, up to MAX_CARRIED_SETS.
  #
  # @param item [String] item noun
  # @param owed [Integer] items still to make, one study each
  # @return [void]
  def ensure_instructions(item, owed)
    name = "#{item} instructions"
    sets = 0
    while sets < MAX_CARRIED_SETS && DRCI.get_item?(name, @bag)
      sets += 1
      reply = DRC.bput("read my #{name}", INSTRUCTION_USES, FOREIGN_INSTRUCTIONS, /What were you referring/)
      if reply.match?(FOREIGN_INSTRUCTIONS)
        # Never usable, and put back it would be the first set picked up
        # next time: bin it and look at the next set carried.
        DRC.message("These #{name} were written for someone else; throwing them away.")
        next if DRCI.dispose_trash(name, @worn_trashcan, @worn_trashcan_verb)
      elsif reply[INSTRUCTION_USES, 1].to_i >= owed
        return
      end

      # Put the short, unreadable or unbinnable set back so only the new one
      # is in hand.
      DRCC.stow_crafting_item(name, @bag, nil)
      break
    end
    request_replacement(item)
  end

  # READ reply for instructions written for another character, which can
  # never be studied: "They were written by or for someone else."
  FOREIGN_INSTRUCTIONS = /written by or for someone else/
  # Instruction sets ensure_instructions looks at before asking for a fresh
  # one, so binning foreign sets always ends.
  MAX_CARRIED_SETS = 5

  # Asks the taskmaster for a fresh set of instructions, once per task. The
  # request is remembered in UserVars (t2 can start the script once per task),
  # and a second request for the same task stops instead: something keeps the
  # items from being made, and repeated requests risk the taskmaster's
  # warning that she will stop handing out replacements. This stop is
  # deliberate even though a replacement has no spare use: the set handed out
  # with a task has one use more than the task count, but a replacement has
  # only as many as are still owed (Zasele, Hollow Eve 2025). So, after a
  # replacement, one more item lost after its study stops the task here for a
  # person to look at, where asking on every relaunch could go on for hours.
  #
  # @param item [String] the task item's noun
  # @return [void]
  # @raise [SystemExit] when instructions were already requested for this task
  def request_replacement(item)
    UserVars.taskmaster_replacements ||= {}
    if UserVars.taskmaster_replacements[@npc] == item
      DRC.message("Already asked #{@npc} for #{item} instructions on this task, and they were used up again. Stopping instead of asking again; check why the #{item}s aren't being made.")
      exit
    end
    UserVars.taskmaster_replacements[@npc] = item
    get_instructions
  end

  # Put the instructions just read into the crafting bag by name, where the
  # crafting scripts put them after studying, rather than leaving them to
  # default stow. Anything else still in hand (a tool or unfinished item held
  # after a crash) goes to default stow as before.
  #
  # @param item [String] item noun
  # @return [void]
  def stow_instructions(item)
    DRCC.stow_crafting_item("#{item} instructions", @bag, nil)
    DRCI.stow_hands
  end

  # Finds the taskmaster and asks for a fresh set of instructions.
  #
  # @return [String] the reply
  def get_instructions
    find_npc(@rooms, @npc)
    DRC.bput("ask #{@npc} for instructions", "hands you", "gives you", "handing you")
  end

  # Asks the taskmaster for a task until one is offered, waiting out
  # cooldowns (including the one after a cancelled task), and returns what
  # finish reads from it. An ongoing task is resumed instead; another
  # taskmaster's that had to be cancelled sends the loop round to ask again.
  # A while loop, not Kernel#loop: loop would swallow a StopIteration raised
  # inside it and return nil, where the old recursion let it propagate.
  #
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   what {#finish} returns
  # @raise [SystemExit] from finish (not on a task) or resume_task, or after
  #   MAX_UNKNOWN_TASK_REPLIES replies in a row it does not know
  def get_task
    unknown_replies = 0
    while true
      find_npc(@rooms, @npc)
      reply = DRC.bput("ask #{@npc} for task", /if you agree to (his|her) terms/, /You may accept by typing ACCEPT TASK/, /utterly ignoring you/, /you must wait before I can give you a task/, /You are already on a task/, /give you a chance a little later/, TASK_UNRELIABLE, /^To whom are you speaking/)
      unknown_replies = 0 unless reply.empty?
      case reply
      when /if you agree to (his|her) terms/, /To whom are you speaking/
        next
      when /You are already on a task/
        catch(FOREIGN_TASK_CANCELLED) { return resume_task }
        # Another taskmaster's task, cancelled: ask our own taskmaster again.
        next
      when /utterly ignoring you/, /give you a chance a little later/, TASK_UNRELIABLE
        DRC.message("Task on cooldown or recently canceled a task, either way, going to have to wait.")
        pause @cooldown_poll
      when /you must wait before I can give you a task/
        if @boost
          fput("boost task")
          pause 2
          @boost = false
        else
          pause @cooldown_poll
        end
      when /You may accept by typing ACCEPT TASK/
        DRC.bput("accept task", /You can check your progress with the TASK verb/)
        forget_replacement
        return finish
      else
        # No reply bput knows: nothing to work on. Returning would send the
        # run on with no task (a crash in the worker); ask again after a
        # wait, and stop after MAX_UNKNOWN_TASK_REPLIES in a row.
        unknown_replies += 1
        if unknown_replies >= MAX_UNKNOWN_TASK_REPLIES
          DRC.message("No answer #{@npc.capitalize} gives that taskmaster knows, #{MAX_UNKNOWN_TASK_REPLIES} times in a row. Stopping.")
          exit
        end
        pause @cooldown_poll
      end
    end
  end

  # Buys ingots of one metal from room 8775 and puts each in the crafting
  # bag.
  #
  # @param count [Integer] how many ingots
  # @param type [String] metal, e.g. 'steel'
  # @return [void]
  def buy_ingots(count, type)
    cost = count * @stockdata[type]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8775, @stockdata[type]['stock-number'])
      DRCC.stow_crafting_item("ingot", @bag, nil)
    end
  end

  # Orders bronze ingot number order from the shop in room 17118 (buy_metal
  # picks 1, 2 or 3 by the task's total volume) and puts it in the crafting
  # bag.
  #
  # @param order [Integer] order number: 1, 2 or 3
  # @return [void]
  def bingots(order)
    cost = order * 8000 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    DRCT.order_item(17118, order)
    DRCC.stow_crafting_item("ingot", @bag, nil)
  end

  # Buys enough 10-volume stock (cloth, leather, bone, lumber) for the
  # task, combines it and stows it, setting @remainder when some is left
  # over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] volumes per item
  # @param base [String] stock base, a STACKMAP key
  # @return [void]
  def buy_stackables(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 10.to_f).ceil
    @remainder = (count * vpi) % 10 > 0 ? true : false
    cost = base_to_buy * @stockdata[@stackmap[base].first]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    base_to_buy.times do
      DRCT.order_item(@stackmap[base].last, @stockdata[@stackmap[base].first]['stock-number'])
      DRC.bput("combine #{base}", /you (combine|must)/i)
    end
    DRCC.stow_crafting_item(base, @bag, @settings.engineering_belt)
  end

  # Buys enough 100-yard yarn for the task, combines it and stows it,
  # setting @remainder when some is left over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] yards per item
  # @param base [String] 'yarn'
  # @return [void]
  def buy_yarn(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 100.to_f).ceil
    @remainder = (count * vpi) % 100 > 0 ? true : false
    cost = base_to_buy * @stockdata[base]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    base_to_buy.times do
      DRCT.order_item(@stackmap[base].last, @stockdata[base]['stock-number'])
      DRC.bput("combine #{base}", /you (combine|must)/i)
    end
    DRCC.stow_crafting_item(base, @bag, @settings.engineering_belt)
  end

  # Buys one alabaster rock deed per item and stows the deeds.
  #
  # @param count [Integer] how many deeds
  # @return [void]
  def buy_rocks(count)
    cost = count * 1250 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8864, 2)
      DRCC.stow_crafting_item("deed", @bag, @settings.engineering_belt)
    end
  end

  # Forges each item with the forge script at an anvil (or the
  # task_crafting_room) and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param type [String] metal to forge with
  # @return [void]
  def forge_item(item, count, type)
    unless @crafting_room
      info = get_data('crafting')['blacksmithing']["Crossing"]
      DRCC.check_consumables('oil', info['finisher-room'], info['finisher-number'], @bag, @bag_items, nil, count)
      DRCC.find_anvil(@anvil_town)
    else
      DRCT.walk_to(@crafting_room)
    end
    DRCC.clean_anvil?
    count.times do
      DRC.wait_for_script_to_complete('forge', ['instructions', type, item, 'skip'])
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Carves each stone item from its rock deed and bags it. When the thief's
  # fog rolls through mid-carve, it buys a new deed and carves that item
  # again.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @note Adds the "thieving-fog" flag, deleted when the script ends.
  # @return [void]
  def carve_stone(item, count)
    Flags.add("thieving-fog", "A low fog rolls in, then just as quickly rolls out")
    DRCC.find_shaping_room(@anvil_town)
    DRCC.get_crafting_item("chisels", @bag, @bag_items, @settings.engineering_belt)
    remaining = count
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get alabaster deed from my #{@bag}", '^You get')
      fput('tap my deed')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /You reach out and touch/, /You are not attuned to this particular enchantment/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/, /^You reach out and touch/) if @cube
      DRC.bput("carve boulder with my chisels", "Roundtime")
      loop do
        case DRC.bput("carve #{item} with my chisels", "Roundtime", "You cannot figure out how to do that", "It would be better to find")
        when "You cannot figure out how to do that", "It would be better to find"
          break
        end
        waitrt?
      end
      if Flags["thieving-fog"]
        buy_rocks(1)
        DRCC.find_shaping_room(@anvil_town)
        count = remaining
        Flags.reset("thieving-fog")
        redo
      end
      DRC.bput("get #{item}", "You pick up")
      DRC.bput("put my #{item} in my #{@bag}", "You put")
      remaining -= 1
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Cuts each bone item from the deer stack and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @return [void]
  def carve_bone(item, count)
    DRCT.walk_to(8868)
    DRCC.get_crafting_item("bone saw", @bag, @bag_items, @settings.engineering_belt)
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get deer stack from my #{@bag}", '^You get')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/) if @cube
      DRC.bput("cut stack with my bone saw", "Roundtime")
      loop do
        case DRC.bput("cut #{item} with my bone saw", "Roundtime", "You cannot figure out how to do that")
        when "You cannot figure out how to do that"
          break
        end
      end
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Sews or knits each item with the sew script, in the tailoring room or
  # task_crafting_room (marathon sews where it stands).
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param base [String] 'yarn' knits, anything else sews
  # @param type [String] stock name
  # @return [void]
  def tailor_item(item, count, base, type)
    unless @crafting_room
      DRCT.walk_to(14886) unless @marathon
    else
      DRCT.walk_to(@crafting_room)
    end
    check_sewing_consumables(count) unless base == 'yarn'
    count.times do
      DRC.wait_for_script_to_complete('sew', ['stow', 'instructions', type, item, base == 'yarn' ? 'knit' : nil, 'skip'])
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Pins and thread are checked once for the whole task, so each sew run can
  # skip its own check (two get/count/put rounds per item). An item uses at
  # most a few pins; sew still restocks mid-item if either runs out.
  # Knitting uses neither.
  PIN_USES_PER_ITEM = 3

  # Checks pins and thread once for the whole sewing task.
  #
  # @param count [Integer] items to sew
  # @return [void]
  def check_sewing_consumables(count)
    info = get_data('crafting')['tailoring']["Crossing"]
    belt = @settings.outfitting_belt
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, belt, PIN_USES_PER_ITEM * count + 5)
    DRCC.check_consumables('thread', info['stock-room'], 6, @bag, @bag_items, belt)
  end

  # Shapes each wooden item with the shape script in a shaping room.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param _base [String] unused
  # @param type [String] lumber, e.g. 'balsa'
  # @return [void]
  def shape_item(item, count, _base, type)
    DRCC.find_shaping_room(@anvil_town)
    count.times do
      DRC.wait_for_script_to_complete('shape', ['stow', 'instructions', type, item])
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Consecutive gives that found nobody to take the item before giving up.
  MAX_GIVE_MISSES = 5
  # GIVE reply when the taskmaster is not in the room.
  GIVE_MISSED = /What is it you're trying to give/

  # Dorhum turning down an item with no enchantment on it (a manual run,
  # 2026-11-04: 'Researcher Dorhum examines the small brazier and shakes his
  # head.  "I don't sense any hint of enchantment on this.  What are you
  # trying to pull, Pezamus?"'). Giving it again cannot help.
  GIVE_NOT_ENCHANTED = /^Researcher Dorhum examines [^"]*"I don't sense any hint of enchantment on this/

  # Gives one finished item to the taskmaster and returns the reply, or nil when
  # there is none in hand or in the bag. A give that misses her (she wandered
  # off between the get and the give) leaves the item in hand: find her again
  # and give that same item, stopping after MAX_GIVE_MISSES misses in a row.
  #
  # @param item [String] item noun
  # @return [String, nil] the taskmaster's reply, or nil when none is left
  # @raise [SystemExit] after MAX_GIVE_MISSES misses in a row
  def give_item(item)
    noun = hand_in_noun(item)
    MAX_GIVE_MISSES.times do
      find_npc(@rooms, @npc)
      return unless DRCI.in_hands?(noun) || DRCI.get_item?(noun, hand_in_bag)

      reply = DRC.bput("give my #{noun} to #{@npc}", TURN_IN_MORE_NEEDED, /hands you a/, GIVE_MISSED, GIVE_NOT_ENCHANTED)
      return reply unless reply =~ GIVE_MISSED
    end
    DRC.message("Could not hand a #{noun} to #{@npc} after #{MAX_GIVE_MISSES} tries, stopping.")
    exit
  end

  # The noun a task's finished items are handed in by. Dorhum's keep their
  # base item's noun (a spongestone is a rock), so it comes from
  # DORHUM_ITEMS; everyone else's is the task item's own noun.
  #
  # @param item [String] the task item's noun
  # @return [String]
  def hand_in_noun(item)
    @npc == 'dorhum' ? dorhum_recipe(item)[:noun] : item
  end

  # Where finished items wait to be handed in: task_loot_bag for Dorhum's,
  # so they never mix with the unworked items of the same noun in the
  # crafting bag; the crafting bag for everyone else's.
  #
  # @return [String]
  def hand_in_bag
    return @bag unless @npc == 'dorhum'

    check_loot_bag
    @lootbag
  end

  # Hands in every finished item until the taskmaster gives the reward
  # sack, then sorts it.
  #
  # @param item [String] item noun
  # @param _count [Integer] unused
  # @return [void]
  # @raise [SystemExit] when the items run out first, when the taskmaster
  #   will not take one (refused_hand_in), or from give_item
  def complete_task(item, _count)
    unknown_replies = 0
    loop do
      reply = give_item(item)
      exit unless reply
      break if reply =~ /hands you a/

      if reply =~ TURN_IN_MORE_NEEDED
        unknown_replies = 0
        next
      end
      if reply =~ GIVE_NOT_ENCHANTED
        trash_unenchanted(item, reply)
        unknown_replies = 0
        next
      end
      # A reply bput did not know may be a lagged acceptance or a passing
      # refusal: give again (the item still in hand, or the next one if it
      # was taken) before calling it a refusal.
      unknown_replies += 1
      refused_hand_in(item, reply) if unknown_replies >= MAX_UNKNOWN_GIVE_REPLIES
    end
    sort_sack(item)
    fput('dump junk')
    task_handed_in(item)
  end

  # Hand-in replies in a row that were neither the reward sack nor "N more
  # are needed" before complete_task stops. Zasele has taken a rope on the
  # fifth give after four "Don't be silly." replies (a fleet log,
  # 2026-11-03), so a few unknown replies are not yet a refusal.
  MAX_UNKNOWN_GIVE_REPLIES = 5

  # Puts an item that cannot be used in the trash: a finished Dorhum item
  # the loot bag would not take, or one Dorhum saw no enchantment on.
  #
  # @param noun [String]
  # @return [Boolean] whether it went in the trash
  def trash_refused(noun)
    DRCI.dispose_trash(noun, @worn_trashcan, @worn_trashcan_verb)
  end

  # Dorhum saw no enchantment on the item handed to him, so it can never be
  # handed in: it goes in the trash and the hand-in goes on with the next
  # one. If the trash will not take it, it goes back in the loot bag and the
  # run stops (refused_hand_in).
  #
  # @param item [String] the task item's noun
  # @param reply [String] Dorhum's refusal
  # @return [void]
  # @raise [SystemExit] when it could not be trashed
  def trash_unenchanted(item, reply)
    noun = hand_in_noun(item)
    refused_hand_in(item, reply) unless trash_refused(noun)
    DRC.message("#{@npc.capitalize} saw no enchantment on a #{noun}, so it went in the trash.")
  end

  # The taskmaster neither took the item nor asked for more, MAX_UNKNOWN_GIVE_REPLIES
  # times in a row: a refusal, or replies bput did not know. The item is
  # still in hand, so it goes back in the bag and the run stops rather than
  # handing the same item over for good.
  #
  # @param item [String] item noun
  # @param reply [String] what bput matched ('' when nothing)
  # @return [void]
  # @raise [SystemExit] always
  def refused_hand_in(item, reply)
    noun = hand_in_noun(item)
    DRCC.stow_crafting_item(noun, hand_in_bag, nil)
    DRC.message("#{@npc.capitalize} did not take the #{noun}#{reply.empty? ? '' : " (#{reply})"}. Stopping.")
    exit
  end

  # The task is done: its instructions can go, and the next task may ask for
  # replacements again. Instructions are kept until here, so a run that could
  # not make the items leaves them for the resume instead of asking the
  # taskmaster for another set.
  #
  # @param item [String] the task item's noun
  # @return [void]
  def task_handed_in(item)
    DRCT.dispose("#{item} instructions", nil, @worn_trashcan, @worn_trashcan_verb)
    forget_replacement
    bin_task_stock
  end

  # Zasele's stock bases. Every task buys fresh stock, so once a task is
  # handed in, each piece of it left in the crafting bag is surplus: the
  # offcuts sew puts back in the bag after each cut, and whatever was left of
  # the purchase.
  TASK_STOCK_BASES = %w[cloth leather yarn].freeze

  # Pieces bin_task_stock bins per stock at most, so the loop always ends.
  TASK_STOCK_BIN_CAP = 100

  # Whether bin_task_stock bins after the hand-in: only when the player opted
  # in with task_bin_leftover_stock, for Zasele's tasks, with a worn trash can,
  # and never in marathon, whose restock stack is carried from task to task
  # (check_stock reuses it), so binning it would force a full restock each time.
  #
  # @return [Boolean]
  def bins_task_stock?
    @bin_leftover_stock && @npc == 'zasele' && @worn_trashcan && !@marathon ? true : false
  end

  # With task_bin_leftover_stock, after a Zasele task is handed in, bins
  # every piece of her stock in the crafting bag into the worn trash can,
  # then uses the trash can's verb twice. Without the setting or a worn trash
  # can it bins nothing, so nothing is ever dropped, and trash keeps taking
  # leftover stock to the bin room. A piece the trash can refuses goes back
  # in the bag and ends that stock's loop.
  #
  # @return [Integer] pieces binned
  def bin_task_stock
    return 0 unless bins_task_stock?

    binned = TASK_STOCK_BASES.sum { |base| bin_stock("#{@stackmap[base].first} #{base}", base) }
    return binned unless binned.positive?

    2.times { DRC.bput("#{@worn_trashcan_verb} my #{@worn_trashcan}", /You drum/, /THUD/, /What were you/, /^You /) } if @worn_trashcan_verb
    DRC.message("Binned #{binned} piece(s) of leftover task stock")
    binned
  end

  # Bins the pieces of one stock from the crafting bag, up to
  # TASK_STOCK_BIN_CAP.
  #
  # @param stock [String] e.g. 'burlap cloth'
  # @param noun [String] the stock's noun, e.g. 'cloth'
  # @return [Integer] pieces binned
  def bin_stock(stock, noun)
    binned = 0
    TASK_STOCK_BIN_CAP.times do
      got = DRC.bput("get my #{stock} from my #{@bag}", /^You get/, /^What were you referring to/, /^I could not find/, /^You need a free hand/)
      break unless got.start_with?('You get')

      put = DRC.bput("put my #{noun} in my #{@worn_trashcan}", /^You drop/, /^You put/, /^What were you/, /won't fit|no room|too full/)
      unless put.match?(/^You (drop|put)/)
        # The trash can refused it: put it back rather than leave a hand full.
        DRC.bput("put my #{noun} in my #{@bag}", /^You put/, /^What were you/)
        break
      end

      binned += 1
    end
    binned
  end

  # Clears the record of a replacement request for this taskmaster's task.
  #
  # @return [void]
  def forget_replacement(npc = @npc)
    UserVars.taskmaster_replacements&.delete(npc)
  end

  # Deals with worn tools after a task: stows them with task_no_repair,
  # repairs them with task_self_repair, or leaves them with Rangu.
  #
  # @param tools [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def repair(tools, belt)
    if @no_repair # skipping repair, stowing tool(s), moving on
      DRCI.stow_hands
      return
    elsif @self_repair
      DRCC.repair_own_tools({ 'finisher-room' => 8776, 'finisher-number' => 6 }, tools, @bag, @bag_items, belt) # runs self repair routine
    else
      tool_drop(tools, belt) # drops tools off at the repair guy to be picked up later
    end
  end

  # Leaves each tool with Rangu for repair and keeps the tickets; a tool he
  # won't take goes back where it came from.
  #
  # @param toolslist [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def tool_drop(toolslist, belt = nil) # accepts array of tools for repair
    return if @self_repair

    DRCT.walk_to(19209)
    @belt = belt
    toolslist.each do |tool_name|
      DRCC.get_crafting_item(tool_name, @bag, @bag_items, belt, true)
      case DRC.bput("give Rangu", "I don't repair those here", 'What is it', "There isn't a scratch on that", 'Just give it to me again', 'I will not', "I can't fix those.  They only have so many uses and then you must buy another.")
      when /give/
        DRC.bput("give Rangu", 'repair ticket')
        DRC.bput('stow ticket', 'You put')
      else
        DRCC.stow_crafting_item(tool_name, @bag, belt)
      end
    end
  end

  # Collects every tool Rangu holds a ticket for, waiting until each is
  # ready, and stows it on the toolbelt that lists it.
  #
  # @note A crafting belt setting left unset is nil; Lich's nil patch lets
  #   the belt search skip it.
  # @return [void]
  def tool_pickup # picks up all your tools from repair shop
    DRCT.walk_to(19209)
    while DRCI.get_item?("rangu ticket")
      pause 30 until DRC.bput('look at my ticket', 'should be ready by now', 'Looking at the') == 'should be ready by now'
      DRC.bput("give Rangu", 'You hand')
      pause 0.01 until (tool = [DRC.right_hand, DRC.left_hand].compact.first) # waits for tool to hit your hand
      belts = [@settings.forging_belt, @settings.engineering_belt, @settings.outfitting_belt, @settings.alchemy_belt, @settings.enchanting_belt]
      toolbelt = belts.select { |belt| belt["items"].find { |name| name =~ /#{tool}/i } }.first # searches your toolbelts for the first one containing the tool.
      DRCC.stow_crafting_item(tool, @bag, toolbelt) # hopefully stows the tool appropriately.
    end
  end

  # Sorts the reward sack: gems go to the gem pouch and coins are picked up,
  # then a keeper goes into the loot bag (with a Slack message if asked)
  # and anything else is binned. Logs the contents to the Task Master
  # window and the sack history.
  #
  # @param _item [String, nil] unused
  # @return [void]
  def sort_sack(_item)
    DRCI.fill_gem_pouch_with_container(@settings.gem_pouch_adjective, @settings.gem_pouch_noun, 'sack', @settings.full_pouch_container, @settings.spare_gem_pouch_container, @settings.tie_gem_pouches)

    4.times do
      DRC.bput("get coin from my sack", "You pick up", "What were you")
    end
    result = DRC.bput("look in my sack", /^In the .* you see.*/)
    if keeper?(result)
      result = result.sub(/In the woven sack you see (?:(?:a|an|some) )?/, '').sub(/\.$/, '')
      DRC.message("Found a keeper: #{result}")
      send_slackbot_message("Found a keeper: #{result}") if @slack_keepers
      DRCI.put_away_item?('sack', @lootbag) unless @unpack_keepers && unpack_keeper?(result)
    else
      DRC.message("Nothing special: #{result}")
      DRCI.dispose_trash('sack', @worn_trashcan, @worn_trashcan_verb)
    end
    result.sub!('In the woven sack you see', '')
    DRC.log_window(result, "Task Master", true, true)
    remember_sack(result)
  end

  # Replies used to take a keeper out of its sack (Hollow Eve 2026 logs).
  UNPACK_GET_SUCCESS = /^You get /
  UNPACK_NEED_FREE_HAND = /^You need a free hand/
  UNPACK_GET_FAILURES = [/^What were you referring to/, /^I could not find/].freeze
  SACK_EMPTY = /^There's nothing inside/
  SACK_NOT_EMPTY = /^Inside .*, you see:/
  # Seconds to wait for another script to free a hand before the one retry.
  UNPACK_FREE_HAND_WAIT = 20

  # Moves a keeper out of its reward sack into the loot bag and bins the
  # empty sack (task_unpack_keepers). Every sack seen held a single item whose
  # description ends in its noun ("a large tyrium bar"), so the item is taken
  # by that noun from the sack's own id; the id the game gives it in hand is
  # then used for the put. The sack is only binned once INVENTORY shows it
  # empty, so nothing is ever thrown away unseen, and it is binned by its id.
  #
  # @param description [String] the sack contents, LOOK prefix stripped
  # @return [Boolean] true when the item is in the loot bag and the sack is
  #   binned; false leaves the sack in hand (with whatever is still in it,
  #   or empty when it could not be binned) for the caller to keep as before
  def unpack_keeper?(description)
    sack_id = held_id('sack')
    noun = description.to_s.split.last
    return false unless sack_id && noun

    item_id = take_from_sack(noun, sack_id)
    return false unless item_id

    unless DRCI.put_away_item?("##{item_id}", @lootbag)
      DRC.bput("put ##{item_id} in ##{sack_id}", 'You put', 'What were you referring to')
      return false
    end
    return false unless DRC.bput("inventory ##{sack_id}", SACK_EMPTY, SACK_NOT_EMPTY).match?(SACK_EMPTY)

    return false unless DRCI.dispose_trash("##{sack_id}", @worn_trashcan, @worn_trashcan_verb)

    true
  end

  # Gets the item by noun from the sack with that id, retrying once when
  # another script is holding the free hand.
  #
  # @param noun [String]
  # @param sack_id [String]
  # @return [String, nil] the id of the item now in hand, or nil
  def take_from_sack(noun, sack_id)
    2.times do |attempt|
      case DRC.bput("get #{noun} from ##{sack_id}", UNPACK_GET_SUCCESS, UNPACK_NEED_FREE_HAND, *UNPACK_GET_FAILURES)
      when UNPACK_GET_SUCCESS
        return held_id(noun, except: sack_id)
      when UNPACK_NEED_FREE_HAND
        break if attempt.positive?

        wait_for_free_hand
      else
        break
      end
    end
    nil
  end

  # @param noun [String]
  # @param except [String, nil] an id to skip (the sack, while it is held)
  # @return [String, nil] the id of a held item with this noun
  def held_id(noun, except: nil)
    [GameObj.right_hand, GameObj.left_hand]
      .find { |obj| obj&.noun == noun && obj.id && obj.id != except }
      &.id
  end

  # Waits (bounded) until a hand is free.
  # @return [void]
  def wait_for_free_hand
    deadline = Time.now + UNPACK_FREE_HAND_WAIT
    pause 1 while DRC.left_hand && DRC.right_hand && Time.now < deadline
  end

  # Sack history for ;taskmaster loot_history. UserVars persists, so the list
  # is capped; a character running tasks all event would otherwise add
  # thousands of entries a month.
  LOOT_HISTORY_LIMIT = 100

  # Adds the sack's contents to this taskmaster's history.
  #
  # @param contents [String] the sack's contents
  # @note UserVars.taskmaster_sacks persists across runs.
  # @return [void]
  def remember_sack(contents)
    UserVars.taskmaster_sacks ||= {}
    history = (UserVars.taskmaster_sacks[@npc] ||= [])
    history << contents
    history.shift(history.size - LOOT_HISTORY_LIMIT) if history.size > LOOT_HISTORY_LIMIT
  end
end

before_dying do
  TaskMaster.restore_hometown
  Flags.delete("wrap-up")
  Flags.delete("thieving-fog")
  Flags.delete(TaskMaster::ENCHANTED_FLAG)
end

TaskMaster.new.run
