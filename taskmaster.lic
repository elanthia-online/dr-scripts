=begin
  YAML SETTINGS(all optional but the first)
  task_loot_bag: bagname
  task_no_repair: true/false # skip repairing tools entirely
  task_self_repair: true/false # use own brush and oil for repairs
  task_get_tools_on_completion: true/false # If you want taskmaster to pickup any remaining tools in the repair shop. Useful if you're using clerk-tools after each task
  task_use_boost: true/false # use boost to eliminate task cooldowns, useful if you have a few and you're doing a lot of tasks
  task_cooldown_poll: 15 # seconds between asks while the taskmaster makes you wait (minimum 3)
  task_boosts: [task, haste] # boosts to use. task: BOOST TASK when a task is on cooldown (same as task_use_boost). haste: keep BOOST HASTE (1 hour, roundtimes -1 second) running between tasks
  task_keep_list: list of items to keep. See default in base.yaml
  task_junk_list: list of items to throw away; everything else is kept. When set (non-empty) it replaces task_keep_list, so a prize nobody has listed yet is kept rather than binned
  task_slack_keepers: true/false # send a Slack message (slack_username) for each keeper
  task_unpack_keepers: true/false # put a keeper's item (not its sack) in task_loot_bag and bin the empty sack
  task_bin_leftover_stock: true/false # after each Zasele task is handed in, bin her leftover stock and offcuts from the crafting bag into worn_trashcan (needs worn_trashcan; not in marathon, which carries its stock between tasks)
  task_bin_metal_from: <container> # before the first metal task (Poltu, Bradyn) of a run, bin every bronze and steel ingot in this container: a one-time sweep of leftover task metal that forge used to leave in the stow container. Bins your own ingots there too; unset it once it says none are left (until then it tries again before each metal task). Ignored when it may be crafting_container: the same worn container, or a noun the same as its noun or shortened from it
  task_crafting_room: <room number> # Room to craft in. Ensure it meets specifications for tooling required...
  task_before_scripts: ['restock'] # scripts (with any arguments) to run before asking for each task, while the previous task's cooldown runs
  task_copper_floor: 20000 # before each task, if you carry less copper (Kronars) than this, exchange foreign coins and withdraw up to task_copper_target
  task_copper_target: 110000
  task_hometown: Crossing # town other scripts (sew, restock) treat as your hometown while a task runs; unset leaves hometown alone
  task_rock_room: 793 # room where Dorhum's spongestone and splashstone tasks forage rocks (none can be had on Andreshlew)
  task_shell_room: 793 # room where Dorhum's glow shell tasks forage shells
  task_cancel_foreign_tasks: true/false # a run never works another taskmaster's task; with this it cancels one it finds open, waits out the 10-minute cooldown a cancel brings, then goes back to its own taskmaster. Off: it stops, saying whose task it is and how to finish or cancel it
  alchemy_tools: [bowl, mixing stick, mortar, pestle, sieve] # Nezhiri's tasks use the mortar and pestle or the bowl and mixing stick (whichever her remedy needs) and the sieve; the two used go to Rangu after each task (task_no_repair / task_self_repair as usual)
  alchemy_belt: # the toolbelt the alchemy tools are tied to, if any
  alchemy_room: <room number> # Nezhiri's remedies are crafted here; unset, in the Crossing alchemy supplies (8862), where the herbs are bought
  ## Nezhiri's tasks: taskmaster buys brewer's brine on Andreshlew (room 51102), then in Crossing the herbs (one 25-piece stack per craft), a coal nugget when the ones carried have too few rubs left for the crafts (TAP shows the size: tiny lasts one craft, small two, and so on), and water and alcohol when none is on hand, so remedy never shops elsewhere. task_hometown is not needed for her. crafting_container holds the brine, the herbs and her remedies: doses left from earlier tasks count toward the next, every stack is combined into one, and the hand-in cuts it to the doses she asked for, putting the rest back. It plans one craft per 6 doses still owed, but a craft can make fewer, and how many has differed between characters (the cause is unknown): so it remembers, for each remedy, the fewest doses one craft made the last time you crafted it (UserVars.taskmaster_remedy_yields, kept per character across runs; each run whose crafts add doses replaces it, and a finish counts as such a run), and plans the next task's crafts at that many doses each, never more than 6. Crafting stops once the doses owed are made, so crafts planned for a yield since outgrown are not made: the herbs, brine and coal bought for them stay in crafting_container and the next task's purchases count them. Extra doses made are not lost either: they stay in crafting_container and count toward the next task. When the crafts planned fall short it makes enough more crafts for the doses still owed, counting each at the fewest doses one craft made this run (never more than 6), buying their supplies first, up to 2 such rounds. To forget the remembered yields, ;e UserVars.taskmaster_remedy_yields = nil. It stops when a round adds no doses, or when the instruction sets carried (all of them, read again) have too few uses left for the extra crafts (ask Nezhiri for another copy, then ;taskmaster nezhiri finish); still short after that, it stops and ;taskmaster nezhiri finish makes the rest. Keep no other item with the remedy's noun (another potion, say) in crafting_container: a task stops before buying anything if it finds one. A remedy run that stops part way (or a crash) leaves the mortar or bowl in hand: a run or a finish looks in it, and carries an unfinished remedy on once with remedy's continue form (buying brine or a coal nugget first when none is left, then crafting where it crafts), takes a finished one out as a made stack, puts a herb back in crafting_container, and puts an empty vessel away; anything else, or a continue run that again ends without the remedy, stops with the vessel in hand. A vessel left on the ground is not looked for. remedy.lic must handle the brine prompt (with a remedy that does not, each craft stops part way, the continue run stops at the same prompt, and the task stops) ##
  enchanting_room: <room number> # Dorhum's tasks enchant in task_crafting_room, else here; with neither, where they stand if you carry a brazier, else at a Crossing brazier room. Outside tasks, enchanting uses enchanting_room as before
  ## Dorhum's tasks need task_loot_bag set to a container other than crafting_container: his finished items keep the base item's noun (a spongestone is still a rock) and wait there apart from the unworked ones. A task stops before buying anything if task_loot_bag already holds that noun, since the hand-in would give those first ##
  ## For Dorhum's tasks make task_crafting_room a room of your own (a private forge): each finished item is picked up off the floor by its noun, so another rock or shell lying there could be taken instead. A rented room's notice is read before enchanting and the rental renewed when under ten minutes are left ##
  crafting_items_in_container: ['oil', 'glue'] # list of items you might have duplicates of in other bags, but which you only want drawn from crafting bag
  crafting_container: bagname
   ## Important: set default stow to the same bag as your crafting bag (tools are still stowed that way when task_no_repair is set, and so is anything else in hand when the task instructions are read) ##
=end

class TaskMaster
  # Printed (bold) each time taskmaster starts, so a log shows which copy ran.
  VERSION = '2026.11.10.6'

  # Stock base => [stock name, room to order it in]. restock tops up cloth,
  # leather, yarn and thread for marathon runs; thread is the cotton spool
  # (stock-name cotton in base-crafting.yaml).
  STACKMAP = {
    'leather' => ['rat', 16667], 'cloth' => ['burlap', 16667], 'stack' => ['deer', 8864], 'ingot' => ['bronze', 8775],
    'stone' => ['alabaster', 8864], 'yarn' => ['wool', 16667], 'lumber' => ['balsa', 8864], 'thread' => ['cotton', 16667]
  }.freeze

  # Search rooms for the taskmasters, in the order find_npc walks them.
  ROOMS = [16_145, 16_146, 16_148, 16_150, 16_153, 16_154, 16_147, 16_276, 16_277, 16_278, 16_290, 16_291, 16_292, 16_293, 16_295, 16_296, 16_294, 16_159, 16_161, 16_166, 16_169].freeze

  # Tools each taskmaster's tasks need, for ;taskmaster <npc> tools.
  TOOLS = {
    'poltu'   => ['forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'bradyn'  => ['bone saw', 'chisels', 'wood shaper', 'rasp', 'carving knife', 'drawknife', 'forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'zasele'  => ['knitting needles', 'sewing needles', 'awl', 'slickstone', 'yardstick', 'scissors'],
    'dorhum'  => ['brazier', 'burin', 'augmenting loop', 'mana fount', 'imbuement rod (or the Imbue spell)'],
    'nezhiri' => ['mortar', 'pestle', 'bowl', 'mixing stick', 'sieve'],
    'shaping' => ['wood shaper', 'rasp', 'carving knife', 'drawknife']
  }.freeze

  # Arguments for parse_args: the npc and finish/find/tools/repeat, or one
  # of the other modes.
  ARG_DEFINITIONS = [
    [
      { name: 'npc', options: %w[poltu bradyn zasele dorhum nezhiri], variable: true, description: "Task npc's name, in full" },
      { name: 'finish', regex: /^finish/, optional: true, description: 'Finishes a task you\'re already on' },
      { name: 'find', regex: /^find/i, optional: true, description: 'Seeks out the taskmaster, then exits' },
      { name: 'tools', regex: /^tools/i, optional: true, description: 'Spits out a list of the tools you need for a given npc\'s tasks' },
      { name: 'repeat', regex: /^repeat/i, optional: true, description: 'Repeat tasks for a given taskmaster (one already open is finished first, then it asks for the next)' }
    ],
    [
      { name: 'reset_output', regex: /^reset_output/i, optional: true, description: 'Clears prize window' },
      { name: 'pickup', regex: /^pickup/i, optional: true, description: 'Picks up any tools left at Rangu for repair' },
      { name: 'cycle', regex: /^cycle/i, optional: true, description: 'Cycles through each taskmaster randomly and completes their task' },
      { name: 'marathon', regex: /^marathon/i, optional: true, description: 'stocks up and runs zasele tasks, repairs during restock' },
      { name: 'loot_history', regex: /^loot_history/i, optional: true, description: 'Prints out saved sack contents history, potentially scrollish' },
      { name: 'script_summary', optional: true, description: 'Completes Hollows Eve tasks for the crafting taskmasters on the island' }
    ]
  ].freeze

  # Reads the settings and sets up state. Does not parse arguments or send
  # anything to the game -- call {#run} to start.
  #
  # @note Adds the "wrap-up" flag (the taskmaster's "Finish your tasks."
  #   call) and seeds UserVars.taskmaster_sacks, which persists across runs.
  # @return [void]
  def initialize
    @settings = get_settings
    @rooms = ROOMS
    configure_loot_filter
    @bag = @settings.crafting_container
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb
    @bin_leftover_stock = @settings.task_bin_leftover_stock
    @bag_items = @settings.crafting_items_in_container
    @lootbag = @settings.task_loot_bag || 'backpack'
    @gem = @settings.gem_pouch_adjective
    @cube = @settings.cube_armor_piece
    @no_repair = @settings.task_no_repair
    @anvil_town = @settings.crafting_hometown || "Crossing"
    @self_repair = @settings.task_self_repair
    @pickup_tools = @settings.task_get_tools_on_completion
    configure_boosts
    @crafting_room = @settings.task_crafting_room
    @cooldown_poll = cooldown_poll_seconds
    configure_copper
    @before_scripts = Array(@settings.task_before_scripts)
    @task_hometown = @settings.task_hometown
    @rock_room = @settings.task_rock_room || DEFAULT_ROCK_ROOM
    @shell_room = @settings.task_shell_room || DEFAULT_SHELL_ROOM
    @cancel_foreign_tasks = @settings.task_cancel_foreign_tasks

    @stockdata = get_data('crafting')['stock']
    @stackmap = STACKMAP
    Flags.add("wrap-up", /^You say, "Finish your tasks."/)
    UserVars.taskmaster_sacks ||= { 'zasele' => [], 'bradyn' => [], 'poltu' => [], 'dorhum' => [], 'nezhiri' => [] }
  end

  # Makes task_hometown the hometown every script in this session sees
  # (sew, restock, ...) while taskmaster runs, through dependency's
  # shift_hometown, which lich-5 applies to hometown in get_settings. The
  # town is resolved to its canonical name with DRC.get_town_name, so
  # 'cross' or 'crossing' become 'Crossing'; lich-5's hometown lookups are
  # case-sensitive on the canonical names. A name that matches no town is
  # reported and hometown is left alone. The previous override, if another
  # script set one, is kept so that restore_hometown can put it back when
  # taskmaster stops. Does nothing when task_hometown is unset.
  #
  # @return [void]
  # @note $HOMETOWN is global to the Lich session, so background scripts
  #   that read settings while a task runs see the same town.
  def shift_to_task_hometown
    name = @task_hometown.to_s.strip
    return if name.empty?

    town = DRC.get_town_name(name)
    unless town
      DRC.message("task_hometown '#{name}' does not match any town; leaving your hometown alone. Use a town name such as Crossing.")
      return
    end

    TaskMaster.saved_hometown = { value: $HOMETOWN, town: town }
    shift_hometown(town)
  end

  class << self
    # The hometown override in place before shift_to_task_hometown (:value),
    # and the town taskmaster set (:town), wrapped in a Hash so a nil
    # override can be told apart from "nothing saved".
    #
    # @return [Hash{Symbol => String, nil}, nil]
    attr_accessor :saved_hometown

    # Puts back the hometown override taskmaster replaced, from before_dying,
    # which also runs on exit and when the script is killed. If something
    # else changed the override while taskmaster ran, that change is left in
    # place rather than overwritten.
    #
    # @return [void]
    def restore_hometown
      return unless saved_hometown

      if $HOMETOWN == saved_hometown[:town]
        previous = saved_hometown[:value]
        previous ? shift_hometown(previous) : clear_hometown
      end
      self.saved_hometown = nil
    end
  end

  # Runs the mode the arguments ask for. The one-shot modes exit; cycle and
  # the plain modes go on to the task loop.
  #
  # @param args [OpenStruct] parsed arguments (npc, finish, find, tools,
  #   repeat, reset_output, pickup, cycle, marathon, loot_history)
  # @return [void]
  # @raise [SystemExit] after the one-shot modes, marathon, and finish (which
  #   goes on to run_tasks instead when it cancelled another taskmaster's
  #   task), or from run_tasks
  def run(args = parse_args(ARG_DEFINITIONS))
    DRC.message("taskmaster version #{VERSION}")
    shift_to_task_hometown
    @npc = args.npc
    @marathon = args.marathon
    if args.find
      find_npc(@rooms, @npc)
      exit
    elsif args.tools
      list_tools
    elsif args.finish
      finish_task_in_progress
    elsif args.reset_output
      _respond("<clearStream id='Task Master'/>")
      exit
    elsif args.cycle
      @npc = ['poltu', 'bradyn', 'zasele'].sample
    elsif args.loot_history
      print_loot_history
    elsif args.pickup
      tool_pickup if DRCI.exists?("rangu ticket")
      exit
    elsif @marathon
      run_marathon
    end

    run_tasks(args)
  end

  # Lists the tools the named taskmaster's tasks need, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def list_tools
    DRC.message("Tools required:")
    TOOLS[@npc.downcase].each do |tool|
      DRC.message("#{tool}")
    end
    exit
  end

  # Prints the saved sack history for each taskmaster, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def print_loot_history
    ['poltu', 'bradyn', 'zasele', 'dorhum', 'nezhiri'].each do |npc|
      DRC.message("Sack history for Taskmaster #{npc.capitalize}:")
      Array(UserVars.taskmaster_sacks[npc]).each do |sack|
        DRC.message(sack)
      end
    end
    exit
  end

  # resume_task exits once the task is handed in, with or without repeat. When
  # the task was another taskmaster's and had to be cancelled, this returns
  # and the run carries on asking its own taskmaster for a task.
  #
  # @return [void]
  # @raise [SystemExit] from resume_task
  def finish_task_in_progress
    reconcile_hands
    catch(FOREIGN_TASK_CANCELLED) { resume_task }
  end

  # Copper, haste and the before scripts, run ahead of asking for each task.
  #
  # @return [void]
  def prepare_for_task
    top_up_copper
    refresh_haste
    run_before_scripts
  end

  # One task, or with repeat or cycle one after another until the wrap-up
  # call. cycle picks a new taskmaster after each task. A task already open
  # when it asks is finished by get_task (resume_task); with repeat or cycle
  # that counts as the iteration's task, and the loop goes on to its usual
  # checks and asks again, where a single task run ends there.
  #
  # @param args [OpenStruct] parsed arguments; reads cycle and repeat
  # @return [void]
  # @raise [SystemExit] from get_task: in any mode when resume_task stops
  #   (not on a task, another taskmaster's task, a worker or hand-in stop),
  #   and without repeat or cycle once the task in progress is handed in;
  #   or from complete_task (nothing left to hand in, or the taskmaster
  #   can't be found)
  def run_tasks(args)
    reconcile_hands
    looping = args.repeat || args.cycle ? true : false
    loop do
      @dispose, @remainder = [false, false]
      prepare_for_task
      # nil: a task already open was finished and handed in by get_task.
      task = get_task(exit_after_resume: !looping)
      if task
        item, count, volume_per_item, base, type = task
        tool_pickup if !@self_repair && DRCI.exists?("rangu ticket") # picks up any tools that you dropped off previous and stows them appropriately
        send(@npc.to_sym, item, count, volume_per_item, base, type)
        complete_task(item, count)
      end
      break if Flags['wrap-up']

      if args.cycle
        @npc = ['poltu', 'bradyn', 'zasele'].sample
        next
      end
      break unless args.repeat
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket") # if indicated, and you have tickets, picks up any tools you may have dropped off previously, all disciplines
  end

  # Zasele tasks until the wrap-up call, restocking (and repairing) only when
  # the stock runs short, then exits. A task already open when it asks is
  # finished by get_task (resume_task, which works it from the carried stock
  # with marathon_tailor too), and the loop then goes on to the wrap-up
  # check and asks again.
  #
  # @return [void]
  # @raise [SystemExit] after the wrap-up call; or from get_task when
  #   resume_task stops (not on a task, another taskmaster's task, a worker
  #   or hand-in stop) or from complete_task
  def run_marathon
    @npc = 'zasele'
    reconcile_hands
    restock
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    loop do
      prepare_for_task
      # nil: a task already open was finished and handed in by get_task.
      task = get_task(exit_after_resume: false)
      if task
        item, count, volume_per_item, base, type = task
        marathon_tailor(item, count, volume_per_item, base, type)
        complete_task(item, count)
      end
      break if Flags['wrap-up']
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket")
    exit
  end

  # Works one of Zasele's tasks in marathon, from the stock restock carries
  # from task to task: restocks (and repairs) first only when it runs short.
  # Unlike the zasele worker it buys no stock for the task and bins nothing
  # after it, since the leftover is the carried stack the next task uses.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] yards per item
  # @param base [String] stock base: 'cloth', 'leather' or 'yarn'
  # @param type [String] stock name, e.g. 'burlap'
  # @return [void]
  def marathon_tailor(item, count, volume_per_item, base, type)
    unless check_stock(count * volume_per_item, type, base)
      repair(@settings.outfitting_tools, @settings.outfitting_belt) unless @no_repair
      restock
      tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
      find_npc(@rooms, @npc)
    end
    tailor_item(item, count, base, type)
  end

  # Cleans up what a crash or disconnect left in hand before starting: a
  # reward sack is sorted, and an unfinished tailoring item made from the
  # stock taskmaster buys for Zasele is finished where the character stands
  # (sewing works in any room) with sew's resume mode, then put in the
  # crafting bag for the turn-in. Any other unfinished item is the player's
  # and is left alone. Knitting is not resumed: the work sits on the needles
  # and does not show in the hand.
  #
  # The hand text never says which: the game shows a "coil of unfinished
  # burlap reinforced rope" in hand as "reinforced rope", without
  # "unfinished" or the stock (glanced_hands). So the full names come from
  # one GLANCE, and the piece is resumed by its GameObj noun and then
  # judged, binned or bagged by its id; a finished piece the bag will not
  # take stays in hand, with a message. When GLANCE gives no full name for
  # a held item, or one that does not match what GameObj shows in that
  # hand, the hands are left alone, with a message.
  #
  # @return [void]
  def reconcile_hands
    waitrt?
    DRC.fix_standing
    sort_sack(nil) if held_objects.any? { |obj| obj.name == REWARD_SACK_NAME }
    return unless @npc == 'zasele'

    held = hands_in_full
    return unless held

    unfinished = held.select { |_, name| name.match?(/\bunfinished\b/) }
    piece, = unfinished.find { |_, name| task_piece?(name) }
    unfinished.each do |obj, name|
      DRC.message("Leaving your #{name} alone: taskmaster only finishes the burlap, rat-pelt and wool pieces from its own tasks.") unless obj.equal?(piece)
    end
    return unless piece

    id = piece.id
    DRC.wait_for_script_to_complete('sew', ['resume', piece.noun])
    # Judge the result by the piece's own id: the finished item keeps it.
    # sew may have put it away, when no hand holds that id any more.
    held = hands_in_full
    return unless held

    _, name = held.find { |obj, _| obj.id == id }
    return unless name

    if task_piece?(name)
      discard_unfinished(id, name)
    elsif !DRCI.put_away_item?("##{id}", @bag)
      DRC.message("Your #{@bag} would not take your finished #{name}, so it is still in your hands. Put it in your #{@bag} for the turn-in.")
    end
  end

  # What each hand holds, by GameObj (id, noun) and by its full name from
  # GLANCE (glanced_hands). A held item counts only when it has an id and a
  # noun, and the full name GLANCE gave for its hand holds that noun
  # (names_noun?), so a hand that changed between the two is not taken for
  # the other. With both hands empty no GLANCE is sent.
  #
  # @return [Array<Array(Object, String)>, nil] [GameObj, full name] for
  #   each held item, right first (empty when nothing is held); nil, with a
  #   message, when any held item could not be read that way (the hands are
  #   then left alone)
  def hands_in_full
    return [] if held_objects.empty?

    glanced = glanced_hands
    return unread_hands(nil) unless glanced

    held = []
    { right: GameObj.right_hand, left: GameObj.left_hand }.each do |hand, obj|
      obj = nil if obj && obj.name.to_s == 'Empty'
      name = glanced[hand]
      next if obj.nil? && name.nil?
      return unread_hands(obj&.name || name) unless obj&.id && obj.noun && names_noun?(name, obj.noun)

      held << [obj, name]
    end
    held
  end

  # Whether a full name holds a noun as whole words, in order: "aged ball
  # and chain" holds the game's noun "ball and chain", and "coil of
  # unfinished burlap reinforced rope" holds "rope". Where in the name the
  # noun stands is not read.
  #
  # @param name [String, nil] an item's full name
  # @param noun [String] the game's noun for it (GameObj)
  # @return [Boolean] false for a nil name or an empty noun
  def names_noun?(name, noun)
    noun_words = name_words(noun)
    !noun_words.empty? && name_words(name).each_cons(noun_words.size).include?(noun_words)
  end

  # Says the hands are left alone, as hands_in_full could not read them.
  #
  # @param what [String, nil] what a hand holds, if known
  # @return [nil]
  def unread_hands(what)
    DRC.message("Could not tell whether #{what ? "the #{what} in your hands" : 'what you hold'} is an unfinished task piece (GLANCE did not name it, or named something else), so your hands are left alone.")
    nil
  end

  # The reply GLANCE gives about the hands, naming each held item in full:
  # "You glance down to see a light pernach with a tempered head in your
  # right hand and nothing in your left hand.", "You glance down to see a
  # firestained kuwinite codex gilded with Gorbesh iconography in your left
  # hand." or "You glance down at your empty hands." (2026-09 logs). The
  # hand text GameObj and DRC.right_hand give is far shorter: the
  # game's own short form ("reinforced rope"), which lich-5's DRC.right_hand
  # cuts further to its first and last word.
  HANDS_GLANCED = /^You glance down (?:to see .* in your (?:right|left) hand|at your empty hands)\.$/

  # The full name of what each hand holds, from one GLANCE, article
  # dropped. GLANCE only looks: TAP would name a held item too, but it
  # activates some, as wand-watcher's default "activate verb" shows.
  #
  # @return [Hash{Symbol => String, nil}, nil] :right and :left, nil for an
  #   empty hand; nil when GLANCE gave none of its replies
  def glanced_hands
    reply = DRC.bput('glance', HANDS_GLANCED, /^You glance down .*/)
    return nil unless reply.match?(HANDS_GLANCED)

    seen = reply[/\AYou glance down to see (.*) in your (?:right|left) hand\.\z/, 1]
    hands = { right: nil, left: nil }
    return hands unless seen

    if reply.match?(/ in your right hand and .* in your left hand\.\z/)
      hands[:right], hands[:left] = seen.split(' in your right hand and ', 2)
    else
      hands[reply.match?(/ in your right hand\.\z/) ? :right : :left] = seen
    end
    hands.transform_values { |name| name == 'nothing' ? nil : name&.sub(/\A(?:a|an|some|the)\s+/i, '') }
  end

  # An unfinished piece of the cloth, leather or yarn taskmaster buys for
  # Zasele's tasks (burlap, rat-pelt, wool).
  #
  # @param name [String] a held item's full name, e.g. "coil of unfinished
  #   burlap reinforced rope" (glanced_hands; the hand text lacks both words)
  # @return [Boolean]
  def task_piece?(name)
    materials = @stackmap.values_at('cloth', 'leather', 'yarn').map(&:first)
    name.match?(/\bunfinished\b/) && name.match?(/\b(?:#{Regexp.union(materials)})\b/)
  end

  # sew could not finish the piece. Throws it away by its id so it never
  # reaches the crafting bag, where the turn-in would pick it up, and stows
  # whatever else sew left in hand (a tool) so the next task starts with
  # free hands. The id is checked to be in a hand first, since lich-5's
  # dispose_trash would GET an item it does not hold. Not exiting: the next
  # start would try the same resume and stop again.
  #
  # @param id [String] the unfinished piece's id
  # @param name [String] its full name, for the message
  # @return [void]
  def discard_unfinished(id, name)
    return unless hand_ids.include?(id)

    DRC.message("sew could not finish your #{name}. Throwing it away and starting a new task.")
    DRCI.dispose_trash("##{id}", @worn_trashcan, @worn_trashcan_verb)
    held_objects.reject { |obj| obj.id == id }.each do |obj|
      DRCC.stow_crafting_item(obj.name, @bag, @settings.outfitting_belt)
    end
  end

  # What GameObj shows in either hand, right first, empty hands left out.
  #
  # @return [Array<Object>] the hands' GameObjs (name, noun, id)
  def held_objects
    [GameObj.right_hand, GameObj.left_hand].compact.reject { |obj| obj.name.to_s == 'Empty' }
  end

  # A new task is offered about 30 seconds after a turn-in, so the poll
  # interval decides how much of each wait is lost past that point.
  MIN_COOLDOWN_POLL = 3

  # Seconds between asks while the taskmaster makes you wait:
  # task_cooldown_poll, 15 by default, never below MIN_COOLDOWN_POLL.
  #
  # @return [Integer]
  def cooldown_poll_seconds
    [(@settings.task_cooldown_poll || 15).to_i, MIN_COOLDOWN_POLL].max
  end

  # Runs each task_before_scripts entry ("script arg arg") to completion. They
  # run before asking for a task, so they overlap the taskmaster's cooldown
  # after the previous turn-in instead of adding to the task.
  #
  # @return [void]
  def run_before_scripts
    @before_scripts.each do |entry|
      name, *script_args = entry.to_s.split
      next unless name

      DRC.wait_for_script_to_complete(name, script_args)
    end
  end

  # Either a keep list (keep matches, bin the rest) or a junk list (bin
  # matches, keep the rest). Entries may be strings or regexps. A missing or
  # empty junk list falls back to the keep list; a missing keep list keeps
  # nothing, as before.
  #
  # @return [void]
  def configure_loot_filter
    junk = Array(@settings.task_junk_list)
    if junk.empty?
      @junk_regex = nil
      @keeplist_regex = Regexp.union(Array(@settings.task_keep_list))
    else
      @junk_regex = Regexp.union(junk)
    end
    @slack_keepers = @settings.task_slack_keepers
    register_slackbot(@settings.slack_username) if @slack_keepers
    @unpack_keepers = @settings.task_unpack_keepers
  end

  # An empty look is never a keeper. sort_sack never asks about one: it bins
  # a sack LOOK shows empty, keeps one whose LOOK it could not read, and only
  # sorts a sack it holds, so neither an empty nor a missing sack can fill
  # the loot bag in junk-list mode.
  #
  # @param contents [String, nil] the LOOK IN reply for the reward sack
  # @return [Boolean] true to keep the sack
  def keeper?(contents)
    return false if contents.to_s.strip.empty?
    return !contents.match?(@junk_regex) if @junk_regex

    contents.match?(@keeplist_regex)
  end

  # How long one Minor Haste boost lasts.
  HASTE_SECONDS = 3600
  # How long to wait before asking again after an answer that was neither an
  # activation nor a lack of credits, or no answer at all.
  # November 2025 logs (Hollow Eve, 21 characters, ~49,000 BOOST HASTE sends)
  # only ever show those two replies (besides "...wait" in roundtime). Each activation spent exactly one credit
  # (BOOST listings before and after agree). With haste running and no credits
  # left, the game gives the no-credits line, not an "already active" one.
  # BOOST HASTE with haste running and credits left never happened, so whether
  # it restarts the hour and spends a credit is unknown; the stored expiry
  # keeps that to at most one credit when the expiry is lost.
  HASTE_RECHECK_SECONDS = 600
  # BOOST HASTE reply when a credit was spent.
  HASTE_ACTIVATED = /You've activated the Minor Haste boost/
  # BOOST HASTE reply with no credits left.
  HASTE_NO_CREDITS = /You don't have enough credits for the Minor Haste boost/

  # Reads task_boosts (and the older task_use_boost, which means the task
  # boost) into @boosts, and arms the one task boost per run in @boost.
  #
  # @return [void]
  def configure_boosts
    @boosts = Array(@settings.task_boosts).map { |boost| boost.to_s.downcase }
    @boosts |= ['task'] if @settings.task_use_boost
    @boost = @boosts.include?('task')
  end

  # Keeps BOOST HASTE running. Its expiry is kept in UserVars because t2 can
  # start this script once per task, so the hour outlives any single run.
  # Out of credits costs one command per task and picks up new credits by
  # itself.
  #
  # @note The expiry lives in UserVars.taskmaster_haste_expires, which
  #   persists across runs, since t2 relaunches this script for each task.
  # @return [void]
  def refresh_haste
    return unless @boosts.include?('haste')
    return if Time.now.to_i < UserVars.taskmaster_haste_expires.to_i

    case DRC.bput('boost haste', HASTE_ACTIVATED, HASTE_NO_CREDITS, /Minor Haste/)
    when HASTE_ACTIVATED
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_SECONDS
    when HASTE_NO_CREDITS
      nil
    else
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_RECHECK_SECONDS
    end
  end

  # Reads task_copper_floor (20000 by default) and task_copper_target
  # (110000 by default, never below the floor).
  #
  # @return [void]
  def configure_copper
    @copper_floor = @settings.task_copper_floor || 20_000
    @copper_target = [@settings.task_copper_target || 110_000, @copper_floor].max
  end

  # One WEALTH check per task. Only when below the floor does this walk to the
  # bank, exchanging any foreign coins from reward sacks on the way, and refill
  # to the target, so most tasks need no trip. The per-purchase
  # ensure_copper_on_hand calls stay as a guard for tasks that cost more than
  # the floor; they only walk when short.
  #
  # @return [void]
  def top_up_copper
    return if DRCM.wealth("Crossing") >= @copper_floor

    exchange_coins
    DRCM.ensure_copper_on_hand(@copper_target, @settings, "Crossing")
  end

  # Walks to the Crossing exchange and changes every other currency into
  # Kronars, such as the coins from reward sacks.
  #
  # @return [void]
  def exchange_coins
    DRCT.walk_to(get_data('town')["Crossing"]['exchange']['id'])
    DRC.release_invisibility
    exchange_to = get_data('town')["Crossing"]['currency']
    $CURRENCIES
      .reject { |currency| currency =~ /#{exchange_to}/i }
      .each { |currency| fput("exchange all #{currency} for #{exchange_to}") }
  end

  # Marathon restock: tops up burlap cloth and rat leather to 100 yards, and
  # wool yarn and cotton thread to 400, plus pins, paying from the copper
  # float.
  #
  # @return [void]
  def restock
    info = get_data('crafting')['tailoring']["Crossing"]
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, nil, 40)
    need = {}
    cost = 0
    ['cloth', 'leather'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (100 - current) / 10)
      else
        need.store(stock, 10)
      end
      cost += need[stock] * @stockdata[@stackmap[stock].first]['stock-value']
    end
    ['yarn', 'thread'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (400 - current) / 100)
      else
        need.store(stock, 4)
      end
      cost += need[stock] * @stockdata[stock]['stock-value']
    end
    return if cost == 0

    top_up_copper
    DRCM.ensure_copper_on_hand(cost + 8000, @settings, "Crossing")
    ## now we have a hash with stock=># to order, and cash on hand
    need.each do |stock, number|
      next unless number > 0

      DRCT.walk_to(16667)
      DRCC.get_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, @bag_items, nil) if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
      number.times do
        DRCT.order_item(@stackmap[stock].last, (stock == 'yarn' || stock == 'thread') ? @stockdata[stock]['stock-number'] : @stockdata[@stackmap[stock].first]['stock-number'])
        DRC.bput("combine #{stock}", /you (combine|must)/i)
      end
      DRCC.stow_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, nil)
    end
  end

  # Whether the crafting bag holds enough of a stock for a task.
  #
  # @param needed [Integer] yards the task needs
  # @param type [String] stock name, e.g. 'burlap'
  # @param base [String] stock base, e.g. 'cloth'
  # @return [Boolean] false when none is carried or it is short
  def check_stock(needed, type, base)
    return false unless DRCI.exists?("#{type} #{base}")

    /(\d+)/ =~ DRC.bput("count my #{type} #{base}", /^You count out (\d+) yards of material/)
    if Regexp.last_match(1).to_i >= needed
      true
    else
      false
    end
  end

  # Leftover pieces trash throws away at most, so a reply it doesn't expect
  # (full hands, a timeout) can't keep it walking to the bin forever.
  TRASH_CAP = 100

  # Throws away what a task leaves over: with @remainder set, every leftover
  # piece of stock in the crafting bag, or for a metal task only the task's
  # own leftover ingots (see trash_task_ingots).
  #
  # @param item [String] item noun, unused
  # @param base [String] stock base; ingots go to a different bin
  # @param type [String] metal of leftover ingots
  # @return [void]
  def trash(_item, base, type)
    return unless @remainder

    if base == 'ingot'
      trash_task_ingots("#{type} #{base}")
    else
      dispose_leftovers("#{@stackmap[base].first} #{base}", 14886)
    end
  end

  # The ingots of each metal taskmaster buys, as the game names them.
  TASK_METAL_INGOTS = ['bronze ingot', 'steel ingot'].freeze

  # How many ingots of each task metal a container (the crafting bag unless
  # given) holds, from one INVENTORY of it (container_listing; asked twice
  # when it goes unanswered). An ingot goes by its noun (count_listed), so
  # a deed for a bronze ingot is not one. An ingot in a container inside
  # that one is not counted: INVENTORY does not list what such a container
  # holds.
  #
  # @param from [String] the container
  # @return [Hash{String => Integer}, nil] e.g. {'bronze ingot' => 2,
  #   'steel ingot' => 0}; nil when INVENTORY went unanswered twice
  def carried_ingots(from = @bag)
    lines = container_listing(from)
    lines = container_listing(from) if lines.nil?
    return nil if lines.nil?

    TASK_METAL_INGOTS.to_h { |name| [name, count_listed(lines, name)] }
  end

  # Throws away a metal task's own leftover ingots of one metal (see
  # leftover_ingots), then says once a run when ingots of that metal stay in
  # the bag: they were there before the metal was bought, so they count as
  # the player's, and that includes any a stopped run left behind.
  #
  # @param stock [String] e.g. 'bronze ingot'
  # @return [void]
  def trash_task_ingots(stock)
    before = @ingots_before&.fetch(stock, nil)
    now = before && carried_ingots&.fetch(stock, nil)
    binned = dispose_leftovers(stock, 793, leftover_ingots(before, now))
    note_kept_ingots(stock, now - binned) if now
  end

  # How many leftover ingots of a metal are the task's own to throw away:
  # those the bag holds beyond what it held before the metal was bought
  # (the player's own), and never more than the task bought (@ingots_bought),
  # since each ingot bought leaves at most one piece. Without both counts, at
  # most the ingots the task bought. The pieces go newest first, which spares
  # the older ones: the game lists a container's newest item first (551 of 556
  # PUTs in the 2026 logs were listed first by the next RUMMAGE; the other 5
  # merged into a stack), and GET is taken to get the first listed, which no
  # log shows either way.
  #
  # @param before [Integer, nil] ingots of the metal before buying
  # @param now [Integer, nil] ingots of the metal after forging
  # @return [Integer]
  def leftover_ingots(before, now)
    bought = @ingots_bought.to_i
    return bought unless before && now

    (now - before).clamp(0, bought)
  end

  # Says, once a run, how many ingots of a task metal stay in the bag after a
  # metal task. They count as the player's (they were there before the metal
  # was bought), so they are never thrown away, including any a stopped or
  # crashed run left behind; taskmaster can't tell those from the player's.
  #
  # @param stock [String] e.g. 'bronze ingot'
  # @param kept [Integer] how many stay
  # @return [void]
  def note_kept_ingots(stock, kept)
    return if kept <= 0 || @kept_ingots_noted

    @kept_ingots_noted = true
    DRC.message("#{kept} #{stock}#{kept == 1 ? ' stays' : 's stay'} in your #{@bag}. They were there before the task bought its metal, so taskmaster keeps them as yours. If any are leftovers from a run that stopped, throw them away by hand.")
  end

  # Takes each piece of stock out of the crafting bag and disposes of it in
  # the given room by the id of the piece in hand, until the bag has none
  # left, `limit` pieces are gone, or TRASH_CAP pieces are gone. A piece that
  # can't be disposed of goes back in the bag by its id and ends the loop;
  # one that has left both hands went in the bin, whatever the reply.
  #
  # @param stock [String] e.g. 'burlap cloth' or 'bronze ingot'
  # @param room [Integer] room with the bin
  # @param limit [Integer] most pieces to throw away
  # @param from [String] the container, the crafting bag unless given
  # @return [Integer] how many pieces went in the bin
  def dispose_leftovers(stock, room, limit = TRASH_CAP, from: @bag)
    binned = 0
    [limit, TRASH_CAP].min.times do
      ref = take_stock_piece(stock, stock.split.last, from)
      break unless ref.is_a?(String)

      if DRCT.dispose(ref, room) || left_hands?(ref)
        binned += 1
        next
      end

      put_back_stock(ref, stock, from)
      break
    end
    binned
  end

  # With task_bin_metal_from set, throws away every bronze and steel ingot in
  # that container before the first metal task of a run: leftover task metal
  # forge used to leave in the stow container, where nothing else looks for
  # it. It bins the player's own ingots there too, which is why it is a
  # setting to set once and unset. The sweep stops at the first ingot it
  # can't throw away, and counts what is left with INVENTORY: only an empty
  # container ends it for the run (and says to unset the setting); otherwise
  # it says so and tries again before the next metal task. A swept ingot
  # still in hand stops the run before any metal is bought. A container that
  # may be crafting_container (same_container? without adjectives: the same
  # worn container, or, when the two names can't be told apart by the worn
  # containers, a noun that is the same as crafting_container's or shortened
  # from it) is left alone: the task's leftovers there are thrown away after
  # each task.
  #
  # @return [void]
  # @raise [SystemExit] when a swept ingot is still in hand
  def bin_stray_ingots
    container = @settings.task_bin_metal_from.to_s.strip.sub(/\Amy\s+/i, '')
    return if container.empty? || @stray_ingots_binned

    if same_container?(container, @bag, adjectives: false)
      @stray_ingots_binned = true
      DRC.message("task_bin_metal_from (#{container}) may be your crafting_container (#{@bag}), so nothing is swept: the task's leftover metal there is thrown away after each task.")
      return
    end

    held = hand_ids
    binned = 0
    left = nil
    TASK_METAL_INGOTS.each do |stock|
      binned += dispose_leftovers(stock, 793, from: container)
      left = carried_ingots(container)
      break unless left && left[stock].zero? && (hand_ids - held).empty?
    end
    report_sweep(container, binned, left, hand_ids - held)
  end

  # What bin_stray_ingots says at the end, and whether the sweep is done for
  # the run: only when INVENTORY counted no bronze or steel ingot left.
  #
  # @param container [String] the swept container
  # @param binned [Integer] ingots thrown away
  # @param left [Hash{String => Integer}, nil] carried_ingots of the container
  # @param stray [Array<String>] ids newly in hand since the sweep began
  # @return [void]
  # @raise [SystemExit] when stray is not empty
  def report_sweep(container, binned, left, stray)
    swept = "task_bin_metal_from: threw away #{binned} bronze and steel ingot#{binned == 1 ? '' : 's'} from your #{container}"
    unless stray.empty?
      DRC.message("#{swept}, but a swept ingot may still be in your hand (#{stray.map { |id| "##{id}" }.join(', ')}). Stopping before buying any metal.")
      exit
    end

    if left && left.values.sum.zero?
      @stray_ingots_binned = true
      DRC.message("#{swept}; none are left there. Unset it now, or it bins your own ingots there on every run.")
    else
      DRC.message("#{swept}, and could not finish (see above, or check that you carry a #{container}). It tries again before the next metal task.")
    end
  end

  # Works one of Poltu's metal tasks.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def poltu(item, count, volume_per_item, base, type)
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # Works one of Bradyn's tasks: carving stone or bone, shaping wood, or
  # forging metal like Poltu.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer, String] volumes per item, or 'boulder' for stone
  # @param base [String] stock base: 'stone', 'stack', 'lumber' or 'ingot'
  # @param type [String] stock name, e.g. 'alabaster', 'deer', 'balsa' or 'bronze'
  # @return [void]
  def bradyn(item, count, volume_per_item, base, type)
    if base == 'stone'
      buy_rocks(count)
      carve_stone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'stack'
      buy_stackables(item, count, volume_per_item, base)
      carve_bone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'lumber'
      buy_stackables(item, count, volume_per_item, base)
      shape_item(item, count, base, type)
      # base.yaml names the shaping toolset shaping_tools; engineering_tools is the
      # older key, kept as a fallback the same way clerk-tools resolves it.
      repair(@settings.shaping_tools || @settings.engineering_tools || [], @settings.engineering_belt)
      trash(item, base, type)
      return
    end
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # A Poltu or Bradyn metal task: buy the metal, forge the items, send the
  # forging tools for repair and throw away any metal left over. When forging
  # stops short, the metal is thrown away even on a task of whole ingots (one
  # per item, which leaves nothing on a full run): the run hands in what was
  # made and exits, and the next run buys metal for every item still owed,
  # so unused ingots kept now would only pile up in crafting_container. The
  # ingots in crafting_container are counted before buying, so the player's
  # own are not thrown away with the task's (trash_task_ingots), and a short
  # count after a full run (INVENTORY unanswered) throws away nothing: the
  # task's ingots were all used.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def forge_metal_task(item, count, volume_per_item, base, type)
    bin_stray_ingots
    @ingots_before = carried_ingots
    type = buy_metal(count, volume_per_item, type)
    made = forge_item(item, count, type)
    @remainder = true if made.to_i < count
    repair(@settings.forging_tools, @settings.forging_belt)
    trash(item, base, type)
  end

  # Buys the metal for a forging task and returns the metal to forge with.
  # Items of exactly one ingot each need no smelting; anything else gets
  # enough bronze ingots for the whole task, or one steel ingot (10 volumes)
  # when the whole task fits in it (small items, or one item of 6 to 9
  # volumes), and sets @remainder so trash throws away what is left. A task of
  # 50 volumes or less that doesn't fit in one steel ingot gets the 50-volume
  # bronze one: small items used to get one steel ingot whatever the count,
  # which ran out part way, so forge stopped and the next run bought another
  # that ran out the same way.
  #
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param type [String] the task's metal, used for one-ingot-per-item tasks
  # @return [String] the metal to forge with: 'steel' or type
  def buy_metal(count, volume_per_item, type)
    if volume_per_item == 10 # exactly one ingot per item, so no scrap, no smelting
      type = 'steel'
      buy_ingots(count, type)
    elsif volume_per_item == 5 # exactly one bronze ingot per item
      buy_ingots(count, type)
    elsif count * volume_per_item > 100
      @remainder = true
      bingots(3)
    elsif count * volume_per_item > 50
      @remainder = (count * volume_per_item) % 100 > 0 ? true : false
      bingots(2)
    elsif count * volume_per_item <= @stockdata['steel']['stock-volume']
      type = 'steel'
      @remainder = true
      buy_ingots(1, type)
    else # 50 volumes or less in all, more than 5 per item
      @remainder = true
      bingots(1)
    end
    type
  end

  # Works one of Zasele's tasks: knitting yarn, or sewing cloth or leather.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] yards per item
  # @param base [String] stock base: 'cloth', 'leather' or 'yarn'
  # @param type [String] stock name, e.g. 'burlap'
  # @return [void]
  def zasele(item, count, volume_per_item, base, type)
    if base == 'yarn'
      buy_yarn(item, count, volume_per_item, base)
      toolset = ["knitting needles"]
    else
      buy_stackables(item, count, volume_per_item, base)
      toolset = @settings.outfitting_tools
    end
    tailor_item(item, count, base, type)
    repair(toolset, @settings.outfitting_belt)
    # When bin_task_stock will bin the leftover stock after the hand-in,
    # there is no walk to the bin room now.
    trash(item, base, type) unless bins_task_stock?
  end

  # Dorhum's items, keyed by the task item's noun, as far as the Hollow Eve
  # 2026 runs show them. :noun is the noun the finished item is handed in by,
  # which is its base item's: a spongestone is made from "a foraged rock" and
  # is still a rock; a virga wand from "a finished stone, bone or wood wand or
  # rod" and is still the wand it was made from; a splashstone from "a
  # foraged rock" and is still a rock; a glow shell from "a foraged shell"
  # and is still that shell (sea, snail, asarwuden... all with the noun
  # shell). All four were handed in by these nouns in live runs (2026-11-03
  # and 2026-11-04). Spongestones and splashstones are both rocks, which is
  # why a task stops when task_loot_bag already holds its noun
  # (check_loot_bag_clear). :base is the method that gets the base items.
  # Any other item pauses the script.
  DORHUM_ITEMS = {
    'spongestone' => { noun: 'rock', base: :forage_rocks },
    'splashstone' => { noun: 'rock', base: :forage_rocks },
    'wand'        => { noun: 'wand', base: :buy_wands },
    'shell'       => { noun: 'shell', base: :forage_shells }
  }.freeze

  # Where Dorhum's rock tasks (spongestones, splashstones) forage rocks unless task_rock_room says
  # otherwise: The Crossing, Town Green Southeast, where FORAGE ROCK finds one
  # rock a time ("You manage to find a rock."). On Andreshlew FORAGE gets "You
  # survey the area and realize that any foraging efforts would be futile."
  DEFAULT_ROCK_ROOM = 793
  # Where Dorhum's glow shell tasks forage shells unless task_shell_room says
  # otherwise: FORAGE SHELL finds shells at The Crossing, Town Green
  # Southeast, as FORAGE ROCK finds rocks there (tested in game, 2026-11-03),
  # though the map tags only Cape of Storms, Path (712, 713) for shells.
  DEFAULT_SHELL_ROOM = 793
  # The wand on the steel crate in the Crossing enchanting supplies, 125
  # Kronars. TAP calls it "a redwood wand", but the game knows it only as a
  # wand: "buy redwood wand" gets "You can't order anything here." and
  # "tap my redwood wand" finds nothing, while "buy wand" gets "You decide to
  # purchase the wand, and pay the sales clerk 125 Kronars." (2026-11-03).
  SUPPLIES_WAND = 'wand'
  # A sigil on Dorhum's instructions and how many each item takes:
  # "(1) primary sigil (congruence)". The plural is accepted, though only
  # (1) has been seen.
  INSTRUCTION_SIGIL = /\((?<count>\d+)\) (?:primary|secondary) sigils? \((?<sigil>[\w-]+)\)/
  # The game's lines when an enchant is finished, caught by a Flag to tell a
  # finished item in hand from an unworked one enchant left there when it
  # stopped. enchant.lic's enchant-complete flag takes these three and also
  # "You collect the <item> and place it at your feet", left out here because
  # it matches the fount's line too. Every item in the Dorhum runs ended with
  # the first.
  ENCHANTED_FLAG = 'taskmaster-enchanted'
  # The completion lines ENCHANTED_FLAG catches.
  ENCHANTED = Regexp.union(
    /^(?:<[^>]*>|[^"<])*?With the enchanting process completed, you believe it is safe to collect your things once more/,
    /^(?:<[^>]*>|[^"<])*?With the enchantment complete/i,
    /^(?:<[^>]*>|[^"<])*?With enchanting complete/i
  )

  # Works one of Dorhum's enchanting tasks: buys the sigil-scrolls, makes
  # sure the fount has a use for every item, gets the base items, then enchants
  # each item with enchant's instructions mode and puts it in task_loot_bag
  # for the hand-in, and finally deals with the enchanting tools.
  #
  # @param item [String] the task item's noun, e.g. 'spongestone'
  # @param count [Integer] how many to make
  # @param sigils [Array<String>] the instructions' sigils, one entry per
  #   sigil used on each item
  # @return [void]
  def dorhum(item, count, sigils, _base = nil, _type = nil)
    check_loot_bag
    recipe = dorhum_recipe(item)
    check_loot_bag_clear(recipe[:noun]) unless @loot_bag_checked
    ensure_tools(dorhum_tools, 'enchanting')
    buy_sigils(sigils, count)
    # Next door to the sigil-scrolls, before the walk to the base items.
    DRCC.fount(artificing_info['tool-room'], 1, artificing_info['fount'], count, @bag, @bag_items, @settings.enchanting_belt)
    send(recipe[:base], count)
    go_to_enchanting_room
    enchant_items(item, recipe[:noun], count)
    repair(dorhum_repair_tools, @settings.enchanting_belt)
  end

  # DORHUM_ITEMS' entry for the item. An item taskmaster does not know how
  # to make pauses the script with a message, then stops when unpaused.
  #
  # @param item [String] the task item's noun
  # @return [Hash] :noun and :base
  # @raise [SystemExit] for an unknown item
  def dorhum_recipe(item)
    DORHUM_ITEMS[item] || pause_for_unknown_item("taskmaster does not know how to make Dorhum's #{item}s yet.")
  end

  # Whether two container settings may name the same bag. When each names
  # one worn container (worn_container_id), they are the same bag only when
  # that is the same container. Otherwise it goes by their nouns
  # (container_noun): the nouns must be the same, or one shortened from the
  # other, since DR takes the start of a noun for the whole of it ("backp"
  # finds a backpack). With adjectives (check_loot_bag) the names must also
  # share an adjective, or one be a bare noun ("put my rock in my backpack"
  # finds a "sturdy backpack" too); "travel.pack" and "traveler's.pack" are
  # two bags. Without (bin_stray_ingots, which bins what it finds), a noun
  # that matches is enough. A name whose noun can't be read (a blank one
  # too) may be any bag.
  #
  # @param one [String, nil]
  # @param other [String, nil]
  # @param adjectives [Boolean] whether names of one noun must also share
  #   an adjective
  # @return [Boolean]
  def same_container?(one, other, adjectives: true)
    one_id = worn_container_id(one)
    other_id = worn_container_id(other)
    return one_id == other_id if one_id && other_id

    one_noun, one_adjectives = container_noun(one)
    other_noun, other_adjectives = container_noun(other)
    return true unless one_noun && other_noun
    return false unless one_noun.start_with?(other_noun) || other_noun.start_with?(one_noun)
    return true unless adjectives

    one_adjectives.empty? || other_adjectives.empty? || !(one_adjectives & other_adjectives).empty?
  end

  # The words of a container setting, as DR reads them: downcased, DR's dot
  # form ("travel.pack") read as words, and a leading "my" and article
  # dropped.
  #
  # @param setting [String, nil]
  # @return [Array<String>]
  def container_words(setting)
    setting.to_s.downcase.strip.sub(/\Amy\s+/, '').sub(/\A(?:a|an|some)\s+/, '').split(/[\s.]+/).reject(&:empty?)
  end

  # A container setting's noun, from DRC.get_noun, and the words before it.
  #
  # @param setting [String, nil]
  # @return [Array(String, Array<String>), Array(nil, Array)] the noun and
  #   its adjectives; a nil noun when get_noun reads none, or one that is
  #   not a word of the setting
  def container_noun(setting)
    words = container_words(setting)
    noun = DRC.get_noun(words.join(' '))&.downcase
    index = noun && words.rindex(noun)
    index ? [noun, words.take(index)] : [nil, []]
  end

  # The id of the one worn container a setting names, by the rule lich-5's
  # DRCI.carried_ids uses for worn items (DRCI.worn_ref is built on it, but
  # is not in a released Lich yet): the item's noun is one of the setting's
  # words (container_words), and its name holds those words in order, as
  # whole words, ignoring case. So "duffel bag" finds a "deep black camlet
  # duffel bag set with a crimson windsteel medallion" (noun bag), and
  # "backp" finds no backpack, since a noun must be a whole word of it.
  #
  # @param setting [String, nil]
  # @return [String, nil] the id; nil when no worn item matches, or more
  #   than one does
  def worn_container_id(setting)
    ids = container_ids(GameObj.inv, setting, &:name)
    ids.size == 1 ? ids.first : nil
  end

  # The distinct ids of the items a container setting names, by
  # worn_container_id's rule.
  #
  # @param items [Array, nil] items with #id and #noun, e.g. GameObj.inv
  # @param setting [String, nil]
  # @yieldparam item [Object] one of items
  # @yieldreturn [String, nil] the name to look for the setting's words in
  # @return [Array<String>]
  def container_ids(items, setting)
    words = container_words(setting)
    return [] if words.empty?

    pattern = /(?<![\w'-])#{words.map { |word| Regexp.escape(word) }.join('\s+')}(?![\w'-])/i
    Array(items).filter_map do |item|
      id = item&.id.to_s
      next if id.empty? || !words.include?(item.noun.to_s.downcase)

      id if yield(item).to_s.match?(pattern)
    end.uniq
  end

  # A resumed Dorhum task may start with a base item in hand, left there when
  # an earlier run stopped. Nothing says it was finished (a finished one goes
  # straight to task_loot_bag), so it goes back with the unworked ones rather
  # than being handed in.
  #
  # @param item [String] the task item's noun
  # @return [void]
  def set_aside_held_base(item)
    return unless @npc == 'dorhum'

    noun = hand_in_noun(item)
    DRCC.stow_crafting_item(noun, @bag, nil) if DRCI.in_hands?(noun)
  end

  # A rough fragile mana fount from the enchanting tools, should DRCC.fount
  # need a new one: "You can purchase a rough fragile mana fount for 312
  # Kronars." (2026-11-03).
  FOUNT_PRICE = 312

  # What a container holds, from one INVENTORY of it: "inventory #<id>" for
  # the one worn container a setting names (worn_container_id), else
  # "inventory <setting>", as "inve sack" was sent in the log
  # inventory_listing cites. A blank setting is not sent, as a bare
  # INVENTORY lists everything carried.
  #
  # @param container [String, nil] a container setting, e.g. 'duffel bag'
  # @return [Array<String>, nil] see inventory_listing; nil for a blank
  #   setting
  def container_listing(container)
    id = worn_container_id(container)
    name = container.to_s.sub(/\A\s*my(?:\s+|\z)/i, '').strip
    return nil if id.nil? && name.empty?

    inventory_listing(id ? "##{id}" : name)
  end

  # Sends INVENTORY of one container and reads the reply, which names each
  # item in full on a line of its own (Kythkani, 2026-11-09 16:51:38 NZDT):
  #
  #   Inside a <a exist="21309821" noun="sack">woven sack</a>, you see:
  #
  #     some rat-skin leather
  #     a gold coin
  #
  #   [Use <d cmd='inventory help'>INVENTORY HELP</d> for more options.]
  #
  # The items are the lines indented by exactly two spaces between the
  # header and the INVENTORY HELP line. They carry no ids. A container
  # inside the listed one is a line of its own like any other item:
  # INVENTORY does not list what is in it. An empty container answers
  # "There's nothing inside a woven sack!" (Hollow Eve 2026). Any other
  # reply, none included, is not read as either. A closed container ends
  # its line with " (closed)": "a heavy bronze waterproof trunk (closed)"
  # (Poltu trunk task, Hollow Eve 2026). That is cut off, as lich-5's
  # DRCI.get_inventory_by_type does, since DRC.get_noun reads no noun off a line
  # ending in ")" and the trunk would not count as made.
  #
  # @param ref [String] the container: "#<id>", or a name
  # @return [Array<String>, nil] the item lines, tags, indent and " (closed)" stripped; [] for an empty container; nil when neither reply came, or
  #   the list came with no item line in it (a reply that can't be read)
  def inventory_listing(ref)
    lines = Array(Lich::Util.issue_command("inventory #{ref}", INVENTORY_REPLY)).map { |line| line.gsub(/<[^>]+>/, '').rstrip }
    start = lines.index { |line| line.match?(INVENTORY_REPLY) }
    return nil unless start
    return [] if lines[start].match?(SACK_EMPTY)

    items = lines.drop(start + 1)
                 .take_while { |line| !line.match?(INVENTORY_LIST_END) }
                 .filter_map { |line| line.strip.sub(INVENTORY_CLOSED, '') if line.start_with?('  ') }
    items.empty? ? nil : items
  end

  # The words of an item's name, downcased: "an intricate decay
  # sigil-scroll" gives ['an', 'intricate', 'decay', 'sigil-scroll'].
  #
  # @param name [String, nil]
  # @return [Array<String>]
  def name_words(name)
    name.to_s.downcase.scan(/[a-z0-9'-]+/)
  end

  # Sorts INVENTORY item lines (inventory_listing) against a kind of item,
  # `name`. Only a line that holds every word of the kind as a whole word
  # is sorted at all. Such a line is of the kind when lich-5's DRC.get_noun
  # reads the kind's noun off it (the noun of 'decay sigil-scroll' is
  # "sigil-scroll"): "a sturdy ironwood wand wrapped in braided lengths of
  # sinew" is a wand, and "an intricate congruence sigil-scroll" is not
  # sorted as a decay one. It is unsure when get_noun reads another noun
  # off it, or none. "a rock marble deed" and "a deed for a large anjisis
  # rock" are unsure rocks, and are deeds; but the task's own "intricate
  # decay sigil-scroll comprised of broad strokes" is an unsure
  # sigil-scroll too, as get_noun reads "strokes" off it: lich-5's
  # FLAVOR_TEXT_PATTERN has no "comprised of" (a gap to fill there, not
  # with another rule here). The unsure lines get_noun reads no noun off at
  # all are also listed as unread. Each caller decides what an unsure or
  # unread line counts as.
  #
  # @param lines [Array<String>, nil] inventory_listing's item lines
  # @param name [String] e.g. 'rock', 'decay sigil-scroll'
  # @return [Hash{Symbol => Array<String>}] the :of_kind and :unsure
  #   lines, and :unread, the unsure lines with no noun read off them; none
  #   when get_noun reads no noun off the name
  def sort_listed(lines, name)
    sorted = { of_kind: [], unsure: [], unread: [] }
    noun = DRC.get_noun(name)&.downcase
    return sorted if noun.to_s.empty?

    words = name_words(name)
    Array(lines).each do |line|
      next unless (words - name_words(line)).empty?

      read = DRC.get_noun(line)&.downcase
      sorted[read == noun ? :of_kind : :unsure] << line.strip
      sorted[:unread] << line.strip if read.nil?
    end
    sorted
  end

  # How many of a container's items are of a kind,
  # by their noun (sort_listed): a "rock" but not a "rock marble deed" (a
  # Dorhum reward). Unsure lines are not counted.
  #
  # @param lines [Array<String>, nil] inventory_listing's item lines
  # @param name [String] e.g. 'rock', 'decay sigil-scroll'
  # @return [Integer]
  def count_listed(lines, name)
    sort_listed(lines, name)[:of_kind].size
  end

  # A note that names the items a guard counted as of a noun, though no
  # noun could be read off them (sort_listed's unread lines).
  #
  # @param noun [String]
  # @param lines [Array<String>]
  # @return [String] '' for none, else a sentence with a leading space
  def unread_note(noun, lines)
    return '' if lines.empty?

    " Counted as #{noun}s, since taskmaster can't tell that #{lines.size == 1 ? 'it is' : 'they are'} not: #{lines.map { |line| "\"#{line}\"" }.join(', ')}."
  end

  # The hand-in gives whatever item of the task's noun it finds in
  # task_loot_bag first. One there before this task has made any is not this
  # task's: left from another task (a spongestone and a splashstone are both
  # rocks), not taken at the hand-in, or the player's own. So the run stops
  # before buying anything rather than hand those in. A resume runs it right
  # after handing in the finished items it found; dorhum then skips it.
  # task_loot_bag is read with INVENTORY (container_listing), and items go
  # by their noun (sort_listed). The hand-in GETs by noun, so an item whose
  # name holds the noun but whose noun reads as another ("a rock marble
  # deed", "some glow shell instructions") is not one it would give, and
  # does not count. One with no noun read off it at all (unread) counts,
  # and is named: it may be one the hand-in would give, so the run stops
  # rather than give or bin the player's item. get_noun read the noun of
  # every rock, shell and wand logged in November 2026 right, so no real
  # one is let through as another noun. An INVENTORY that goes unanswered
  # counts as none, as an unanswered RUMMAGE did before.
  #
  # @param noun [String] the finished items' noun
  # @return [void]
  # @raise [SystemExit] when task_loot_bag holds any
  def check_loot_bag_clear(noun)
    sorted = sort_listed(container_listing(@lootbag), noun)
    @loot_bag_checked = true
    unread = sorted[:unread]
    held = sorted[:of_kind].size + unread.size
    return if held.zero?

    DRC.message("#{@lootbag} already holds #{held} #{noun}#{held == 1 ? '' : 's'} that this task has not made or could not hand in: left from another task, not taken at the hand-in, or your own. The hand-in would give those first. Move them out of #{@lootbag}, then start again.#{unread_note(noun, unread)}")
    exit
  end

  # Dorhum's finished items keep their base item's noun, so they must wait
  # in a different container from the unworked ones: with task_loot_bag
  # the same container as the crafting bag (it is 'backpack' when unset), a
  # GET for the next base item could take a finished one, and a hand-in an
  # unworked one. Two names are taken for one container when same_container?
  # says so.
  #
  # @return [void]
  # @raise [SystemExit] when task_loot_bag is the crafting bag
  def check_loot_bag
    return unless same_container?(@lootbag, @bag)

    DRC.message("Dorhum's tasks need task_loot_bag (#{@lootbag}) to be a container other than your crafting bag (#{@bag}): his finished items keep the base item's noun (a spongestone is still a rock). Stopping.")
    exit
  end

  # @param reason [String]
  # @return [void]
  # @raise [SystemExit] once unpaused
  def pause_for_unknown_item(reason)
    DRC.message("#{reason} Pausing; make them yourself, or kill the script. Unpausing stops it.")
    pause_script
    exit
  end

  # The enchanting tools a Dorhum task needs on hand before anything is
  # bought: enchanting_tools less the fount (DRCC.fount buys one); your own
  # brazier only when enchanting in a set room that is not a public brazier
  # room (with neither room set, a free brazier room is found); and the
  # imbue rod enchant falls back to. With an Imbue spell in waggle_sets
  # enchant casts it and never waves a rod, so no rod is needed then.
  #
  # @return [Array<String>]
  def dorhum_tools
    tools = Array(@settings.enchanting_tools).reject { |tool| tool =~ /fount|brazier/ }
    tools.reject! { |tool| tool =~ /wand|rod/ } if imbue_spell?
    tools << own_brazier if needs_own_brazier?
    tools << imbue_tool unless imbue_spell? || tools.any? { |tool| tool =~ /wand|rod/ }
    tools
  end

  # @return [Boolean] whether the room Dorhum's items are enchanted in may
  #   have no brazier: a set room that is not one of the towns' public
  #   brazier rooms (the artificing brazier-rooms in the crafting data)
  def needs_own_brazier?
    room = task_enchanting_room
    room ? !public_brazier_rooms.include?(room.to_i) : false
  end

  # @return [Array<Integer>] every town's public brazier rooms
  def public_brazier_rooms
    get_data('crafting')['artificing'].values.flat_map { |town| Array(town['brazier-rooms']) }
  end

  # The imbue rod (or wand) from enchanting_tools, as enchant finds it.
  #
  # @return [String]
  def imbue_tool
    Array(@settings.enchanting_tools).find { |tool| tool =~ /wand|rod/ } || 'rod'
  end

  # @return [Boolean] whether enchant will cast Imbue instead of waving a rod
  def imbue_spell?
    waggle_sets = @settings.waggle_sets
    waggle_sets.respond_to?(:dig) && waggle_sets.dig('imbue', 'Imbue') ? true : false
  end

  # The enchanting tools that go for repair after a Dorhum task: all but the
  # fount, which wears out by use and which Rangu turns away ("They only
  # have so many uses and then you must buy another.").
  #
  # @return [Array<String>]
  def dorhum_repair_tools
    Array(@settings.enchanting_tools).reject { |tool| tool =~ /fount/ }
  end

  # Makes sure the tools are on you before money is spent on a task: any
  # missing are asked of the society clerk (;clerk-tools <discipline> get),
  # and any still missing stop the run with their names, rather than buying
  # supplies and spending an instructions use on an item that cannot be made.
  # Tools left with Rangu were already collected before the task started.
  #
  # @param tools [Array<String>] tool names as in the settings
  # @param discipline [String] clerk-tools toolset, e.g. 'enchanting'
  # @return [void]
  # @raise [SystemExit] when a tool cannot be found
  def ensure_tools(tools, discipline)
    missing = missing_tools(tools)
    return if missing.empty?

    DRC.message("Missing #{missing.join(', ')}; asking the #{discipline} clerk.")
    DRCI.stow_hands
    DRC.wait_for_script_to_complete('clerk-tools', [discipline, 'get'])
    missing = missing_tools(missing)
    return if missing.empty?

    DRC.message("Can't find #{missing.join(', ')}: not on you, and the #{discipline} clerk didn't have it. Stopping before buying anything.")
    exit
  end

  # @param tools [Array<String>]
  # @return [Array<String>] the tools neither in hand nor anywhere TAP finds them
  def missing_tools(tools)
    Array(tools).compact.reject { |tool| DRCI.in_hands?(tool) || DRCI.exists?(tool) }
  end

  # Carries amount copper (Kronars), from the bank when short, or stops.
  #
  # @param amount [Integer]
  # @param keep_hands [Boolean] leave the hands as they are on the stop (a
  #   held vessel with an unfinished remedy in it stays in hand)
  # @param note [String, nil] said before the stop (what to do about a
  #   vessel kept in hand)
  # @return [void]
  # @raise [SystemExit] when the bank cannot cover it
  def afford(amount, keep_hands: false, note: nil)
    return if DRCM.ensure_copper_on_hand(amount, @settings, "Crossing")

    DRCI.stow_hands unless keep_hands
    DRC.message("Out of money: #{amount} Kronars (copper) needed and the Crossing bank could not cover it. #{note && "#{note} "}Stopping before buying anything more.")
    exit
  end

  # Whether the item reaches a hand within a few seconds: buy_item returns on
  # "You decide to purchase the wand...", and the hand only updates with the
  # next line, "The sales clerk hands you your wand." (log 2).
  #
  # @param noun [String]
  # @return [Boolean]
  def held_soon?(noun)
    10.times do
      return true if DRCI.in_hands?(noun)

      pause 0.3
    end
    false
  end

  # A purchase that did not go through (not enough coins, or the shop could
  # not be reached) stops the run before the supplies run short mid-task.
  #
  # Ids in keep stay in hand and everything else held goes in the crafting
  # bag by id (a Nezhiri continue keeps the vessel with the unfinished
  # remedy in it); with keep empty the hands are stowed as always. note is
  # said before the stop.
  #
  # @param what [String] e.g. 'a decay sigil-scroll'
  # @param keep [Array<String>] ids to leave in hand
  # @param note [String, nil] said before the stop
  # @raise [SystemExit] always
  def stop_buying(what, keep: [], note: nil)
    if keep.empty?
      DRCI.stow_hands
    else
      (hand_ids - keep).each { |id| DRCI.put_away_item?("##{id}", @bag) }
    end
    DRC.message("Could not buy #{what}. #{note && "#{note} "}Stopping.")
    exit
  end

  # The Crossing enchanting society's rooms and stock numbers.
  #
  # @return [Hash]
  def artificing_info
    get_data('crafting')['artificing']['Crossing']
  end

  # Reads Dorhum's instructions for their sigils (the read costs no use), then
  # stows them.
  #
  # @param item [String] the task item's noun
  # @param count [Integer] how many are owed
  # @return [Array(String, Integer, Array<String>)] item, count and sigils,
  #   each sigil once per scroll an item takes
  # @raise [SystemExit] when no sigil can be read off them
  def read_enchanting_instructions(item, count)
    lines = Lich::Util.issue_command("read my #{item} instructions", /Instructions for crafting/)
    sigils = Array(lines).flat_map do |line|
      line.gsub(/<[^>]+>/, '').scan(INSTRUCTION_SIGIL).flat_map { |count, sigil| [sigil] * count.to_i }
    end
    stow_instructions(item)
    pause_for_unknown_item("No sigils could be read off the #{item} instructions.") if sigils.empty?
    DRC.message("Each #{item} needs #{sigils.join(' and ')} sigils")
    return item, count, sigils
  end

  # Orders the sigil-scrolls the task needs (one per sigil per item, less any
  # already carried) from the Crossing enchanting supplies, into the crafting
  # bag. The carried ones are read off one INVENTORY of the crafting bag
  # (container_listing) and go by their noun (sort_listed). The task's own
  # scrolls are named "an intricate decay sigil-scroll comprised of broad
  # strokes" (taskmaster-nezhiri logs, 2026-11-06), whose noun lich-5's
  # DRC.get_noun reads as "strokes", so an unsure scroll, one whose name
  # holds "decay sigil-scroll" as whole words, counts as carried too, with a
  # message naming it. Buying each such scroll again costs up to 1575
  # Kronars, and would happen on every task; counting one that is not a
  # scroll only leaves the task short, which the message says how to put
  # right. One in a container inside the bag is not counted: INVENTORY does
  # not list what such a container holds. An INVENTORY that goes unanswered counts none, so
  # every scroll is bought, as an unanswered RUMMAGE did before.
  #
  # @param sigils [Array<String>] one entry per sigil used on each item
  # @param count [Integer] items to make
  # @return [void]
  def buy_sigils(sigils, count)
    needs = sigils.tally.transform_values { |per_item| per_item * count }
    carried = container_listing(@bag)
    needs.each_key do |sigil|
      kind = "#{sigil} sigil-scroll"
      pause_for_unknown_item("No #{kind} in the crafting data.") unless @stockdata[kind]
      sorted = sort_listed(carried, kind)
      sorted[:unsure].tally.each do |line, many|
        DRC.message("Counted #{many} \"#{line}\" in your #{@bag} as #{kind}#{many == 1 ? '' : 's'}, so none is bought for #{many == 1 ? 'it' : 'them'}: the name holds \"#{kind}\", but its noun could not be read. " \
                    "If #{many == 1 ? 'it is not one' : 'they are not'}, move #{many == 1 ? 'it' : 'them'} out of your #{@bag} and start again.")
      end
      needs[sigil] -= sorted[:of_kind].size + sorted[:unsure].size
    end
    cost = needs.sum { |sigil, needed| [needed, 0].max * @stockdata["#{sigil} sigil-scroll"]['stock-value'] }
    afford(cost + FOUNT_PRICE + 7500) if cost.positive? # a fount if it is used up, 5 gold for the next task, 2500 for repairs
    needs.each do |sigil, needed|
      needed.times do
        bought = DRCT.order_item(artificing_info['stock-room'], @stockdata["#{sigil} sigil-scroll"]['stock-number'])
        stop_buying("a #{sigil} sigil-scroll") if bought.to_s.empty?
        DRCC.stow_crafting_item('sigil-scroll', @bag, nil)
      end
    end
  end

  # Buys a wand from the steel crate for each virga wand still to make, less
  # any wands already in the crafting bag. DRCT.buy_item takes the crate's
  # "You decide to purchase" reply.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @note Every wand in the crafting bag counts, so an imbue wand kept there
  #   (rather than a rod) would be taken for an unworked one.
  def buy_wands(count)
    needed = count - DRCI.count_items_in_container(SUPPLIES_WAND, @bag)
    return unless needed.positive?

    afford(needed * 125 + 7500)
    needed.times do
      DRCT.buy_item(artificing_info['stock-room'], SUPPLIES_WAND)
      # buy_item returns nothing useful after "You decide to purchase", so
      # the hand says whether the wand was bought.
      stop_buying('a wand') unless held_soon?(SUPPLIES_WAND)
      DRCC.stow_crafting_item(SUPPLIES_WAND, @bag, nil)
    end
  end

  # A rock for each spongestone or splashstone still to make, foraged at task_rock_room.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_rocks(count)
    forage_base('rock', @rock_room, 'task_rock_room', count)
  end

  # A shell for each glow shell still to make, foraged at task_shell_room.
  #
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_shells(count)
    forage_base('shell', @shell_room, 'task_shell_room', count)
  end

  # Forages one base item per item still to make (less any carried) in the
  # room, into the crafting bag.
  #
  # @param noun [String] what FORAGE looks for, e.g. 'rock'
  # @param room [Integer, String] where to forage
  # @param setting [String] the setting that names the room, for the stop message
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when a forage finds nothing
  def forage_base(noun, room, setting, count)
    needed = count - DRCI.count_items_in_container(noun, @bag)
    return unless needed.positive?

    DRCT.walk_to(room)
    needed.times do
      unless DRC.forage?(noun)
        DRC.message("Could not forage a #{noun} at room #{room}, stopping. Set #{setting} to a room where #{noun}s can be found.")
        exit
      end
      DRCC.stow_crafting_item(noun, @bag, nil)
    end
  end

  # The room set for enchanting during a task: task_crafting_room, the room
  # every task crafts in, else enchanting_room. Outside tasks, enchanting
  # (craft, workorders) goes on using enchanting_room; only taskmaster reads
  # this.
  #
  # @return [Integer, String, nil] nil when neither is set
  def task_enchanting_room
    @crafting_room || @settings.enchanting_room
  end

  # Goes where Dorhum's items are enchanted: task_enchanting_room. With
  # neither room set, stays put when a brazier is carried (enchanting works
  # anywhere with your own), else finds a free brazier room in Crossing.
  #
  # @return [void]
  def go_to_enchanting_room
    room = task_enchanting_room
    return DRCT.walk_to(room) if room
    return if DRCI.exists?(own_brazier)

    DRCC.find_enchanting_room('Crossing')
  end

  # The brazier from enchanting_tools, as enchant finds it.
  #
  # @return [String]
  def own_brazier
    Array(@settings.enchanting_tools).find { |tool| tool =~ /brazier/ } || 'brazier'
  end

  # A rented room's notice (Mahtra's private forge, task_crafting_room 16936):
  # "[It will expire Thu Dec  3 20:58:13 ET 2026.]", in US Eastern time.
  RENTAL_EXPIRES = /^\[It will expire \w+ (?<month>\w+)\s+(?<day>\d+) (?<hour>\d+):(?<min>\d+):(?<sec>\d+) ET (?<year>\d+)\.\]/
  # READ NOTICE where there is none: the room is not rented.
  RENTAL_NO_NOTICE = [/^I could not find/, /^What were you referring to/].freeze
  # The sentry's warning, ten minutes before the rental ends (2026-11-02, with
  # 18:58:13 ET on the notice): "[You have less than 10 minutes remaining.  If
  # you wish to renew your rental, simply MARK NOTICE to signal the sentry.]"
  RENTAL_WARNING = /^(?:<[^>]*>)*\[You have less than 10 minutes remaining\.\s+If you wish to renew your rental/
  RENTAL_WARNING_FLAG = 'taskmaster-rental-warning'
  # MARK NOTICE that went through: "[Your private forge rental has been
  # extended until Thu Dec  3 00:56:41 ET 2026.]" (an hour per mark).
  RENTAL_EXTENDED = /^\[Your private forge rental has been extended until/
  # Minutes left on the notice under which the rental is renewed before
  # enchanting, the margin the sentry's warning gives too.
  RENTAL_RENEW_MINUTES = 10
  MONTHS = %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec].freeze

  # Reads the notice of task_crafting_room, if it has one, and renews the
  # rental when it ends within RENTAL_RENEW_MINUTES, as sew does in a
  # rented room: when it runs out, the game moves you out and drops on the
  # ground whatever is not a tool, the item on the brazier too.
  #
  # @return [Boolean] whether the room is rented
  def check_rental
    reply = DRC.bput('read notice', RENTAL_EXPIRES, *RENTAL_NO_NOTICE)
    match = RENTAL_EXPIRES.match(reply)
    return false unless match

    renew_rental if rental_minutes_left(match) < RENTAL_RENEW_MINUTES
    true
  end

  # @param match [MatchData] RENTAL_EXPIRES on the notice
  # @param now [Time]
  # @return [Float] minutes until the rental ends
  def rental_minutes_left(match, now = Time.now)
    month = MONTHS.index(match[:month]) + 1
    year = match[:year].to_i
    day = match[:day].to_i
    expires = Time.new(year, month, day, match[:hour].to_i, match[:min].to_i, match[:sec].to_i, eastern_offset(year, month, day))
    (expires - now) / 60
  end

  # US Eastern time's UTC offset on a date: daylight time from the second
  # Sunday of March to the first Sunday of November.
  #
  # @return [String] '-04:00' or '-05:00'
  def eastern_offset(year, month, day)
    sunday = ->(mon, nth) { (((7 - Time.utc(year, mon, 1).wday) % 7) + 1) + (7 * (nth - 1)) }
    daylight = case month
               when 4..10 then true
               when 3 then day >= sunday.call(3, 2)
               when 11 then day < sunday.call(11, 1)
               else false
               end
    daylight ? '-04:00' : '-05:00'
  end

  # MARK NOTICE, an hour more. A reply other than the extension stops the
  # run between items, before the rental can end under an enchant.
  #
  # @return [void]
  # @raise [SystemExit] when the rental was not extended
  def renew_rental
    Flags.reset(RENTAL_WARNING_FLAG)
    reply = DRC.bput('mark notice', RENTAL_EXTENDED, /^You don't have enough/, *RENTAL_NO_NOTICE)
    return if RENTAL_EXTENDED.match?(reply)

    DRC.message("Could not renew the rental of room #{@crafting_room}#{reply.empty? ? '' : " (#{reply})"}; stopping before it runs out.")
    exit
  end

  # Enchants each item with `enchant instructions` and puts it in
  # task_loot_bag. An item the game did not finish (enchant stopped and
  # said why) stops the task, leaving everything where it is. In a rented
  # task_crafting_room the rental is checked first and renewed between items
  # once the sentry warns it is nearly up.
  #
  # @param item [String] the task item's noun, naming the instructions
  # @param noun [String] the finished item's noun (its base item's)
  # @param count [Integer] items to make
  # @return [void]
  # @raise [SystemExit] when an enchant did not finish, a finished item
  #   would not go in task_loot_bag (it is trashed first), or the rental
  #   could not be renewed
  def enchant_items(item, noun, count)
    Flags.add(ENCHANTED_FLAG, ENCHANTED)
    Flags.add(RENTAL_WARNING_FLAG, RENTAL_WARNING)
    rented = @crafting_room ? check_rental : false
    count.times do
      renew_rental if rented && Flags[RENTAL_WARNING_FLAG]
      Flags.reset(ENCHANTED_FLAG)
      DRC.wait_for_script_to_complete('enchant', ['instructions', item, noun])
      unless Flags[ENCHANTED_FLAG] && DRCI.in_hands?(noun)
        # An unworked base item enchant left in hand (it stopped before the
        # brazier) goes back with the others, not to the hand-in.
        DRCC.stow_crafting_item(noun, @bag, nil) if DRCI.in_hands?(noun)
        DRC.message("enchant did not finish a #{noun} for the #{item}s; stopping.")
        exit
      end
      next if DRCI.put_away_item?(noun, @lootbag)

      # Kept, it would end up among the unworked base items on the next
      # start, so it goes in the trash; the task is short one, which the
      # next start makes again.
      where = trash_refused(noun) ? 'it went in the trash' : 'it is still in your hand'
      DRC.message("The finished #{noun} would not go in #{@lootbag}, so #{where}. Make room in #{@lootbag}, then start again. Stopping.")
      exit
    end
    DRC.message("#{count} #{item}s completed")
  ensure
    Flags.delete(ENCHANTED_FLAG)
    Flags.delete(RENTAL_WARNING_FLAG)
  end

  # Taskmasters wander, but between turn-ins they are usually back in the
  # room they were last seen in. Search from there outwards along the room
  # list, and remember where each one was found. Kept in UserVars because t2
  # can start this script once per task.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param npc [String] taskmaster name, lower case
  # @note UserVars.taskmaster_last_seen persists across runs.
  # @return [void]
  def find_npc(rooms, npc)
    UserVars.taskmaster_last_seen ||= {}
    looked_in = []
    found = false
    search_order(rooms, UserVars.taskmaster_last_seen[npc]).each do |room_id|
      break if (found = npc_here?(npc, looked_in))

      DRCT.walk_to(room_id)
    end
    # The last room walked to is checked here.
    found ||= npc_here?(npc, looked_in)
    UserVars.taskmaster_last_seen[npc] = Room.current.id if found
  end

  # Still needed once Lich repairs DRRoom from the full room view: a refresh
  # while standing in the room arrives cut short with no view after it, so a
  # taskmaster listed after the cut drops out of DRRoom.npcs until a LOOK.
  # See elanthia-online/dr-scripts#7993.
  #
  # In a cluttered room the game cuts its room objects data short, ending it
  # "... and some other stuff." (or "and a lot of other stuff."). Lich builds
  # DRRoom.npcs from that data alone, so a taskmaster listed after the cut is
  # missing from it, and DRRoom.room_objs ends with what Lich makes of the
  # marker: 'other stuff' or 'lot of other stuff'.
  ROOM_OBJS_CUT_SHORT = /\A(?:lot of )?other stuff\z/

  # LOOK lists the whole room on one line: at the start of the line, or after
  # the room description and two spaces. A room with nothing in it has no
  # such line, and the exits line ends the look instead. The game quotes what
  # players say, whisper and think, so a line with a double quote before the
  # words is not the listing. \K leaves the description out of the match.
  LOOK_ROOM_LISTING = /\A(?:[^"]*\s{2})?\s*\KYou also see .*/
  LOOK_ROOM_EXITS = /^Obvious (?:exits|paths):/

  # Whether the taskmaster is in this room. When DRRoom.npcs does not list
  # them and the room objects data was cut short, LOOK's full listing
  # decides, once per room per search; otherwise no command is sent.
  #
  # @param npc [String] taskmaster name, lower case
  # @param looked_in [Array<Integer>] rooms already looked in this search; a
  #   room looked in is added. A search checks its first room twice when it
  #   starts in the last-seen room (search_order puts it first and walking
  #   there stays put), and keeps checking one room when walking fails.
  # @return [Boolean]
  def npc_here?(npc, looked_in = [])
    name = npc.capitalize
    return true if DRRoom.npcs.include?(name)
    return false unless DRRoom.room_objs.last.to_s.match?(ROOM_OBJS_CUT_SHORT)

    room = Room.current.id
    return false if room && looked_in.include?(room)

    looked_in << room if room
    # Not followed by ' or -, so an item named for them ("Zasele's ...") is not taken for them.
    DRC.bput('look', LOOK_ROOM_LISTING, LOOK_ROOM_EXITS).match?(/\b#{Regexp.escape(name)}\b(?!['-])/)
  end

  # The room list starting at start_room and alternating outwards from it
  # (start, next, previous, two on, two back, ...), or the list unchanged when
  # start_room is not in it.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param start_room [Integer, nil] where the taskmaster was last seen
  # @return [Array<Integer>] every room, once
  def search_order(rooms, start_room)
    start = rooms.index(start_room)
    return rooms unless start

    order = [rooms[start]]
    (1...rooms.size).each do |step|
      order << rooms[start + step] if start + step < rooms.size
      order << rooms[start - step] if start - step >= 0
    end
    order
  end

  # The task journal entry. "So far, you have returned N" is optional so an
  # entry printed without it still parses as nothing returned.
  # The game names the taskmaster first: "Zasele has asked you to craft some
  # items ... In particular, she wanted you to craft a reinforced rope and
  # indicated that 5 would suffice." Groups: taskmaster (when named), item,
  # how many, how many returned. Nezhiri counts doses, not items: "she
  # wanted you to craft some gill glop and indicated that 12 doses would
  # suffice." The word "doses" is skipped, so the count group is the same.
  TASK_JOURNAL = /(?:(\w+) has asked you to craft .*?)?wanted you to craft (.*) and indicated that (\d+)(?: doses)? would suffice\.(?:\s+So far, you have returned (\d+))?/
  # The taskmasters this script works for.
  TASKMASTERS = %w[poltu bradyn zasele dorhum nezhiri].freeze
  # TASK reply when not on a task.
  NOT_ON_TASK = /^You are not currently on a task/
  # The materials line of READ INSTRUCTIONS: the stock and its volume, or
  # the size of rock for stone.
  INSTRUCTION_MATERIALS = /(cloth|bone|stone|yarn|wood|leather|metal).* \(((\d+) .*|boulder|large rock|small rock|stone|pebble)\)/

  # Reads the task just accepted, or the one in progress, and its
  # instructions.
  #
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count still owed, volume per item ('boulder' for stone), base
  #   and type
  # @raise [SystemExit] when not on a task
  def finish
    item, count = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    read_instructions(item, count)
  end

  # Reads the task journal and returns the item noun and how many are still
  # owed, or nil when not on a task. Notes the taskmaster the journal names
  # in @task_giver (nil when it names none), and the item's whole name,
  # without "some" or "a", in @task_product: Nezhiri's recipe depends on it,
  # since the noun alone ("potion") does not say which remedy she wants.
  # For Nezhiri, how many owed counts doses.
  #
  # @return [Array(String, Integer), nil] item noun and how many are owed
  def read_task
    entry = DRC.bput("task", TASK_JOURNAL, NOT_ON_TASK)
    match = TASK_JOURNAL.match(entry)
    return nil unless match

    @task_giver = match[1]&.downcase
    item = match[2].split.last
    @task_item = item
    @task_product = match[2].sub(ITEM_ARTICLE, '')
    remaining = [match[3].to_i - match[4].to_i, 0].max
    DRC.message(@npc == 'nezhiri' ? "Making #{remaining} doses of #{@task_product}" : "Making #{remaining} #{item}s")
    return item, remaining
  end

  # The article the journal and the instructions put before an item's name:
  # "some gill glop", "a spongestone".
  ITEM_ARTICLE = /\A(?:some|an?|the)\s+/i

  # Reads the item's instructions for its material and volume, then stows
  # them, returning everything the worker methods need.
  #
  # @param item [String] item noun
  # @param count [Integer] how many are owed
  # @note An unrecognised materials line leaves base nil; Lich's nil patch
  #   then makes type nil instead of raising.
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count, volume per item ('boulder' for stone), base and type
  def read_instructions(item, count)
    return read_enchanting_instructions(item, count) if @npc == 'dorhum'
    return read_remedy_instructions(item, count) if @npc == 'nezhiri'

    case DRC.bput("read my #{item} instructions", INSTRUCTION_MATERIALS)
    when /(cloth|bone|yarn|wood|leather|metal).* \(((\d+) .*)\)/
      base = Regexp.last_match(1)
      volume_per_item = Regexp.last_match(3).to_i
      base = base.sub('bone', 'stack').sub('metal', 'ingot').sub('wood', 'lumber')
      DRC.message("Each #{item} requires #{volume_per_item} volumes")
    when /stone .* \((\w+)\)/
      volume_per_item = 'boulder'
      base = 'stone'
      DRC.message("Using a boulder for each #{item}")
    end
    stow_instructions(item)
    type = @stackmap[base].first
    return item, count, volume_per_item, base, type
  end

  # Turn-in reply while more items are owed.
  TURN_IN_MORE_NEEDED = /(\d+) more (?:are|is) needed/
  # READ INSTRUCTIONS line giving the uses left.
  INSTRUCTION_USES = /They have only (\d+) uses? remaining/

  # Nezhiri's remedies, by the name her task journal gives them. Her
  # instructions never name the herb; they say what it heals: "(5) prepared
  # herb (pieces per use, known to heal external wounds of the neck)". So
  # each product carries the herb that heals that, as remedy's instructions
  # form takes it, and the heal phrase to check the instructions against.
  # - :noun is the word the game knows the remedy by (GIVE, COUNT, remedy);
  # - :herb is remedy's herb argument ('red flower': remedy uses its dried
  #   flower);
  # - :stock is the herb's key in base-crafting.yaml stock: (order number and
  #   price come from there);
  # - :vessel is the mortar or the bowl. The mortar crushes dried herbs; it
  #   refuses crushed ones ("You stop, realizing that type of plant requires
  #   a cooking pot and mixing stick.");
  # - :heals is the heal phrase on the instructions' herb line.
  # All four were made by these herbs and vessels in the Hollow Eve 2026 logs.
  # Any other product pauses the script.
  NEZHIRI_ITEMS = {
    'gill glop'           => { noun: 'glop', herb: 'georin', stock: 'georin', vessel: 'mortar', heals: 'heal external wounds of the neck' },
    'scale moisturizer'   => { noun: 'moisturizer', herb: 'red flower', stock: 'red flowers', vessel: 'mortar',
                               heals: 'provide minor external healing over the entire body' },
    'landsickness potion' => { noun: 'potion', herb: 'aevaes', stock: 'aevaes', vessel: 'bowl', heals: 'heal internal wounds of the eyes' },
    'deep-sea draught'    => { noun: 'draught', herb: 'junliar', stock: 'junliar', vessel: 'bowl', heals: 'heal internal wounds of the back' }
  }.freeze
  # Where Nezhiri's READ is captured from: the uses line, which comes first,
  # or the title when the uses line is missing.
  NEZHIRI_READ_START = /They have only \d+ uses? remaining|Instructions for crafting/
  # Seconds the READ of her instructions may take, as long as DRC.bput
  # waits. Lich::Util.issue_command gives up after 5 s by default, and the
  # roundtime the game makes you wait out ("...wait 6 seconds.", after a
  # study) counts toward it.
  NEZHIRI_READ_TIMEOUT = 15
  # The title of a set of instructions: "-=   Instructions for crafting some
  # gill glop    =-". Captures the product, without "some".
  INSTRUCTION_TITLE = /Instructions for crafting (?:(?:some|an?|the)\s+)?(?<product>.+?)\s*=-/
  # Nezhiri's herb line: how many pieces each use takes, and what the herb
  # heals.
  NEZHIRI_HERB_LINE = /\((?<pieces>\d+)\) prepared herb \(pieces per use, known to (?<heals>[^)]+)\)/
  # Nezhiri's brine line: "(1) splash of brewer's brine".
  NEZHIRI_BRINE_LINE = /\(\d+\) splash of brewer's brine/
  # Herb pieces each use takes on every set of Nezhiri's instructions in the
  # logs. The craft counts below assume it.
  NEZHIRI_HERB_PIECES = 5
  # Doses one craft is planned to make: one 25-piece herb stack, one splash
  # of brine, one catalyst and one study of the instructions gave "You count
  # out 6 uses remaining." in every craft of the first logs (6100..6106).
  # Crafts can make fewer: in log 6400 two scale moisturizer crafts, each from a
  # full 25-piece stack (6400:550, 6400:716), made 5 each (6400:679,
  # 6400:805), and a 2026-11 report had 13 doses from the crafts planned
  # for 15. Extra crafts make up a shortfall (top_up_remedies). The yield
  # has differed between characters (5 a craft in log 6400, while another
  # player's moisturizer stacks counted 6, 6101:3613,
  # 6101:3696; the cause is unknown), so each character's fewest
  # doses a craft made the last time it crafted a product is remembered
  # (remember_remedy_yield), and the next task plans by it
  # (remedy_planned_yield). This stays the most a craft is ever planned at:
  # no log shows a craft making more.
  NEZHIRI_DOSES_PER_CRAFT = 6
  # Rounds of extra crafts a task makes when the crafts planned make fewer
  # doses than owed (top_up_remedies). Each round plans its crafts at the
  # fewest doses one craft made this run, so one round should make up the
  # rest; the second covers a craft that made fewer still. Still short
  # after them, the task stops for ;taskmaster nezhiri finish rather than
  # buy and craft without end.
  NEZHIRI_TOP_UP_ROUNDS = 2

  # Reads Nezhiri's instructions with one READ, checks them against
  # NEZHIRI_ITEMS, then stows them. The product is the one the journal named
  # (@task_product), else the one the title names. The script pauses, then
  # stops, when taskmaster does not know the product, when the title names
  # another product than the journal, or when the herb line (what the herb
  # heals, pieces per use) or the brine line is not what the table expects.
  # The READ waits up to NEZHIRI_READ_TIMEOUT seconds for its answer.
  #
  # @param item [String] the remedy's noun, e.g. 'glop'
  # @param count [Integer] how many doses are owed
  # @return [Array(String, Integer, Hash)] item, count and the recipe: the
  #   NEZHIRI_ITEMS entry plus :product, :order and :price (the herb's
  #   order number and price from base-crafting.yaml), :pieces (herb pieces
  #   per use) and :uses (uses left on the set; nil when the uses line was
  #   not read)
  # @raise [SystemExit] once unpaused, for an unknown product or
  #   instructions that do not match it
  def read_remedy_instructions(item, count)
    lines = Array(Lich::Util.issue_command("read my #{item} instructions", NEZHIRI_READ_START, timeout: NEZHIRI_READ_TIMEOUT)).map { |line| line.gsub(/<[^>]+>/, '') }
    stow_instructions(item)
    title = lines.filter_map { |line| line[INSTRUCTION_TITLE, :product] }.first
    product = @task_product || title
    recipe = nezhiri_recipe(product, item)
    herb = lines.filter_map { |line| line.match(NEZHIRI_HERB_LINE) }.first
    problem = remedy_instructions_problem(product, recipe, title, herb, lines)
    pause_for_unknown_item("The #{item} instructions do not read as taskmaster expects for #{product}: #{problem}.") if problem
    stock = @stockdata[recipe[:stock]]
    pause_for_unknown_item("base-crafting.yaml has no stock entry '#{recipe[:stock]}' for #{product}'s herb.") unless stock
    uses = lines.filter_map { |line| line[INSTRUCTION_USES, 1] }.first&.to_i
    DRC.message("Each craft of #{product} needs #{recipe[:herb]} in a #{recipe[:vessel]}")
    return item, count, recipe.merge(product: product, order: stock['stock-number'], price: stock['stock-value'], pieces: herb[:pieces].to_i, uses: uses)
  end

  # NEZHIRI_ITEMS' entry for a product, checked against the journal's noun.
  # A product taskmaster does not know, or one whose noun is not the
  # journal's, pauses the script with a message, then stops when unpaused.
  #
  # @param product [String, nil] the product's whole name, e.g. 'gill glop'
  # @param item [String] the noun the journal gave
  # @return [Hash] the NEZHIRI_ITEMS entry
  # @raise [SystemExit] once unpaused, for an unknown product or one with
  #   another noun
  def nezhiri_recipe(product, item)
    recipe = NEZHIRI_ITEMS[product.to_s.downcase]
    pause_for_unknown_item("taskmaster does not know how to make Nezhiri's #{product || item} yet.") unless recipe
    pause_for_unknown_item("The #{item} instructions are for #{product}, which is not a #{item}.") unless recipe[:noun] == item
    recipe
  end

  # What is wrong with a READ of Nezhiri's instructions, or nil when they are
  # what NEZHIRI_ITEMS expects.
  #
  # @param product [String] the product the task is for
  # @param recipe [Hash] its NEZHIRI_ITEMS entry
  # @param title [String, nil] the product the title names
  # @param herb [MatchData, nil] the herb line, NEZHIRI_HERB_LINE
  # @param lines [Array<String>] every line read, tags removed
  # @return [String, nil] the problem, in words
  def remedy_instructions_problem(product, recipe, title, herb, lines)
    return 'no title was read' unless title
    return "they are for #{title}" unless title.casecmp?(product)
    return 'no herb line was read' unless herb
    return "the herb is known to #{herb[:heals]}, not to #{recipe[:heals]}" unless herb[:heals] == recipe[:heals]
    return "each use takes #{herb[:pieces]} herb pieces, not #{NEZHIRI_HERB_PIECES}" unless herb[:pieces].to_i == NEZHIRI_HERB_PIECES
    return 'no brine line was read' unless lines.any? { |line| line.match?(NEZHIRI_BRINE_LINE) }

    nil
  end

  # Crafts needed to make some doses of a Nezhiri remedy: one study of the
  # instructions each, NEZHIRI_DOSES_PER_CRAFT doses each, or per_craft
  # each when crafts are known to make fewer (remedy_planned_yield,
  # remedy_top_up_crafts).
  #
  # @param doses [Integer] doses still to make
  # @param per_craft [Integer] doses one craft is counted on to make
  # @return [Integer] crafts, 0 when none are left to make
  def nezhiri_crafts(doses, per_craft = NEZHIRI_DOSES_PER_CRAFT)
    return 0 unless doses.positive?

    (doses + per_craft - 1) / per_craft
  end

  # Where Nezhiri's tasks buy brewer's brine: Andreshlew, Craftsmen's
  # Academy, Association of Alchemists. BUY BRINE there answers "You decide
  # to purchase the brine, and pay the sales clerk 50 Kronars." and "The
  # sales clerk hands you your brewer's brine." (6100:8717-8719). No town in
  # base-crafting.yaml sells it.
  NEZHIRI_BRINE_ROOM = 51_102
  # Kronars one brine costs (6100:8718).
  BRINE_PRICE = 50
  # Splashes one brine holds: a bought one counts "There are ten parts left
  # of the brewer's brine." (6100:8800). Each craft takes one splash.
  BRINE_PARTS = 10
  # The town whose shops sell the herbs, water, alcohol and coal nugget her
  # remedies need: Crossing, as for every taskmaster this script works for
  # (Zasele's stock, Poltu's ingots, Bradyn's rocks and Dorhum's sigils are
  # all bought there, and the copper comes from its bank). Andreshlew has no
  # alchemy shop. The rooms are the alchemy supplies (base-crafting.yaml
  # remedies stock-room, 8862) and the forging supplies for the coal nugget
  # (catalyst-room, 8775), where the logs bought them (6100:8887-8902,
  # 6100:4250).
  NEZHIRI_SUPPLY_TOWN = 'Crossing'
  # Herb pieces one order buys and one craft takes: "hands you (25 pieces)
  # dried georin" (6100:8890), and every logged craft put one whole stack in
  # the vessel. remedy is told to gather this many.
  NEZHIRI_HERB_STACK = 25
  # The catalyst every logged craft used, a coal nugget. remedy is given it
  # by name.
  NEZHIRI_CATALYST = 'coal nugget'
  # TAP of a coal nugget: "You tap a tiny coal nugget inside your leather
  # satchel." (6100:3154). Captures its size.
  COAL_TAPPED = /^You tap an? (\w+) coal nugget/
  # The replies TAP of a coal nugget waits for: its size, or none there
  # ("I could not find what you were referring to.", 6100:225).
  COAL_TAP_REPLIES = [COAL_TAPPED, /^I could not find/, /^What were you referring to/].freeze
  # Crafts a coal nugget of each size still has in it. A craft rubs the
  # nugget once, and below massive each rub takes it down one size: huge,
  # then large (6100:680, 839), large, medium, small (6100:9143, 9318,
  # 9468), small, tiny (6100:2662, 3154), and the tiny one is used up
  # (6100:3370-3372, then 6100:3501 "there's none"). A massive one was
  # rubbed five times and was still massive (6100:4967-6729), so 6 is the
  # least it has. A size not listed counts as 1.
  COAL_RUBS = { 'tiny' => 1, 'small' => 2, 'medium' => 3, 'large' => 4, 'huge' => 5, 'massive' => 6 }.freeze
  # Kronars kept back on top of what a task's supplies cost: 5 gold for the
  # next task's fee and 2500 for repairs, as the other tasks keep.
  NEZHIRI_SPARE_COPPER = 7500
  # The tools each vessel is worked with: a mortar with a pestle, a bowl
  # with a mixing stick (remedy picks them the same way). A task needs its
  # vessel's two, and the sieve when the game asks for it; Rangu repaired
  # the mortar, pestle, bowl and stick in the logs (6100:9659, 6100:11156).
  REMEDY_VESSEL_TOOLS = { 'mortar' => /mortar|pestle/i, 'bowl' => /bowl|cauldron|mixing stick/i }.freeze
  # COUNT of a finished remedy: "You count out 6 uses remaining."
  # (6100:9223). Captures the doses.
  REMEDY_COUNT = /^You count out (\d+) uses? remaining/
  # The replies COUNT of a remedy stack by id waits for: the doses, or the
  # id is not to be found.
  REMEDY_COUNT_REPLIES = [REMEDY_COUNT, /^I could not find/].freeze
  # MARK <remedy> AT <doses>: "You measure out 13 usable portions from the
  # stack and mark it for cutting." (6100:9688). CUT does not split a
  # remedy ("You can't cut that."); MARK, then BREAK, does.
  REMEDY_MARKED = /^You measure out \d+ usable portions?/
  # BREAK <remedy> after the mark: "You carefully break off 13 pieces from
  # the stack." (6100:9690). Two stacks are held after it.
  REMEDY_BROKEN = /^You carefully break off \d+ pieces?/
  # Nezhiri turning down a remedy of the wrong size: "Potion Peddler Nezhiri
  # squints at the landsickness potion and shakes her head.  "The amount
  # here looks off.  I asked for 15 doses turned in as a single product.
  # Please CUT that down to the correct amount, if you would."" (6101:5463),
  # or "... Please COMBINE that with some more first, if you would.""
  # (6106:1811) when it holds too few. Captures the doses she asked for.
  GIVE_WRONG_AMOUNT = /The amount here looks off\.\s+I asked for (\d+) doses turned in as a single product/
  # Nezhiri not looking at a give: "Potion Peddler Nezhiri ignores your
  # offer." (6106:1800), when the remedy was in the left hand. After a SWAP
  # the same give was taken (6106:1834-1839).
  GIVE_IGNORED = /ignores your offer/

  # Works one of Nezhiri's remedy tasks: counts the doses already in the
  # crafting bag, then, for the crafts still needed, gets the tools, buys
  # brine (Andreshlew), herbs, water, alcohol and a coal nugget (Crossing),
  # crafts each with remedy's instructions form, combining every new stack
  # into one, and leaves the mortar and pestle (or bowl and stick) with
  # Rangu. The hand-in (give_item) makes the stack the size she asked for.
  # With the doses already on hand it buys and crafts nothing. The crafts
  # are planned at the fewest doses one craft made the last time this
  # character crafted the product, never more than NEZHIRI_DOSES_PER_CRAFT
  # (remedy_planned_yield), and the plan message says so when that is
  # fewer. Crafts planned for a yield since outgrown are not made
  # (brew_remedies stops once the doses owed are made); their herbs, brine
  # and coal stay in the crafting bag, where the next task's purchases
  # count them (buy_remedy_supplies). When they make fewer than owed,
  # top_up_remedies buys for and makes extra crafts, up to
  # NEZHIRI_TOP_UP_ROUNDS rounds of them, before the tools go to Rangu. The
  # remedy's vessel left in hand by a remedy run that stopped is looked in
  # first (clear_held_vessel), and an unfinished remedy in it carried on; so
  # is one a craft leaves (remedy_left_in_vessel). A finish (resume_task)
  # runs this too: the doses on hand are counted afresh here, so the ones
  # made before the finish count once.
  #
  # Notes the instructions studied this run in @remedy_studies and the
  # fewest doses one craft made in @remedy_yield, which brew_remedies
  # remembers for the next task (remember_remedy_yield).
  #
  # @param item [String] the remedy's noun, e.g. 'glop'
  # @param doses [Integer] doses owed
  # @param recipe [Hash] what read_remedy_instructions returns
  # @return [void]
  # @raise [SystemExit] when the bag holds another item of the same noun,
  #   the instructions have too few uses (for the crafts planned or the
  #   extra ones), a tool is missing, money or a purchase runs short, the
  #   held vessel holds something it does not carry on, a craft (or its one
  #   continue run) does not end with the remedy in hand, or the crafts and
  #   extra crafts make fewer doses than owed
  def nezhiri(item, doses, recipe, _base = nil, _type = nil)
    @remedy_studies = 0
    @remedy_yield = nil
    on_hand = remedy_doses_on_hand(recipe)
    per_craft = remedy_planned_yield(recipe[:product])
    crafts = nezhiri_crafts(doses - on_hand, per_craft)
    last_time = crafts.positive? && per_craft < NEZHIRI_DOSES_PER_CRAFT ? " (#{per_craft} doses a craft last time)" : ''
    DRC.message("#{doses} doses of #{recipe[:product]} owed, #{on_hand} on hand: #{crafts} craft#{crafts == 1 ? '' : 's'} to make#{last_time}.")
    return if crafts.zero?

    check_remedy_uses(item, recipe, crafts)
    tools = remedy_tools(recipe)
    ensure_tools(tools, 'alchemy')
    added = brew_remedy_round(recipe, doses, crafts)
    top_up_remedies(item, doses, recipe, added)
    repair(tools.grep(REMEDY_VESSEL_TOOLS[recipe[:vessel]]), @settings.alchemy_belt)
  end

  # One round of crafts: buys what they need (buy_remedy_supplies, which
  # counts the herbs, brine and coal carried), walks to where her remedies
  # are crafted and crafts them into the stack made before.
  #
  # @param recipe [Hash] the task's recipe
  # @param owed [Integer] doses owed
  # @param crafts [Integer] crafts to make
  # @return [Integer] doses the round added to the stack
  # @raise [SystemExit] from buy_remedy_supplies or brew_remedies
  def brew_remedy_round(recipe, owed, crafts)
    buy_remedy_supplies(recipe, crafts)
    DRCT.walk_to(remedy_room)
    brew_remedies(recipe, owed, crafts)
  end

  # Makes up the doses when the crafts made fewer than owed: extra crafts
  # for the doses still owed, planned at the fewest doses one craft made
  # this run (remedy_top_up_crafts), one round at a time, up to
  # NEZHIRI_TOP_UP_ROUNDS rounds. Before each round's purchases the
  # instructions are checked for a use per extra craft, less the studies
  # this run already made, and when those fall short the uses on every set
  # carried (check_remedy_uses). It stops, the stack in the
  # crafting bag, when a round (the first one included) adds no doses, or
  # when the rounds are spent and the doses still short.
  #
  # @param item [String] the remedy's noun
  # @param owed [Integer] doses owed
  # @param recipe [Hash] the task's recipe
  # @param added [Integer] doses the round before added
  # @return [void]
  # @raise [SystemExit] when the doses can't be made up, the instructions
  #   have too few uses for the extra crafts, or a purchase or craft stops
  def top_up_remedies(item, owed, recipe, added)
    rounds = 0
    while @remedy_doses.to_i < owed
      stop_short_of_remedy(owed, 'The last crafts added no doses, so more of them would not help. ') unless added.positive?
      if rounds >= NEZHIRI_TOP_UP_ROUNDS
        stop_short_of_remedy(owed, "#{NEZHIRI_TOP_UP_ROUNDS} round#{NEZHIRI_TOP_UP_ROUNDS == 1 ? '' : 's'} of extra crafts did not make up the doses. ")
      end
      rounds += 1
      crafts = remedy_top_up_crafts(owed - @remedy_doses.to_i, recipe[:product])
      DRC.message("#{@remedy_doses.to_i} of #{owed} doses of #{recipe[:product]} made: #{crafts} more craft#{crafts == 1 ? '' : 's'} to make.")
      check_remedy_uses(item, recipe, crafts, spent: @remedy_studies.to_i)
      added = brew_remedy_round(recipe, owed, crafts)
    end
  end

  # Extra crafts for a shortfall: planned at the fewest doses one craft
  # made this run (@remedy_yield), never at more than
  # NEZHIRI_DOSES_PER_CRAFT. This run's yield is used even when the one
  # remembered from the last task is smaller: it was made this run, by the
  # character as it is now, so it is the fresher of the two, and the
  # remembered one is replaced by it anyway (remember_remedy_yield). With no craft seen this run (a top-up only
  # follows a round that added doses, so this is a fallback) it plans as
  # the first round did, at remedy_planned_yield.
  #
  # @param short [Integer] doses still owed
  # @param product [String] the remedy's whole name, e.g. 'scale moisturizer'
  # @return [Integer] crafts
  def remedy_top_up_crafts(short, product)
    per_craft = @remedy_yield ? [@remedy_yield, NEZHIRI_DOSES_PER_CRAFT].min : remedy_planned_yield(product)
    nezhiri_crafts(short, per_craft)
  end

  # Doses one craft of a product is planned to make: the fewest one craft
  # made the last time this character crafted it (remembered_remedy_yield),
  # never more than NEZHIRI_DOSES_PER_CRAFT, since no log shows a craft
  # making more; with nothing remembered, NEZHIRI_DOSES_PER_CRAFT. Planning
  # at a yield the character has since outgrown buys supplies for crafts
  # that are not made (brew_remedies stops once the doses owed are made):
  # the herbs, brine and coal stay in the crafting bag, and the next task's
  # purchases count them (buy_remedy_supplies; the herbs only for the same
  # remedy).
  #
  # @param product [String, nil] the remedy's whole name
  # @return [Integer] doses a craft, 1 to NEZHIRI_DOSES_PER_CRAFT
  def remedy_planned_yield(product)
    [remembered_remedy_yield(product) || NEZHIRI_DOSES_PER_CRAFT, NEZHIRI_DOSES_PER_CRAFT].min
  end

  # The fewest doses one craft of a product made in the last run that
  # crafted it, as remember_remedy_yield stored it. Anything stored that is
  # not a Hash of positive whole numbers (unset, or changed by hand) counts
  # as nothing remembered.
  #
  # @param product [String, nil] the remedy's whole name, any case
  # @return [Integer, nil] the doses, nil when none is remembered
  def remembered_remedy_yield(product)
    yields = UserVars.taskmaster_remedy_yields
    return nil unless yields.is_a?(Hash)

    doses = yields[product.to_s.downcase]
    doses if doses.is_a?(Integer) && doses.positive?
  end

  # Stores this run's fewest doses one craft of the product made
  # (@remedy_yield) for the next task's plan, replacing what was stored:
  # the latest yield, not the smallest ever, so a character whose crafts
  # come to make more plans by that. It is stored after each craft that
  # added doses (brew_remedies), not once at the end: @remedy_yield starts
  # each run at nil and only falls, so what is stored once the crafts stop
  # is this run's own fewest, however the run ends after them (a top-up
  # stop, a stop for instruction uses or a purchase, a later craft that
  # fails, a crash). A run whose crafts added nothing leaves it alone.
  #
  # A finish (resume_task) is a run of its own, so its crafts replace what
  # an earlier run of the same task stored, rather than joining it: nothing
  # names the task across runs (the journal's product and count repeat from
  # task to task), and the finish's crafts are the latest seen.
  #
  # @param product [String] the remedy's whole name, any case
  # @return [void]
  # @note UserVars.taskmaster_remedy_yields persists across runs, per
  #   character. A value that is not a Hash is replaced by a new one.
  def remember_remedy_yield(product)
    return unless @remedy_yield.to_i.positive?

    yields = UserVars.taskmaster_remedy_yields
    yields = {} unless yields.is_a?(Hash)
    UserVars.taskmaster_remedy_yields = yields.merge(product.to_s.downcase => @remedy_yield)
  end

  # Stops a task whose crafts made fewer doses than owed, saying how to
  # make the rest. The stack is already in the crafting bag.
  #
  # @param owed [Integer] doses owed
  # @param why [String] what went before, ending in a space
  # @return [void]
  # @raise [SystemExit] always
  def stop_short_of_remedy(owed, why)
    DRC.message("#{why}#{@remedy_doses.to_i} doses made is short of the #{owed} owed. Run ;taskmaster nezhiri finish to make the rest. Stopping.")
    exit
  end

  # The Crossing alchemy shop's rooms and order numbers
  # (base-crafting.yaml remedies).
  #
  # @return [Hash]
  def remedy_shop
    get_data('crafting')['remedies'][NEZHIRI_SUPPLY_TOWN]
  end

  # Where her remedies are crafted: alchemy_room, else the Crossing alchemy
  # supplies, where the herbs are bought.
  #
  # @return [Integer]
  def remedy_room
    @settings.alchemy_room || remedy_shop['stock-room']
  end

  # The alchemy_tools a remedy needs: all of them but the other vessel's
  # two (a mortar task needs no bowl or mixing stick).
  #
  # @param recipe [Hash] the task's recipe
  # @return [Array<String>]
  def remedy_tools(recipe)
    others = REMEDY_VESSEL_TOOLS.reject { |vessel, _| vessel == recipe[:vessel] }.values
    Array(@settings.alchemy_tools).reject { |tool| others.any? { |pattern| tool.match?(pattern) } }
  end

  # Each craft studies the instructions once (remedy's study takes one use;
  # the study of a set's last use leaves the game tossing it, and the next
  # craft's study gets the next set carried). The uses were read off one
  # set, at the start (read_remedy_instructions), so extra crafts
  # (top_up_remedies) take off the studies this run already made. When that
  # leaves fewer uses than crafts to make, every set carried is read afresh
  # (carried_instruction_uses) and their uses added up: a finish's set may
  # have only the uses for the crafts planned (ensure_instructions takes the
  # first set with that many), with another set behind it. Too few uses
  # even then stops the run before anything is bought. None read at the
  # start means nothing to check. A stop for extra crafts leaves the doses
  # made in the crafting bag, where the finish counts them.
  #
  # @param item [String] the remedy's noun
  # @param recipe [Hash] the task's recipe; reads :uses
  # @param crafts [Integer] crafts to make
  # @param spent [Integer] studies made since the uses were read
  # @return [void]
  # @raise [SystemExit] when the sets carried have too few uses
  def check_remedy_uses(item, recipe, crafts, spent: 0)
    return if recipe[:uses].nil?
    return if recipe[:uses] - spent >= crafts

    uses = carried_instruction_uses(item)
    return if uses >= crafts

    needed = "#{crafts} #{spent.positive? ? 'more ' : ''}craft#{crafts == 1 ? ' is' : 's are'} needed"
    made = spent.positive? ? " The #{@remedy_doses.to_i} doses made so far stay in your #{@bag}." : ''
    DRC.message("The #{item} instructions you carry have #{uses} use#{uses == 1 ? '' : 's'} left, and #{needed}.#{made} Ask Nezhiri for another copy (ASK NEZHIRI FOR INSTRUCTIONS), then run ;taskmaster nezhiri finish. Stopping before buying anything#{spent.positive? ? ' more' : ''}.")
    exit
  end

  # Uses left on every set of the remedy's instructions carried in the
  # crafting bag, each got, read and put back (read_carried_instructions,
  # which throws away a set written for someone else). Reading changes the
  # order of the sets in the bag, which does not matter: remedy studies the
  # set in front until the game tosses it, then the next.
  #
  # @param item [String] the remedy's noun
  # @return [Integer] uses on all the sets read; 0 when none is carried or
  #   no READ gave the uses
  def carried_instruction_uses(item)
    total = 0
    read_carried_instructions("#{item} instructions") do |uses|
      total += uses
      false
    end
    total
  end

  # Doses of the task's remedy already in the crafting bag, left from
  # earlier tasks or crafts: every stack there (and in hand) is combined
  # into one, counted, and put back. Notes the stack's id in @remedy_stack
  # and its doses in @remedy_doses.
  #
  # @param recipe [Hash] the task's recipe
  # @return [Integer] doses on hand, 0 for none
  # @raise [SystemExit] from gather_remedy or count_remedy
  def remedy_doses_on_hand(recipe)
    product = recipe[:product]
    stack = gather_remedy(recipe)
    @remedy_stack = stack
    @remedy_doses = stack ? count_remedy(stack, product) : 0
    put_away_remedy(stack, product) if stack
    @remedy_doses
  end

  # Gets every stack of the task's remedy into one hand, combining them:
  # those already held, then each one INVENTORY lists in the crafting bag. The
  # stack noted in @remedy_stack is got by its id first. Anything else held
  # is put in the crafting bag first, so a hand is free for each get. The
  # remedy's vessel in hand is dealt with after the INVENTORY and before the
  # hands are freed (clear_held_vessel): an unfinished remedy in it is
  # carried on, a finished one taken out, and either then counts with the
  # rest.
  #
  # @param recipe [Hash] the task's recipe
  # @return [String, nil] the id of the stack, held; nil when there is none
  # @raise [SystemExit] when the bag holds another item of the remedy's
  #   noun (remedy_stacks_in_bag), the held vessel can't be cleared
  #   (clear_held_vessel), or a stack can't be got or combined
  def gather_remedy(recipe)
    product = recipe[:product]
    bagged = remedy_stacks_in_bag(recipe)
    clear_held_vessel(recipe)
    held = held_remedy_ids(product)
    free_hands_for(product, keep: held)
    stack = held.reduce { |kept, piece| combine_stock(kept, piece, product) }
    bagged.times do |index|
      piece = get_remedy_stack(recipe, index.zero? ? @remedy_stack : nil)
      stack = stack ? combine_stock(stack, piece, product) : piece
    end
    stack
  end

  # LOOK IN the remedy's vessel: what it holds, "In the stone mortar you
  # see some unfinished scale moisturizer." (6101:3436), "... some scale
  # moisturizer." (6101:2017) or "... some crushed aevaes." (6101:4236).
  # Captures what it holds. The logs looked with the vessel's noun ("l in
  # mort" 6101:2016, "look in mort" 6105:613, "l in bowl" 6101:5692); no
  # log looks in anything by id.
  VESSEL_HOLDS = /^In the [^"]+? you see (.+?)\.?$/
  # LOOK IN an empty vessel: "There is nothing in there." (6101:5693, the
  # bowl just back from Rangu).
  VESSEL_EMPTY = /^There is nothing in there\./
  # Every reply LOOK IN the vessel waits for.
  VESSEL_LOOK_REPLIES = [VESSEL_HOLDS, VESSEL_EMPTY, /^I could not find/, /^What were you referring to/].freeze
  # GET <item> FROM the vessel: "You get some scale moisturizer from inside
  # a polished belzune stone mortar which is on your grass toolstrap."
  # (6101:2020), "You get some crushed junliar from inside your rustic
  # mortar." (6105:616). The new id in hand decides, not the reply.
  VESSEL_GET_REPLIES = [/^You get /, /^What were you referring to/, /^I could not find/, /^You need a free hand/].freeze

  # The remedy's vessel (a mortar or a bowl) when a hand holds it, by the
  # noun GameObj gives the hand, never by how its name ends: a "rustic
  # mortar of unpolished soapstone" is a mortar.
  #
  # @param recipe [Hash] the task's recipe; reads :vessel
  # @return [OpenStruct, nil] the hand's object, or nil
  def held_vessel(recipe)
    [GameObj.right_hand, GameObj.left_hand].find { |obj| obj&.noun.to_s.casecmp?(recipe[:vessel]) }
  end

  # remedy, when it stops part way, leaves the vessel in hand with the
  # unfinished remedy in it, and so does a crash. Freeing the hands would
  # put it in the crafting bag, and the run would buy and craft afresh with
  # the unfinished one forgotten. So with the remedy's vessel in hand it is
  # looked in first, and what it holds decides:
  # - an unfinished remedy of the task: carried on with remedy's continue
  #   form (continue_remedy); the remedy it makes is left in hand;
  # - the finished remedy (left in it, never tilted out: TILT destroys it,
  #   6101:620-626): taken out and left in hand;
  # - the herb alone, crafting never begun: the herb goes in the crafting
  #   bag, where it counts as a stack carried, and the vessel is put away;
  # - nothing: the vessel is put away.
  # Anything else, or no answer, stops the run with the vessel in hand.
  #
  # @param recipe [Hash] the task's recipe
  # @return [void]
  # @raise [SystemExit] when the vessel holds something else or does not
  #   answer, a continue run ends without the remedy, or a get or a put
  #   away fails
  def clear_held_vessel(recipe)
    held = held_vessel(recipe)
    return unless held

    contents = look_in_vessel(recipe)
    case vessel_state(recipe, contents)
    when :unfinished
      continue_remedy(recipe, held, contents, 1)
    when :finished
      take_from_vessel(recipe, held, recipe[:noun])
      put_vessel_away(recipe, held)
    when :herb
      put_away_remedy(take_from_vessel(recipe, held, recipe[:stock]), recipe[:stock])
      put_vessel_away(recipe, held)
    when :empty
      put_vessel_away(recipe, held)
    else
      stop_for_vessel(recipe, held, contents)
    end
  end

  # LOOK IN the remedy's vessel, asked once more when unanswered.
  #
  # @param recipe [Hash] the task's recipe; reads :vessel
  # @return [String] the reply, '' when unanswered twice
  def look_in_vessel(recipe)
    look = "look in my #{recipe[:vessel]}"
    reply = DRC.bput(look, *VESSEL_LOOK_REPLIES)
    reply = DRC.bput(look, *VESSEL_LOOK_REPLIES) if reply.empty?
    reply
  end

  # What a LOOK IN the vessel shows, for this task's remedy.
  #
  # @param recipe [Hash] the task's recipe; reads :product and :stock
  # @param contents [String] the LOOK reply
  # @return [Symbol] :unfinished, :finished, :herb, :empty, or :other for
  #   anything else (another remedy, more than one thing, no answer)
  def vessel_state(recipe, contents)
    return :empty if contents.match?(VESSEL_EMPTY)

    what = contents[VESSEL_HOLDS, 1].to_s
    product = Regexp.escape(recipe[:product])
    return :other if what.empty? || what.include?(' and ') || what.include?(',')
    return :unfinished if what.match?(/\A(?:some |an? )?unfinished #{product}\z/i)
    return :finished if what.match?(/\A(?:some |an? )?#{product}\z/i)
    return :herb if what.match?(/\A(?:some |an? )?(?:\w+ )?#{Regexp.escape(recipe[:stock])}\z/i)

    :other
  end

  # Carries an unfinished remedy in the held vessel on, once: makes sure the
  # brine and the coal nugget it may still ask for are on hand (buying them
  # as buy_remedy_supplies does, the vessel kept in hand), walks to where
  # remedies are crafted and runs ;remedy continue na "coal nugget"
  # <vessel> <noun>. remedy gets the stirrer, starts with "analyze my
  # <noun>" (6105:724-731) and crafts on, adding what the game asks for; it
  # ends with the remedy in hand and the vessel put away (put away here if
  # remedy left it in hand). A run that ends without the remedy stops:
  # remedy's own Remedy: line says why, and a second continue would only
  # meet the same trouble.
  #
  # @param recipe [Hash] the task's recipe
  # @param held [OpenStruct] the vessel, held
  # @param contents [String] the LOOK reply, for the message
  # @param crafts [Integer] crafts the supplies must cover, this one first
  # @return [String] the id of the remedy made
  # @raise [SystemExit] when a purchase fails or remedy leaves no remedy in
  #   hand
  def continue_remedy(recipe, held, contents, crafts)
    product = recipe[:product]
    keep = [held.id].compact
    free_hands_for(product, keep: keep)
    buy_remedy_supplies(recipe, crafts, herbs: false, keep: keep)
    DRCT.walk_to(remedy_room)
    DRC.message("#{contents} Carrying it on with ;remedy continue.")
    DRC.wait_for_script_to_complete('remedy', remedy_continue_args(recipe))
    made = held_remedy_ids(product).first
    if made
      put_vessel_away(recipe, held) if held.id && hand_ids.include?(held.id)
      return made
    end

    DRC.message("remedy's continue run left no #{product} in your hands either; its Remedy: line says why. taskmaster carries an unfinished remedy on only once. Once that is sorted, run ;taskmaster nezhiri finish. Stopping.")
    exit
  end

  # What remedy's continue form is run with: herb2 na, the coal nugget, the
  # vessel and the noun (remedy.lic CONTINUE_FORM).
  #
  # @param recipe [Hash] the task's recipe
  # @return [Array<String>]
  def remedy_continue_args(recipe)
    ['continue', 'na', NEZHIRI_CATALYST, recipe[:vessel], recipe[:noun]]
  end

  # Gets something out of the held vessel into the other hand: GET MY
  # <item> FROM MY <vessel>, as the logs did ("get moist from mort",
  # 6101:2019; "get jun in my mort", 6105:615).
  #
  # @param recipe [Hash] the task's recipe; reads :vessel
  # @param held [OpenStruct] the vessel, held
  # @param item [String] what to get, e.g. 'moisturizer' or 'red flowers'
  # @return [String] the id of what came into a hand
  # @raise [SystemExit] when no hand can be freed or nothing new is held
  def take_from_vessel(recipe, held, item)
    free_hands_for(item, keep: [held.id].compact)
    before = hand_ids
    DRC.bput("get my #{item} from my #{recipe[:vessel]}", *VESSEL_GET_REPLIES)
    piece = (hand_ids - before).first
    return piece if piece

    DRC.message("Could not get the #{item} out of your #{held.name}, which is left in your hands. Stopping.")
    exit
  end

  # Puts the vessel away as remedy does: tied to alchemy_belt when it lists
  # it, else in the crafting bag.
  #
  # @param recipe [Hash] the task's recipe; reads :vessel
  # @param held [OpenStruct] the vessel, held
  # @return [void]
  # @raise [SystemExit] when it is still in hand
  def put_vessel_away(recipe, held)
    DRCC.stow_crafting_item(recipe[:vessel], @bag, @settings.alchemy_belt)
    return unless held.id ? hand_ids.include?(held.id) : held_vessel(recipe)

    DRC.message("Could not put your #{held.name} away. Stopping.")
    exit
  end

  # Stops with the vessel in hand when what it holds is not something
  # taskmaster carries on, naming remedy's continue line.
  #
  # @param recipe [Hash] the task's recipe
  # @param held [OpenStruct] the vessel, held
  # @param contents [String] the LOOK reply, '' for none
  # @param why [String] what came before, to start the message with
  # @raise [SystemExit] always
  def stop_for_vessel(recipe, held, contents, why = '')
    vessel = recipe[:vessel]
    noun = recipe[:noun]
    seen = contents.empty? ? 'LOOK IN went unanswered twice' : "the game said \"#{contents}\""
    DRC.message("#{why}Your #{held.name} is in your hands, and taskmaster can't carry on what is in it (#{seen}). If it holds an unfinished #{noun}, finish it with ;remedy continue na \"#{NEZHIRI_CATALYST}\" #{vessel} #{noun}; if not, empty it or put it away. Then run ;taskmaster nezhiri finish. Stopping, with the #{vessel} left in hand.")
    exit
  end

  # How many stacks of the task's remedy the crafting bag holds, from one
  # INVENTORY of it (container_listing), by their noun (sort_listed).
  # Another item there with the same noun but another name (a healing
  # potion when the remedy is landsickness potion) stops the run: remedy
  # and the hand-in work the remedy by its noun, so it could be crafted
  # into, combined or handed in. So does an item whose name holds the noun
  # but with no noun read off it at all (unread in sort_listed), as it may
  # be one of the noun; it is named. One whose noun reads as another is not
  # one they would take, and does not count: the task's own instructions
  # ("some gill glop instructions", noun "instructions"), or "a cracked
  # black leather draught holster set with a vivid fire whirl ruby". get_noun
  # read the noun of every glop, moisturizer, potion and draught logged in
  # November 2026 right. An INVENTORY with no answer is asked once more;
  # unanswered twice it stops the run, since taking it for an empty bag
  # would craft doses already made, or leave them out of the hand-in. On
  # the stop the hands are emptied, but for the remedy's vessel, which may
  # hold an unfinished remedy the next run carries on (clear_held_vessel).
  #
  # @param recipe [Hash] the task's recipe
  # @return [Integer] stacks of the remedy in the bag
  # @raise [SystemExit] when another item may have the remedy's noun, or
  #   INVENTORY went unanswered twice
  def remedy_stacks_in_bag(recipe)
    noun = recipe[:noun]
    lines = container_listing(@bag)
    lines = container_listing(@bag) if lines.nil?
    stop_stock("Could not look for #{recipe[:product]} in your #{@bag}: INVENTORY went unanswered twice.") if lines.nil?
    ours = count_listed(lines, recipe[:product])
    sorted = sort_listed(lines, noun)
    unread = sorted[:unread]
    others = sorted[:of_kind].size - ours + unread.size
    return ours if others.zero?

    DRCI.stow_hands unless held_vessel(recipe)
    DRC.message("Your #{@bag} holds #{others} #{noun}#{others == 1 ? '' : 's'} that #{others == 1 ? 'is' : 'are'} not #{recipe[:product]}. remedy and the hand-in find the #{recipe[:product]} by its noun, so they could take #{others == 1 ? 'it' : 'them'} instead. Move #{others == 1 ? 'it' : 'them'} out of your #{@bag}, then start again. Stopping before buying anything.#{unread_note(noun, unread)}")
    exit
  end

  # The ids of the stacks of a remedy in hand: the hand's GameObj noun is
  # the remedy's (NEZHIRI_ITEMS' :noun, "glop" for gill glop; lich-5's
  # DRC.get_noun of the name for a product not listed there), and the
  # remedy's other words ("gill") are whole words of the hand's name, so a
  # healing potion is not taken for landsickness potion. A remedy whose
  # name gives no noun has none in hand.
  #
  # Whether a held stack is unfinished is not read: the hand text never
  # says so (the game shows a "coil of unfinished burlap reinforced rope"
  # in hand as "reinforced rope"), and an unfinished remedy stays in its
  # vessel ("In the stone mortar you see some unfinished scale
  # moisturizer.", 6101:3436), where clear_held_vessel looks for it; remedy
  # only takes the finished one out.
  #
  # @param product [String] e.g. 'gill glop'
  # @return [Array<String>] right hand first
  def held_remedy_ids(product)
    noun = (NEZHIRI_ITEMS.dig(product.to_s.downcase, :noun) || DRC.get_noun(product)).to_s.downcase
    return [] if noun.empty?

    kind = name_words(product) - [noun]
    [GameObj.right_hand, GameObj.left_hand].filter_map do |obj|
      next unless obj&.id && obj.noun.to_s.casecmp?(noun)

      obj.id if (kind - name_words(obj.name)).empty?
    end
  end

  # Gets one stack of the remedy out of the crafting bag: by id when one is
  # known and not already held, else by the remedy's noun, the way the logs
  # got it ("get my glop from my leather satchel" took a second stack with
  # one already held, 6100:9365-9366). No log gets a remedy by its whole
  # name ("get my deep-sea draught"), and the noun is safe: the run has
  # already stopped if the bag holds any other item of that noun
  # (remedy_stacks_in_bag), and the instructions' noun is "instructions".
  # The new id in
  # hand is the stack; the get's answer is not read, since with a stack
  # already held it is true either way. What the known id brought is kept
  # only when it is this remedy: the id may be the piece cut off another
  # remedy for an earlier task (a gill glop left over, on a deep-sea
  # draught task), which goes back in the bag.
  #
  # @param recipe [Hash] the task's recipe; reads :product and :noun
  # @param known [String, nil] the id of a stack known to be in the bag
  # @return [String] the id of the stack got
  # @raise [SystemExit] when no new stack came into a hand, or another
  #   remedy got by the known id would not go back in the bag
  def get_remedy_stack(recipe, known)
    product = recipe[:product]
    before = hand_ids
    if known && !before.include?(known)
      DRCI.get_item?("##{known}", @bag)
      piece = (hand_ids - before).first
      return piece if piece && held_remedy_ids(product).include?(piece)

      put_away_remedy(piece, product) if piece
    end

    DRCI.get_item?(recipe[:noun], @bag)
    piece = (hand_ids - before).first
    return piece if piece

    stop_stock("Could not get the #{product} out of your #{@bag}.")
  end

  # Doses in a remedy stack, counted by its id. A COUNT with no answer is
  # asked once more.
  #
  # @param id [String] the stack's id
  # @param product [String] e.g. 'gill glop', for the stop message
  # @return [Integer] its doses
  # @raise [SystemExit] when the stack is not found or the count can't be
  #   read (whatever is held goes back in the crafting bag)
  def count_remedy(id, product)
    reply = DRC.bput("count ##{id}", *REMEDY_COUNT_REPLIES)
    reply = DRC.bput("count ##{id}", *REMEDY_COUNT_REPLIES) if reply.empty?
    return reply[REMEDY_COUNT, 1].to_i if reply.match?(REMEDY_COUNT)

    stop_stock("Could not count the #{product} (##{id}): #{reply.empty? ? 'COUNT went unanswered twice' : "the game said \"#{reply}\""}.")
  end

  # Puts a remedy stack in the crafting bag by its id.
  #
  # @param id [String] the stack's id
  # @param product [String] e.g. 'gill glop', for the stop message
  # @return [void]
  # @raise [SystemExit] when it would not go in
  def put_away_remedy(id, product)
    ref = "##{id}"
    return if DRCI.put_away_item?(ref, @bag) || left_hands?(ref)

    stop_stock("Could not put the #{product} (#{ref}) in your #{@bag}.")
  end

  # Buys what the crafts need and are not on hand, after one check that the
  # money is there: brine on Andreshlew, until its parts cover a splash per
  # craft; then in Crossing a coal nugget when the ones carried have too
  # few rubs left for the crafts, and water and alcohol when missing
  # (remedy would otherwise buy them at the hometown's shop, which may be a
  # long way off, even when the remedy does not use them), and one 25-piece
  # herb stack per craft, less the full stacks carried. Each goes in the
  # crafting bag.
  #
  # @param recipe [Hash] the task's recipe; reads :stock, :order, :price
  # @param crafts [Integer] crafts to make
  # @param herbs [Boolean] false to buy no herbs (a continue run: the herb
  #   is already in the vessel)
  # @param keep [Array<String>] ids to keep in hand while buying (the
  #   vessel with an unfinished remedy in it)
  # @return [void]
  # @raise [SystemExit] when the money can't be had or a purchase fails
  def buy_remedy_supplies(recipe, crafts, herbs: true, keep: [])
    brines = brines_to_buy(crafts)
    supplies = missing_remedy_supplies(crafts)
    stacks = herbs ? [crafts - (DRCI.count_item_parts(recipe[:stock]) / NEZHIRI_HERB_STACK), 0].max : 0
    cost = (brines * BRINE_PRICE) + (stacks * recipe[:price].to_i) + supplies.sum { |supply| supply[:price] }
    note = kept_vessel_note(recipe) unless keep.empty?
    afford(cost + NEZHIRI_SPARE_COPPER, keep_hands: !keep.empty?, note: note) if cost.positive?
    buy_brines(brines, keep: keep, note: note)
    supplies.each { |supply| order_remedy_supply(supply[:room], supply[:number], supply[:name], keep: keep, note: note) }
    stacks.times { order_remedy_supply(remedy_shop['stock-room'], recipe[:order], recipe[:stock]) }
  end

  # What to do about the vessel a continue keeps in hand when a purchase
  # stops the run: the unfinished remedy is still in it, and remedy's
  # continue form finishes it once the supplies are there. A purchase stop
  # that put the vessel away would leave the unfinished remedy in the bag,
  # where clear_held_vessel, which looks only at a held vessel, never finds
  # it again.
  #
  # @param recipe [Hash] the task's recipe; reads :vessel and :noun
  # @return [String]
  def kept_vessel_note(recipe)
    vessel = recipe[:vessel]
    name = held_vessel(recipe)&.name || vessel
    "Your #{name} is left in your hands with the unfinished #{recipe[:noun]} in it: once you have the supplies, " \
      "finish it with ;remedy continue na \"#{NEZHIRI_CATALYST}\" #{vessel} #{recipe[:noun]}, then run ;taskmaster nezhiri finish."
  end

  # Brines to buy so the parts carried cover a splash for each craft.
  # DRCI.count_item_parts adds up every brine carried ("There is only one
  # part left of the brewer's brine.", 6100:8665).
  #
  # @param crafts [Integer] crafts to make
  # @return [Integer]
  def brines_to_buy(crafts)
    short = crafts - DRCI.count_item_parts('brine')
    short.positive? ? (short + BRINE_PARTS - 1) / BRINE_PARTS : 0
  end

  # The Crossing supplies remedy would buy itself because none is on hand:
  # plain water and alcohol (none when water_container or
  # alcohol_container names a vessel, which remedy fills instead), and the
  # coal nugget. A coal nugget is bought too when the ones carried have
  # fewer rubs left than crafts (coal_rubs): one runs out part way, and
  # remedy would then buy one at the hometown's shop. The coal nugget comes
  # first, so the walk ends at the alchemy supplies, where the herbs are
  # ordered.
  #
  # @param crafts [Integer] crafts to make, one rub of coal each
  # @return [Array<Hash>] each with :name, :room, :number and :price
  def missing_remedy_supplies(crafts)
    shop = remedy_shop
    wanted = []
    wanted << { name: NEZHIRI_CATALYST, room: shop['catalyst-room'], number: shop['catalyst_number'], stock: 'coal' } if coal_rubs(crafts) < crafts
    wanted << { name: 'water', room: shop['stock-room'], number: shop['stock-number'], stock: 'water' } if @settings.water_container.nil? && !DRCI.exists?('water')
    wanted << { name: 'alcohol', room: shop['stock-room'], number: shop['stock-number-a'], stock: 'alcohol' } if @settings.alcohol_container.nil? && !DRCI.exists?('alcohol')
    wanted.each { |supply| supply[:price] = @stockdata.dig(supply[:stock], 'stock-value').to_i }
  end

  # Rubs left in the coal nuggets carried, from the size TAP shows
  # (COAL_RUBS), tapping the first, the second and so on until none is
  # found or the rubs cover the crafts. A TAP with no answer ends the count.
  #
  # @param crafts [Integer] crafts to make
  # @return [Integer] rubs counted, 0 with no nugget
  def coal_rubs(crafts)
    rubs = 0
    $ORDINALS.each do |ordinal|
      size = DRC.bput("tap my #{ordinal} #{NEZHIRI_CATALYST}", *COAL_TAP_REPLIES)[COAL_TAPPED, 1]
      break unless size

      rubs += COAL_RUBS.fetch(size, 1)
      break if rubs >= crafts
    end
    rubs
  end

  # Buys brines at the Andreshlew alchemists and puts each in the crafting
  # bag. DRCT.buy_item returns nothing useful after "You decide to
  # purchase", so the hand says whether it was bought.
  #
  # @param count [Integer] brines to buy
  # @param keep [Array<String>] ids the stop leaves in hand (stop_buying)
  # @param note [String, nil] said before the stop
  # @return [void]
  # @raise [SystemExit] when one was not bought
  def buy_brines(count, keep: [], note: nil)
    count.times do
      DRCT.buy_item(NEZHIRI_BRINE_ROOM, 'brine')
      stop_buying("brewer's brine at Andreshlew (room #{NEZHIRI_BRINE_ROOM})", keep: keep, note: note) unless held_soon?('brine')
      DRCC.stow_crafting_item('brine', @bag, nil)
    end
  end

  # Orders one supply and puts it in the crafting bag by the id that came
  # into a hand.
  #
  # @param room [Integer] the shop's room
  # @param number [Integer] the order number
  # @param name [String] what it is, for messages
  # @param keep [Array<String>] ids to keep in hand, on a stop too
  # @param note [String, nil] said before a stop
  # @return [void]
  # @raise [SystemExit] when no hand is free, the order fails or it would
  #   not go in the bag
  def order_remedy_supply(room, number, name, keep: [], note: nil)
    free_hands_for(name, keep: keep)
    piece = order_stock_piece(room, number, name, keep: keep, note: note)
    return if DRCI.put_away_item?("##{piece}", @bag) || left_hands?("##{piece}")

    stop_stock("Could not put the #{name} you bought (##{piece}) in your #{@bag}.", keep: keep, note: note)
  end

  # Crafts the remedy with remedy's instructions form, once per craft, and
  # combines each new stack into the one made before (or the doses on hand),
  # counting the doses after each and putting the stack back in the
  # crafting bag so remedy has both hands. Stops crafting once the doses
  # cover the task. A craft that ends without the remedy in hand is looked
  # after by remedy_left_in_vessel: an unfinished remedy is carried on
  # once. Crafts that make fewer doses than owed do not stop the run: the
  # doses made are said and returned, and nezhiri makes up the rest
  # (top_up_remedies). Notes the stack in @remedy_stack and its doses in
  # @remedy_doses, counts each craft's study in @remedy_studies, and keeps
  # the fewest doses one craft added in @remedy_yield, remembered for the
  # next task after each craft (remember_remedy_yield).
  #
  # @param recipe [Hash] the task's recipe
  # @param owed [Integer] doses owed
  # @param crafts [Integer] crafts to make
  # @return [Integer] doses the crafts added to the stack
  # @raise [SystemExit] when a craft leaves no remedy in hand and none can
  #   be had from the vessel, or a stack can't be combined or counted
  def brew_remedies(recipe, owed, crafts)
    product = recipe[:product]
    stack = @remedy_stack
    start = doses = @remedy_doses.to_i
    crafts.times do |craft|
      @remedy_studies = @remedy_studies.to_i + 1
      DRC.wait_for_script_to_complete('remedy', remedy_args(recipe))
      made = held_remedy_ids(product).first || remedy_left_in_vessel(recipe, craft + 1, crafts)
      stack = stack ? combine_remedy(stack, made, product) : made
      before = doses
      doses = count_remedy(stack, product)
      put_away_remedy(stack, product)
      @remedy_stack = stack
      @remedy_doses = doses
      note_remedy_yield(doses - before)
      remember_remedy_yield(product)
      break if doses >= owed
    end
    DRC.message("#{doses} doses of #{product} made and combined into one.")
    doses - start
  end

  # Keeps the fewest doses one craft has added this run in @remedy_yield;
  # a craft that added none is not a yield to plan by.
  #
  # @param gain [Integer] doses one craft added
  # @return [void]
  def note_remedy_yield(gain)
    @remedy_yield = [@remedy_yield, gain].compact.min if gain.positive?
  end

  # What remedy is run with: its instructions form, the herb, the coal
  # nugget, the vessel, the noun and a 25-piece herb stack.
  #
  # @param recipe [Hash] the task's recipe
  # @return [Array<String>]
  def remedy_args(recipe)
    ['instructions', recipe[:herb], NEZHIRI_CATALYST, recipe[:vessel], recipe[:noun], NEZHIRI_HERB_STACK.to_s]
  end

  # Gets the stack made before out of the crafting bag by its id and
  # combines the new one into it.
  #
  # @param stack [String] the id of the stack made before, in the bag
  # @param made [String] the id of the new stack, in hand
  # @param product [String] e.g. 'gill glop'
  # @return [String] the id of the combined stack
  # @raise [SystemExit] when it can't be got or the two won't combine
  def combine_remedy(stack, made, product)
    DRCI.get_item?("##{stack}", @bag)
    stop_stock("Could not get the #{product} made before (##{stack}) out of your #{@bag} to combine the new one with it.") unless hand_ids.include?(stack)

    combine_stock(stack, made, product)
  end

  # remedy ended without the remedy in hand: it stopped and said why in its
  # Remedy: line. When it stopped part way it left the vessel in hand, the
  # unfinished remedy in it: that is looked in, and an unfinished remedy is
  # carried on once (continue_remedy), with brine and coal for this craft
  # and the ones still to come; a finished one left in it is taken out.
  # Anything else stops the run: the vessel not in hand (remedy stopped
  # before it got that far), empty, or holding only the herb (crafting
  # never began, and running remedy again would meet the same trouble).
  #
  # @param recipe [Hash] the task's recipe
  # @param craft [Integer] which craft it was
  # @param crafts [Integer] crafts to make
  # @return [String] the id of the remedy, held
  # @raise [SystemExit] unless a remedy could be had from the vessel
  def remedy_left_in_vessel(recipe, craft, crafts)
    why = "remedy did not leave any #{recipe[:product]} in your hands (craft #{craft} of #{crafts}); its Remedy: line says why. "
    held = held_vessel(recipe)
    unless held
      DRC.message("#{why}Once that is sorted, run ;taskmaster nezhiri finish. Stopping.")
      exit
    end

    contents = look_in_vessel(recipe)
    case vessel_state(recipe, contents)
    when :unfinished
      continue_remedy(recipe, held, contents, crafts - craft + 1)
    when :finished
      made = take_from_vessel(recipe, held, recipe[:noun])
      put_vessel_away(recipe, held)
      made
    else
      stop_for_vessel(recipe, held, contents, why)
    end
  end

  # Makes the hand-in ready: every stack of the remedy, held or in the
  # crafting bag, combined into one and counted. Too few doses: it goes
  # back in the bag and there is nothing to hand in. Too many: it is cut to
  # the doses owed (trim_remedy), the rest going back in the bag for a
  # later task. The stack to give ends in the right hand, its id noted in
  # @remedy_hand_in. Notes the doses counted in @remedy_doses.
  #
  # @param item [String] the remedy's noun
  # @param owed [Integer] doses owed
  # @return [Boolean] whether the right hand holds the stack to give
  # @raise [SystemExit] when a stack can't be got, combined, counted or cut
  def remedy_hand_in?(item, owed)
    product = @task_product.to_s.downcase
    recipe = nezhiri_recipe(product, item).merge(product: product)
    stack = gather_remedy(recipe)
    @remedy_hand_in = nil
    @remedy_stack = stack
    @remedy_doses = stack ? count_remedy(stack, product) : 0
    if @remedy_doses < owed
      DRC.message("#{@remedy_doses} of the #{owed} doses of #{product} owed are on hand: not enough to hand in yet.")
      put_away_remedy(stack, product) if stack
      return false
    end
    stack = trim_remedy(stack, owed, recipe) if @remedy_doses > owed
    unless move_to_right_hand(stack)
      put_away_remedy(stack, product)
      DRC.message("Could not get the #{product} (##{stack}) into your right hand to hand it in; it is back in your #{@bag}.")
      return false
    end

    @remedy_hand_in = stack
    true
  end

  # Cuts a remedy stack down to the doses owed: MARK <noun> AT <doses>, then
  # BREAK <noun>, which leaves two stacks in hand. Which hand holds the
  # piece of the doses owed is not in the logs, so each is counted by its id
  # until one holds them; the other goes back in the crafting bag, and is
  # noted in @remedy_stack for a later task.
  #
  # @param stack [String] the id of the stack, held alone
  # @param owed [Integer] doses owed
  # @param recipe [Hash] the task's recipe
  # @return [String] the id of the stack of the doses owed
  # @raise [SystemExit] when the mark or the break is refused, or no stack
  #   counts the doses owed
  def trim_remedy(stack, owed, recipe)
    product = recipe[:product]
    marked = DRC.bput("mark my #{recipe[:noun]} at #{owed}", REMEDY_MARKED, /^You can't/, /^What were you referring to/)
    stop_stock("Could not mark the #{product} (##{stack}) at #{owed} doses#{marked.empty? ? '' : " (#{marked})"}.") unless marked.match?(REMEDY_MARKED)
    broken = DRC.bput("break my #{recipe[:noun]}", REMEDY_BROKEN, /^You can't/, /^What were you referring to/)
    stop_stock("Could not break the #{product} down to #{owed} doses#{broken.empty? ? '' : " (#{broken})"}.") unless broken.match?(REMEDY_BROKEN)

    pieces = held_remedy_ids(product)
    kept = pieces.find { |id| count_remedy(id, product) == owed }
    stop_stock("After the break, no #{product} in your hands counts #{owed} doses.") unless kept
    rest = pieces - [kept]
    rest.each { |id| put_away_remedy(id, product) }
    @remedy_stack = rest.first
    kept
  end

  # Moves a held item to the right hand by its id: GIVE <taskmaster> with
  # no object hands over the right hand, and Nezhiri ignores a give from
  # the left (6106:1800). SWAP moves it ("You move some gill glop to your
  # right hand.", 6106:1805).
  #
  # @param id [String, nil] the item's id
  # @return [Boolean] whether the right hand holds it
  def move_to_right_hand(id)
    return false unless id

    DRC.bput('swap', /^You move/, /^You have nothing/) if GameObj.left_hand&.id == id
    GameObj.right_hand&.id == id
  end

  # Nezhiri said the remedy given holds the wrong number of doses, and how
  # many she asked for. The first time, the hand-in is made ready again for
  # that many (gathering every stack again, so a COMBINE takes in the rest,
  # and a CUT cuts it down). The second time the stack goes back in the
  # crafting bag and the run stops, rather than give the same wrong size
  # over and over.
  #
  # @param item [String] the remedy's noun
  # @param reply [String] her refusal, GIVE_WRONG_AMOUNT
  # @param retried [Boolean] whether it was made ready again already
  # @return [Integer] the doses she asked for
  # @raise [SystemExit] when retried
  def remedy_amount_off(item, reply, retried)
    asked = reply[GIVE_WRONG_AMOUNT, 1].to_i
    held = @remedy_hand_in
    @remedy_hand_in = nil
    unless retried
      DRC.message("Nezhiri wants #{asked} doses turned in as a single #{item}; making it that size.")
      return asked
    end

    put_away_remedy(held, item) if held && hand_ids.include?(held)
    DRC.message("Nezhiri still says the amount is off: she asked for #{asked} doses as a single #{item}, and taskmaster could not hand her that. The #{item} is back in your #{@bag}. Stopping.")
    exit
  end

  # Finishes a task already in progress, for instance after a crash or a
  # reconnect: hand in any finished items already in the bag, make sure the
  # instructions have a use for every item still owed (asking the taskmaster
  # only when they don't, since replacements are limited), then make and hand
  # in the rest. A finish run, and a run that does one task, end here; a
  # run that goes on to further tasks (repeat, cycle, marathon) has it
  # return instead, so its loop asks for the next. In marathon the items are
  # made from the carried stock (marathon_tailor), not with the zasele
  # worker, which would buy stock for the task and bin the carried stack
  # with its leftovers.
  #
  # @param exit_when_done [Boolean] whether to end the script once the task
  #   is handed in (true for finish and single task runs); false returns
  # @return [void] only with exit_when_done false, once the task is handed in
  # @raise [SystemExit] when not on a task; when the journal shows nothing
  #   owed but nothing could be handed in (the task stays open, so a run
  #   that went on would only be told so again); from check_task_giver, the
  #   worker or complete_task when they stop; and with exit_when_done when
  #   the banked items finish it or after the last item is handed in
  # @raise [UncaughtThrowError] never: with task_cancel_foreign_tasks, a
  #   task for another taskmaster is cancelled and FOREIGN_TASK_CANCELLED
  #   thrown, caught in get_task and finish_task_in_progress
  def resume_task(exit_when_done: true)
    @dispose, @remainder = [false, false]
    @task_handed_in = false
    item, owed = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    check_task_giver
    set_aside_held_base(item)
    owed = turn_in_banked(item, owed)
    if owed.zero?
      # read_task counts nothing owed once the journal shows every item
      # returned, and turn_in_banked then returns 0 without a hand-in when
      # there is nothing to give: the task is still open.
      unless @task_handed_in
        DRC.message("Your task journal shows nothing more owed to #{@npc.capitalize}, but nothing could be handed in, so the task is still open. Stopping.")
        exit
      end
      exit if exit_when_done
      return
    end

    # Before new instructions or a bank trip: anything of the task's noun
    # still in the loot bag now was not taken at the hand-in.
    check_loot_bag_clear(hand_in_noun(item)) if @npc == 'dorhum'

    # Nezhiri's doses already on hand (counted by the hand-in above) need
    # no instructions use.
    ensure_instructions(item, @npc == 'nezhiri' ? owed - @remedy_doses.to_i : owed)
    item, count, volume_per_item, base, type = read_instructions(item, owed)
    refresh_haste
    top_up_copper
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    if @marathon
      marathon_tailor(item, count, volume_per_item, base, type)
    else
      send(@npc.to_sym, item, count, volume_per_item, base, type)
    end
    complete_task(item, count)
    exit if exit_when_done
  end

  # The task in progress may be another taskmaster's (";taskmaster zasele"
  # while on one of Dorhum's tasks, say). A run never works another
  # taskmaster's task: its items, tools and hand-in are theirs, and a
  # character set up for one craft may not be for another. So it says whose
  # task it is and how to clear it, and stops. With task_cancel_foreign_tasks
  # it cancels that task instead, waits out the cooldown a cancel brings,
  # and goes back to asking its own taskmaster.
  #
  # @return [void]
  # @raise [SystemExit] when the journal names another taskmaster and
  #   task_cancel_foreign_tasks is off
  # @raise [UncaughtThrowError] never: with task_cancel_foreign_tasks, throws
  #   FOREIGN_TASK_CANCELLED, caught in get_task and finish_task_in_progress
  def check_task_giver
    giver = @task_giver
    return if giver.nil? || giver == @npc

    cancel_foreign_task(giver) if @cancel_foreign_tasks
    DRC.message("#{another_taskmasters_task_message(giver)} Or set task_cancel_foreign_tasks to have taskmaster cancel such tasks itself.")
    exit
  end

  # @param giver [String] the taskmaster the journal names
  # @return [String] whose task it is, and how to finish or cancel it
  def another_taskmasters_task_message(giver)
    name = giver.capitalize
    finish = TASKMASTERS.include?(giver) ? "Finish it with ;taskmaster #{giver}" : "#{name} is not a taskmaster this script does, so finish it yourself"
    "You are on a task for #{name}, not #{@npc.capitalize}. #{finish}, or cancel it with ASK #{giver.upcase} FOR TASK CANCEL (taskmasters then refuse you for about ten minutes)."
  end

  # A taskmaster's refusal after a task was cancelled, sent as two lines:
  # "Word has traveled.  You are unreliable.  Perhaps I'll give" /
  # "you a chance a little later." (Zasele, 2026-11-03), so the older
  # one-line "give you a chance a little later" never matched it.
  TASK_UNRELIABLE = /You are unreliable/
  # Unknown replies in a row to ASK FOR TASK before get_task stops.
  MAX_UNKNOWN_TASK_REPLIES = 3

  # Thrown (and caught in get_task and finish_task_in_progress) once another
  # taskmaster's task has been cancelled, so the run goes back to asking its
  # own taskmaster.
  FOREIGN_TASK_CANCELLED = :taskmaster_foreign_task_cancelled
  # The taskmaster's replies to ASK <taskmaster> FOR TASK CANCEL (Dorhum,
  # 2026-11-03): the first asks to confirm within fifteen seconds, the second
  # cancels, and with no task there is nothing to cancel. They are speech
  # ('Researcher Dorhum says, "Very well, I see that you no longer wish to
  # assist me."'), so cancel_reply matches them only after the taskmaster's
  # name; a player saying the words does not count.
  TASK_CANCEL_CONFIRM = 'ask me again within fifteen seconds'
  TASK_CANCELLED = 'I see that you no longer wish to assist me'
  TASK_CANCEL_NONE = 'You do not currently have a task'
  # How long taskmasters call you unreliable after a cancel: about ten
  # minutes, the figure players go by, and what Mahtra's log shows (cancel
  # 18:45:30, refused until 18:54:47, offered a task at 18:56:00).
  CANCEL_COOLDOWN_SECONDS = 600

  # Cancels another taskmaster's task (task_cancel_foreign_tasks), waits out
  # the cooldown a cancel brings, and sends the run back to asking its own
  # taskmaster.
  #
  # @param giver [String] the taskmaster whose task it is
  # @return [void]
  # @raise [UncaughtThrowError] never: throws FOREIGN_TASK_CANCELLED, caught
  #   in get_task and finish_task_in_progress
  # @raise [SystemExit] when the cancel does not go through
  def cancel_foreign_task(giver)
    cancel_task(giver, @task_item)
    DRC.message("Waiting #{CANCEL_COOLDOWN_SECONDS / 60} minutes: after a cancel, taskmasters call you unreliable for about that long.")
    pause CANCEL_COOLDOWN_SECONDS
    throw FOREIGN_TASK_CANCELLED
  end

  # Cancels the task with ASK <giver> FOR TASK CANCEL, asked twice as the
  # game wants, then throws its instructions away and clears its
  # replacement record.
  #
  # @param giver [String] the taskmaster whose task it is
  # @param item [String, nil] the task item's noun, for the instructions
  # @return [void]
  # @raise [SystemExit] when the cancel does not go through
  def cancel_task(giver, item)
    DRC.message("You are on a task for #{giver.capitalize}, not #{@npc.capitalize}: cancelling it (task_cancel_foreign_tasks).")
    DRCI.stow_hands
    find_npc(@rooms, giver)
    confirm, cancelled, none = [TASK_CANCEL_CONFIRM, TASK_CANCELLED, TASK_CANCEL_NONE].map { |text| cancel_reply(giver, text) }
    asks = 0
    reply = ''
    while asks < 2
      asks += 1
      reply = DRC.bput("ask #{giver} for task cancel", confirm, cancelled, none)
      break unless reply.match?(confirm)
    end
    unless reply.match?(cancelled) || reply.match?(none)
      DRC.message("Could not cancel #{giver.capitalize}'s task#{reply.empty? ? '' : " (#{reply})"}. Stopping.")
      exit
    end
    DRCT.dispose("#{item} instructions", nil, @worn_trashcan, @worn_trashcan_verb) if item
    forget_replacement(giver)
  end

  # @param giver [String] the taskmaster
  # @param text [String] one of the TASK_CANCEL_* replies
  # @return [Regexp] the reply, said by the taskmaster: the line starts with
  #   its name (after a title of one or two words, such as "Researcher" or
  #   "Potion Peddler"), then "says," or "looks at you and says," before the
  #   quote, as every logged reply does. So "Mallory looks at Researcher
  #   Dorhum and says, ..." does not count.
  def cancel_reply(giver, text)
    /^(?:[\w'-]+ ){0,2}#{Regexp.escape(giver)} (?:looks at you and )?says, "[^"]*#{Regexp.escape(text)}/i
  end

  # Hands in finished items already in the bag and returns how many are still
  # owed, or 0 once the task is complete (its reward sack sorted and the task
  # closed out by task_handed_in). A give that misses a wandering taskmaster is
  # retried (give_item). A reply bput did not know is given again, as in
  # complete_task; after MAX_UNKNOWN_GIVE_REPLIES of them in a row the item
  # goes back in the bag and the hand-in stops. For Nezhiri the doses on
  # hand are handed in only when they cover the task (remedy_hand_in?);
  # otherwise they are counted (@remedy_doses) and the task goes on.
  #
  # @param item [String] item noun
  # @param owed [Integer] how many are owed before the hand-in
  # @return [Integer] how many are still owed, 0 once the task is done
  # @raise [SystemExit] from give_item after repeated misses
  def turn_in_banked(item, owed)
    unknown_replies = 0
    retried = false
    loop do
      case (reply = give_item(item, owed))
      when nil
        break
      when /hands you a/
        sort_sack(item)
        fput('dump junk')
        task_handed_in(item)
        return 0
      when GIVE_WRONG_AMOUNT
        owed = remedy_amount_off(item, reply, retried)
        retried = true
        unknown_replies = 0
      when TURN_IN_MORE_NEEDED
        owed = Regexp.last_match(1).to_i
        unknown_replies = 0
      when GIVE_NOT_ENCHANTED
        trash_unenchanted(item, Regexp.last_match(0))
        unknown_replies = 0
      else
        unknown_replies += 1
        next if unknown_replies < MAX_UNKNOWN_GIVE_REPLIES

        DRCC.stow_crafting_item(hand_in_noun(item), hand_in_bag, nil)
        break
      end
    end
    owed
  end

  # Leaves the item's instructions in hand, asking the taskmaster for a fresh
  # set only when no usable set is carried: none at all, or none with as many
  # uses as items owed (each item takes one study). Every set carried is
  # read, up to MAX_CARRIED_SETS, not only the first: a replacement sits in
  # front of the task's own set, and once it ran short the set behind it was
  # never read, though it had a use for each item owed (a 1-use replacement
  # in front of the task's 2-use set, 2 ropes owed, stopped with "Already
  # asked", 2026-11-07). Sets written for someone else are thrown away on
  # the way.
  #
  # Nezhiri counts doses, and one study makes up to NEZHIRI_DOSES_PER_CRAFT
  # of them, so her sets need a use per craft still to make, not per dose.
  # The crafts are counted as nezhiri will plan them, at the doses a craft
  # this character made last time for the journal's product
  # (remedy_planned_yield of @task_product, which read_task set): counted
  # at 6 a craft, a set with too few uses for the crafts planned at 5 would
  # be taken, and check_remedy_uses would then read every set again, or
  # stop. Her task's set has one use more than the doses (13 for 12), a
  # replacement exactly the doses owed (12 for 12): after a craft or two the
  # uses fall below the doses while plenty are left for the crafts.
  #
  # @param item [String] item noun
  # @param owed [Integer] items still to make, one study each (for Nezhiri,
  #   doses still to make)
  # @return [void]
  def ensure_instructions(item, owed)
    name = "#{item} instructions"
    uses_needed = @npc == 'nezhiri' ? nezhiri_crafts(owed, remedy_planned_yield(@task_product)) : owed
    # A craft that stopped after its study leaves the set in hand, where the
    # gets below would never look.
    DRCC.stow_crafting_item(name, @bag, nil) if DRCI.in_hands?(name)
    most = nil
    found = read_carried_instructions(name) do |uses|
      most = [most.to_i, uses].max
      uses >= uses_needed
    end
    request_replacement(item, needed: uses_needed, most: most) unless found
  end

  # Gets and reads each set of the instructions carried in the crafting
  # bag, up to MAX_CARRIED_SETS, yielding each set's uses left while it is
  # in hand. A set written for someone else is thrown away (put back when
  # the trash will not take it) and not yielded; a set whose READ gives no
  # uses is put back and not yielded. A set the block answers true for is
  # left in hand and the look ends there; every other set is put back,
  # which puts it in front of the others in the bag.
  #
  # @param name [String] the instructions, e.g. 'glop instructions'
  # @yieldparam uses [Integer] uses left on the set in hand
  # @yieldreturn [Boolean] true to keep that set in hand and stop looking
  # @return [Boolean] true when the block kept a set in hand
  def read_carried_instructions(name)
    put_back = 0
    sets = 0
    while sets < MAX_CARRIED_SETS && DRCI.get_item?(put_back.zero? ? name : "#{$ORDINALS[put_back]} #{name}", @bag)
      sets += 1
      reply = DRC.bput("read my #{name}", INSTRUCTION_USES, FOREIGN_INSTRUCTIONS, /What were you referring/)
      if reply.match?(FOREIGN_INSTRUCTIONS)
        # Never usable: bin it rather than read it again on every run.
        DRC.message("These #{name} were written for someone else; throwing them away.")
        next if DRCI.dispose_trash(name, @worn_trashcan, @worn_trashcan_verb)
      elsif (uses = reply[INSTRUCTION_USES, 1])
        return true if yield(uses.to_i)
      end

      # A set put back goes in front of the others (a GET takes the set put
      # away last), so the next one unread comes after every set put back.
      DRCC.stow_crafting_item(name, @bag, nil)
      put_back += 1
    end
    false
  end

  # READ reply for instructions written for another character, which can
  # never be studied: "They were written by or for someone else."
  FOREIGN_INSTRUCTIONS = /written by or for someone else/
  # Instruction sets ensure_instructions looks at before asking for a fresh
  # one, so binning foreign sets always ends.
  MAX_CARRIED_SETS = 5

  # Asks the taskmaster for a fresh set of instructions, once per task. The
  # request is remembered in UserVars (t2 can start the script once per task),
  # and a second request for the same task stops instead: something keeps the
  # items from being made, and repeated requests risk the taskmaster's
  # warning that she will stop handing out replacements. This stop is
  # deliberate even though a replacement has no spare use: the set handed out
  # with a task has one use more than the task count, but a replacement has
  # only as many as are still owed (Zasele, Hollow Eve 2025). So, after a
  # replacement, one more item lost after its study stops the task here for a
  # person to look at, where asking on every relaunch could go on for hours.
  #
  # The request is remembered only once a set was handed over. A request the
  # taskmaster turned down is not the task's one replacement: with both hands
  # full Zasele answers "Zasele glances at your full hands." and hands nothing
  # over (Barrask, 2026-11-04 22:06:35). Remembered anyway, that request
  # stopped every later run with "Already asked", though no replacement had
  # ever come, and the task could never be finished. So a request that got
  # no set stops this run without being remembered, and the next run asks
  # again.
  #
  # @param item [String] the task item's noun
  # @param needed [Integer, nil] uses the task still needs, for the stop
  #   message
  # @param most [Integer, nil] the most uses left on a set carried; nil when
  #   no set's uses were read
  # @return [void]
  # @raise [SystemExit] when instructions were already requested for this
  #   task, or this request got none
  def request_replacement(item, needed: nil, most: nil)
    UserVars.taskmaster_replacements ||= {}
    if UserVars.taskmaster_replacements[@npc] == item
      DRC.message("Already asked #{@npc} for #{item} instructions on this task, and #{carried_uses(needed, most)}. Stopping instead of asking again; check why the #{item}s aren't being made.")
      exit
    end
    reply = get_instructions(item)
    if instructions_handed_over?(reply, item)
      UserVars.taskmaster_replacements[@npc] = item
      return
    end

    said = reply.empty? ? 'no answer' : "\"#{reply}\""
    DRC.message("Asked #{@npc} for #{item} instructions, but none were handed over (#{said}). That does not count as this task's one replacement. Stopping; the next run asks again.")
    exit
  end

  # What the sets carried had, for the "Already asked" stop.
  #
  # @param needed [Integer, nil] uses the task still needs
  # @param most [Integer, nil] the most uses left on a set carried
  # @return [String]
  def carried_uses(needed, most)
    return 'they were used up again' unless needed

    best = most ? "the best has #{most}" : 'you carry none with a use left'
    "no set you carry has the #{needed} use#{needed == 1 ? '' : 's'} still needed (#{best})"
  end

  # Whether a set of instructions came from the taskmaster: the reply says she
  # handed them over ("Seamstress Zasele frowns.  She holds up one of her
  # signs while handing you some reinforced rope instructions:"), or, when the
  # reply was missed, the set is in hand.
  #
  # @param reply [String] what get_instructions read
  # @param item [String] the task item's noun
  # @return [Boolean]
  def instructions_handed_over?(reply, item)
    INSTRUCTIONS_HANDED_OVER.any? { |pattern| reply.match?(pattern) } || DRCI.in_hands?("#{item} instructions")
  end

  # Put the instructions just read into the crafting bag by name, where the
  # crafting scripts put them after studying, rather than leaving them to
  # default stow. Anything else still in hand (a tool or unfinished item held
  # after a crash) goes to default stow as before.
  #
  # @param item [String] item noun
  # @return [void]
  def stow_instructions(item)
    DRCC.stow_crafting_item("#{item} instructions", @bag, nil)
    DRCI.stow_hands
  end

  # The taskmaster's replies to ASK <taskmaster> FOR INSTRUCTIONS that hand a
  # set over: "... while handing you some reinforced rope instructions:"
  # (Alexzander, 2026-11-05 10:38:27), "... hands you some scale moisturizer
  # instructions" (Nezhiri).
  INSTRUCTIONS_HANDED_OVER = [/hands you/i, /gives you/i, /handing you/i].freeze
  # Zasele's reply when both hands are full: nothing is handed over
  # ("Zasele glances at your full hands.", Barrask, 2026-11-04 22:06:35).
  INSTRUCTIONS_HANDS_FULL = /glances at your full hands/

  # Finds the taskmaster, puts whatever is in either hand in the crafting bag
  # by its id (free_hands_for), so the set has a hand to land in, and asks
  # for a fresh set of instructions. By id, so a held leftover is never taken
  # for a worn item of the same noun (Barrask's "put my leather" hit his worn
  # leathers, and both hands stayed full).
  #
  # @param item [String] the task item's noun
  # @return [String] the reply, '' when none came
  # @raise [SystemExit] when a hand can't be emptied (free_hands_for)
  def get_instructions(item)
    find_npc(@rooms, @npc)
    free_hands_for("#{item} instructions")
    DRC.bput("ask #{@npc} for instructions", *INSTRUCTIONS_HANDED_OVER, INSTRUCTIONS_HANDS_FULL)
  end

  # Asks the taskmaster for a task until one is offered, waiting out
  # cooldowns (including the one after a cancelled task), and returns what
  # finish reads from it. An ongoing task is finished and handed in instead
  # (resume_task), which ends the script unless exit_after_resume is false,
  # when this returns nil so the caller's loop goes on to its end-of-task
  # checks and asks again. Another taskmaster's task that had to be
  # cancelled sends this round to ask its own taskmaster again.
  # A while loop, not Kernel#loop: loop would swallow a StopIteration raised
  # inside it and return nil, where the old recursion let it propagate.
  #
  # @param exit_after_resume [Boolean] whether a task already in progress
  #   ends the script once handed in (single task runs); false for runs that
  #   go on to further tasks (repeat, cycle, marathon)
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String), nil]
  #   what {#finish} returns for a newly accepted task; nil once a task
  #   already in progress was handed in (only with exit_after_resume false)
  # @raise [SystemExit] from finish (not on a task); from resume_task in
  #   any mode when it stops (not on a task, another taskmaster's task
  #   without task_cancel_foreign_tasks, a worker or hand-in stop) and, with
  #   exit_after_resume, once the task in progress is handed in; or after
  #   MAX_UNKNOWN_TASK_REPLIES replies in a row it does not know
  def get_task(exit_after_resume: true)
    unknown_replies = 0
    while true
      find_npc(@rooms, @npc)
      reply = DRC.bput("ask #{@npc} for task", /if you agree to (his|her) terms/, /You may accept by typing ACCEPT TASK/, /utterly ignoring you/, /you must wait before I can give you a task/, /You are already on a task/, /give you a chance a little later/, TASK_UNRELIABLE, /^To whom are you speaking/)
      unknown_replies = 0 unless reply.empty?
      case reply
      when /if you agree to (his|her) terms/, /To whom are you speaking/
        next
      when /You are already on a task/
        catch(FOREIGN_TASK_CANCELLED) do
          resume_task(exit_when_done: exit_after_resume)
          # Handed in, and the run goes on: its loop asks for the next task.
          return nil
        end
        # Another taskmaster's task, cancelled: ask our own taskmaster again.
        next
      when /utterly ignoring you/, /give you a chance a little later/, TASK_UNRELIABLE
        DRC.message("Task on cooldown or recently canceled a task, either way, going to have to wait.")
        pause @cooldown_poll
      when /you must wait before I can give you a task/
        if @boost
          fput("boost task")
          pause 2
          @boost = false
        else
          pause @cooldown_poll
        end
      when /You may accept by typing ACCEPT TASK/
        DRC.bput("accept task", /You can check your progress with the TASK verb/)
        forget_replacement
        return finish
      else
        # No reply bput knows: nothing to work on. Returning would send the
        # run on with no task (a crash in the worker); ask again after a
        # wait, and stop after MAX_UNKNOWN_TASK_REPLIES in a row.
        unknown_replies += 1
        if unknown_replies >= MAX_UNKNOWN_TASK_REPLIES
          DRC.message("No answer #{@npc.capitalize} gives that taskmaster knows, #{MAX_UNKNOWN_TASK_REPLIES} times in a row. Stopping.")
          exit
        end
        pause @cooldown_poll
      end
    end
  end

  # Buys ingots of one metal from room 8775 and puts each in the crafting
  # bag, noting how many in @ingots_bought (see leftover_ingots).
  #
  # @param count [Integer] how many ingots
  # @param type [String] metal, e.g. 'steel'
  # @return [void]
  def buy_ingots(count, type)
    @ingots_bought = count
    cost = count * @stockdata[type]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8775, @stockdata[type]['stock-number'])
      DRCC.stow_crafting_item("ingot", @bag, nil)
    end
  end

  # Orders bronze ingot number order from the shop in room 17118 (buy_metal
  # picks 1, 2 or 3 by the task's total volume) and puts it in the crafting
  # bag, noting the one ingot in @ingots_bought.
  #
  # @param order [Integer] order number: 1, 2 or 3
  # @return [void]
  def bingots(order)
    @ingots_bought = 1
    cost = order * 8000 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    DRCT.order_item(17118, order)
    DRCC.stow_crafting_item("ingot", @bag, nil)
  end

  # Buys enough 10-volume stock (cloth, leather, bone, lumber) for the
  # task, combines it and stows it (see buy_stock), setting @remainder when
  # some is left over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] volumes per item
  # @param base [String] stock base, a STACKMAP key
  # @return [void]
  def buy_stackables(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 10.to_f).ceil
    @remainder = (count * vpi) % 10 > 0 ? true : false
    cost = base_to_buy * @stockdata[@stackmap[base].first]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    buy_stock(base, @stockdata[@stackmap[base].first]['stock-number'], base_to_buy, count * vpi)
  end

  # Buys enough 100-yard yarn for the task, combines it and stows it (see
  # buy_stock), setting @remainder when some is left over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] yards per item
  # @param base [String] 'yarn'
  # @return [void]
  def buy_yarn(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 100.to_f).ceil
    @remainder = (count * vpi) % 100 > 0 ? true : false
    cost = base_to_buy * @stockdata[base]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    buy_stock(base, @stockdata[base]['stock-number'], base_to_buy, count * vpi)
  end

  # Replies to COMBINE. "You must be holding both substances to combine
  # them." is a refusal, not a combine (Barrask, Hollow Eve 2026-11-04), and
  # so is "Those items cannot be combined." (6100:9169, two brines).
  COMBINE_REPLIES = [/^You combine/, /^You must be holding both/, /^Those items cannot be combined/].freeze

  # Replies to COUNT by id: the yards counted, or the id is not to be found.
  # The last two catch any other answer, in full, so that an answer in other
  # wording ("You count out 30 pieces of material there.", or "That doesn't
  # tell you much of anything." for what can't be counted, as corn-maze.lic
  # reads it) is told apart from no answer at all: bput returns '' for both.
  COUNT_YARDS = /^You count out \d+ yards/.freeze
  COUNT_REPLIES = [COUNT_YARDS, /^I could not find/, /^You count.*/, /^That doesn't tell you much.*/].freeze

  # Buys pieces of a stock one at a time, combining each into the stack in
  # the other hand, then puts the stack in the crafting bag, everything by
  # the ids in hand. Each piece needs a free hand: with one hand full, every
  # order after the first gets "You realize your hands are full, and stop."
  # So it empties both hands into the crafting bag first. For Zasele's stock
  # (counted in yards) it counts the stack before stowing it, so a task never
  # starts on a stack that counts short. A COUNT unanswered twice is the one
  # exception: it goes ahead uncounted, saying so (see check_yards). Whatever
  # else goes wrong, it says what and stops.
  #
  # @param base [String] stock base, a STACKMAP key, e.g. 'cloth'
  # @param number [Integer] the stock's order number
  # @param pieces [Integer] pieces to buy
  # @param yards [Integer] yards the task needs
  # @return [void]
  # @raise [SystemExit] when a hand can't be freed, an order or combine
  #   fails, the stack is short or it won't go in the crafting bag
  def buy_stock(base, number, pieces, yards)
    stock = "#{@stackmap[base].first} #{base}"
    free_hands_for(stock)
    stack = nil
    pieces.times do
      piece = order_stock_piece(@stackmap[base].last, number, stock)
      stack = stack ? combine_stock(stack, piece, stock) : piece
    end
    check_yards(stack, yards, stock) if TASK_STOCK_BASES.include?(base)
    return if DRCI.put_away_item?("##{stack}", @bag) || left_hands?("##{stack}")

    DRC.message("Could not put the #{stock} you bought (##{stack}) in your #{@bag}. Stopping.")
    exit
  end

  # Puts whatever is in either hand in the crafting bag by its id, so the
  # orders that follow (or a taskmaster's replacement instructions) have a
  # hand to land in. Items whose ids are in keep stay in hand (the remedy
  # stacks a hand-in gathers).
  #
  # @param stock [String] what is about to come into a hand, e.g. 'burlap
  #   cloth' or 'rope instructions'
  # @param keep [Array<String>] ids to leave in hand
  # @return [void]
  # @raise [SystemExit] when a hand can't be emptied
  def free_hands_for(stock, keep: [])
    [GameObj.right_hand, GameObj.left_hand].each do |obj|
      next unless obj&.id
      next if keep.include?(obj.id)

      ref = "##{obj.id}"
      next if DRCI.put_away_item?(ref, @bag) || left_hands?(ref)

      DRC.message("Could not put your #{obj.name} (#{ref}) in your #{@bag}, so there is no free hand for the #{stock}. Empty your hands, then start again. Stopping.")
      exit
    end
  end

  # Orders one piece of stock and returns the id of the piece that came into
  # a hand. DRCT.order_item returns nil without coins or a way to the shop,
  # and '' when the clerk's reply is not the sale ("You realize your hands
  # are full, and stop." among them) or came after its timeout. The hands
  # decide, as in combine_stock: a new id in hand is the piece even when
  # order_item returned '' or nil, since the sale line can be missed after
  # the coins are paid; no new id in hand stops.
  #
  # @param room [Integer] the shop's room
  # @param number [Integer] the stock's order number
  # @param stock [String] e.g. 'burlap cloth'
  # @param keep [Array<String>] ids the stop leaves in hand (stop_stock)
  # @param note [String, nil] said before the stop
  # @return [String] id of the new piece
  # @raise [SystemExit] when the order fails or no new piece is in hand
  def order_stock_piece(room, number, stock, keep: [], note: nil)
    before = hand_ids
    bought = DRCT.order_item(room, number)
    piece = (hand_ids - before).first
    return piece if piece

    why = bought.to_s.empty? ? 'the order did not go through (not enough coins, no way to the shop, or full hands)' : 'no new piece is in your hands'
    stop_stock("Could not buy #{stock}: #{why}.", keep: keep, note: note)
  end

  # Combines a newly bought piece into the stack, both named by id. In game
  # "combine #a with #b" answers "You combine the bolts of cloth together."
  # and the stack comes back under a new id, neither of the two (Mahtra,
  # 2026-11-05). The hands decide: unless the game refused, it worked when one
  # id is all that is held, one of the two or the stack under its new id, even
  # when the reply was missed. check_yards still counts that stack.
  #
  # @param stack [String] id of the stack
  # @param piece [String] id of the new piece
  # @param stock [String] e.g. 'burlap cloth'
  # @return [String] id of the combined stack
  # @raise [SystemExit] when they did not combine
  def combine_stock(stack, piece, stock)
    reply = DRC.bput("combine ##{stack} with ##{piece}", *COMBINE_REPLIES)
    unless reply.start_with?('You must')
      held = hand_ids & [stack, piece]
      return held.first if held.size == 1
      return hand_ids.first if hand_ids.size == 1
    end

    stop_stock("Could not combine the #{stock} (#{combine_failure(reply)}).")
  end

  # Says why a combine did not take, for the stop message.
  #
  # @param reply [String] what COMBINE matched, '' for no answer
  # @return [String]
  def combine_failure(reply)
    return 'no answer' if reply.empty?
    return reply unless reply.start_with?('You combine')

    held = hand_ids.map { |id| "##{id}" }
    "the game said it combined them, but your hands hold #{held.empty? ? 'nothing' : held.join(' and ')}"
  end

  # Counts the stack and stops when it holds fewer yards than the task needs,
  # when its id is not to be found, or when COUNT answers in wording other
  # than yards (quoting the answer), since a number it can't read could be
  # short. A COUNT with no answer at all (bput's '') is asked once more;
  # unanswered twice, it goes ahead uncounted, saying so: each piece was a new
  # id in hand and each combine left one id held, so the pieces ordered
  # should cover the yards. Stopping there would put a stack already paid for
  # back and buy a whole new one on the relaunch.
  #
  # @param stack [String] id of the stack
  # @param yards [Integer] yards the task needs
  # @param stock [String] e.g. 'burlap cloth'
  # @return [void]
  # @raise [SystemExit] when short, not found or answered in other wording
  def check_yards(stack, yards, stock)
    reply = DRC.bput("count ##{stack}", *COUNT_REPLIES)
    reply = DRC.bput("count ##{stack}", *COUNT_REPLIES) if reply.empty?
    return DRC.message("Could not count the #{stock} (##{stack}): COUNT went unanswered twice. Going ahead uncounted; the task needs #{yards} yards.") if reply.empty?
    stop_stock("Could not find the #{stock} you bought (##{stack}) to count it. Not starting the task.") if reply.start_with?('I could not find')
    stop_stock("Could not read the count of the #{stock} you bought (##{stack}): the game said \"#{reply}\", not yards. Not starting the task.") unless reply.match?(COUNT_YARDS)

    counted = reply[/\d+/].to_i
    return if counted >= yards

    stop_stock("Bought #{counted} yards of #{stock}, but the task needs #{yards}: #{yards - counted} yards missing. Not starting the task short.")
  end

  # Puts whatever is in either hand back in the crafting bag by id, says why
  # it is stopping, names by id whatever would not go back, and stops.
  # free_hands_for emptied both hands before the first order, so all that is
  # held is stock bought since. Hands are read once: a piece that lands after
  # that (the whole reply more than bput's timeout late) is neither put back
  # nor named.
  #
  # @param text [String] why
  # @param keep [Array<String>] ids to leave in hand, and out of the
  #   "would not go back" text (a vessel a Nezhiri continue keeps)
  # @param note [String, nil] said before the stop
  # @raise [SystemExit] always
  def stop_stock(text, keep: [], note: nil)
    kept = (hand_ids - keep).reject { |id| DRCI.put_away_item?("##{id}", @bag) || left_hands?("##{id}") }
    unless kept.empty?
      refs = kept.map { |id| "##{id}" }.join(' and ')
      text = "#{text} #{refs} would not go back in your #{@bag} and #{kept.size == 1 ? 'is' : 'are'} still in your hands; put #{kept.size == 1 ? 'it' : 'them'} away before starting again."
    end
    DRC.message("#{text}#{note && " #{note}"} Stopping.")
    exit
  end

  # Buys one alabaster rock deed per item and stows the deeds.
  #
  # @param count [Integer] how many deeds
  # @return [void]
  def buy_rocks(count)
    cost = count * 1250 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8864, 2)
      DRCC.stow_crafting_item("deed", @bag, @settings.engineering_belt)
    end
  end

  # Forges each item with the forge script at an anvil (or the
  # task_crafting_room) and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param type [String] metal to forge with
  # @return [Integer] how many were made (craft_each stops on a run that made none)
  def forge_item(item, count, type)
    unless @crafting_room
      info = get_data('crafting')['blacksmithing']["Crossing"]
      DRCC.check_consumables('oil', info['finisher-room'], info['finisher-number'], @bag, @bag_items, nil, count)
      DRCC.find_anvil(@anvil_town)
    else
      DRCT.walk_to(@crafting_room)
    end
    DRCC.clean_anvil?
    craft_each('forge', item, count) do
      DRC.wait_for_script_to_complete('forge', ['instructions', type, item, 'skip'])
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
  end

  # Carves each stone item from its rock deed and bags it. When the thief's
  # fog rolls through mid-carve, it buys a new deed and carves that item
  # again.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @note Adds the "thieving-fog" flag, deleted when the script ends.
  # @return [void]
  def carve_stone(item, count)
    Flags.add("thieving-fog", "A low fog rolls in, then just as quickly rolls out")
    DRCC.find_shaping_room(@anvil_town)
    DRCC.get_crafting_item("chisels", @bag, @bag_items, @settings.engineering_belt)
    remaining = count
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get alabaster deed from my #{@bag}", '^You get')
      fput('tap my deed')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /You reach out and touch/, /You are not attuned to this particular enchantment/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/, /^You reach out and touch/) if @cube
      DRC.bput("carve boulder with my chisels", "Roundtime")
      loop do
        case DRC.bput("carve #{item} with my chisels", "Roundtime", "You cannot figure out how to do that", "It would be better to find")
        when "You cannot figure out how to do that", "It would be better to find"
          break
        end
        waitrt?
      end
      if Flags["thieving-fog"]
        buy_rocks(1)
        DRCC.find_shaping_room(@anvil_town)
        count = remaining
        Flags.reset("thieving-fog")
        redo
      end
      DRC.bput("get #{item}", "You pick up")
      DRC.bput("put my #{item} in my #{@bag}", "You put")
      remaining -= 1
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Cuts each bone item from the deer stack and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @return [void]
  def carve_bone(item, count)
    DRCT.walk_to(8868)
    DRCC.get_crafting_item("bone saw", @bag, @bag_items, @settings.engineering_belt)
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get deer stack from my #{@bag}", '^You get')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/) if @cube
      DRC.bput("cut stack with my bone saw", "Roundtime")
      loop do
        case DRC.bput("cut #{item} with my bone saw", "Roundtime", "You cannot figure out how to do that")
        when "You cannot figure out how to do that"
          break
        end
      end
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Sews or knits each item with the sew script, in the tailoring room or
  # task_crafting_room (marathon sews where it stands). Pins and thread are
  # checked before the walk, while still near the Crossing shops that sell
  # them: checked in a far task_crafting_room (a rented Andreshlew outfitting
  # room), a short spool sent the character all the way back to the Crossing
  # stock room and back again (2026-11-10 report).
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param base [String] 'yarn' knits, anything else sews
  # @param type [String] stock name
  # @return [Integer] how many were made (craft_each stops on a run that made none)
  def tailor_item(item, count, base, type)
    check_sewing_consumables(count) unless base == 'yarn'
    unless @crafting_room
      DRCT.walk_to(14886) unless @marathon
    else
      DRCT.walk_to(@crafting_room)
    end
    craft_each('sew', item, count) do
      DRC.wait_for_script_to_complete('sew', ['stow', 'instructions', type, item, base == 'yarn' ? 'knit' : nil, 'skip'])
    end
  end

  # Runs a crafting script once per item owed (the block runs it once) and
  # stops on the first run that made none, judged by the finished items in
  # the crafting bag and hands before and after each run. A run with no
  # stock still uses one instruction use (sew studies them before it looks
  # for the cloth): a 6-netting task with stock for one launched sew six
  # times and said "6 nettings completed" (Barrask, 2026-11-04).
  #
  # A count the game did not answer (finished_count nil) judges nothing: with
  # none to start from no run is launched, and a run after which none came
  # is judged by the next count instead.
  #
  # @param script [String] the script the block runs, for the message
  # @param item [String] item noun
  # @param count [Integer] how many are owed
  # @yield runs the script once
  # @return [Integer] how many were made
  def craft_each(script, item, count)
    start = before = finished_count(item)
    unless start
      DRC.message("Could not count the #{item}s in #{@bag} (no reply to INVENTORY), so no #{script} runs.")
      return 0
    end
    stalled = false
    after = start
    count.times do
      yield
      after = finished_count(item)
      next unless after

      stalled = after <= before
      break if stalled

      before = after
    end
    before = finished_count(item) || before unless after
    made = before - start
    if stalled
      DRC.message("Made #{made} of #{count} #{item}s: no new #{item} in #{@bag} or in hand after the last #{script} run, so no more runs.")
    elsif made < count
      DRC.message("Counted #{made} of #{count} #{item}s made (INVENTORY did not answer after every #{script} run).")
    else
      DRC.message("#{made} #{item}s completed")
    end
    made
  end

  # Finished items of the noun in the crafting bag (one INVENTORY of it,
  # container_listing, which also lists an unfinished one, the same before
  # and after a run) and in hand (a finished item the bag would not take
  # stays there). Items in the bag count by their noun (count_listed): the
  # "netting instructions" sew and forge stow in the same bag do not, so a
  # run that makes the last item and uses up the instructions still counts
  # as one made. Held items count by held_finished.
  #
  # An INVENTORY that goes unanswered is asked once more, and is not a
  # count of none.
  #
  # @param item [String] item noun
  # @return [Integer, nil] nil when INVENTORY got no reply twice
  def finished_count(item)
    lines = container_listing(@bag)
    lines = container_listing(@bag) if lines.nil?
    return nil if lines.nil?

    count_listed(lines, item) + held_finished(item)
  end

  # How many finished items of the noun the hands hold. A hand counts when
  # GameObj gives it that noun, so a "lumpy bundle bound by a braided
  # bundling rope" is no rope, and its full name from GLANCE
  # (glanced_hands) does not say "unfinished": the hand text never does,
  # as the game shows a "coil of unfinished burlap reinforced rope" in hand
  # as "reinforced rope". GLANCE is only sent when a hand holds the noun.
  # When it goes unanswered, or names something without the noun in that
  # hand, the held item is not counted, so a run is never taken as having
  # made an item on a guess.
  #
  # @param item [String] item noun
  # @return [Integer]
  def held_finished(item)
    hands = { right: GameObj.right_hand, left: GameObj.left_hand }.select { |_, obj| obj&.noun.to_s.casecmp?(item) }
    return 0 if hands.empty?

    glanced = glanced_hands
    return 0 unless glanced

    hands.count { |hand, _| names_noun?(glanced[hand], item) && !name_words(glanced[hand]).include?('unfinished') }
  end

  # Pins and thread are checked once for the whole task, so each sew run can
  # skip its own check (two get/count/put rounds per item). An item uses at
  # most a few pins; sew still restocks mid-item if either runs out.
  # Knitting uses neither.
  PIN_USES_PER_ITEM = 3

  # Checks pins and thread once for the whole sewing task.
  #
  # @param count [Integer] items to sew
  # @return [void]
  def check_sewing_consumables(count)
    info = get_data('crafting')['tailoring']["Crossing"]
    belt = @settings.outfitting_belt
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, belt, PIN_USES_PER_ITEM * count + 5)
    # Named by material: spun spools ("some heavy silk thread") share the
    # noun and live in the crafting container too (see sew.lic SEWING_THREAD).
    DRCC.check_consumables('cotton thread', info['stock-room'], 6, @bag, @bag_items, belt)
  end

  # Shapes each wooden item with the shape script in a shaping room.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param _base [String] unused
  # @param type [String] lumber, e.g. 'balsa'
  # @return [Integer] how many were made (craft_each stops on a run that made none)
  def shape_item(item, count, _base, type)
    DRCC.find_shaping_room(@anvil_town)
    craft_each('shape', item, count) do
      DRC.wait_for_script_to_complete('shape', ['stow', 'instructions', type, item])
    end
  end

  # Consecutive gives that found nobody to take the item before giving up.
  MAX_GIVE_MISSES = 5
  # GIVE reply when the taskmaster is not in the room.
  GIVE_MISSED = /What is it you're trying to give/

  # GIVE reply, after "You don't need to specify the object - GIVE <person>
  # assumes you mean to give the object in your right hand!", to a give that
  # names its item. The way through is the one the game spells out: the item
  # in the right hand and GIVE <taskmaster> with no object
  # (give_from_right_hand). Unlisted, each one waited out bput's 15 s and
  # counted toward a stop: 181 times across the fleet on 2026-11-05, 165 of
  # them between 10:38 and 10:44, with 19 tasks stopped and relaunched.
  GIVE_NOT_NOW = /^Don't be silly\./
  # Seconds between gives while the taskmaster answers GIVE_NOT_NOW.
  GIVE_NOT_NOW_PAUSE = 10
  # Most seconds give_item waits out GIVE_NOT_NOW in a row, across calls, before
  # it hands the reply back, so complete_task's own count can stop the task.
  # Any other reply starts the count again.
  GIVE_NOT_NOW_MAX_WAIT = 600

  # Dorhum turning down an item with no enchantment on it (a manual run,
  # 2026-11-04: 'Researcher Dorhum examines the small brazier and shakes his
  # head.  "I don't sense any hint of enchantment on this.  What are you
  # trying to pull, Pezamus?"'). Giving it again cannot help.
  GIVE_NOT_ENCHANTED = /^Researcher Dorhum examines [^"]*"I don't sense any hint of enchantment on this/

  # Gives one finished item to the taskmaster and returns the reply, or nil when
  # there is none in hand or in the bag. A give that misses her (she wandered
  # off between the get and the give) leaves the item in hand: find her again
  # and give that same item, stopping after MAX_GIVE_MISSES misses in a row.
  # A GIVE_NOT_NOW answer is followed at once by GIVE <taskmaster> with the
  # item in the right hand (give_from_right_hand). While that gets
  # GIVE_NOT_NOW too, both are tried again every GIVE_NOT_NOW_PAUSE seconds,
  # for up to GIVE_NOT_NOW_MAX_WAIT seconds in a row (counted across calls,
  # so complete_task asking again doesn't restart the wait); after that the
  # reply goes back to the caller like any other.
  #
  # Nezhiri takes one stack of exactly the doses she asked for, so for her
  # the stack is made ready first (remedy_hand_in?), before she is looked
  # for: with too few doses there is nothing to give. Her GIVE_IGNORED is
  # answered like GIVE_NOT_NOW, from the right hand.
  #
  # @param item [String] item noun
  # @param owed [Integer, nil] doses owed (Nezhiri's tasks; unused for the
  #   others)
  # @return [String, nil] the taskmaster's reply, or nil when none is left
  # @raise [SystemExit] after MAX_GIVE_MISSES misses in a row
  def give_item(item, owed = nil)
    noun = hand_in_noun(item)
    return if @npc == 'nezhiri' && !remedy_hand_in?(item, owed)

    misses = 0
    @not_now_waited ||= 0
    loop do
      find_npc(@rooms, @npc)
      return unless holding_hand_in?(noun)

      reply = DRC.bput("give my #{noun} to #{@npc}", *GIVE_REPLIES)
      reply = give_from_right_hand(noun, hand_in_id(noun)) || reply if reply.match?(GIVE_NOT_NOW) || reply.match?(GIVE_IGNORED)
      if reply.match?(GIVE_NOT_NOW)
        if @not_now_waited < GIVE_NOT_NOW_MAX_WAIT
          DRC.message("#{@npc.capitalize} answered \"Don't be silly.\" to the #{noun} from the right hand too. Trying again every #{GIVE_NOT_NOW_PAUSE} seconds, for up to #{GIVE_NOT_NOW_MAX_WAIT / 60} minutes.") if @not_now_waited.zero?
          pause GIVE_NOT_NOW_PAUSE
          @not_now_waited += GIVE_NOT_NOW_PAUSE
          next
        end
        return reply
      end
      @not_now_waited = 0
      return reply unless reply =~ GIVE_MISSED

      misses += 1
      break if misses >= MAX_GIVE_MISSES
    end
    DRC.message("Could not hand a #{noun} to #{@npc} after #{MAX_GIVE_MISSES} tries, stopping.")
    exit
  end

  # Every reply a GIVE to the taskmaster waits for.
  GIVE_REPLIES = [TURN_IN_MORE_NEEDED, /hands you a/, GIVE_MISSED, GIVE_NOT_ENCHANTED, GIVE_NOT_NOW, GIVE_WRONG_AMOUNT, GIVE_IGNORED].freeze

  # Hands the item over the way the game asks after GIVE_NOT_NOW: in the
  # right hand, with GIVE <taskmaster> and no object. A bare GIVE hands over
  # whatever the right hand holds, and the taskmaster keeps what she is
  # given, so it is only sent once the right hand holds this item, checked by
  # its id; from the left hand it is swapped over first (move_to_right_hand).
  #
  # @param noun [String] the item's noun
  # @param id [String, nil] the item's id, when known (Nezhiri's stack);
  #   otherwise the held item of the noun
  # @return [String, nil] the reply; nil, with no GIVE sent, when the item is
  #   not in a hand or would not move to the right hand
  def give_from_right_hand(noun, id = nil)
    id ||= held_id(noun)
    return unless id && hand_ids.include?(id)
    return unless move_to_right_hand(id)

    DRC.bput("give #{@npc}", *GIVE_REPLIES)
  end

  # Whether the item to hand in is in hand, getting one from the hand-in bag
  # when not: for Nezhiri, the stack remedy_hand_in? made ready, by its id.
  # A held item counts by its own noun: DRCI.in_hands?('rope') also matches
  # the "reinforced rope instructions" a stopped sew leaves in hand, so the
  # rope was never taken out of the bag and five gives of nothing stopped
  # the task (2026-11-07).
  #
  # @param noun [String] the item's noun
  # @return [Boolean]
  def holding_hand_in?(noun)
    return hand_ids.include?(@remedy_hand_in) if @npc == 'nezhiri'

    !held_id(noun).nil? || DRCI.get_item?(noun, hand_in_bag)
  end

  # The id of the item being handed in, for a give from the right hand.
  #
  # @param noun [String] the item's noun
  # @return [String, nil]
  def hand_in_id(noun)
    @npc == 'nezhiri' ? @remedy_hand_in : held_id(noun)
  end

  # The noun a task's finished items are handed in by. Dorhum's keep their
  # base item's noun (a spongestone is a rock), so it comes from
  # DORHUM_ITEMS; everyone else's is the task item's own noun.
  #
  # @param item [String] the task item's noun
  # @return [String]
  def hand_in_noun(item)
    @npc == 'dorhum' ? dorhum_recipe(item)[:noun] : item
  end

  # Where finished items wait to be handed in: task_loot_bag for Dorhum's,
  # so they never mix with the unworked items of the same noun in the
  # crafting bag; the crafting bag for everyone else's.
  #
  # @return [String]
  def hand_in_bag
    return @bag unless @npc == 'dorhum'

    check_loot_bag
    @lootbag
  end

  # Hands in every finished item until the taskmaster gives the reward
  # sack, then sorts it. Nezhiri's "The amount here looks off" makes the
  # stack ready once more for the doses she asked for (remedy_amount_off).
  #
  # @param item [String] item noun
  # @param count [Integer] how many are owed (doses for Nezhiri)
  # @return [void]
  # @raise [SystemExit] when the items run out first, when the taskmaster
  #   will not take one (refused_hand_in), or from give_item
  def complete_task(item, count)
    unknown_replies = 0
    retried = false
    loop do
      reply = give_item(item, count)
      unless reply
        DRC.message("Could not get another #{hand_in_noun(item)} to hand in and the task is not finished, stopping.")
        exit
      end
      break if reply =~ /hands you a/

      if reply.match?(GIVE_WRONG_AMOUNT)
        count = remedy_amount_off(item, reply, retried)
        retried = true
        unknown_replies = 0
        next
      end

      if reply =~ TURN_IN_MORE_NEEDED
        unknown_replies = 0
        next
      end
      if reply =~ GIVE_NOT_ENCHANTED
        trash_unenchanted(item, reply)
        unknown_replies = 0
        next
      end
      # A reply bput did not know may be a lagged acceptance or a passing
      # refusal: give again (the item still in hand, or the next one if it
      # was taken) before calling it a refusal.
      unknown_replies += 1
      refused_hand_in(item, reply) if unknown_replies >= MAX_UNKNOWN_GIVE_REPLIES
    end
    sort_sack(item)
    fput('dump junk')
    task_handed_in(item)
  end

  # Hand-in replies in a row that were neither the reward sack nor "N more
  # are needed" before complete_task stops: a few unknown replies are not
  # yet a refusal. "Don't be silly." (GIVE_NOT_NOW) is waited out in
  # give_item first, and only reaches this count once that wait is used up.
  MAX_UNKNOWN_GIVE_REPLIES = 5

  # Puts an item that cannot be used in the trash: a finished Dorhum item
  # the loot bag would not take, or one Dorhum saw no enchantment on.
  #
  # @param noun [String]
  # @return [Boolean] whether it went in the trash
  def trash_refused(noun)
    DRCI.dispose_trash(noun, @worn_trashcan, @worn_trashcan_verb)
  end

  # Dorhum saw no enchantment on the item handed to him, so it can never be
  # handed in: it goes in the trash and the hand-in goes on with the next
  # one. If the trash will not take it, it goes back in the loot bag and the
  # run stops (refused_hand_in).
  #
  # @param item [String] the task item's noun
  # @param reply [String] Dorhum's refusal
  # @return [void]
  # @raise [SystemExit] when it could not be trashed
  def trash_unenchanted(item, reply)
    noun = hand_in_noun(item)
    refused_hand_in(item, reply) unless trash_refused(noun)
    DRC.message("#{@npc.capitalize} saw no enchantment on a #{noun}, so it went in the trash.")
  end

  # The taskmaster neither took the item nor asked for more, MAX_UNKNOWN_GIVE_REPLIES
  # times in a row: a refusal, or replies bput did not know. The item is
  # still in hand, so it goes back in the bag and the run stops rather than
  # handing the same item over for good.
  #
  # @param item [String] item noun
  # @param reply [String] what bput matched ('' when nothing)
  # @return [void]
  # @raise [SystemExit] always
  def refused_hand_in(item, reply)
    noun = hand_in_noun(item)
    DRCC.stow_crafting_item(noun, hand_in_bag, nil)
    DRC.message("#{@npc.capitalize} did not take the #{noun}#{reply.empty? ? '' : " (#{reply})"}. Stopping.")
    exit
  end

  # The task is done: its instructions can go, and the next task may ask for
  # replacements again. Instructions are kept until here, so a run that could
  # not make the items leaves them for the resume instead of asking the
  # taskmaster for another set. Notes the hand-in in @task_handed_in, which
  # resume_task reads to tell a finished task from one with nothing to give.
  #
  # @param item [String] the task item's noun
  # @return [void]
  def task_handed_in(item)
    @task_handed_in = true
    @remedy_hand_in = nil
    DRCT.dispose("#{item} instructions", nil, @worn_trashcan, @worn_trashcan_verb)
    forget_replacement
    bin_task_stock
  end

  # Zasele's stock bases. Every task buys fresh stock, so once a task is
  # handed in, each piece of it left in the crafting bag is surplus: the
  # offcuts sew puts back in the bag after each cut, and whatever was left of
  # the purchase.
  TASK_STOCK_BASES = %w[cloth leather yarn].freeze

  # Pieces bin_task_stock bins per stock at most, so the loop always ends.
  TASK_STOCK_BIN_CAP = 100

  # Whether bin_task_stock bins after the hand-in: only when the player opted
  # in with task_bin_leftover_stock, for Zasele's tasks, with a worn trash can,
  # and never in marathon, whose restock stack is carried from task to task
  # (check_stock reuses it), so binning it would force a full restock each time.
  #
  # @return [Boolean]
  def bins_task_stock?
    @bin_leftover_stock && @npc == 'zasele' && @worn_trashcan && !@marathon ? true : false
  end

  # With task_bin_leftover_stock, after a Zasele task is handed in, bins
  # every piece of her stock in the crafting bag into the worn trash can,
  # each by the id of the piece in hand, then uses the trash can's verb
  # twice. Without the setting or a worn trash can it bins nothing, so
  # nothing is ever dropped, and trash keeps taking leftover stock to the bin
  # room. A piece the trash can refuses goes back in the bag and ends that
  # stock's loop. When a piece may be left in hand, or the hands are full,
  # it stops altogether, so the next stock can't fill the other hand.
  #
  # @return [Integer] pieces binned
  def bin_task_stock
    return 0 unless bins_task_stock?

    binned = 0
    TASK_STOCK_BASES.each do |base|
      count, stop = bin_stock("#{@stackmap[base].first} #{base}", base)
      binned += count
      break if stop
    end
    return binned unless binned.positive?

    2.times { DRC.bput("#{@worn_trashcan_verb} my #{@worn_trashcan}", /You drum/, /THUD/, /What were you/, /^You /) } if @worn_trashcan_verb
    DRC.message("Binned #{binned} piece(s) of leftover task stock")
    binned
  end

  # Bins the pieces of one stock from the crafting bag into the worn trash
  # can, up to TASK_STOCK_BIN_CAP, each by the id of the piece in hand. A
  # plain put, not DRCI.dispose_trash: when the trash can refuses a piece,
  # dispose_trash goes on to a room bin and then drops it on the floor.
  #
  # @param stock [String] e.g. 'burlap cloth'
  # @param noun [String] the stock's noun, e.g. 'cloth'
  # @return [Array(Integer, Boolean)] pieces binned, and whether to stop
  #   binning other stock (a piece may be left in hand, or the hands are full)
  def bin_stock(stock, noun)
    binned = 0
    TASK_STOCK_BIN_CAP.times do
      ref = take_stock_piece(stock, noun)
      return [binned, true] if ref == :stuck
      break unless ref
      landed = DRCI.put_away_item?(ref, @worn_trashcan) || left_hands?(ref)
      return [binned, !put_back_stock(ref, stock)] unless landed

      binned += 1
    end
    [binned, false]
  end

  # Takes one piece of stock out of the crafting bag and returns the id of
  # the piece in hand, so the commands after it name that piece and nothing
  # else. By noun, "put my leather" can name worn "sinuous leathers" instead
  # and get "Perhaps you should be holding that first." (Hollow Eve 2026).
  #
  # @param stock [String] e.g. 'rat leather'
  # @param noun [String] the stock's noun, e.g. 'leather'
  # @param from [String] the container, the crafting bag unless given
  # @return [String, Symbol, nil] "#id" of the piece in hand; nil when the
  #   bag has none left (or the get went unanswered); :stuck, after saying
  #   why, when the hands are full or the piece can't be found in hand (a
  #   piece taken out but not found goes back in the bag by its full name)
  def take_stock_piece(stock, noun, from = @bag)
    before = hand_ids
    got = DRC.bput("get my #{stock} from my #{from}", /^You get/, /^You are already/, /^You're already/,
                   /^What were you referring to/, /^I could not find/, /^You need a free hand/)
    if got.start_with?('You need a free hand')
      DRC.message("Both hands are full, so the leftover #{stock} stays in your #{from}. Empty your hands to get rid of it.")
      return :stuck
    end
    return unless got.match?(/^You (get|are already|'re already)/)

    # After "You get" only an id that newly appeared is the piece, never a
    # same-noun piece already in the other hand. "You are already holding
    # that" adds no id, so only then is the held piece of that stock it.
    id = (hand_ids - before).first
    id ||= held_stock_id(stock, noun) if got.include?('already')
    return "##{id}" if id

    stock_not_found(stock, got, from)
  end

  # Says why a piece of stock can't be thrown away when its id is not in
  # hand. After "You get" the piece was taken out, so it goes back in the bag
  # by its full name, which names no worn item: "rat leather" can't mean
  # "sinuous leathers" the way "leather" can.
  #
  # @param stock [String] e.g. 'rat leather'
  # @param got [String] the get's reply
  # @param from [String] the container it came from
  # @return [Symbol] :stuck
  def stock_not_found(stock, got, from = @bag)
    unless got.start_with?('You get')
      DRC.message("The game says you already hold the #{stock}, but it is not in your hands, so nothing was thrown away. Stopping.")
      return :stuck
    end

    if DRCI.put_away_item?(stock, from)
      DRC.message("Took out the #{stock} but can't find it in your hands, so it went back in your #{from}. Stopping.")
    else
      DRC.message("Took out the #{stock} but can't find it in your hands or put it back in your #{from}. It may still be in your hand. Stopping.")
    end
    :stuck
  end

  # Puts a piece that could not be thrown away back in the crafting bag by
  # its id. When that fails too and the piece is still in hand, says so: a
  # later STOW would send it to the default container.
  #
  # @param ref [String] "#id" of the piece
  # @param stock [String] e.g. 'rat leather'
  # @param from [String] the container it came from
  # @return [Boolean] true when the piece is no longer in hand
  def put_back_stock(ref, stock, from = @bag)
    return true if DRCI.put_away_item?(ref, from) || left_hands?(ref)

    DRC.message("Could not throw away the #{stock} (#{ref}) or put it back in your #{from}. It may still be in your hand. Stopping.")
    false
  end

  # Whether a piece has left both hands. A put that names it by id moves
  # only that piece, so when the reply went unmatched (bput's timeout) the
  # piece still went where the put sent it if its id is no longer in hand.
  #
  # @param ref [String] "#id" of the piece
  # @return [Boolean]
  def left_hands?(ref)
    !hand_ids.include?(ref.delete_prefix('#'))
  end

  # The id of a held piece of this stock: its noun, and every other word of
  # the stock name starting a word of the piece's name, as the game matches
  # them ("rat leather" names a "rat-pelt leather"), so the player's own
  # "silk cloth" is never taken for "burlap cloth".
  #
  # @param stock [String] e.g. 'rat leather'
  # @param noun [String] e.g. 'leather'
  # @return [String, nil]
  def held_stock_id(stock, noun)
    words = stock.split[0...-1]
    [GameObj.right_hand, GameObj.left_hand]
      .find { |obj| obj&.noun == noun && obj.id && words.all? { |word| obj.name.to_s.match?(/\b#{Regexp.escape(word)}/) } }
      &.id
  end

  # @return [Array<String>] the ids of what is in either hand
  def hand_ids
    [GameObj.right_hand, GameObj.left_hand].filter_map { |obj| obj&.id }
  end

  # Clears the record of a replacement request for this taskmaster's task.
  #
  # @return [void]
  def forget_replacement(npc = @npc)
    UserVars.taskmaster_replacements&.delete(npc)
  end

  # Deals with worn tools after a task: stows them with task_no_repair,
  # repairs them with task_self_repair, or leaves them with Rangu.
  #
  # @param tools [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def repair(tools, belt)
    if @no_repair # skipping repair, stowing tool(s), moving on
      DRCI.stow_hands
      return
    elsif @self_repair
      DRCC.repair_own_tools({ 'finisher-room' => 8776, 'finisher-number' => 6 }, tools, @bag, @bag_items, belt) # runs self repair routine
    else
      tool_drop(tools, belt) # drops tools off at the repair guy to be picked up later
    end
  end

  # Leaves each tool with Rangu for repair and keeps the tickets; a tool he
  # won't take goes back where it came from.
  #
  # @param toolslist [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def tool_drop(toolslist, belt = nil) # accepts array of tools for repair
    return if @self_repair

    DRCT.walk_to(19209)
    @belt = belt
    toolslist.each do |tool_name|
      DRCC.get_crafting_item(tool_name, @bag, @bag_items, belt, true)
      case DRC.bput("give Rangu", "I don't repair those here", 'What is it', "There isn't a scratch on that", 'Just give it to me again', 'I will not', "I can't fix those.  They only have so many uses and then you must buy another.")
      when /give/
        DRC.bput("give Rangu", 'repair ticket')
        DRC.bput('stow ticket', 'You put')
      else
        DRCC.stow_crafting_item(tool_name, @bag, belt)
      end
    end
  end

  # Collects every tool Rangu holds a ticket for, waiting until each is
  # ready, and stows it on the toolbelt that lists it.
  #
  # @note A crafting belt setting left unset is nil; Lich's nil patch lets
  #   the belt search skip it.
  # @return [void]
  def tool_pickup # picks up all your tools from repair shop
    DRCT.walk_to(19209)
    while DRCI.get_item?("rangu ticket")
      pause 30 until DRC.bput('look at my ticket', 'should be ready by now', 'Looking at the') == 'should be ready by now'
      DRC.bput("give Rangu", 'You hand')
      pause 0.01 until (tool = [DRC.right_hand, DRC.left_hand].compact.first) # waits for tool to hit your hand
      belts = [@settings.forging_belt, @settings.engineering_belt, @settings.outfitting_belt, @settings.alchemy_belt, @settings.enchanting_belt]
      toolbelt = belts.select { |belt| belt["items"].find { |name| name =~ /#{tool}/i } }.first # searches your toolbelts for the first one containing the tool.
      DRCC.stow_crafting_item(tool, @bag, toolbelt) # hopefully stows the tool appropriately.
    end
  end

  # Replies to GET COIN FROM MY SACK (Hollow Eve 2026 logs): each get picks up
  # one coin stack ("You pick up 2 copper Dokoras."), and once none is left
  # the game says "What were you referring to?". Sacks have held up to four
  # stacks, of mixed currencies.
  SACK_COIN_TAKEN = /^You pick up/
  SACK_NO_COIN = /^What were you referring to/
  # Gets before giving up on a sack whose coins never seem to run out.
  SACK_COIN_GETS_MAX = 20

  # What the game calls the reward sack in hand (<right exist="..."
  # noun="sack">woven sack</right>, Hollow Eve 2026 XML logs). Players carry
  # other sacks ("a soft woven sack with a golden piglet charm"), so the noun
  # alone does not pick out the reward.
  REWARD_SACK_NAME = 'woven sack'
  # Seconds to wait for the reward sack to show in a hand, as the hand update
  # can trail the "hands you a woven sack" line.
  REWARD_SACK_WAIT = 3
  # LOOK IN replies for the reward sack: its contents ("In the woven sack you
  # see a large iron nugget.", Hollow Eve 2026 logs), or the reply an empty
  # container gives (VESSEL_EMPTY). Anything else, a timeout or a line about
  # some other item, leaves the contents unseen.
  SACK_LOOK_CONTENTS = /^In the .* you see.*/
  SACK_LOOK_EMPTY = VESSEL_EMPTY

  # Sorts the reward sack: gems go to the gem pouch and coins are picked up,
  # then a keeper goes into the loot bag (with a Slack message if asked)
  # and anything else is binned. Logs the contents to the Task Master
  # window and the sack history.
  #
  # Every command after the pouch fill names the sack by the id it has in
  # hand. A bare "sack" reaches the first sack the game finds, so a lagged
  # second sort of a sack already binned (Hollow Eve 2026: Catheroine,
  # 2026-11-06 00:31) looked in, and then fetched and binned, a pet sack from
  # the duffel bag. With no reward sack in hand there is nothing to sort. A
  # sack LOOK shows empty is binned; one whose LOOK gives neither reply is
  # kept, as its contents were never seen.
  #
  # @param _item [String, nil] unused
  # @return [void]
  def sort_sack(_item)
    sack_id = reward_sack_id
    unless sack_id
      DRC.message('No reward sack in hand to sort.')
      return
    end
    sack = "##{sack_id}"
    DRCI.fill_gem_pouch_with_container(@settings.gem_pouch_adjective, @settings.gem_pouch_noun, 'sack', @settings.full_pouch_container, @settings.spare_gem_pouch_container, @settings.tie_gem_pouches)

    SACK_COIN_GETS_MAX.times do
      break unless DRC.bput("get coin from #{sack}", SACK_COIN_TAKEN, SACK_NO_COIN).match?(SACK_COIN_TAKEN)
    end
    result = DRC.bput("look in #{sack}", SACK_LOOK_CONTENTS, SACK_LOOK_EMPTY)
    if result.match?(SACK_LOOK_EMPTY)
      DRC.message('Nothing special: the reward sack is empty.')
      DRCI.dispose_trash(sack, @worn_trashcan, @worn_trashcan_verb)
      return
    end
    unless result.match?(SACK_LOOK_CONTENTS)
      DRC.message('Could not read the reward sack; keeping it unopened.')
      DRCI.put_away_item?(sack, @lootbag)
      return
    end
    if keeper?(result)
      result = result.sub(/In the woven sack you see (?:(?:a|an|some) )?/, '').sub(/\.$/, '')
      DRC.message("Found a keeper: #{result}")
      send_slackbot_message("Found a keeper: #{result}") if @slack_keepers
      DRCI.put_away_item?(sack, @lootbag) unless @unpack_keepers && unpack_keeper?(result, sack_id)
    else
      DRC.message("Nothing special: #{result}")
      DRCI.dispose_trash(sack, @worn_trashcan, @worn_trashcan_verb)
    end
    result = result.sub('In the woven sack you see', '')
    DRC.log_window(result, "Task Master", true, true)
    remember_sack(result)
  end

  # The id of the reward sack in hand, waiting briefly for the hand update.
  #
  # @return [String, nil] nil when neither hand holds a reward sack
  def reward_sack_id
    deadline = Time.now + REWARD_SACK_WAIT
    loop do
      sack = [GameObj.right_hand, GameObj.left_hand]
             .find { |obj| obj&.name == REWARD_SACK_NAME && obj.id }
      return sack.id if sack
      return nil if Time.now >= deadline

      pause 0.1
    end
  end

  # Replies used to take a keeper out of its sack (Hollow Eve 2026 logs).
  UNPACK_GET_SUCCESS = /^You get /
  UNPACK_NEED_FREE_HAND = /^You need a free hand/
  UNPACK_GET_FAILURES = [/^What were you referring to/, /^I could not find/].freeze
  SACK_EMPTY = /^There's nothing inside/
  SACK_NOT_EMPTY = /^Inside .*, you see:/
  # INVENTORY replies for any container (inventory_listing): its list, or
  # the reply for an empty one.
  INVENTORY_REPLY = Regexp.union(SACK_NOT_EMPTY, SACK_EMPTY)
  # The line INVENTORY ends a container's list with, tags stripped: "[Use
  # <d cmd='inventory help'>INVENTORY HELP</d> for more options.]".
  INVENTORY_LIST_END = /^\[Use INVENTORY HELP/
  # The mark INVENTORY puts after a closed container's name, cut off its
  # item line (inventory_listing).
  INVENTORY_CLOSED = /\s+\(closed\)\z/
  # Seconds to wait for another script to free a hand before the one retry.
  UNPACK_FREE_HAND_WAIT = 20

  # Moves a keeper out of its reward sack into the loot bag and bins the
  # empty sack (task_unpack_keepers). The items are read off one INVENTORY
  # of the sack's id (inventory_listing), a line each, not off the LOOK
  # description, whose one sentence lists them all: from "a large coralite
  # lump, a huge piece of amber and a small lilac amethyst" (Lukedo,
  # 2026-11-05) its last word took only the amethyst. Each of the sack's own
  # item lines is taken by lich-5's DRC.get_noun of it, one get per line, so
  # two items of one noun both come out (unpack_item). A container in the
  # sack is one line (INVENTORY does not list what is in it) and comes out
  # whole, with what it holds. A line get_noun reads no noun off is left, and so is one
  # whose noun the game finds nothing in the sack by (get_noun reads "as"
  # off "frosty observer manifested as an array of jagged icicles"): the
  # next line is still got, and the sack is kept with what is left. A get
  # that brings nothing new to hand otherwise, a free hand refused twice,
  # or a put that fails stops the unpack. The sack is only binned once
  # INVENTORY shows it empty, so nothing is ever thrown away unseen, and it
  # is binned by its id. The description is not read; the caller passes it
  # as before.
  #
  # @param _description [String] the sack contents, LOOK prefix stripped
  # @param sack_id [String] the reward sack's id (sort_sack's
  #   reward_sack_id, never nil here), never found by noun: another sack in
  #   hand (a pet sack) is not the reward
  # @return [Boolean] true when the item is in the loot bag and the sack is
  #   binned; false leaves the sack in hand (with whatever is still in it,
  #   or empty when it could not be binned) for the caller to keep as before
  def unpack_keeper?(_description, sack_id)
    lines = inventory_listing("##{sack_id}")
    return false if lines.nil? || lines.empty?

    lines.filter_map { |line| DRC.get_noun(line) }.each do |noun|
      return false if unpack_item(noun, sack_id) == :stuck
    end
    return false unless inventory_listing("##{sack_id}") == []

    return false unless DRCI.dispose_trash("##{sack_id}", @worn_trashcan, @worn_trashcan_verb)

    true
  end

  # Takes one item out of the sack by noun (take_from_sack) and puts it in
  # the loot bag by the id it has in hand, or back in the sack when the
  # loot bag won't take it.
  #
  # @param noun [String]
  # @param sack_id [String]
  # @return [Symbol] :bagged when it is in the loot bag; :not_found when the
  #   game found nothing in the sack by that noun, so nothing moved; :stuck
  #   when the get or the put failed any other way
  def unpack_item(noun, sack_id)
    item_id = take_from_sack(noun, sack_id)
    return :not_found if item_id == :not_found
    return :stuck unless item_id
    return :bagged if DRCI.put_away_item?("##{item_id}", @lootbag)

    DRC.bput("put ##{item_id} in ##{sack_id}", 'You put', 'What were you referring to')
    :stuck
  end

  # Gets the item by noun from the sack with that id, retrying once when
  # another script is holding the free hand. The item is the one newly in
  # hand, whatever noun the game gives it, as the noun asked for is read
  # off its name by get_noun: get_noun's "robe" gets a "shadowy black
  # nightsilk robe pinned with a trio of panther claws", whose noun is
  # "robes".
  #
  # @param noun [String]
  # @param sack_id [String]
  # @return [String, Symbol, nil] the id of the item now in hand;
  #   :not_found when the game found nothing by that noun
  #   (UNPACK_GET_FAILURES) and no hand changed; nil for anything else (no
  #   new item in hand after the get, a free hand refused twice, no answer)
  def take_from_sack(noun, sack_id)
    before = hand_ids
    2.times do |attempt|
      case DRC.bput("get #{noun} from ##{sack_id}", UNPACK_GET_SUCCESS, UNPACK_NEED_FREE_HAND, *UNPACK_GET_FAILURES)
      when UNPACK_GET_SUCCESS
        return (hand_ids - before - [sack_id]).first
      when UNPACK_NEED_FREE_HAND
        break if attempt.positive?

        wait_for_free_hand
      when *UNPACK_GET_FAILURES
        return hand_ids == before ? :not_found : nil
      else
        break
      end
    end
    nil
  end

  # @param noun [String]
  # @param except [String, nil] an id to skip (the sack, while it is held)
  # @return [String, nil] the id of a held item with this noun
  def held_id(noun, except: nil)
    [GameObj.right_hand, GameObj.left_hand]
      .find { |obj| obj&.noun == noun && obj.id && obj.id != except }
      &.id
  end

  # Waits (bounded) until a hand is free.
  # @return [void]
  def wait_for_free_hand
    deadline = Time.now + UNPACK_FREE_HAND_WAIT
    pause 1 while DRC.left_hand && DRC.right_hand && Time.now < deadline
  end

  # Sack history for ;taskmaster loot_history. UserVars persists, so the list
  # is capped; a character running tasks all event would otherwise add
  # thousands of entries a month.
  LOOT_HISTORY_LIMIT = 100

  # Adds the sack's contents to this taskmaster's history.
  #
  # @param contents [String] the sack's contents
  # @note UserVars.taskmaster_sacks persists across runs.
  # @return [void]
  def remember_sack(contents)
    UserVars.taskmaster_sacks ||= {}
    history = (UserVars.taskmaster_sacks[@npc] ||= [])
    history << contents
    history.shift(history.size - LOOT_HISTORY_LIMIT) if history.size > LOOT_HISTORY_LIMIT
  end
end

before_dying do
  TaskMaster.restore_hometown
  Flags.delete("wrap-up")
  Flags.delete("thieving-fog")
  Flags.delete(TaskMaster::ENCHANTED_FLAG)
end

TaskMaster.new.run
