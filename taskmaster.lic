=begin
  YAML SETTINGS(all optional but the first)
  task_loot_bag: bagname
  task_no_repair: true/false # skip repairing tools entirely
  task_self_repair: true/false # use own brush and oil for repairs
  task_get_tools_on_completion: true/false # If you want taskmaster to pickup any remaining tools in the repair shop. Useful if you're using clerk-tools after each task
  task_use_boost: true/false # use boost to eliminate task cooldowns, useful if you have a few and you're doing a lot of tasks
  task_cooldown_poll: 15 # seconds between asks while the taskmaster makes you wait (minimum 3)
  task_boosts: [task, haste] # boosts to use. task: BOOST TASK when a task is on cooldown (same as task_use_boost). haste: keep BOOST HASTE (1 hour, roundtimes -1 second) running between tasks
  task_keep_list: list of items to keep. See default in base.yaml
  task_junk_list: list of items to throw away; everything else is kept. When set (non-empty) it replaces task_keep_list, so a prize nobody has listed yet is kept rather than binned
  task_slack_keepers: true/false # send a Slack message (slack_username) for each keeper
  task_crafting_room: <room number> # Room to craft in. Ensure it meets specifications for tooling required...
  task_before_scripts: ['restock'] # scripts (with any arguments) to run before asking for each task, while the previous task's cooldown runs
  task_copper_floor: 20000 # before each task, if you carry less copper (Kronars) than this, exchange foreign coins and withdraw up to task_copper_target
  task_copper_target: 110000
  crafting_items_in_container: ['oil', 'glue'] # list of items you might have duplicates of in other bags, but which you only want drawn from crafting bag
  crafting_container: bagname
   ## Important: set default stow to the same bag as your crafting bag (tools are still stowed that way when task_no_repair is set, and so is anything else in hand when the task instructions are read) ##
=end

class TaskMaster
  # Stock base => [stock name, room to order it in]. restock tops up cloth,
  # leather, yarn and thread for marathon runs; thread is the cotton spool
  # (stock-name cotton in base-crafting.yaml).
  STACKMAP = {
    'leather' => ['rat', 16667], 'cloth' => ['burlap', 16667], 'stack' => ['deer', 8864], 'ingot' => ['bronze', 8775],
    'stone' => ['alabaster', 8864], 'yarn' => ['wool', 16667], 'lumber' => ['balsa', 8864], 'thread' => ['cotton', 16667]
  }.freeze

  # Search rooms for the taskmasters, in the order find_npc walks them.
  ROOMS = [16_145, 16_146, 16_148, 16_150, 16_153, 16_154, 16_147, 16_276, 16_277, 16_278, 16_290, 16_291, 16_292, 16_293, 16_295, 16_296, 16_294, 16_159, 16_161, 16_166, 16_169].freeze

  # Tools each taskmaster's tasks need, for ;taskmaster <npc> tools.
  TOOLS = {
    'poltu'   => ['forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'bradyn'  => ['bone saw', 'chisels', 'wood shaper', 'rasp', 'carving knife', 'drawknife', 'forging hammer', 'bellows', 'tongs', 'stirring rod', 'shovel'],
    'zasele'  => ['knitting needles', 'sewing needles', 'awl', 'slickstone', 'yardstick', 'scissors'],
    'shaping' => ['wood shaper', 'rasp', 'carving knife', 'drawknife']
  }.freeze

  # Arguments for parse_args: the npc and finish/find/tools/repeat, or one
  # of the other modes.
  ARG_DEFINITIONS = [
    [
      { name: 'npc', options: %w[poltu bradyn zasele], variable: true, description: "Task npc's name, in full" },
      { name: 'finish', regex: /^finish/, optional: true, description: 'Finishes a task you\'re already on' },
      { name: 'find', regex: /^find/i, optional: true, description: 'Seeks out the taskmaster, then exits' },
      { name: 'tools', regex: /^tools/i, optional: true, description: 'Spits out a list of the tools you need for a given npc\'s tasks' },
      { name: 'repeat', regex: /^repeat/i, optional: true, description: 'Repeat tasks for a given taskmaster' }
    ],
    [
      { name: 'reset_output', regex: /^reset_output/i, optional: true, description: 'Clears prize window' },
      { name: 'pickup', regex: /^pickup/i, optional: true, description: 'Picks up any tools left at Rangu for repair' },
      { name: 'cycle', regex: /^cycle/i, optional: true, description: 'Cycles through each taskmaster randomly and completes their task' },
      { name: 'marathon', regex: /^marathon/i, optional: true, description: 'stocks up and runs zasele tasks, repairs during restock' },
      { name: 'loot_history', regex: /^loot_history/i, optional: true, description: 'Prints out saved sack contents history, potentially scrollish' },
      { name: 'script_summary', optional: true, description: 'Completes Hollows Eve tasks for the crafting taskmasters on the island' }
    ]
  ].freeze

  # Reads the settings and sets up state. Does not parse arguments or send
  # anything to the game -- call {#run} to start.
  #
  # @note Adds the "wrap-up" flag (the taskmaster's "Finish your tasks."
  #   call) and seeds UserVars.taskmaster_sacks, which persists across runs.
  # @return [void]
  def initialize
    @settings = get_settings
    @rooms = ROOMS
    configure_loot_filter
    @bag = @settings.crafting_container
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb
    @bag_items = @settings.crafting_items_in_container
    @lootbag = @settings.task_loot_bag || 'backpack'
    @gem = @settings.gem_pouch_adjective
    @cube = @settings.cube_armor_piece
    @no_repair = @settings.task_no_repair
    @anvil_town = @settings.crafting_hometown || "Crossing"
    @self_repair = @settings.task_self_repair
    @pickup_tools = @settings.task_get_tools_on_completion
    configure_boosts
    @crafting_room = @settings.task_crafting_room
    @cooldown_poll = cooldown_poll_seconds
    configure_copper
    @before_scripts = Array(@settings.task_before_scripts)

    @stockdata = get_data('crafting')['stock']
    @stackmap = STACKMAP
    Flags.add("wrap-up", /^You say, "Finish your tasks."/)
    UserVars.taskmaster_sacks ||= { 'zasele' => [], 'bradyn' => [], 'poltu' => [] }
  end

  # Runs the mode the arguments ask for. The one-shot modes exit; cycle and
  # the plain modes go on to the task loop.
  #
  # @param args [OpenStruct] parsed arguments (npc, finish, find, tools,
  #   repeat, reset_output, pickup, cycle, marathon, loot_history)
  # @return [void]
  # @raise [SystemExit] after the one-shot modes, marathon and finish, or
  #   from run_tasks
  def run(args = parse_args(ARG_DEFINITIONS))
    @npc = args.npc
    @marathon = args.marathon
    if args.find
      find_npc(@rooms, @npc)
      exit
    elsif args.tools
      list_tools
    elsif args.finish
      finish_task_in_progress
    elsif args.reset_output
      _respond("<clearStream id='Task Master'/>")
      exit
    elsif args.cycle
      @npc = ['poltu', 'bradyn', 'zasele'].sample
    elsif args.loot_history
      print_loot_history
    elsif args.pickup
      tool_pickup if DRCI.exists?("rangu ticket")
      exit
    elsif @marathon
      run_marathon
    end

    run_tasks(args)
  end

  # Lists the tools the named taskmaster's tasks need, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def list_tools
    DRC.message("Tools required:")
    TOOLS[@npc.downcase].each do |tool|
      DRC.message("#{tool}")
    end
    exit
  end

  # Prints the saved sack history for each taskmaster, then exits.
  #
  # @return [void]
  # @raise [SystemExit] always
  def print_loot_history
    ['poltu', 'bradyn', 'zasele'].each do |npc|
      DRC.message("Sack history for Taskmaster #{npc.capitalize}:")
      UserVars.taskmaster_sacks[npc].each do |sack|
        DRC.message(sack)
      end
    end
    exit
  end

  # resume_task exits once the task is handed in.
  #
  # @return [void]
  # @raise [SystemExit] from resume_task
  def finish_task_in_progress
    reconcile_hands
    resume_task
  end

  # Copper, haste and the before scripts, run ahead of asking for each task.
  #
  # @return [void]
  def prepare_for_task
    top_up_copper
    refresh_haste
    run_before_scripts
  end

  # One task, or with repeat or cycle one after another until the wrap-up
  # call. cycle picks a new taskmaster after each task.
  #
  # @param args [OpenStruct] parsed arguments; reads cycle and repeat
  # @return [void]
  # @raise [SystemExit] from get_task (a task already in progress is finished
  #   by resume_task) or complete_task (nothing left to hand in, or the
  #   taskmaster can't be found)
  def run_tasks(args)
    reconcile_hands
    loop do
      @dispose, @remainder = [false, false]
      prepare_for_task
      item, count, volume_per_item, base, type = get_task
      tool_pickup if !@self_repair && DRCI.exists?("rangu ticket") # picks up any tools that you dropped off previous and stows them appropriately
      send(@npc.to_sym, item, count, volume_per_item, base, type)
      complete_task(item, count)
      break if Flags['wrap-up']

      if args.cycle
        @npc = ['poltu', 'bradyn', 'zasele'].sample
        next
      end
      break unless args.repeat
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket") # if indicated, and you have tickets, picks up any tools you may have dropped off previously, all disciplines
  end

  # Zasele tasks until the wrap-up call, restocking (and repairing) only when
  # the stock runs short, then exits.
  #
  # @return [void]
  # @raise [SystemExit] after the wrap-up call
  def run_marathon
    @npc = 'zasele'
    reconcile_hands
    restock
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    loop do
      prepare_for_task
      item, count, volume_per_item, base, type = get_task
      unless check_stock(count * volume_per_item, type, base)
        repair(@settings.outfitting_tools, @settings.outfitting_belt) unless @no_repair
        restock
        tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
        find_npc(@rooms, @npc)
      end
      tailor_item(item, count, base, type)
      DRCT.dispose("#{item} instructions", 16144)
      complete_task(item, count)
      break if Flags['wrap-up']
    end
    tool_pickup if @pickup_tools && DRCI.exists?("rangu ticket")
    exit
  end

  # Cleans up what a crash or disconnect left in hand before starting: a
  # reward sack is sorted, and an unfinished tailoring item made from the
  # stock taskmaster buys for Zasele is finished where the character stands
  # (sewing works in any room) with sew's resume mode, then put in the
  # crafting bag for the turn-in. Any other unfinished item is the player's
  # and is left alone. Knitting is not resumed: the work sits on the needles
  # and does not show in the hand.
  #
  # @return [void]
  def reconcile_hands
    waitrt?
    DRC.fix_standing
    sort_sack(nil) if held_items.any? { |held| held =~ /\bwoven sack\b/ }
    return unless @npc == 'zasele'

    unfinished = held_items.grep(/\bunfinished\b/)
    piece = unfinished.find { |held| task_piece?(held) }
    (unfinished - [piece]).each do |held|
      DRC.message("Leaving your #{held} alone: taskmaster only finishes the burlap, rat-pelt and wool pieces from its own tasks.")
    end
    return unless piece

    noun = piece.split.last
    DRC.wait_for_script_to_complete('sew', ['resume', noun])
    # Judge the result by the hand text: DRCI.in_hands?(noun) also matches
    # the unfinished piece, since the noun is the same.
    if held_items.any? { |held| task_piece?(held) }
      discard_unfinished(noun)
    elsif held_items.any? { |held| held =~ /\b#{Regexp.escape(noun)}\b/i }
      DRCC.stow_crafting_item(noun, @bag, nil)
    end
  end

  # An unfinished piece of the cloth, leather or yarn taskmaster buys for
  # Zasele's tasks (burlap, rat-pelt, wool).
  #
  # @param held [String] a hand's text, e.g. "coil of unfinished burlap reinforced rope"
  # @return [Boolean]
  def task_piece?(held)
    materials = @stackmap.values_at('cloth', 'leather', 'yarn').map(&:first)
    held.match?(/\bunfinished\b/) && held.match?(/\b(?:#{Regexp.union(materials)})\b/)
  end

  # sew could not finish the piece. Throws it away so it never reaches the
  # crafting bag, where the turn-in would pick it up, and stows any tool sew
  # left in hand so the next task starts with free hands. Not exiting: the
  # next start would try the same resume and stop again.
  #
  # @param noun [String] the unfinished item's noun
  # @return [void]
  def discard_unfinished(noun)
    DRC.message("sew could not finish your unfinished #{noun}. Throwing it away and starting a new task.")
    DRCI.dispose_trash(noun, @worn_trashcan, @worn_trashcan_verb)
    held_items.reject { |held| held =~ /\bunfinished\b/ }.each do |held|
      DRCC.stow_crafting_item(held, @bag, @settings.outfitting_belt)
    end
  end

  # What is in either hand, right first.
  #
  # @return [Array<String>] the hands' text, empty hands left out
  def held_items
    [DRC.right_hand, DRC.left_hand].compact
  end

  # A new task is offered about 30 seconds after a turn-in, so the poll
  # interval decides how much of each wait is lost past that point.
  MIN_COOLDOWN_POLL = 3

  # Seconds between asks while the taskmaster makes you wait:
  # task_cooldown_poll, 15 by default, never below MIN_COOLDOWN_POLL.
  #
  # @return [Integer]
  def cooldown_poll_seconds
    [(@settings.task_cooldown_poll || 15).to_i, MIN_COOLDOWN_POLL].max
  end

  # Runs each task_before_scripts entry ("script arg arg") to completion. They
  # run before asking for a task, so they overlap the taskmaster's cooldown
  # after the previous turn-in instead of adding to the task.
  #
  # @return [void]
  def run_before_scripts
    @before_scripts.each do |entry|
      name, *script_args = entry.to_s.split
      next unless name

      DRC.wait_for_script_to_complete(name, script_args)
    end
  end

  # Either a keep list (keep matches, bin the rest) or a junk list (bin
  # matches, keep the rest). Entries may be strings or regexps. A missing or
  # empty junk list falls back to the keep list; a missing keep list keeps
  # nothing, as before.
  #
  # @return [void]
  def configure_loot_filter
    junk = Array(@settings.task_junk_list)
    if junk.empty?
      @junk_regex = nil
      @keeplist_regex = Regexp.union(Array(@settings.task_keep_list))
    else
      @junk_regex = Regexp.union(junk)
    end
    @slack_keepers = @settings.task_slack_keepers
    register_slackbot(@settings.slack_username) if @slack_keepers
  end

  # An unreadable or empty look is never a keeper, so a failed LOOK cannot
  # fill the loot bag with empty sacks in junk-list mode.
  #
  # @param contents [String, nil] the LOOK IN reply for the reward sack
  # @return [Boolean] true to keep the sack
  def keeper?(contents)
    return false if contents.to_s.strip.empty?
    return !contents.match?(@junk_regex) if @junk_regex

    contents.match?(@keeplist_regex)
  end

  # How long one Minor Haste boost lasts.
  HASTE_SECONDS = 3600
  # How long to wait before asking again after an answer that was neither an
  # activation nor a lack of credits, or no answer at all.
  # November 2025 logs (Hollow Eve, 21 characters, ~49,000 BOOST HASTE sends)
  # only ever show those two replies (besides "...wait" in roundtime). Each activation spent exactly one credit
  # (BOOST listings before and after agree). With haste running and no credits
  # left, the game gives the no-credits line, not an "already active" one.
  # BOOST HASTE with haste running and credits left never happened, so whether
  # it restarts the hour and spends a credit is unknown; the stored expiry
  # keeps that to at most one credit when the expiry is lost.
  HASTE_RECHECK_SECONDS = 600
  # BOOST HASTE reply when a credit was spent.
  HASTE_ACTIVATED = /You've activated the Minor Haste boost/
  # BOOST HASTE reply with no credits left.
  HASTE_NO_CREDITS = /You don't have enough credits for the Minor Haste boost/

  # Reads task_boosts (and the older task_use_boost, which means the task
  # boost) into @boosts, and arms the one task boost per run in @boost.
  #
  # @return [void]
  def configure_boosts
    @boosts = Array(@settings.task_boosts).map { |boost| boost.to_s.downcase }
    @boosts |= ['task'] if @settings.task_use_boost
    @boost = @boosts.include?('task')
  end

  # Keeps BOOST HASTE running. Its expiry is kept in UserVars because t2 can
  # start this script once per task, so the hour outlives any single run.
  # Out of credits costs one command per task and picks up new credits by
  # itself.
  #
  # @note The expiry lives in UserVars.taskmaster_haste_expires, which
  #   persists across runs, since t2 relaunches this script for each task.
  # @return [void]
  def refresh_haste
    return unless @boosts.include?('haste')
    return if Time.now.to_i < UserVars.taskmaster_haste_expires.to_i

    case DRC.bput('boost haste', HASTE_ACTIVATED, HASTE_NO_CREDITS, /Minor Haste/)
    when HASTE_ACTIVATED
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_SECONDS
    when HASTE_NO_CREDITS
      nil
    else
      UserVars.taskmaster_haste_expires = Time.now.to_i + HASTE_RECHECK_SECONDS
    end
  end

  # Reads task_copper_floor (20000 by default) and task_copper_target
  # (110000 by default, never below the floor).
  #
  # @return [void]
  def configure_copper
    @copper_floor = @settings.task_copper_floor || 20_000
    @copper_target = [@settings.task_copper_target || 110_000, @copper_floor].max
  end

  # One WEALTH check per task. Only when below the floor does this walk to the
  # bank, exchanging any foreign coins from reward sacks on the way, and refill
  # to the target, so most tasks need no trip. The per-purchase
  # ensure_copper_on_hand calls stay as a guard for tasks that cost more than
  # the floor; they only walk when short.
  #
  # @return [void]
  def top_up_copper
    return if DRCM.wealth("Crossing") >= @copper_floor

    exchange_coins
    DRCM.ensure_copper_on_hand(@copper_target, @settings, "Crossing")
  end

  # Walks to the Crossing exchange and changes every other currency into
  # Kronars, such as the coins from reward sacks.
  #
  # @return [void]
  def exchange_coins
    DRCT.walk_to(get_data('town')["Crossing"]['exchange']['id'])
    DRC.release_invisibility
    exchange_to = get_data('town')["Crossing"]['currency']
    $CURRENCIES
      .reject { |currency| currency =~ /#{exchange_to}/i }
      .each { |currency| fput("exchange all #{currency} for #{exchange_to}") }
  end

  # Marathon restock: tops up burlap cloth and rat leather to 100 yards, and
  # wool yarn and cotton thread to 400, plus pins, paying from the copper
  # float.
  #
  # @return [void]
  def restock
    info = get_data('crafting')['tailoring']["Crossing"]
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, nil, 40)
    need = {}
    cost = 0
    ['cloth', 'leather'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (100 - current) / 10)
      else
        need.store(stock, 10)
      end
      cost += need[stock] * @stockdata[@stackmap[stock].first]['stock-value']
    end
    ['yarn', 'thread'].each do |stock|
      if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
        /(\d+)/ =~ DRC.bput("count my #{@stackmap[stock].first} #{stock}", /^You count out (\d+) yards of material/)
        current = Regexp.last_match(1).to_i
        need.store(stock, (400 - current) / 100)
      else
        need.store(stock, 4)
      end
      cost += need[stock] * @stockdata[stock]['stock-value']
    end
    return if cost == 0

    top_up_copper
    DRCM.ensure_copper_on_hand(cost + 8000, @settings, "Crossing")
    ## now we have a hash with stock=># to order, and cash on hand
    need.each do |stock, number|
      next unless number > 0

      DRCT.walk_to(16667)
      DRCC.get_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, @bag_items, nil) if DRCI.exists?("#{@stackmap[stock].first} #{stock}")
      number.times do
        DRCT.order_item(@stackmap[stock].last, (stock == 'yarn' || stock == 'thread') ? @stockdata[stock]['stock-number'] : @stockdata[@stackmap[stock].first]['stock-number'])
        DRC.bput("combine #{stock}", /you (combine|must)/i)
      end
      DRCC.stow_crafting_item("#{@stackmap[stock].first} #{stock}", @bag, nil)
    end
  end

  # Whether the crafting bag holds enough of a stock for a task.
  #
  # @param needed [Integer] yards the task needs
  # @param type [String] stock name, e.g. 'burlap'
  # @param base [String] stock base, e.g. 'cloth'
  # @return [Boolean] false when none is carried or it is short
  def check_stock(needed, type, base)
    return false unless DRCI.exists?("#{type} #{base}")

    /(\d+)/ =~ DRC.bput("count my #{type} #{base}", /^You count out (\d+) yards of material/)
    if Regexp.last_match(1).to_i >= needed
      true
    else
      false
    end
  end

  # Throws away what a task leaves over: with @remainder set, every leftover
  # ingot or piece of stock in the crafting bag, then the instructions.
  #
  # @param item [String] item noun, for the instructions
  # @param base [String] stock base; ingots go to a different bin
  # @param type [String] metal of leftover ingots
  # @return [void]
  def trash(item, base, type)
    if @remainder && base == 'ingot'
      until /What were you/ =~ DRC.bput("get my #{type} #{base} from my #{@bag}", "You get", "You are already", "You're already", "What were you")
        DRCT.dispose("#{type} #{base}", 793)
      end
    elsif @remainder
      until /What were you/ =~ DRC.bput("get my #{@stackmap[base].first} #{base} from my #{@bag}", "You get", "You are already", "You're already", "What were you")
        DRCT.dispose("#{@stackmap[base].first} #{base}", 14886)
      end
    end
    DRCT.dispose("#{item} instructions", Room.current.id)
  end

  # Works one of Poltu's metal tasks.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def poltu(item, count, volume_per_item, base, type)
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # Works one of Bradyn's tasks: carving stone or bone, shaping wood, or
  # forging metal like Poltu.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer, String] volumes per item, or 'boulder' for stone
  # @param base [String] stock base: 'stone', 'stack', 'lumber' or 'ingot'
  # @param type [String] stock name, e.g. 'alabaster', 'deer', 'balsa' or 'bronze'
  # @return [void]
  def bradyn(item, count, volume_per_item, base, type)
    if base == 'stone'
      buy_rocks(count)
      carve_stone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'stack'
      buy_stackables(item, count, volume_per_item, base)
      carve_bone(item, count)
      repair([DRC.right_hand], @settings.engineering_belt)
      trash(item, base, type)
      return
    elsif base == 'lumber'
      buy_stackables(item, count, volume_per_item, base)
      shape_item(item, count, base, type)
      # base.yaml names the shaping toolset shaping_tools; engineering_tools is the
      # older key, kept as a fallback the same way clerk-tools resolves it.
      repair(@settings.shaping_tools || @settings.engineering_tools || [], @settings.engineering_belt)
      trash(item, base, type)
      return
    end
    forge_metal_task(item, count, volume_per_item, base, type)
  end

  # A Poltu or Bradyn metal task: buy the metal, forge the items, send the
  # forging tools for repair and throw away any metal left over.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param base [String] stock base, 'ingot'
  # @param type [String] the task's metal, e.g. 'bronze'
  # @return [void]
  def forge_metal_task(item, count, volume_per_item, base, type)
    type = buy_metal(count, volume_per_item, type)
    forge_item(item, count, type)
    repair(@settings.forging_tools, @settings.forging_belt)
    trash(item, base, type)
  end

  # Buys the metal for a forging task and returns the metal to forge with.
  # Items of exactly one ingot each need no smelting; anything else gets
  # enough bronze ingots for the whole task, or one steel ingot for small
  # items, and sets @remainder so trash throws away what is left.
  #
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] volumes of metal per item
  # @param type [String] the task's metal, used for one-ingot-per-item tasks
  # @return [String] the metal to forge with: 'steel' or type
  def buy_metal(count, volume_per_item, type)
    if volume_per_item == 10 # exactly one ingot per item, so no scrap, no smelting
      type = 'steel'
      buy_ingots(count, type)
    elsif volume_per_item == 5 # exactly one bronze ingot per item
      buy_ingots(count, type)
    elsif count * volume_per_item > 100
      @remainder = true
      bingots(3)
    elsif count * volume_per_item > 50
      @remainder = (count * volume_per_item) % 100 > 0 ? true : false
      bingots(2)
    elsif volume_per_item < 5
      type = 'steel'
      @remainder = true
      buy_ingots(1, type)
    else # 50 volumes or less in all, more than 5 per item
      @remainder = true
      bingots(1)
    end
    type
  end

  # Works one of Zasele's tasks: knitting yarn, or sewing cloth or leather.
  #
  # @param item [String] item noun from the task journal
  # @param count [Integer] how many items to make
  # @param volume_per_item [Integer] yards per item
  # @param base [String] stock base: 'cloth', 'leather' or 'yarn'
  # @param type [String] stock name, e.g. 'burlap'
  # @return [void]
  def zasele(item, count, volume_per_item, base, type)
    if base == 'yarn'
      buy_yarn(item, count, volume_per_item, base)
      toolset = ["knitting needles"]
    else
      buy_stackables(item, count, volume_per_item, base)
      toolset = @settings.outfitting_tools
    end
    tailor_item(item, count, base, type)
    repair(toolset, @settings.outfitting_belt)
    trash(item, base, type)
  end

  # Taskmasters wander, but between turn-ins they are usually back in the
  # room they were last seen in. Search from there outwards along the room
  # list, and remember where each one was found. Kept in UserVars because t2
  # can start this script once per task.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param npc [String] taskmaster name, lower case
  # @note UserVars.taskmaster_last_seen persists across runs.
  # @return [void]
  def find_npc(rooms, npc)
    UserVars.taskmaster_last_seen ||= {}
    search_order(rooms, UserVars.taskmaster_last_seen[npc]).each do |room_id|
      break if DRRoom.npcs.include?(npc.capitalize)

      DRCT.walk_to(room_id)
    end
    UserVars.taskmaster_last_seen[npc] = Room.current.id if DRRoom.npcs.include?(npc.capitalize)
  end

  # The room list starting at start_room and alternating outwards from it
  # (start, next, previous, two on, two back, ...), or the list unchanged when
  # start_room is not in it.
  #
  # @param rooms [Array<Integer>] rooms to search, in order
  # @param start_room [Integer, nil] where the taskmaster was last seen
  # @return [Array<Integer>] every room, once
  def search_order(rooms, start_room)
    start = rooms.index(start_room)
    return rooms unless start

    order = [rooms[start]]
    (1...rooms.size).each do |step|
      order << rooms[start + step] if start + step < rooms.size
      order << rooms[start - step] if start - step >= 0
    end
    order
  end

  # The task journal entry. "So far, you have returned N" is optional so an
  # entry printed without it still parses as nothing returned.
  TASK_JOURNAL = /wanted you to craft (.*) and indicated that (\d+) would suffice\.(?:\s+So far, you have returned (\d+))?/
  # TASK reply when not on a task.
  NOT_ON_TASK = /^You are not currently on a task/
  # The materials line of READ INSTRUCTIONS: the stock and its volume, or
  # the size of rock for stone.
  INSTRUCTION_MATERIALS = /(cloth|bone|stone|yarn|wood|leather|metal).* \(((\d+) .*|boulder|large rock|small rock|stone|pebble)\)/

  # Reads the task just accepted, or the one in progress, and its
  # instructions.
  #
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count still owed, volume per item ('boulder' for stone), base
  #   and type
  # @raise [SystemExit] when not on a task
  def finish
    item, count = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    read_instructions(item, count)
  end

  # Reads the task journal and returns the item noun and how many are still
  # owed, or nil when not on a task.
  #
  # @return [Array(String, Integer), nil] item noun and how many are owed
  def read_task
    entry = DRC.bput("task", TASK_JOURNAL, NOT_ON_TASK)
    match = TASK_JOURNAL.match(entry)
    return nil unless match

    item = match[1].split.last
    remaining = [match[2].to_i - match[3].to_i, 0].max
    DRC.message("Making #{remaining} #{item}s")
    return item, remaining
  end

  # Reads the item's instructions for its material and volume, then stows
  # them, returning everything the worker methods need.
  #
  # @param item [String] item noun
  # @param count [Integer] how many are owed
  # @note An unrecognised materials line leaves base nil; Lich's nil patch
  #   then makes type nil instead of raising.
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String)]
  #   item, count, volume per item ('boulder' for stone), base and type
  def read_instructions(item, count)
    case DRC.bput("read my #{item} instructions", INSTRUCTION_MATERIALS)
    when /(cloth|bone|yarn|wood|leather|metal).* \(((\d+) .*)\)/
      base = Regexp.last_match(1)
      volume_per_item = Regexp.last_match(3).to_i
      base = base.sub('bone', 'stack').sub('metal', 'ingot').sub('wood', 'lumber')
      DRC.message("Each #{item} requires #{volume_per_item} volumes")
    when /stone .* \((\w+)\)/
      volume_per_item = 'boulder'
      base = 'stone'
      DRC.message("Using a boulder for each #{item}")
    end
    stow_instructions(item)
    type = @stackmap[base].first
    return item, count, volume_per_item, base, type
  end

  # Turn-in reply while more items are owed.
  TURN_IN_MORE_NEEDED = /(\d+) more (?:are|is) needed/
  # READ INSTRUCTIONS line giving the uses left.
  INSTRUCTION_USES = /They have only (\d+) uses? remaining/

  # Finishes a task already in progress, for instance after a crash or a
  # reconnect: hand in any finished items already in the bag, make sure the
  # instructions have a use for every item still owed (asking the taskmaster
  # only when they don't, since replacements are limited), then make and hand
  # in the rest.
  #
  # @return [void]
  # @raise [SystemExit] always: when not on a task, when the banked items
  #   finish it, or after the last item is handed in
  def resume_task
    @dispose, @remainder = [false, false]
    item, owed = read_task
    unless item
      DRC.message("You are not on a task with #{@npc}.")
      exit
    end
    owed = turn_in_banked(item, owed)
    exit if owed.zero?

    ensure_instructions(item, owed)
    item, count, volume_per_item, base, type = read_instructions(item, owed)
    refresh_haste
    top_up_copper
    tool_pickup if !@self_repair && DRCI.exists?("rangu ticket")
    send(@npc.to_sym, item, count, volume_per_item, base, type)
    complete_task(item, count)
    exit
  end

  # Hands in finished items already in the bag and returns how many are still
  # owed, or 0 once the task is complete (its reward sack sorted). A give that
  # misses a wandering taskmaster is retried (give_item); anything she won't
  # take goes back in the bag and stops the hand-in.
  #
  # @param item [String] item noun
  # @param owed [Integer] how many are owed before the hand-in
  # @return [Integer] how many are still owed, 0 once the task is done
  # @raise [SystemExit] from give_item after repeated misses
  def turn_in_banked(item, owed)
    loop do
      case give_item(item)
      when nil
        break
      when /hands you a/
        sort_sack(item)
        fput('dump junk')
        return 0
      when TURN_IN_MORE_NEEDED
        owed = Regexp.last_match(1).to_i
      else
        DRCC.stow_crafting_item(item, @bag, nil)
        break
      end
    end
    owed
  end

  # Leaves the item's instructions in hand, asking the taskmaster for a fresh
  # set only when none are carried, they are someone else's, or they have fewer
  # uses than items owed (each item takes one study).
  #
  # @param item [String] item noun
  # @param owed [Integer] items still to make, one study each
  # @return [void]
  def ensure_instructions(item, owed)
    carried = DRCI.get_item?("#{item} instructions", @bag)
    if carried
      reply = DRC.bput("read my #{item} instructions", INSTRUCTION_USES, /written by or for someone else/, /What were you referring/)
      return if reply[INSTRUCTION_USES, 1].to_i >= owed

      # Put the short or unreadable set back so only the new one is in hand.
      DRCC.stow_crafting_item("#{item} instructions", @bag, nil)
    end
    get_instructions
  end

  # Put the instructions just read into the crafting bag by name, where the
  # crafting scripts put them after studying, rather than leaving them to
  # default stow. Anything else still in hand (a tool or unfinished item held
  # after a crash) goes to default stow as before.
  #
  # @param item [String] item noun
  # @return [void]
  def stow_instructions(item)
    DRCC.stow_crafting_item("#{item} instructions", @bag, nil)
    DRCI.stow_hands
  end

  # Finds the taskmaster and asks for a fresh set of instructions.
  #
  # @return [String] the reply
  def get_instructions
    find_npc(@rooms, @npc)
    DRC.bput("ask #{@npc} for instructions", "hands you", "gives you", "handing you")
  end

  # Asks the taskmaster for a task until one is offered, waiting out
  # cooldowns, and returns what finish reads from it. An ongoing task is
  # resumed instead, and nil comes back when the reply matches nothing.
  # A while loop, not Kernel#loop: loop would swallow a StopIteration raised
  # inside it and return nil, where the old recursion let it propagate.
  #
  # @return [Array(String, Integer, Integer, String, String), Array(String, Integer, String, String, String), nil]
  #   what {#finish} returns, or nil
  # @raise [SystemExit] from finish (not on a task) or resume_task
  def get_task
    while true
      find_npc(@rooms, @npc)
      case DRC.bput("ask #{@npc} for task", /if you agree to (his|her) terms/, /You may accept by typing ACCEPT TASK/, /utterly ignoring you/, /you must wait before I can give you a task/, /You are already on a task/, /give you a chance a little later/, /^To whom are you speaking/)
      when /if you agree to (his|her) terms/, /To whom are you speaking/
        next
      when /You are already on a task/
        return resume_task
      when /utterly ignoring you/, /give you a chance a little later/
        DRC.message("Task on cooldown or recently canceled a task, either way, going to have to wait.")
        pause @cooldown_poll
      when /you must wait before I can give you a task/
        if @boost
          fput("boost task")
          pause 2
          @boost = false
        else
          pause @cooldown_poll
        end
      when /You may accept by typing ACCEPT TASK/
        DRC.bput("accept task", /You can check your progress with the TASK verb/)
        return finish
      else
        return nil
      end
    end
  end

  # Buys ingots of one metal from room 8775 and puts each in the crafting
  # bag.
  #
  # @param count [Integer] how many ingots
  # @param type [String] metal, e.g. 'steel'
  # @return [void]
  def buy_ingots(count, type)
    cost = count * @stockdata[type]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8775, @stockdata[type]['stock-number'])
      DRCC.stow_crafting_item("ingot", @bag, nil)
    end
  end

  # Orders bronze ingot number order from the shop in room 17118 (buy_metal
  # picks 1, 2 or 3 by the task's total volume) and puts it in the crafting
  # bag.
  #
  # @param order [Integer] order number: 1, 2 or 3
  # @return [void]
  def bingots(order)
    cost = order * 8000 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    DRCT.order_item(17118, order)
    DRCC.stow_crafting_item("ingot", @bag, nil)
  end

  # Buys enough 10-volume stock (cloth, leather, bone, lumber) for the
  # task, combines it and stows it, setting @remainder when some is left
  # over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] volumes per item
  # @param base [String] stock base, a STACKMAP key
  # @return [void]
  def buy_stackables(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 10.to_f).ceil
    @remainder = (count * vpi) % 10 > 0 ? true : false
    cost = base_to_buy * @stockdata[@stackmap[base].first]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    base_to_buy.times do
      DRCT.order_item(@stackmap[base].last, @stockdata[@stackmap[base].first]['stock-number'])
      DRC.bput("combine #{base}", /you (combine|must)/i)
    end
    DRCC.stow_crafting_item(base, @bag, @settings.engineering_belt)
  end

  # Buys enough 100-yard yarn for the task, combines it and stows it,
  # setting @remainder when some is left over.
  #
  # @param _item [String] unused
  # @param count [Integer] how many items
  # @param vpi [Integer] yards per item
  # @param base [String] 'yarn'
  # @return [void]
  def buy_yarn(_item, count, vpi, base)
    base_to_buy = ((count * vpi) / 100.to_f).ceil
    @remainder = (count * vpi) % 100 > 0 ? true : false
    cost = base_to_buy * @stockdata[base]['stock-value'] + 7500 # 5 gold for the next task, 2500 for repair monies
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    base_to_buy.times do
      DRCT.order_item(@stackmap[base].last, @stockdata[base]['stock-number'])
      DRC.bput("combine #{base}", /you (combine|must)/i)
    end
    DRCC.stow_crafting_item(base, @bag, @settings.engineering_belt)
  end

  # Buys one alabaster rock deed per item and stows the deeds.
  #
  # @param count [Integer] how many deeds
  # @return [void]
  def buy_rocks(count)
    cost = count * 1250 + 7500
    DRCM.ensure_copper_on_hand(cost, @settings, "Crossing")
    count.times do
      DRCT.order_item(8864, 2)
      DRCC.stow_crafting_item("deed", @bag, @settings.engineering_belt)
    end
  end

  # Forges each item with the forge script at an anvil (or the
  # task_crafting_room) and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param type [String] metal to forge with
  # @return [void]
  def forge_item(item, count, type)
    unless @crafting_room
      info = get_data('crafting')['blacksmithing']["Crossing"]
      DRCC.check_consumables('oil', info['finisher-room'], info['finisher-number'], @bag, @bag_items, nil, count)
      DRCC.find_anvil(@anvil_town)
    else
      DRCT.walk_to(@crafting_room)
    end
    DRCC.clean_anvil?
    count.times do
      DRC.wait_for_script_to_complete('forge', ['instructions', type, item, 'skip'])
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Carves each stone item from its rock deed and bags it. When the thief's
  # fog rolls through mid-carve, it buys a new deed and carves that item
  # again.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @note Adds the "thieving-fog" flag, deleted when the script ends.
  # @return [void]
  def carve_stone(item, count)
    Flags.add("thieving-fog", "A low fog rolls in, then just as quickly rolls out")
    DRCC.find_shaping_room(@anvil_town)
    DRCC.get_crafting_item("chisels", @bag, @bag_items, @settings.engineering_belt)
    remaining = count
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get alabaster deed from my #{@bag}", '^You get')
      fput('tap my deed')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /You reach out and touch/, /You are not attuned to this particular enchantment/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/, /^You reach out and touch/) if @cube
      DRC.bput("carve boulder with my chisels", "Roundtime")
      loop do
        case DRC.bput("carve #{item} with my chisels", "Roundtime", "You cannot figure out how to do that", "It would be better to find")
        when "You cannot figure out how to do that", "It would be better to find"
          break
        end
        waitrt?
      end
      if Flags["thieving-fog"]
        buy_rocks(1)
        DRCC.find_shaping_room(@anvil_town)
        count = remaining
        Flags.reset("thieving-fog")
        redo
      end
      DRC.bput("get #{item}", "You pick up")
      DRC.bput("put my #{item} in my #{@bag}", "You put")
      remaining -= 1
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Cuts each bone item from the deer stack and bags it.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @return [void]
  def carve_bone(item, count)
    DRCT.walk_to(8868)
    DRCC.get_crafting_item("bone saw", @bag, @bag_items, @settings.engineering_belt)
    count.times do
      if /What were you/ =~ DRC.bput("get my #{item} instructions", "You get", "What were you")
        break
      end

      2.times do
        fput("Study my instructions")
      end
      waitrt?
      DRCC.stow_crafting_item("instructions", @bag, @settings.engineering_belt)
      DRC.bput("get deer stack from my #{@bag}", '^You get')
      DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/) if @cube
      DRC.bput("cut stack with my bone saw", "Roundtime")
      loop do
        case DRC.bput("cut #{item} with my bone saw", "Roundtime", "You cannot figure out how to do that")
        when "You cannot figure out how to do that"
          break
        end
      end
      DRC.bput("put my #{item} in my #{@bag}", "You put")
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Sews or knits each item with the sew script, in the tailoring room or
  # task_crafting_room (marathon sews where it stands).
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param base [String] 'yarn' knits, anything else sews
  # @param type [String] stock name
  # @return [void]
  def tailor_item(item, count, base, type)
    unless @crafting_room
      DRCT.walk_to(14886) unless @marathon
    else
      DRCT.walk_to(@crafting_room)
    end
    check_sewing_consumables(count) unless base == 'yarn'
    count.times do
      DRC.wait_for_script_to_complete('sew', ['stow', 'instructions', type, item, base == 'yarn' ? 'knit' : nil, 'skip'])
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Pins and thread are checked once for the whole task, so each sew run can
  # skip its own check (two get/count/put rounds per item). An item uses at
  # most a few pins; sew still restocks mid-item if either runs out.
  # Knitting uses neither.
  PIN_USES_PER_ITEM = 3

  # Checks pins and thread once for the whole sewing task.
  #
  # @param count [Integer] items to sew
  # @return [void]
  def check_sewing_consumables(count)
    info = get_data('crafting')['tailoring']["Crossing"]
    belt = @settings.outfitting_belt
    DRCC.check_consumables('pins', info['tool-room'], 5, @bag, @bag_items, belt, PIN_USES_PER_ITEM * count + 5)
    DRCC.check_consumables('thread', info['stock-room'], 6, @bag, @bag_items, belt)
  end

  # Shapes each wooden item with the shape script in a shaping room.
  #
  # @param item [String] item noun
  # @param count [Integer] how many
  # @param _base [String] unused
  # @param type [String] lumber, e.g. 'balsa'
  # @return [void]
  def shape_item(item, count, _base, type)
    DRCC.find_shaping_room(@anvil_town)
    count.times do
      DRC.wait_for_script_to_complete('shape', ['stow', 'instructions', type, item])
    end
    DRC.message("#{count} #{item}s completed")
  end

  # Consecutive gives that found nobody to take the item before giving up.
  MAX_GIVE_MISSES = 5
  # GIVE reply when the taskmaster is not in the room.
  GIVE_MISSED = /What is it you're trying to give/

  # Gives one finished item to the taskmaster and returns the reply, or nil when
  # there is none in hand or in the bag. A give that misses her (she wandered
  # off between the get and the give) leaves the item in hand: find her again
  # and give that same item, stopping after MAX_GIVE_MISSES misses in a row.
  #
  # @param item [String] item noun
  # @return [String, nil] the taskmaster's reply, or nil when none is left
  # @raise [SystemExit] after MAX_GIVE_MISSES misses in a row
  def give_item(item)
    MAX_GIVE_MISSES.times do
      find_npc(@rooms, @npc)
      return unless DRCI.in_hands?(item) || DRCI.get_item?(item, @bag)

      reply = DRC.bput("give my #{item} to #{@npc}", TURN_IN_MORE_NEEDED, /hands you a/, GIVE_MISSED)
      return reply unless reply =~ GIVE_MISSED
    end
    DRC.message("Could not hand a #{item} to #{@npc} after #{MAX_GIVE_MISSES} tries, stopping.")
    exit
  end

  # Hands in every finished item until the taskmaster gives the reward
  # sack, then sorts it.
  #
  # @param item [String] item noun
  # @param _count [Integer] unused
  # @return [void]
  # @raise [SystemExit] when the items run out first, or from give_item
  def complete_task(item, _count)
    loop do
      reply = give_item(item)
      exit unless reply
      break if reply =~ /hands you a/
    end
    sort_sack(item)
    fput('dump junk')
  end

  # Deals with worn tools after a task: stows them with task_no_repair,
  # repairs them with task_self_repair, or leaves them with Rangu.
  #
  # @param tools [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def repair(tools, belt)
    if @no_repair # skipping repair, stowing tool(s), moving on
      DRCI.stow_hands
      return
    elsif @self_repair
      DRCC.repair_own_tools({ 'finisher-room' => 8776, 'finisher-number' => 6 }, tools, @bag, @bag_items, belt) # runs self repair routine
    else
      tool_drop(tools, belt) # drops tools off at the repair guy to be picked up later
    end
  end

  # Leaves each tool with Rangu for repair and keeps the tickets; a tool he
  # won't take goes back where it came from.
  #
  # @param toolslist [Array<String>] tool names
  # @param belt [Hash, nil] toolbelt settings the tools live on
  # @return [void]
  def tool_drop(toolslist, belt = nil) # accepts array of tools for repair
    return if @self_repair

    DRCT.walk_to(19209)
    @belt = belt
    toolslist.each do |tool_name|
      DRCC.get_crafting_item(tool_name, @bag, @bag_items, belt, true)
      case DRC.bput("give Rangu", "I don't repair those here", 'What is it', "There isn't a scratch on that", 'Just give it to me again', 'I will not', "I can't fix those.  They only have so many uses and then you must buy another.")
      when /give/
        DRC.bput("give Rangu", 'repair ticket')
        DRC.bput('stow ticket', 'You put')
      else
        DRCC.stow_crafting_item(tool_name, @bag, belt)
      end
    end
  end

  # Collects every tool Rangu holds a ticket for, waiting until each is
  # ready, and stows it on the toolbelt that lists it.
  #
  # @note A crafting belt setting left unset is nil; Lich's nil patch lets
  #   the belt search skip it.
  # @return [void]
  def tool_pickup # picks up all your tools from repair shop
    DRCT.walk_to(19209)
    while DRCI.get_item?("rangu ticket")
      pause 30 until DRC.bput('look at my ticket', 'should be ready by now', 'Looking at the') == 'should be ready by now'
      DRC.bput("give Rangu", 'You hand')
      pause 0.01 until (tool = [DRC.right_hand, DRC.left_hand].compact.first) # waits for tool to hit your hand
      belts = [@settings.forging_belt, @settings.engineering_belt, @settings.outfitting_belt, @settings.alchemy_belt, @settings.enchanting_belt]
      toolbelt = belts.select { |belt| belt["items"].find { |name| name =~ /#{tool}/i } }.first # searches your toolbelts for the first one containing the tool.
      DRCC.stow_crafting_item(tool, @bag, toolbelt) # hopefully stows the tool appropriately.
    end
  end

  # Sorts the reward sack: gems go to the gem pouch and coins are picked up,
  # then a keeper goes into the loot bag (with a Slack message if asked)
  # and anything else is binned. Logs the contents to the Task Master
  # window and the sack history.
  #
  # @param _item [String, nil] unused
  # @return [void]
  def sort_sack(_item)
    DRCI.fill_gem_pouch_with_container(@settings.gem_pouch_adjective, @settings.gem_pouch_noun, 'sack', @settings.full_pouch_container, @settings.spare_gem_pouch_container, @settings.tie_gem_pouches)

    4.times do
      DRC.bput("get coin from my sack", "You pick up", "What were you")
    end
    result = DRC.bput("look in my sack", /^In the .* you see.*/)
    if keeper?(result)
      result = result.sub(/In the woven sack you see (?:(?:a|an|some) )?/, '').sub(/\.$/, '')
      DRC.message("Found a keeper: #{result}")
      send_slackbot_message("Found a keeper: #{result}") if @slack_keepers
      DRCI.put_away_item?('sack', @lootbag)
    else
      DRC.message("Nothing special: #{result}")
      DRCI.dispose_trash('sack', @worn_trashcan, @worn_trashcan_verb)
    end
    result.sub!('In the woven sack you see', '')
    DRC.log_window(result, "Task Master", true, true)
    remember_sack(result)
  end

  # Sack history for ;taskmaster loot_history. UserVars persists, so the list
  # is capped; a character running tasks all event would otherwise add
  # thousands of entries a month.
  LOOT_HISTORY_LIMIT = 100

  # Adds the sack's contents to this taskmaster's history.
  #
  # @param contents [String] the sack's contents
  # @note UserVars.taskmaster_sacks persists across runs.
  # @return [void]
  def remember_sack(contents)
    UserVars.taskmaster_sacks ||= {}
    history = (UserVars.taskmaster_sacks[@npc] ||= [])
    history << contents
    history.shift(history.size - LOOT_HISTORY_LIMIT) if history.size > LOOT_HISTORY_LIMIT
  end
end

before_dying do
  Flags.delete("wrap-up")
  Flags.delete("thieving-fog")
end

TaskMaster.new.run
