    if check
      look_lock
      message("Possible words: #{@dr_word_list}")
    end

    if full
      redeem_slip
      find_empty_room
      touch_lock
      whisper_first_guesses
      look_lock
      if @dr_word_list.count > 1
        DRC.message("Possible words: #{@dr_word_list}")
      else
        case DRC.bput("whisper lock #{@dr_word_list[0]}", { 'timeout' => 5 }, /You have received \d+ role-playing points? for your assistance in locking away/)
        when /You have received \d+ role-playing points? for your assistance in locking away/
          DRCT.walk_to(16958)
        else
          DRC.message("Something may have gone wrong.  Check the lock!")
        end
      end
    end
    echo "Script Runtime: #{((Time.now.to_f - @start_time))}"
  end

  def redeem_slip
    DRCT.walk_to(16958)
    put 'redeem my slip'
    put 'redeem my slip'
    put 'ask timekeeper about access'
    waitfor 'The apprentice Timekeeper shows you to a time lock'
  end

  def find_empty_room
    rooms = ['nw', 'nw', 'ne', 'ne', 'se', 'se', 'sw', 'sw', 's']
    rooms.each { |d| break if DRRoom.pcs.count == 0; move(d) }
    if Room.current.id == 16959
      message("NO EMPTY ROOMS FOUND!")
      exit
    end
  end

  def touch_lock
    put 'touch time lock'
    put 'touch time lock'
  end

  def whisper_first_guesses
    put 'whisper time lock aeiou'
    put 'whisper time lock tpmrs'
    put 'whisper time lock bcdgn'
    put 'whisper time lock fhklw'
  end

  def look_lock
    word = [nil, nil, nil, nil, nil]
    good_letters = Array.new
    bad_letters = Array.new
    DRC.bput("look lock", /^The time lock is divided into several grids/)

    loop do
      line = get
      next if line.include?("+-----+-----+-----+-----+-----+")
      next if line.include?("|  1  |  2  |  3  |  4  |  5  |")
      break if line.include?("| ___ | ___ | ___ | ___ | ___ |")
      break if line.include?("[6 of the 6 rows are locked into place.]")
      break if line.include?("You innately sense that fate has smiled on you")
      # break if line =~ (/[1-5] of the 6 rows are locked into place./)
      /\| (...) \| (...) \| (...) \| (...) \| (...) \|/ =~ line
      for i in 1..5 do
        temp = Regexp.last_match(i);
        letter = temp[1]
        x, y = check_letter(temp)
        if x && y
          good_letters.push(letter)
          word[i - 1] = letter
          @dr_word_list.reject! { |word| word[i - 1] != letter }
        elsif x && !y
          good_letters.push(letter)
          @dr_word_list.reject! { |word| !word.include?(letter) || word[i - 1] == letter }
        else
          bad_letters.push(letter)
          @dr_word_list.reject! { |word| word.include?(letter) }
        end
      end
    end
    respond("Good Letters: #{good_letters}")
    respond("Bad Letters: #{bad_letters}")
    respond("Word: #{word}")
  end

  def check_letter(s)
    case s[0]
    when /_/
      # echo 'wrong place'
      return [true, false]
    when /\+/
      # echo 'right place'
      return [true, true]
    when /\*/
      # echo 'bad letter'
      return [false, false]
    end
  end
end

Aesthene.new
