=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#buffother
=end

class BuffOther
  def initialize
    arg_definitions = [
      [
        { name: 'recipient', regex: /\w+/, description: 'Player to buff.' },
        { name: 'waggle', regex: /\w+/, description: 'Waggle set to buff on player.' },
        { name: 'room', regex: /\d+/, optional: true, description: 'Will move to room number of target player.' }
      ]
    ]

    args = parse_args(arg_definitions)

    settings = get_settings
    recipient = args.recipient.capitalize
    waggle_set = args.waggle
    room = args.room

    spells = buff_spells(settings, waggle_set)
    move_to_room(recipient, room)
    cast_buff_spells(recipient, spells, settings)
  end

  # The spells in the waggle set to cast. Exits with a message, before any
  # walking or casting, when there's no such set, when it's a thief's or
  # barbarian's list (those can't be cast on someone else), or when it's empty.
  def buff_spells(settings, waggle_set)
    spells = (settings.waggle_sets || {})[waggle_set]
    if spells.nil?
      DRC.message("No waggle set found for name: #{waggle_set}")
      exit
    elsif !spells.is_a?(Hash)
      DRC.message("Waggle set \"#{waggle_set}\" is a list of khri or abilities; buffother can only cast spells on someone else.")
      exit
    elsif spells.empty?
      DRC.message("Waggle set \"#{waggle_set}\" has no spells to cast.")
      exit
    end

    spells
  end

  def move_to_room(recipient, room)
    return unless room

    DRC.message "Tracking down #{recipient} in room ##{room}!"
    DRCT.walk_to(room)
  end

  def cast_buff_spells(recipient, spells, settings)
    if !DRRoom.pcs.include?(recipient)
      DRC.message "#{recipient} not found in room. Exiting..."
      exit
    end

    spells.each_value do |spell_data|
      spell_data['cast'] = "cast #{recipient}"
      spell_data['recast'] = 99

      pause 1 while DRStats.mana < 40
      DRCA.cast_spell(spell_data, settings, settings.waggle_force_cambrinth)
    end
  end
end

before_dying do
  fput("release mana")
end

BuffOther.new
