=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#status-monitor

  First-time setup: the shared corpus of known lines starts empty, and every
  line it has not seen alerts (up to 10 a minute). Warm it up first, either by
  running `;status-monitor learn` through a normal session, or by importing
  your existing logs with `;status-monitor-import`.
=end

status_tags
no_pause_all
no_kill_all

arg_definitions = [
  [
    { name: 'debug', regex: /debug/i, optional: true },
    { name: 'nowindow', regex: /nowindow/i, optional: true },
    { name: 'learn', regex: /^learn(=[1-9]\d*)?$/i, optional: true, description: 'learn new lines silently for 30 min (learn=N for N min)' }
  ]
]

args = parse_args(arg_definitions)

nowindow = args.nowindow || get_settings.status_monitor_no_window
# Without GTK (e.g. a headless host), run headless instead of exiting.
unless nowindow || HAVE_GTK
  echo 'ruby-gtk bindings are not installed or failed to load; running without a window.'
  nowindow = true
end

require 'sqlite3'
require 'fileutils'

module StatusMonitor
  # Persists and retrieves the corpus of previously seen game messages using a
  # single, INSTALLATION-WIDE SQLite database. A line safe on any character is
  # safe everywhere, so the corpus is one shared whitelist across all characters.
  #
  # Writes are immediate (INSERT on record) so a line one character learns is
  # visible to every other character at once -- there is no per-process cache to
  # go stale. Because the shared file can have many concurrent writers (every
  # running character, plus an import), all DB access goes through a
  # busy-retry/backoff wrapper that logs-and-continues rather than crashing the
  # monitor. A small in-process cache of KNOWN lines only avoids repeat SELECTs
  # (known stays known, so it never needs invalidation).
  #
  # On first run, any legacy per-character .dat (Marshal) and seen_messages_<Char>.db
  # files found in the working directory are merged in and renamed .migrated.
  #
  # @note in_corpus? is the novelty gate: a known line is never analysed/alerted.
  class MessageStore
    # Attempts to ride out a busy shared DB after the SQLite busy_timeout is
    # itself exceeded (e.g. a burst of simultaneous logins all writing at once).
    BUSY_RETRIES = 5
    # Soft cap on the in-process known-line cache before it is cleared (it is
    # only a read optimisation; clearing just forces DB reads again).
    KNOWN_CACHE_CAP = 50_000

    # Installation-wide corpus path, shared by every character and the importer.
    # @return [String] absolute path to the shared seen_messages database
    def self.default_db_path
      File.join(DATA_DIR, 'status-monitor', 'seen_messages.db')
    end

    # @param db_path [String] path to the shared corpus database
    def initialize(db_path = self.class.default_db_path)
      @db_path = db_path
      FileUtils.mkdir_p(File.dirname(@db_path))
      @db = open_database
      @known = {}
      migrate_legacy
    end

    # Whether a line is already part of the known-safe corpus. This is the
    # novelty gate: a known line is safe by construction and never analysed.
    #
    # On a persistent DB failure this fails OPEN (returns false -> treated as
    # novel -> alerts) rather than silently swallow a possible check.
    #
    # @param line [String] scrubbed message line
    # @return [Boolean] true if the line is already known
    def in_corpus?(line)
      return true if line.nil? || line.strip.empty?
      return true if @known[line]

      found = with_retry { exists_in_db?(line) }
      remember(line) if found
      found ? true : false
    end

    # Records a line as known-safe, writing it through to the shared store
    # immediately so other characters see it at once.
    #
    # @param line [String] scrubbed message line
    # @param source [String] provenance tag; learn sessions use a unique tag so
    #   everything one session learned can be deleted by source
    # @return [void]
    def record(line, source = 'live')
      return if line.nil? || line.strip.empty?

      remember(line)
      with_retry { insert_line(line, source) }
    end

    # Closes the database connection.
    #
    # @return [void]
    def shutdown
      @db.close
    end

    # Returns the total count of seen messages in the database.
    #
    # @return [Integer] number of stored messages
    def count
      @db.get_first_value('SELECT COUNT(*) FROM seen_messages').to_i
    end

    private

    # Adds a line to the in-process known-line cache, bounding its size.
    def remember(line)
      @known.clear if @known.size >= KNOWN_CACHE_CAP
      @known[line] = true
    end

    # Runs a DB operation, retrying past the busy_timeout on contention and
    # logging-and-continuing (returning nil) rather than raising into process.
    def with_retry
      tries = 0
      begin
        yield
      rescue SQLite3::BusyException, SQLite3::LockedException => e
        tries += 1
        if tries <= BUSY_RETRIES
          pause(0.05 * tries)
          retry
        end
        echo "status-monitor: corpus busy after #{tries} tries (#{e.message}); continuing."
        nil
      end
    end

    # Schema must stay in sync with StatusMonitorImport.open_database.
    # @return [SQLite3::Database] initialized database connection
    def open_database
      db = SQLite3::Database.new(@db_path)
      # Wait up to 5s on a locked db before raising; with_retry rides out longer
      # contention on top of that (many characters + an import share this file).
      db.busy_timeout = 5000
      db.execute('PRAGMA journal_mode=WAL')
      db.execute('PRAGMA synchronous=NORMAL')
      db.execute(<<~SQL)
        CREATE TABLE IF NOT EXISTS seen_messages (
          line_text TEXT PRIMARY KEY,
          first_seen_at DATETIME DEFAULT CURRENT_TIMESTAMP,
          source TEXT DEFAULT 'live'
        )
      SQL
      db
    end

    # @param line [String] message line to check
    # @return [Boolean] true if line exists in the database
    def exists_in_db?(line)
      @db.get_first_value('SELECT 1 FROM seen_messages WHERE line_text = ?', [as_text(line)]) ? true : false
    end

    # @param line [String] message line to insert
    # @param source [String] origin of the line ('live', 'import', 'migration')
    # @return [void]
    def insert_line(line, source = 'live')
      @db.execute('INSERT OR IGNORE INTO seen_messages (line_text, source) VALUES (?, ?)', [as_text(line), as_text(source)])
    end

    # Game lines arrive from Lich as binary (ASCII-8BIT) strings, and the sqlite3
    # gem binds binary strings as BLOBs. A BLOB never equals TEXT in SQLite, so a
    # live line would never match the same line imported from a log (TEXT), and
    # would be stored again as a separate BLOB row. Always bind UTF-8 TEXT.
    #
    # @param value [String] string to bind
    # @return [String] UTF-8 copy with invalid bytes scrubbed (as the importer does)
    def as_text(value)
      String.new(value.to_s, encoding: Encoding::UTF_8).scrub
    end

    # Merges any legacy per-character corpora (Marshal .dat and per-character
    # seen_messages_<Char>.db) found in the working directory into the shared
    # store, then renames each to .migrated so it runs only once.
    #
    # @return [void]
    def migrate_legacy
      dats = Dir.glob('seen_messages_*.dat')
      dbs = Dir.glob('seen_messages_*.db').reject { |f| File.expand_path(f) == File.expand_path(@db_path) }
      return if dats.empty? && dbs.empty?

      total = dats.sum { |f| migrate_dat(f) } + dbs.sum { |f| migrate_db(f) }
      echo "status-monitor: merged #{total} entries from #{dats.size + dbs.size} legacy corpus file(s) into the shared store."
    end

    # @param path [String] legacy Marshal .dat file
    # @return [Integer] entries merged
    def migrate_dat(path)
      data = File.open(path, 'rb') { |f| Marshal.load(f) }
      count = 0
      with_retry do
        @db.transaction do
          data.each_key do |line|
            insert_line(line.to_s, 'migration')
            count += 1
          end
        end
      end
      File.rename(path, "#{path}.migrated")
      backup = "backup/#{File.basename(path, '.dat')}.bak"
      File.rename(backup, "#{backup}.migrated") if File.exist?(backup)
      count
    rescue => e
      echo "status-monitor: could not merge #{path} (#{e.message}); skipping."
      0
    end

    # @param path [String] legacy per-character seen_messages_<Char>.db file
    # @return [Integer] entries merged
    def migrate_db(path)
      src = SQLite3::Database.new(path)
      rows = src.execute('SELECT line_text, source FROM seen_messages')
      src.close
      with_retry do
        @db.transaction do
          rows.each { |line, source| insert_line(line, source || 'migration') }
        end
      end
      File.rename(path, "#{path}.migrated")
      rows.size
    rescue => e
      echo "status-monitor: could not merge #{path} (#{e.message}); skipping."
      0
    end
  end

  # Filters raw game stream lines, stripping XML tags and removing
  # lines from known players, NPCs, and non-useful UI elements.
  #
  # @note Uses status_tags mode to receive raw XML from the game stream.
  class MessageFilter
    # @return [String, nil] the last raw "Also here:" room players component line seen
    attr_reader :last_player_line

    FILTERED_STREAMS = %w[assess ooc atmospherics thoughts talk death group percWindow logons shopWindow].freeze

    # @param filter_strings [Array<Regexp>] configurable patterns to ignore
    def initialize(filter_strings)
      @filter_strings = filter_strings
      @room_players = []
      @in_stream = false
      @current_stream = ''
      @non_useful_tags = [
        /<preset id='roomDesc'>/i,
        /component id='room/i,
        /component id='exp/i,
        %r{</prompt>$},
        /preset id='roomDesc'/,
        /style id="roomName"/,
        /<room>/, # Saga-identity room block (replaces roomName/roomDesc)
        /<spell exist='spell'>/,
        %r{<spell>None</spell>},
        /&lt; .*/,
        /<clearContainer/,
        /<right/,
        /<left/,
        /<indicator id='IconINVISIBLE'/,
        %r{<roundTime value='\d+'/>}
      ]
    end

    # Cleans a raw game line by stripping tags and filtering known sources.
    #
    # Does not mutate its argument: tag stripping returns a new String.
    #
    # @param line [String] raw game stream line with XML tags
    # @return [String, nil] a new cleaned line, or nil if it should be ignored
    def clean(line)
      update_players(line)
      update_stream_state(line)
      return nil if @in_stream && FILTERED_STREAMS.include?(@current_stream)
      return nil if line.nil? || line.empty? || @non_useful_tags.any? { |tag| tag =~ line }
      return nil if @room_players.any? { |name| line.include?(name) }
      return nil if UserVars.npcs&.any? { |name| line.include?(name) }

      if UserVars.players_online
        players_to_check = UserVars.players_online - [checkname, 'Endith']
        return nil if players_to_check.any? { |name| line.include?(name) }
      end
      line.gsub(/<[^>]+>/, '')
    end

    # Checks whether a cleaned line matches any configured filter patterns.
    #
    # @param line [String] cleaned message line
    # @return [Boolean] true if the line matches a filter
    def filtered?(line)
      return true if line.nil? || line.empty?

      @filter_strings.any? { |regex| line =~ regex }
    end

    # Normalizes a line by stripping variable content (numbers, currency)
    # so that semantically identical messages compare as equal.
    # Must stay in sync with StatusMonitorImport.similarity_scrub.
    #
    # @param line [String] cleaned message line
    # @return [String] scrubbed copy of the line
    def similarity_scrub(line)
      result = line.dup
      [/[0-9]+/, /(kronars|lirums|dokoras)/i].each { |pattern| result.gsub!(pattern, '') }
      result
    end

    # @return [Array<Regexp>] the configured filter patterns
    attr_reader :filter_strings

    private

    # Extracts player names from the room players component.
    #
    # @param room_players [String] raw "Also here:" component text
    # @return [Array<String>] list of player short names
    def find_pcs(room_players)
      room_players.sub(/ and (.*)$/) { ", #{Regexp.last_match(1)}" }
                  .split(', ')
                  .map { |obj| obj.sub(/ who (has|is) .+/, '').sub(/ \(.+\)/, '') }
                  .filter_map { |obj| obj.strip.scan(/\w+$/).first }
    end

    # @param line [String] raw game stream line to check for player component
    # @return [void]
    def update_players(line)
      return unless line =~ %r{\'room players\'>Also here: (.*)\.</component>}

      @last_player_line = line
      # The Saga-identity stream links each name (<a exist=.. noun=..>Name</a>);
      # parse the text inside the links.
      @room_players = find_pcs(Regexp.last_match(1).gsub(%r{</?a\b[^>]*>}, ''))
    end

    # @param line [String] raw game stream line
    # @return [void]
    def update_stream_state(line)
      if line =~ /<pushStream id="([^"]+)"/i
        @in_stream = true
        @current_stream = Regexp.last_match(1)
      elsif line =~ /<popStream/i
        @in_stream = false
        @current_stream = ''
      end
    end
  end

  # Handles alert responses when spam is detected: audio beeps,
  # optional auto-response, Slack notification, and optional auto-quit.
  #
  # @note Configurable via YAML settings:
  #   - `status_monitor_respond` [Boolean] whether to auto-respond
  #   - `quit_on_status_warning` [Boolean] whether to auto-quit
  #   - `slack_username` [String] Slack user to notify
  class AlertHandler
    # @param settings [OpenStruct] user settings from get_settings
    def initialize(settings)
      @settings = settings
      @responses = ["'Hmmm?", "'Yes", "'Ok?"].shuffle
      @quit_on_flag = settings.quit_on_status_warning
      @slack_enabled = !@settings.slack_username.nil? && !@settings.slack_username.to_s.strip.empty?
      @slackbot = nil
    end

    # Handles an alerted line.
    #
    # Every alert notifies (audible beeps, echo to the window, Slack). The
    # optional auto-actions (canned response, auto-quit) only run on a STRONG
    # signal: the line matched a known GM-check pattern. Commands found in a line
    # are never typed -- ordinary game output is full of capitalised verbs
    # ("---Active RPA---", "when OPENed"), and a real check needs a human answer.
    #
    # @param line [String] the alerted line
    # @param strong [Boolean] whether the line matched a GM-check pattern
    # @return [void]
    def handle(line, strong:)
      3.times do
        echo("\a")
        pause 0.25
      end
      if strong
        fput @responses.first if @settings.status_monitor_respond
        # Queue the auto-quit before send_slack: constructing the SlackBot on the
        # first alert can block for several seconds, and we do not want that to
        # delay logout when quit_on_status_warning is set. The exit command is
        # queued to the game, so the Slack notification still goes out afterward.
        fput('exit') if @quit_on_flag
        @responses.rotate!
      end
      echo(line)
      send_slack(line)
      pause 2 if strong
    end

    # Echoes and Slacks an informational notice (no beeps, no auto-actions).
    #
    # @param message [String] notice text
    # @return [void]
    def notify(message)
      echo(message)
      send_slack(message)
    end

    private

    # Lazily constructs the SlackBot on first use.
    #
    # SlackBot.new can block for several seconds (lnet startup, users.list
    # fetch, jitter/backoff). Building it here rather than in the constructor
    # keeps script startup and the status window responsive, and defers the
    # connection until an alert actually needs to be sent (by which point lnet
    # is far more likely to be up).
    #
    # @return [Lich::DragonRealms::SlackBot, nil] the bot, or nil if construction failed
    def slackbot
      return @slackbot if @slackbot

      @slackbot = Lich::DragonRealms::SlackBot.new
    rescue => e
      echo "SlackBot init failed: #{e.message}"
      nil
    end

    # @param message [String] message body to send
    # @return [void]
    #
    # @note Delegates the connection check to SlackBot#direct_message, which
    #   reconnects itself when not yet initialized. Gating on #initialized?
    #   here would permanently suppress delivery whenever the first connection
    #   attempt failed (e.g. lnet not up yet at login), because the self-healing
    #   reconnect path inside direct_message would never be reached.
    def send_slack(message)
      return unless @slack_enabled

      bot = slackbot
      return unless bot

      bot.direct_message(@settings.slack_username, message.to_s)
    rescue => e
      echo "SlackBot error: #{e.message}"
    end
  end

  # Top-level orchestrator for status monitoring.
  #
  # Coordinates message filtering, the shared corpus novelty gate, and alert
  # handling. Provides both headless and GTK windowed modes.
  #
  # @note Optional settings keys:
  #   - `status_monitor_no_window` [Boolean] disable GTK window
  #   - `status_monitor_respond` [Boolean] canned reply on a GM-check alert
  #   - `quit_on_status_warning` [Boolean] auto-quit on a GM-check alert
  #   - `slack_username` [String] Slack user to notify
  #   - `status_monitor_grace_seconds` [Integer] warm-up window at session start
  #     during which novel lines are learned silently (default 60; 0 disables)
  #
  # Learn mode is deliberately NOT a setting, so it can never be left on: it is
  # only enabled by the `learn` argument and always expires. While learning,
  # novel lines are recorded silently (GM-check lines still alert and are never
  # recorded). The start-up grace period is the same mechanism with a short
  # default window and no Slack notices.
  #
  # @example Basic usage
  #   ;status-monitor
  #
  # @example Learn mode (30 minutes, or N minutes)
  #   ;status-monitor learn
  #   ;status-monitor learn=90
  #
  # @example Headless mode
  #   ;status-monitor nowindow
  #
  # @example Debug mode
  #   ;status-monitor debug
  #
  # @see https://elanthipedia.play.net/Lich_script_repository#status-monitor
  class Monitor
    # Seconds at the start of a session during which novel lines are learned
    # silently (no alert) to absorb the warm-up burst before the corpus is warm.
    GRACE_SECONDS = 60
    # Default length of an explicit `learn` session, and how often it reminds.
    LEARN_DEFAULT_MINUTES = 30
    LEARN_REMINDER_SECONDS = 600
    # Notification safety valve: at most this many alerts per rolling window;
    # beyond it, novel lines are dropped unrecorded so they can alert later.
    ALERT_RATE_MAX = 10
    ALERT_RATE_WINDOW = 60
    # Known GM-check wordings, matched against the cleaned line. These always
    # alert -- regardless of the corpus, grace, learn mode or the rate cap -- and
    # are never recorded, so a check can never be whitelisted into silence.
    CHECK_PATTERNS = Regexp.union(
      /Say go away/i, # squirrel check: 'You hear a child nearby yelling, "... Say go away to shoo him away!"'
      /scurries into the room and .+ before it runs off/, # squirrel check
      /test of your conscious awareness/i, # failed check, about to be moved
      /Scripting Violation Limbo/, # moved to limbo
      /game ?master/i,
      /SEND\[/,
      /You can use RESPOND/
    )

    attr_reader :spam_line

    # @return [String, nil] the most recent cleaned line (tags stripped), for debug logging
    attr_reader :last_clean_line

    # @return [String] corpus source tag for lines learned silently this session
    attr_reader :learn_source

    # @param settings [OpenStruct] user settings from get_settings
    # @param store [MessageStore] shared corpus (defaults to the installation-wide store)
    # @param learn_minutes [Integer, nil] explicit learn session length; nil for
    #   the normal start-up grace period
    def initialize(settings, store = MessageStore.new, learn_minutes: nil)
      @store = store
      @filter = MessageFilter.new(load_filter_strings)
      @alerter = AlertHandler.new(settings)
      started_at = Time.now
      @explicit_learn = !learn_minutes.nil?
      window = @explicit_learn ? learn_minutes * 60 : (settings.status_monitor_grace_seconds || GRACE_SECONDS)
      @learning = window.positive?
      @learn_until = started_at + window
      @last_reminder = started_at
      @learn_source = "learn:#{checkname}:#{started_at.utc.strftime('%Y-%m-%dT%H:%M:%SZ')}"
      @alert_times = []
      @spam_line = nil
      @last_clean_line = nil
      announce_learning(window) if @learning
    end

    # Processes a single raw game line through the full pipeline.
    #
    # A line matching CHECK_PATTERNS always alerts as a strong signal (canned
    # response / auto-quit if configured) and is never recorded.
    #
    # Any other line is novelty-gated: a line already in the shared corpus is
    # known-safe and silent. A NOVEL line alerts once and is then recorded, so it
    # goes quiet on every character. During the start-up grace period or learn
    # mode a novel line is recorded silently instead (tagged with learn_source);
    # past the rate cap it is dropped unrecorded, so it can still alert once the
    # cap clears.
    #
    # @param line [String] raw game stream line
    # @return [Boolean] true if the line alerted
    def process(line)
      update_learning
      cleaned = @filter.clean(line)
      @last_clean_line = cleaned
      return false if cleaned.nil?

      if cleaned.match?(CHECK_PATTERNS)
        alert(cleaned.strip, strong: true)
        return true
      end
      return false if @filter.filtered?(cleaned)

      scrubbed = @filter.similarity_scrub(cleaned).strip
      return false if scrubbed.empty?
      return false if @store.in_corpus?(scrubbed) # known-safe -> silent

      if @learning
        @store.record(scrubbed, @learn_source)
        return false
      end
      return false if rate_limited?

      alert(scrubbed, strong: false)
      @alert_times << Time.now
      @store.record(scrubbed)
      true
    end

    # Clears the current spam line after it has been consumed.
    #
    # @return [String, nil] the spam line that was cleared
    def consume_spam_line
      line = @spam_line
      @spam_line = nil
      line
    end

    # Closes the database connection.
    #
    # @return [void]
    def shutdown
      @store.shutdown
    end

    # @return [String, nil] last seen room players component line
    def last_player_line
      @filter.last_player_line
    end

    private

    # @param line [String] the line to announce
    # @param strong [Boolean] whether it matched a GM-check pattern
    # @return [void]
    def alert(line, strong:)
      @alerter.handle(line, strong: strong)
      @spam_line = line
    end

    # Advances the learning window; called for every line so expiry and
    # reminders happen on time even when no novel line arrives. Ends the
    # session (with a notice for explicit learn) once it expires, and reminds
    # periodically during explicit learn.
    #
    # @return [void]
    def update_learning
      return unless @learning

      now = Time.now
      if now >= @learn_until
        @learning = false
        @alerter.notify('status-monitor: learn mode ended -- alerting on new lines again.') if @explicit_learn
      elsif @explicit_learn && now - @last_reminder >= LEARN_REMINDER_SECONDS
        @last_reminder = now
        echo "status-monitor: LEARN MODE until #{@learn_until.strftime('%H:%M')} -- not alerting on new lines."
      end
    end

    # Whether the alert rate cap has been reached in the current window.
    #
    # @return [Boolean]
    def rate_limited?
      cutoff = Time.now - ALERT_RATE_WINDOW
      @alert_times.reject! { |t| t < cutoff }
      if @alert_times.size >= ALERT_RATE_MAX
        unless @rate_notice
          echo "status-monitor: alert rate cap reached (#{ALERT_RATE_MAX}/#{ALERT_RATE_WINDOW}s); dropping alerts until it clears."
          @rate_notice = true
        end
        return true
      end
      @rate_notice = false
      false
    end

    # One-time notice that a learning window has started. Explicit learn mode
    # also goes to Slack and names the tag that undoes the session.
    #
    # @param window [Integer] learning window in seconds
    # @return [void]
    def announce_learning(window)
      unless @explicit_learn
        echo "status-monitor: warming up for #{window}s -- learning novel lines quietly before alerting."
        return
      end

      @alerter.notify("status-monitor: LEARN MODE for #{window / 60} min (until #{@learn_until.strftime('%H:%M')}) -- " \
                      'recording new lines silently, not alerting. GM checks still alert.')
      echo "status-monitor: to undo this session: DELETE FROM seen_messages WHERE source = '#{@learn_source}'"
    end

    # Loads the configurable ignore patterns from the 'filters' data file.
    #
    # get_data can briefly return nil (or data lacking the key) if it is read
    # before Lich finishes loading its data files, so retry a bounded number of
    # times. If no filter list is ever produced, run with no filters rather than
    # failing: an unconfigured (or empty) filter list is valid, not fatal. Note
    # get_data is a synchronous read, so this retry only helps a genuine
    # not-yet-loaded race -- it will not conjure a key that the data file lacks.
    #
    # @return [Array<Regexp>] compiled filter patterns (empty if none configured)
    def load_filter_strings
      10.times do
        data = get_data('filters')
        strings = data && data['filter_strings']
        return strings.map { |string| /#{string}/ } if strings

        pause 1
      end
      echo 'status-monitor: no filter list available; running with no filters.'
      []
    end
  end
end

# @param entry [Gtk::Entry] health bar widget to update
# @return [void]
def update_health_bar(entry)
  hp = health
  if hp >= 75
    entry.override_background_color(:normal, Gdk::RGBA.parse('green'))
  else
    entry.override_background_color(:normal, Gdk::RGBA.parse('red'))
  end
  entry.text = "#{hp}%"
end

# @param raw [String, nil] original raw line as received from the game stream
# @param cleaned [String, nil] the line after tag stripping and source filtering
# @param player_line [String, nil] last room players component
# @return [void]
def write_debug_log(raw, cleaned, player_line)
  File.open("status-monitor-debug-#{checkname}.txt", 'a') do |f|
    f.puts(raw)
    f.puts(cleaned)
    f.puts(player_line)
  end
end

settings = get_settings
learn_minutes = (args.learn[/\d+/] || StatusMonitor::Monitor::LEARN_DEFAULT_MINUTES).to_i if args.learn
monitor = StatusMonitor::Monitor.new(settings, learn_minutes: learn_minutes)

before_dying do
  monitor.shutdown
end

if nowindow
  loop do
    line = script.gets
    if monitor.process(line) && args.debug
      write_debug_log(line, monitor.last_clean_line, monitor.last_player_line)
    end
    monitor.consume_spam_line
  end
end

window = nil
window_done = false
load_window_position = CharSettings['window_position'] || []
load_window_width    = CharSettings['window_width'] || 300
load_window_height   = CharSettings['window_height'] || 100
window_title = "#{checkname} Status"
save_window_position = nil
save_window_width    = nil
save_window_height   = nil
healthbar_et = nil
messages_tv = nil

before_dying do
  CharSettings['window_position'] = save_window_position if (save_window_position.class == Array) && (save_window_position[0].to_i >= 0) && (save_window_position[1].to_i >= 0)
  CharSettings['window_width']    = save_window_width    if (save_window_width.class == Integer) && (save_window_width > 100)
  CharSettings['window_height']   = save_window_height   if (save_window_height.class == Integer) && (save_window_height > 100)
  Gtk.queue { window.destroy }
end

begin
  Gtk.queue do
    messages_tv = Gtk::TextView.new
    messages_tv.editable = false
    messages_tv.cursor_visible = false

    messages_sw = Gtk::ScrolledWindow.new
    messages_sw.add(messages_tv)
    messages_sw.set_policy(:automatic, :automatic)

    healthbar_et = Gtk::Entry.new
    healthbar_et.editable = false
    healthbar_et.xalign = 0.5
    health_font = Pango::FontDescription.new
    health_font.weight = :bold
    healthbar_et.override_font(health_font)

    vbox = Gtk::Box.new(:vertical, 0)
    vbox.pack_start(messages_sw)
    vbox.pack_start(healthbar_et, :expand => false)

    window              = Gtk::Window.new
    window.title        = window_title
    window.keep_above = true
    window.border_width = 1
    window.resize(load_window_width, load_window_height)
    unless load_window_position.empty?
      window.move(load_window_position[0], load_window_position[1])
    end
    window.add(vbox)

    window.signal_connect('delete_event') do
      save_window_position = window.position
      save_window_width    = window.allocation.width
      save_window_height   = window.allocation.height
      window_done = true
    end
    window.show_all
  end
  prev_health = 0

  loop do
    line = script.gets?
    if prev_health != health
      prev_health = health
      Gtk.queue { update_health_bar(healthbar_et) }
    end
    if monitor.process(line)
      write_debug_log(line, monitor.last_clean_line, monitor.last_player_line) if args.debug
    else
      pause 0.1 unless args.debug && line
    end
    if (spam = monitor.consume_spam_line)
      Gtk.queue do
        text_buffer = messages_tv.buffer
        text_buffer.insert(text_buffer.end_iter, "new:'#{spam}'")
        text_buffer.insert(text_buffer.end_iter, "\r\n")
        messages_tv.scroll_to_iter(text_buffer.end_iter, 0.0, true, 0, 0)
      end
    end
    break if window_done
  end
end
