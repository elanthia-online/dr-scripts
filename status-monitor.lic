=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#status-monitor

  First-time setup: the shared corpus of known lines starts empty, and every
  line it has not seen alerts (up to 10 a minute). Warm it up first, either by
  running `;status-monitor learn` through a normal session, or by importing
  your existing logs with `;status-monitor-import`.
=end

status_tags
no_pause_all
no_kill_all

arg_definitions = [
  [
    { name: 'debug', regex: /debug/i, optional: true },
    { name: 'nowindow', regex: /nowindow/i, optional: true },
    { name: 'learn', regex: /^learn(=[1-9]\d*)?$/i, optional: true, description: 'learn new lines silently for 30 min (learn=N for N min)' }
  ]
]

args = parse_args(arg_definitions)

nowindow = args.nowindow || get_settings.status_monitor_no_window
require 'sqlite3'
require 'fileutils'

module StatusMonitor
  # Persists and retrieves the corpus of previously seen game messages using a
  # single, INSTALLATION-WIDE SQLite database. A line safe on any character is
  # safe everywhere, so the corpus is one shared whitelist across all characters.
  #
  # Writes are immediate (INSERT on record) so a line one character learns is
  # visible to every other character at once. Lookups always read the shared
  # file: there is no per-process cache, so rows deleted from it (a learn
  # session undone by source) alert again in every running monitor at once. A
  # primary-key lookup costs microseconds even on a corpus of millions of lines.
  # Because the shared file can have many concurrent writers (every running
  # character, plus an import), all DB access goes through a busy-retry/backoff
  # wrapper that logs-and-continues rather than crashing the monitor.
  #
  # On first run, any legacy per-character .dat (Marshal) and seen_messages_<Char>.db
  # files found in the working directory are merged in and renamed .migrated
  # (an unreadable .dat is recovered from its backup and kept as .corrupt).
  #
  # @note in_corpus? is the novelty gate: a known line is never analysed/alerted.
  class MessageStore
    # Attempts to ride out a busy shared DB after the SQLite busy_timeout is
    # itself exceeded (e.g. a burst of simultaneous logins all writing at once).
    BUSY_RETRIES = 5
    # Minimum seconds between echoes of a swallowed DB error.
    DB_ERROR_ECHO_SECONDS = 60

    # Installation-wide corpus path, shared by every character and the importer.
    # @return [String] absolute path to the shared seen_messages database
    def self.default_db_path
      File.join(DATA_DIR, 'status-monitor', 'seen_messages.db')
    end

    # @param db_path [String] path to the shared corpus database
    def initialize(db_path = self.class.default_db_path)
      @db_path = db_path
      FileUtils.mkdir_p(File.dirname(@db_path))
      @db = open_database
      migrate_legacy
    end

    # Whether a line is already part of the known-safe corpus. This is the
    # novelty gate: a known line is safe by construction and never analysed.
    #
    # On a persistent DB failure this fails OPEN (returns false -> treated as
    # novel -> alerts) rather than silently swallow a possible check.
    #
    # @param line [String] scrubbed message line
    # @return [Boolean] true if the line is already known
    def in_corpus?(line)
      return true if line.nil? || line.strip.empty?

      with_retry { exists_in_db?(line) } ? true : false
    end

    # Records a line as known-safe, writing it through to the shared store
    # immediately so other characters see it at once.
    #
    # @param line [String] scrubbed message line
    # @param source [String] provenance tag; learn sessions use a unique tag so
    #   everything one session learned can be deleted by source
    # @return [void]
    def record(line, source = 'live')
      return if line.nil? || line.strip.empty?

      with_retry { insert_line(line, source) }
    end

    # Closes the database connection.
    #
    # @return [void]
    def shutdown
      @db.close
    end

    # Returns the total count of seen messages in the database.
    #
    # @return [Integer] number of stored messages
    def count
      @db.get_first_value('SELECT COUNT(*) FROM seen_messages').to_i
    end

    private

    # Runs a DB operation, retrying past the busy_timeout on contention and
    # logging-and-continuing (returning nil) on ANY SQLite error rather than
    # raising into process: a full disk, read-only file, I/O error or corrupt
    # page degrades to fail-open alerting instead of killing the monitor.
    def with_retry(&block)
      retrying(&block)
    rescue SQLite3::Exception => e
      report_db_error(e)
      nil
    end

    # Runs a DB operation, retrying on busy/locked contention. Re-raises once
    # the retries are exhausted, and at once for any other error. Migration
    # calls this directly so a failed merge leaves the legacy file in place to
    # retry on the next start instead of renaming it as merged.
    def retrying
      tries = 0
      begin
        yield
      rescue SQLite3::BusyException, SQLite3::LockedException
        tries += 1
        raise if tries > BUSY_RETRIES

        pause(0.05 * tries)
        retry
      end
    end

    # Echoes a DB error at most once per DB_ERROR_ECHO_SECONDS: a persistent
    # failure is hit on every line, and must not flood the game window.
    #
    # @param error [SQLite3::Exception] the error that was swallowed
    # @return [void]
    def report_db_error(error)
      now = Time.now
      return if @last_db_error_at && now - @last_db_error_at < DB_ERROR_ECHO_SECONDS

      @last_db_error_at = now
      echo "status-monitor: corpus error (#{error.class}: #{error.message}); continuing."
    end

    # Schema must stay in sync with StatusMonitorImport.open_database.
    # @return [SQLite3::Database] initialized database connection
    def open_database
      db = SQLite3::Database.new(@db_path)
      # Wait up to 5s on a locked db before raising; with_retry rides out longer
      # contention on top of that (many characters + an import share this file).
      db.busy_timeout = 5000
      db.execute('PRAGMA journal_mode=WAL')
      db.execute('PRAGMA synchronous=NORMAL')
      db.execute(<<~SQL)
        CREATE TABLE IF NOT EXISTS seen_messages (
          line_text TEXT PRIMARY KEY,
          first_seen_at DATETIME DEFAULT CURRENT_TIMESTAMP,
          source TEXT DEFAULT 'live'
        )
      SQL
      db
    end

    # @param line [String] message line to check
    # @return [Boolean] true if line exists in the database
    def exists_in_db?(line)
      @db.get_first_value('SELECT 1 FROM seen_messages WHERE line_text = ?', [as_text(line)]) ? true : false
    end

    # @param line [String] message line to insert
    # @param source [String] origin of the line ('live', 'import', 'migration')
    # @return [void]
    def insert_line(line, source = 'live')
      @db.execute('INSERT OR IGNORE INTO seen_messages (line_text, source) VALUES (?, ?)', [as_text(line), as_text(source)])
    end

    # Game lines arrive from Lich as binary (ASCII-8BIT) strings, and the sqlite3
    # gem binds binary strings as BLOBs. A BLOB never equals TEXT in SQLite, so a
    # live line would never match the same line imported from a log (TEXT), and
    # would be stored again as a separate BLOB row. Always bind UTF-8 TEXT.
    #
    # @param value [String] string to bind
    # @return [String] UTF-8 copy with invalid bytes scrubbed (as the importer does)
    def as_text(value)
      String.new(value.to_s, encoding: Encoding::UTF_8).scrub
    end

    # Merges any legacy per-character corpora (Marshal .dat and per-character
    # seen_messages_<Char>.db) found in the working directory into the shared
    # store, then renames each to .migrated so it runs only once. Keys are
    # stripped as they are merged: the old monitor stored them unstripped, but
    # the live path strips before every lookup, so an unstripped key never matches.
    #
    # @return [void]
    def migrate_legacy
      dats = Dir.glob('seen_messages_*.dat')
      dbs = Dir.glob('seen_messages_*.db').reject { |f| File.expand_path(f) == File.expand_path(@db_path) }
      return if dats.empty? && dbs.empty?

      total = dats.sum { |f| migrate_dat(f) } + dbs.sum { |f| migrate_db(f) }
      echo "status-monitor: merged #{total} entries from #{dats.size + dbs.size} legacy corpus file(s) into the shared store."
    end

    # Merges a legacy Marshal .dat. If it is unreadable, merges the backup copy
    # the old monitor kept in backup/ instead (the old monitor restored from it
    # the same way). Files are renamed only after a successful merge: a
    # recovered primary is kept as .corrupt for diagnosis and the backup becomes
    # .migrated. When nothing can be merged, both files stay as they are.
    #
    # @param path [String] legacy Marshal .dat file
    # @return [Integer] entries merged
    def migrate_dat(path)
      backup = "backup/#{File.basename(path, '.dat')}.bak"
      data, recovered = read_dat_or_backup(path, backup)
      lines = data.keys.map { |line| line.to_s.strip }.reject(&:empty?).uniq
      retrying do
        @db.transaction { lines.each { |line| insert_line(line, 'migration') } }
      end
      File.rename(path, recovered ? "#{path}.corrupt" : "#{path}.migrated")
      File.rename(backup, "#{backup}.migrated") if File.exist?(backup)
      lines.size
    rescue => e
      echo "status-monitor: could not merge #{path} (#{e.message}); skipping."
      0
    end

    # @param path [String] legacy Marshal .dat file
    # @param backup [String] the old monitor's backup copy of it
    # @return [Array(Hash, Boolean)] the corpus hash, and whether it came from the backup
    # @raise [StandardError] when the primary is unreadable and there is no readable backup
    def read_dat_or_backup(path, backup)
      [read_dat(path), false]
    rescue => e
      raise unless File.exist?(backup)

      echo "status-monitor: #{path} is unreadable (#{e.message}); merging its backup #{backup} instead."
      [read_dat(backup), true]
    end

    # @param path [String] Marshal file holding a { line => true } corpus hash
    # @return [Hash] the corpus hash
    # @raise [TypeError] when the file holds something other than a Hash
    def read_dat(path)
      data = File.open(path, 'rb') { |f| Marshal.load(f) }
      raise TypeError, "expected a Hash, got #{data.class}" unless data.is_a?(Hash)

      data
    end

    # @param path [String] legacy per-character seen_messages_<Char>.db file
    # @return [Integer] entries merged
    def migrate_db(path)
      src = SQLite3::Database.new(path)
      rows = begin
        src.execute('SELECT line_text, source FROM seen_messages')
      ensure
        src.close
      end
      entries = rows.filter_map do |line, source|
        stripped = line.to_s.strip
        [stripped, source || 'migration'] unless stripped.empty?
      end
      retrying do
        @db.transaction { entries.each { |line, source| insert_line(line, source) } }
      end
      File.rename(path, "#{path}.migrated")
      entries.size
    rescue => e
      echo "status-monitor: could not merge #{path} (#{e.message}); skipping."
      0
    end
  end

  # Filters raw game stream lines, stripping XML tags and removing
  # lines from known players, NPCs, and non-useful UI elements.
  #
  # Names are matched as whole words, and a creature noun only where it names a
  # creature ("a void-black umbral moth", "the moth's"): a GameMaster check often
  # quotes the nouns around you ("pouch.  bundle.  moth.  ...bow twice"), and a
  # bare substring match on the creature you are fighting would hide it.
  #
  # @note Uses status_tags mode to receive raw XML from the game stream.
  class MessageFilter
    # @return [String, nil] the last raw "Also here:" room players component line seen
    attr_reader :last_player_line

    FILTERED_STREAMS = %w[assess ooc atmospherics thoughts talk death group percWindow logons shopWindow].freeze
    # An opening (capturing the stream id) or closing stream tag.
    STREAM_TAG = /<(?:pushStream id="([^"]+)"|popStream)[^>]*>/i
    # The title the game shows before a GameMaster's name in the room players list.
    GM_TITLE = /\bgame ?master\b/i
    # The room players component of a room with no other players (the same form
    # Lich's DRParser matches as RoomPlayersEmpty).
    EMPTY_ROOM_PLAYERS = %r{'room players'></component>}
    # One linked player in the Saga-identity room players component: the title
    # before the link (group 1, never crossing a ", " or " and " separator, so a
    # previous player's description is not taken as this one's title) and the
    # link's noun (group 2), which is the player's name as the game spells it.
    LINKED_PLAYER = %r{(?:\A|, | and )((?:(?!, | and )[^<])*)<a\b[^>]*\bnoun="([^"]+)"[^>]*>[^<]*</a>}
    # Words that open a phrase naming a creature: "a void-black umbral moth",
    # "the moth", "its moth".
    CREATURE_ARTICLE = %q{(?:[Aa]n?|[Tt]he|[Ss]ome|[Yy]our|[Hh]is|[Hh]er|[Ii]ts|[Tt]heir)}

    # @param filter_strings [Array<Regexp>] configurable patterns to ignore
    def initialize(filter_strings)
      @filter_strings = filter_strings
      @room_players = []
      @room_players_pattern = nil
      @players_component_seen = false
      @gms_present = []
      @npc_key = nil
      @npc_pattern = nil
      @online_key = nil
      @online_pattern = nil
      @gm_arrival = nil
      @in_stream = false
      @current_stream = ''
      @non_useful_tags = [
        /<preset id='roomDesc'>/i,
        /component id='room/i,
        /component id='exp/i,
        %r{</prompt>$},
        /preset id='roomDesc'/,
        /style id="roomName"/,
        /<room>/, # Saga-identity room block (replaces roomName/roomDesc)
        /<spell exist='spell'>/,
        %r{<spell>None</spell>},
        /&lt; .*/,
        /<clearContainer/,
        /<right/,
        /<left/,
        /<indicator id='IconINVISIBLE'/,
        %r{<roundTime value='\d+'/>}
      ]
    end

    # Cleans a raw game line by stripping tags and filtering lines that name
    # another player. Creature lines are filtered separately by #creature_line?,
    # after the GameMaster-check patterns, so a creature noun can never hide a
    # check; player lines are filtered here, before them, so a player's emote
    # cannot fake one.
    #
    # Does not mutate its argument: tag stripping returns a new String.
    #
    # @param line [String] raw game stream line with XML tags
    # @return [String, nil] a new cleaned line, or nil if it should be ignored
    def clean(line)
      return nil if line.nil?

      update_players(line)
      line = visible_text(line)
      return nil if line.empty? || @non_useful_tags.any? { |tag| tag =~ line }
      # The bare "Also here:" text repeats the room players component, which is
      # authoritative once seen; before that it is the only GameMaster signal.
      return nil if @players_component_seen && line.start_with?('Also here: ')
      return nil if @room_players_pattern&.match?(line)
      return nil if online_player_pattern&.match?(line)

      line.gsub(/<[^>]+>/, '')
    end

    # Whether a cleaned line is about a creature in the room (Lich's
    # UserVars.npcs). A capitalised name (a named NPC) matches as a whole word
    # anywhere; a creature noun only inside a phrase that names a creature
    # ("a void-black umbral moth lunges", "the moth's wings"), never as a bare
    # word ("pouch.  bundle.  moth.").
    #
    # @param line [String] cleaned message line
    # @return [Boolean]
    def creature_line?(line)
      pattern = npc_pattern
      !pattern.nil? && pattern.match?(line)
    end

    # Checks whether a cleaned line matches any configured filter patterns.
    #
    # @param line [String] cleaned message line
    # @return [Boolean] true if the line matches a filter
    def filtered?(line)
      return true if line.nil? || line.empty?

      @filter_strings.any? { |regex| line =~ regex }
    end

    # Normalizes a line by stripping variable content (numbers, currency)
    # so that semantically identical messages compare as equal.
    # Must stay in sync with StatusMonitorImport.similarity_scrub.
    #
    # @param line [String] cleaned message line
    # @return [String] scrubbed copy of the line
    def similarity_scrub(line)
      result = line.dup
      [/[0-9]+/, /(kronars|lirums|dokoras)/i].each { |pattern| result.gsub!(pattern, '') }
      result
    end

    # @return [Array<Regexp>] the configured filter patterns
    attr_reader :filter_strings

    # Returns, once, the room players text in which a GameMaster has just
    # appeared. The game re-sends the room players component on every room
    # update, so this fires when a GameMaster joins the list, not while one
    # stays in it.
    #
    # @return [String, nil] the "Also here: ..." text, or nil if no GameMaster arrived
    def consume_gm_arrival
      arrival = @gm_arrival
      @gm_arrival = nil
      arrival
    end

    private

    # The room players as [entry, name] pairs, where entry is the title and name
    # ("GameMaster Avaari") and name is the player's name ("Avaari").
    #
    # The Saga-identity stream links every name, and the links are used when
    # present: a description can contain ", " or " and " ("trailed by a flag
    # displaying a dragon skull and crossbones"), which no text split can tell
    # from a list separator. Otherwise the text is split on ", " and the last
    # " and ", and "who ..."/"whose ..."/"(...)" descriptions are removed.
    #
    # @param room_players [String] "Also here:" component text
    # @return [Array<Array(String, String)>]
    def player_entries(room_players)
      if room_players.include?('noun="')
        return room_players.scan(LINKED_PLAYER).map { |title, noun| ["#{title.gsub(/<[^>]+>/, '').strip} #{noun}".strip, noun] }
      end

      head, separator, last = room_players.gsub(/<[^>]+>/, '').rpartition(' and ')
      list = separator.empty? ? last : "#{head}, #{last}"
      list.split(', ').filter_map do |obj|
        entry = obj.sub(/ (?:who|whose) .+/, '').sub(/ \(.+\)/, '').strip
        name = entry[/\w+\z/]
        [entry, name] if name
      end
    end

    # A whole-word pattern for a list of names, or nil for an empty list.
    #
    # @param names [Array<String>]
    # @return [Regexp, nil]
    def names_pattern(names)
      return nil if names.empty?

      /\b(?:#{Regexp.union(names).source})\b/
    end

    # Whole-word pattern for the online players other than this character,
    # rebuilt only when Lich replaces the list.
    #
    # @return [Regexp, nil]
    def online_player_pattern
      online = UserVars.players_online
      return nil unless online
      return @online_pattern if online.equal?(@online_key)

      @online_key = online
      @online_pattern = names_pattern(online - [checkname, 'Endith'])
    end

    # Pattern matching a line about a creature in the room, rebuilt only when
    # the creature list changes.
    #
    # @return [Regexp, nil]
    def npc_pattern
      npcs = UserVars.npcs
      return nil if npcs.nil? || npcs.empty?
      return @npc_pattern if npcs == @npc_key

      @npc_key = npcs.dup
      parts = npcs.uniq.map do |noun|
        word = Regexp.escape(noun)
        if noun.match?(/\A[A-Z]/)
          "\\b#{word}\\b"
        else
          "\\b#{CREATURE_ARTICLE}\\s+(?:[\\w'-]+\\s+){0,5}?#{word}(?:'s|s|es)?\\b"
        end
      end
      @npc_pattern = Regexp.new(parts.join('|'))
    end

    # Tracks the room's players. The component is game-generated markup that a
    # player cannot inject, so it is also where a GameMaster's presence is read:
    # the line itself is dropped as UI markup by #clean, and so is the bare
    # "Also here:" line that may follow. A GameMaster's name is not added to the
    # room players, so their emotes still reach the novelty gate. An empty
    # component clears the GameMasters present, so one who leaves an otherwise
    # empty room alerts again on return.
    #
    # @param line [String] raw game stream line to check for player component
    # @return [void]
    def update_players(line)
      if line.match?(EMPTY_ROOM_PLAYERS)
        # Keep the last names: a departure line ("Bob just went north.") can
        # follow the update that dropped them.
        @players_component_seen = true
        @gms_present = []
        return
      end
      return unless line =~ %r{\'room players\'>Also here: (.*)\.</component>}

      @players_component_seen = true
      @last_player_line = line
      raw = Regexp.last_match(1)
      entries = player_entries(raw)
      gm_entries, players = entries.partition { |entry, _name| entry.match?(GM_TITLE) }
      @room_players = players.map(&:last)
      @room_players_pattern = names_pattern(@room_players)
      gms = gm_entries.map(&:first)
      @gm_arrival = "Also here: #{raw.gsub(/<[^>]+>/, '')}." if (gms - @gms_present).any?
      @gms_present = gms
    end

    # Removes the content of filtered streams from a line, walking its stream
    # tags in order, and carries the stream state on to the next line. A whole
    # ESP thought arrives as one line that opens and closes its stream, so the
    # tags must be applied in sequence: deciding on the line's first tag alone
    # left the monitor muted after the thought, and deciding on its last tag
    # alone would let the thought's quoted text through.
    #
    # @param line [String] raw game stream line
    # @return [String] the line without filtered-stream content (empty if none is left)
    def visible_text(line)
      return (filtered_stream? ? '' : line) unless line.match?(STREAM_TAG)

      visible = String.new(encoding: line.encoding)
      pos = 0
      line.scan(STREAM_TAG) do
        tag = Regexp.last_match
        visible << line[pos...tag.begin(0)] unless filtered_stream?
        tag[1] ? enter_stream(tag[1]) : leave_stream
        pos = tag.end(0)
      end
      visible << line[pos..] unless filtered_stream?
      visible
    end

    # @return [Boolean] whether the stream state is inside a filtered stream
    def filtered_stream?
      @in_stream && FILTERED_STREAMS.include?(@current_stream)
    end

    # @param stream [String] id of the stream being pushed
    # @return [void]
    def enter_stream(stream)
      @in_stream = true
      @current_stream = stream
    end

    # @return [void]
    def leave_stream
      @in_stream = false
      @current_stream = ''
    end
  end

  # Handles alert responses when spam is detected: audio beeps,
  # optional auto-response, Slack notification, and optional auto-quit.
  #
  # @note Configurable via YAML settings:
  #   - `status_monitor_respond` [Boolean] whether to auto-respond
  #   - `quit_on_status_warning` [Boolean] whether to auto-quit
  #   - `slack_username` [String] Slack user to notify
  class AlertHandler
    # @param settings [OpenStruct] user settings from get_settings
    def initialize(settings)
      @settings = settings
      @responses = ["'Hmmm?", "'Yes", "'Ok?"].shuffle
      @quit_on_flag = settings.quit_on_status_warning
      @slack_enabled = !@settings.slack_username.nil? && !@settings.slack_username.to_s.strip.empty?
      @slackbot = nil
    end

    # Handles an alerted line.
    #
    # Every alert notifies (audible beeps, echo to the window, Slack). The
    # optional auto-actions (canned response, auto-quit) only run on a STRONG
    # signal: the line matched a known GM-check pattern. Commands found in a line
    # are never typed -- ordinary game output is full of capitalised verbs
    # ("---Active RPA---", "when OPENed"), and a real check needs a human answer.
    #
    # @param line [String] the alerted line
    # @param strong [Boolean] whether the line matched a GM-check pattern
    # @return [void]
    def handle(line, strong:)
      3.times do
        echo("\a")
        pause 0.25
      end
      if strong
        fput @responses.first if @settings.status_monitor_respond
        # Queue the auto-quit before send_slack: constructing the SlackBot on the
        # first alert can block for several seconds, and we do not want that to
        # delay logout when quit_on_status_warning is set. The exit command is
        # queued to the game, so the Slack notification still goes out afterward.
        fput('exit') if @quit_on_flag
        @responses.rotate!
      end
      echo(line)
      send_slack(line)
      pause 2 if strong
    end

    # Echoes and Slacks an informational notice (no beeps, no auto-actions).
    #
    # @param message [String] notice text
    # @return [void]
    def notify(message)
      echo(message)
      send_slack(message)
    end

    private

    # Lazily constructs the SlackBot on first use.
    #
    # SlackBot.new can block for several seconds (lnet startup, users.list
    # fetch, jitter/backoff). Building it here rather than in the constructor
    # keeps script startup and the status window responsive, and defers the
    # connection until an alert actually needs to be sent (by which point lnet
    # is far more likely to be up).
    #
    # @return [Lich::DragonRealms::SlackBot, nil] the bot, or nil if construction failed
    def slackbot
      return @slackbot if @slackbot

      @slackbot = Lich::DragonRealms::SlackBot.new
    rescue => e
      echo "SlackBot init failed: #{e.message}"
      nil
    end

    # @param message [String] message body to send
    # @return [void]
    #
    # @note Delegates the connection check to SlackBot#direct_message, which
    #   reconnects itself when not yet initialized. Gating on #initialized?
    #   here would permanently suppress delivery whenever the first connection
    #   attempt failed (e.g. lnet not up yet at login), because the self-healing
    #   reconnect path inside direct_message would never be reached.
    def send_slack(message)
      return unless @slack_enabled

      bot = slackbot
      return unless bot

      bot.direct_message(@settings.slack_username, message.to_s)
    rescue => e
      echo "SlackBot error: #{e.message}"
    end
  end

  # Top-level orchestrator for status monitoring.
  #
  # Coordinates message filtering, the shared corpus novelty gate, and alert
  # handling. Provides both headless and GTK windowed modes.
  #
  # @note Optional settings keys:
  #   - `status_monitor_no_window` [Boolean] disable GTK window
  #   - `status_monitor_respond` [Boolean] canned reply on a GM-check alert
  #   - `quit_on_status_warning` [Boolean] auto-quit on a GM-check alert
  #   - `slack_username` [String] Slack user to notify
  #   - `status_monitor_grace_seconds` [Integer] warm-up window at session start
  #     during which novel lines are learned silently (default 60; 0 disables)
  #
  # Learn mode is deliberately NOT a setting, so it can never be left on: it is
  # only enabled by the `learn` argument and always expires. While learning,
  # novel lines are recorded silently (GM-check lines still alert and are never
  # recorded). The start-up grace period is the same mechanism with a short
  # default window and no Slack notices.
  #
  # @example Basic usage
  #   ;status-monitor
  #
  # @example Learn mode (30 minutes, or N minutes)
  #   ;status-monitor learn
  #   ;status-monitor learn=90
  #
  # @example Headless mode
  #   ;status-monitor nowindow
  #
  # @example Debug mode
  #   ;status-monitor debug
  #
  # @see https://elanthipedia.play.net/Lich_script_repository#status-monitor
  class Monitor
    # Seconds at the start of a session during which novel lines are learned
    # silently (no alert) to absorb the warm-up burst before the corpus is warm.
    GRACE_SECONDS = 60
    # Default length of an explicit `learn` session, and how often it reminds.
    LEARN_DEFAULT_MINUTES = 30
    LEARN_REMINDER_SECONDS = 600
    # Notification safety valve: at most this many alerts per rolling window;
    # beyond it, novel lines are dropped unrecorded so they can alert later.
    ALERT_RATE_MAX = 10
    ALERT_RATE_WINDOW = 60
    # Known GM-check wordings, matched against the cleaned line. These always
    # alert -- regardless of the corpus, grace, learn mode or the rate cap -- and
    # are never recorded, so a check can never be whitelisted into silence.
    CHECK_PATTERNS = Regexp.union(
      /Say go away/i, # squirrel check: 'You hear a child nearby yelling, "... Say go away to shoo him away!"'
      /scurries into the room and .+ before it runs off/, # squirrel check
      /test of your conscious awareness/i, # failed check, about to be moved
      /Scripting Violation Limbo/, # moved to limbo
      /game ?master/i,
      /SEND\[/,
      /You can use RESPOND/
    )
    # Game wordings that match CHECK_PATTERNS (they mention GameMasters) but are
    # not a check. They are never recorded, but they are weak alerts: no canned
    # reply, no auto-quit, and they are subject to the rate cap.
    GM_NOTICE_PATTERNS = Regexp.union(
      /error has occurred and the Gamemasters have been alerted/i # 'Some sort of error has occurred and the Gamemasters have been alerted.'
    )

    attr_reader :spam_line

    # @return [String, nil] the most recent cleaned line (tags stripped), for debug logging
    attr_reader :last_clean_line

    # @return [String] corpus source tag for lines learned silently this session
    attr_reader :learn_source

    # @param settings [OpenStruct] user settings from get_settings
    # @param store [MessageStore] shared corpus (defaults to the installation-wide store)
    # @param learn_minutes [Integer, nil] explicit learn session length; nil for
    #   the normal start-up grace period
    def initialize(settings, store = MessageStore.new, learn_minutes: nil)
      @store = store
      @filter = MessageFilter.new(load_filter_strings)
      @alerter = AlertHandler.new(settings)
      started_at = Time.now
      @explicit_learn = !learn_minutes.nil?
      window = @explicit_learn ? learn_minutes * 60 : (settings.status_monitor_grace_seconds || GRACE_SECONDS)
      @learning = window.positive?
      @learn_until = started_at + window
      @last_reminder = started_at
      @learn_source = "learn:#{checkname}:#{started_at.utc.strftime('%Y-%m-%dT%H:%M:%SZ')}"
      @alert_times = []
      @spam_line = nil
      @last_clean_line = nil
      announce_learning(window) if @learning
    end

    # Processes a single raw game line through the full pipeline.
    #
    # A GameMaster appearing in the room players component alerts as a strong
    # signal, like a check, bypassing grace, learn mode and the rate cap.
    #
    # Lines naming another player are dropped before the check patterns (a
    # player's emote cannot fake a check); lines about a creature in the room
    # only after them (a creature noun cannot hide one).
    #
    # A line matching CHECK_PATTERNS always alerts as a strong signal (canned
    # response / auto-quit if configured) and is never recorded. One that also
    # matches GM_NOTICE_PATTERNS alerts weakly (no canned response or auto-quit),
    # is never recorded either, and counts toward the rate cap.
    #
    # Any other line is novelty-gated: a line already in the shared corpus is
    # known-safe and silent. A NOVEL line alerts once and is then recorded, so it
    # goes quiet on every character. During the start-up grace period or learn
    # mode a novel line is recorded silently instead (tagged with learn_source);
    # past the rate cap it is dropped unrecorded, so it can still alert once the
    # cap clears.
    #
    # @param line [String] raw game stream line
    # @return [Boolean] true if the line alerted
    def process(line)
      update_learning
      cleaned = @filter.clean(line)
      @last_clean_line = cleaned
      if (arrival = @filter.consume_gm_arrival)
        alert(arrival, strong: true)
        return true
      end
      return false if cleaned.nil?

      if cleaned.match?(CHECK_PATTERNS)
        return alert_gm_notice(cleaned.strip) if cleaned.match?(GM_NOTICE_PATTERNS)

        alert(cleaned.strip, strong: true)
        return true
      end
      return false if @filter.creature_line?(cleaned)
      return false if @filter.filtered?(cleaned)

      scrubbed = @filter.similarity_scrub(cleaned).strip
      return false if scrubbed.empty?
      return false if @store.in_corpus?(scrubbed) # known-safe -> silent

      if @learning
        @store.record(scrubbed, @learn_source)
        return false
      end
      return false if rate_limited?

      # Alert with the real line; the scrubbed form is only the corpus key.
      alert(cleaned.strip, strong: false)
      @alert_times << Time.now
      @store.record(scrubbed)
      true
    end

    # Clears the current spam line after it has been consumed.
    #
    # @return [String, nil] the spam line that was cleared
    def consume_spam_line
      line = @spam_line
      @spam_line = nil
      line
    end

    # Closes the database connection.
    #
    # @return [void]
    def shutdown
      @store.shutdown
    end

    # @return [String, nil] last seen room players component line
    def last_player_line
      @filter.last_player_line
    end

    private

    # @param line [String] the line to announce
    # @param strong [Boolean] whether it matched a GM-check pattern
    # @return [void]
    def alert(line, strong:)
      @alerter.handle(line, strong: strong)
      @spam_line = line
    end

    # Weak alert for a GM_NOTICE_PATTERNS line. Unlike a real check it is
    # throttled by, and counts toward, the rate cap, so a burst of the notice
    # cannot become an unthrottled stream of beeps and Slack DMs. Never recorded.
    #
    # @param line [String] the cleaned notice line
    # @return [Boolean] true if it alerted
    def alert_gm_notice(line)
      return false if rate_limited?

      alert(line, strong: false)
      @alert_times << Time.now
      true
    end

    # Advances the learning window; called for every line so expiry and
    # reminders happen on time even when no novel line arrives. Ends the
    # session (with a notice for explicit learn) once it expires, and reminds
    # periodically during explicit learn.
    #
    # @return [void]
    def update_learning
      return unless @learning

      now = Time.now
      if now >= @learn_until
        @learning = false
        @alerter.notify('status-monitor: learn mode ended -- alerting on new lines again.') if @explicit_learn
      elsif @explicit_learn && now - @last_reminder >= LEARN_REMINDER_SECONDS
        @last_reminder = now
        echo "status-monitor: LEARN MODE until #{@learn_until.strftime('%H:%M')} -- not alerting on new lines."
      end
    end

    # Whether the alert rate cap has been reached in the current window.
    #
    # @return [Boolean]
    def rate_limited?
      cutoff = Time.now - ALERT_RATE_WINDOW
      @alert_times.reject! { |t| t < cutoff }
      if @alert_times.size >= ALERT_RATE_MAX
        unless @rate_notice
          echo "status-monitor: alert rate cap reached (#{ALERT_RATE_MAX}/#{ALERT_RATE_WINDOW}s); dropping alerts until it clears."
          @rate_notice = true
        end
        return true
      end
      @rate_notice = false
      false
    end

    # One-time notice that a learning window has started. Explicit learn mode
    # also goes to Slack and names the tag that undoes the session.
    #
    # @param window [Integer] learning window in seconds
    # @return [void]
    def announce_learning(window)
      unless @explicit_learn
        echo "status-monitor: warming up for #{window}s -- learning novel lines quietly before alerting."
        return
      end

      @alerter.notify("status-monitor: LEARN MODE for #{window / 60} min (until #{@learn_until.strftime('%H:%M')}) -- " \
                      'recording new lines silently, not alerting. GM checks still alert.')
      echo "status-monitor: to undo this session: DELETE FROM seen_messages WHERE source = '#{@learn_source}'"
    end

    # Loads the configurable ignore patterns from the 'filters' data file.
    #
    # get_data can briefly return nil (or data lacking the key) if it is read
    # before Lich finishes loading its data files, so retry a bounded number of
    # times. If no filter list is ever produced, run with no filters rather than
    # failing: an unconfigured (or empty) filter list is valid, not fatal. Note
    # get_data is a synchronous read, so this retry only helps a genuine
    # not-yet-loaded race -- it will not conjure a key that the data file lacks.
    #
    # @return [Array<Regexp>] compiled filter patterns (empty if none configured)
    def load_filter_strings
      10.times do
        data = get_data('filters')
        strings = data && data['filter_strings']
        return strings.map { |string| /#{string}/ } if strings

        pause 1
      end
      echo 'status-monitor: no filter list available; running with no filters.'
      []
    end
  end

  # Native WebUI window: new lines on top, health below. Callbacks run on the
  # WebUI host thread and only record state; the script thread does the rest.
  class Window
    PAGE_ID = 'status-monitor'
    # Lines kept on screen; older ones scroll off.
    MAX_LINES = 500
    # Health at or above this shows as healthy (the old green bar).
    HEALTHY = 75
    DEFAULT_WIDTH = 300
    DEFAULT_HEIGHT = 100
    # Saved sizes at or below this are ignored, as the GTK window did.
    MIN_SAVED_SIZE = 100

    # @return [Boolean] true when this Lich can show native WebUI windows
    def self.available?
      (defined?(Lich::WebUI) && Lich::WebUI.respond_to?(:presentation_enabled?) && Lich::WebUI.presentation_enabled? &&
        defined?(Lich::API) && Lich::API.respond_to?(:webui_page)) ? true : false
    end

    # Width, height and position worth saving, or nil for each value that is not.
    #
    # @param geometry [Hash] :width, :height, :position as reported by the window
    # @return [Hash{String => Object}] CharSettings keys to write
    def self.saved_geometry(geometry)
      saved = {}
      position = geometry[:position]
      saved['window_position'] = position if position.is_a?(Array) && position.size == 2 && position.all? { |v| v.is_a?(Integer) && v >= 0 }
      saved['window_width'] = geometry[:width] if geometry[:width].is_a?(Integer) && geometry[:width] > MIN_SAVED_SIZE
      saved['window_height'] = geometry[:height] if geometry[:height].is_a?(Integer) && geometry[:height] > MIN_SAVED_SIZE
      saved
    end

    # @param hp [Integer, nil] health percent
    # @return [String] contract tone for the health bar
    def self.health_tone(hp)
      hp.to_i >= HEALTHY ? 'positive' : 'danger'
    end

    attr_reader :lines, :health

    # @param owner [Lich::Common::Script] owning script
    # @param title [String] window title
    # @param saved [Hash] CharSettings-like store holding window_position/width/height
    def initialize(owner, title, saved)
      @owner = owner
      @title = title
      @saved = saved
      @lines = []
      @health = nil
      @closed = false
      @geometry = {}
      @mutex = Mutex.new
      @page = nil
    end

    # Opens the window.
    #
    # @return [Boolean] false if no window could be opened
    def open
      window = self
      size = [@saved['window_width'] || DEFAULT_WIDTH, @saved['window_height'] || DEFAULT_HEIGHT]
      position = @saved['window_position']
      props = { size: size, bare: true, density: :compact, viewport: true, presentation: { always_on_top: true } }
      props[:position] = position if position.is_a?(Array) && position.size == 2
      @page = Lich::API.webui_page(owner: @owner, id: PAGE_ID, title: @title, props: props,
                                   on: { close: ->(_ev) { window.closed! },
                                         configure: ->(ev) { window.configured(ev.payload) } }) do |ui|
        window.render(ui)
      end
      Lich::API.webui_refresh(@page)
      Lich::API.webui_start
      Lich::API.webui_open(page: @page) ? true : false
    end

    # @return [Boolean] true once the user has closed the window
    def closed?
      @mutex.synchronize { @closed }
    end

    # Close event callback.
    # @return [void]
    def closed!
      @mutex.synchronize { @closed = true }
    end

    # Configure event callback: remembers the latest size and position.
    # @param payload [Hash] width, height, position
    # @return [void]
    def configured(payload)
      @mutex.synchronize { @geometry = { width: payload[:width], height: payload[:height], position: payload[:position] } }
    end

    # Writes the last known good geometry to the settings store.
    # @return [void]
    def save_geometry
      geometry = @mutex.synchronize { @geometry.dup }
      self.class.saved_geometry(geometry).each { |key, value| @saved[key] = value }
    end

    # @param hp [Integer] health percent
    # @return [void]
    def health=(hp)
      @mutex.synchronize { @health = hp }
      redraw
    end

    # Adds a line to the window.
    # @param text [String]
    # @return [void]
    def append(text)
      @mutex.synchronize do
        @lines << text.to_s
        @lines.shift while @lines.size > MAX_LINES
      end
      redraw
    end

    # Closes the window and releases this script's WebUI resources.
    # @return [void]
    def shutdown
      save_geometry
      Lich::API.webui_terminate_owner(@owner)
    rescue StandardError
      nil
    end

    # @return [void]
    def redraw
      Lich::API.webui_refresh(@page) if @page && !closed?
    end

    # Page builder.
    # @param ui [Lich::WebUI::TreeBuilder]
    # @return [void]
    def render(ui)
      # The builder block runs with the builder as self, so take values first.
      lines, hp = @mutex.synchronize { [@lines.dup, @health] }
      value = hp ? hp.clamp(0, 100) / 100.0 : 0.0
      label = hp ? "#{hp}%" : ''
      tone = self.class.health_tone(hp)
      max_lines = MAX_LINES
      ui.stack(key: 'root', gap: 2, margin: 2) do
        ui.log(key: 'messages', lines: lines, max_lines: max_lines, follow: true)
        ui.progress(key: 'health', value: value, label: label, tone: tone)
      end
    end
  end
end

# @param raw [String, nil] original raw line as received from the game stream
# @param cleaned [String, nil] the line after tag stripping and source filtering
# @param player_line [String, nil] last room players component
# @return [void]
def write_debug_log(raw, cleaned, player_line)
  File.open("status-monitor-debug-#{checkname}.txt", 'a') do |f|
    f.puts(raw)
    f.puts(cleaned)
    f.puts(player_line)
  end
end

settings = get_settings
learn_minutes = (args.learn[/\d+/] || StatusMonitor::Monitor::LEARN_DEFAULT_MINUTES).to_i if args.learn
monitor = StatusMonitor::Monitor.new(settings, learn_minutes: learn_minutes)

before_dying do
  monitor.shutdown
end

# Without a window, the monitor keeps running on game lines alone.
run_headless = lambda do
  loop do
    line = script.gets
    if monitor.process(line) && args.debug
      write_debug_log(line, monitor.last_clean_line, monitor.last_player_line)
    end
    monitor.consume_spam_line
  end
end

unless nowindow || StatusMonitor::Window.available?
  echo 'status-monitor: this Lich cannot open WebUI windows; running without a window.'
  nowindow = true
end
run_headless.call if nowindow

window = StatusMonitor::Window.new(Script.current, "#{checkname} Status", CharSettings)

before_dying do
  window.shutdown
end

unless window.open
  echo 'status-monitor: could not open a window; running without a window.'
  run_headless.call
end

prev_health = nil
loop do
  line = script.gets?
  if prev_health != health
    prev_health = health
    window.health = prev_health
  end
  if monitor.process(line)
    write_debug_log(line, monitor.last_clean_line, monitor.last_player_line) if args.debug
  else
    pause 0.1 unless args.debug && line
  end
  if (spam = monitor.consume_spam_line)
    window.append("new:'#{spam}'")
  end
  break if window.closed?
end
