=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#sell-pouches

  Sells a gem pouch at the hometown gem shop.

  Takes a pouch from sale_pouches_container, walks to the gem shop, sells it and
  runs sell-loot afterwards. The empty pouch goes to worn_trashcan if set,
  otherwise a bin in the room, or is dropped if there isn't one. If the shop
  doesn't buy it, the pouch goes back into sale_pouches_container.
=end

class PouchSeller
  def initialize
    settings = get_settings
    @pouch_container = settings.sale_pouches_container
    @worn_trashcan = settings.worn_trashcan
    @worn_trashcan_verb = settings.worn_trashcan_verb
    hometown = settings.hometown

    exit unless have_pouch?(@pouch_container)

    gemshop = get_data('town')[hometown]['gemshop']['id']
    unless gemshop
      echo('NO GEMSHOP DATA FOUND?')
      fput('stow pouch')
      exit
    end

    sell_pouch(gemshop)
  end

  def have_pouch?(container)
    return false unless container

    DRC.bput("get pouch from my #{container}", 'You get a', 'What were you') == 'You get a'
  end

  def sell_pouch(shop_id)
    return unless shop_id

    DRCT.walk_to(shop_id)
    DRC.wait_for_script_to_complete('buff', [Script.current.name])
    if pouch_sold?
      discard_pouch
    else
      return_unsold_pouch
    end
    DRC.wait_for_script_to_complete('sell-loot')
  end

  # Anything but a sale (a refusal, or no reply) may leave gems in the pouch.
  def pouch_sold?
    DRC.bput('sell pouch', /hands you [\d,]+/, /not a market for that/i, /not interested/i, 'What were you').match?(/hands you/)
  end

  # PUT goes to the front of a container, so the next run fetches this same pouch first.
  def return_unsold_pouch
    if DRCI.put_away_item?('pouch', @pouch_container)
      DRC.message("***STATUS*** The gem shop didn't buy the pouch, so it's back in your #{@pouch_container}. " \
                  "It will be tried first again next time -- sell it by hand or move it out of your #{@pouch_container}.")
    else
      DRC.message("***STATUS*** The gem shop didn't buy the pouch and it won't go back in your #{@pouch_container} -- it's still in your hand with its gems.")
    end
  end

  # dispose_trash fetches with a bare GET when nothing is held, which could pick
  # up the next full pouch, so only throw away a pouch seen in hand.
  def discard_pouch
    unless pouch_in_hand?
      DRC.message("***STATUS*** Sold, but the empty pouch isn't in your hand -- not throwing anything away.")
      return
    end
    return if DRCI.dispose_trash('pouch', @worn_trashcan, @worn_trashcan_verb)

    DRC.message("***STATUS*** Couldn't throw away the empty pouch -- check your hands.")
  end

  # The hand update can trail the clerk's text.
  def pouch_in_hand?
    3.times do |attempt|
      return true if DRCI.in_hands?('pouch')

      pause 0.5 if attempt < 2
    end
    false
  end
end

PouchSeller.new
