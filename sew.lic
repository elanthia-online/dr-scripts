=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#sew
=end

require 'time'

class Sew
  CLOTH = [
    'silk', 'wool', 'burlap', 'cotton', 'felt', 'linen',
    'electroweave', 'steelsilk', 'arzumodine', 'bourde',
    'dergatine', 'dragonar', 'faeweave', 'farandine',
    'imperial', 'imperial weave', 'jaspe', 'khaddar', 'ruazin',
    'titanese', 'zenganne'
  ].freeze

  # Flags see every server line, other players' speech, whispers and ESP
  # included, and those always have a double quote before the spoken text.
  # LINE_START: the game's message starts the line (leading tags allowed).
  # NO_QUOTE: the message may follow other text, but no double quote outside
  # a tag. NO_QUOTE_RUN stands in for '.*' inside a message.
  LINE_START = '^(?:<[^>]+>)*'
  NO_QUOTE = '^(?:<[^>]*>|[^"<])*?'
  NO_QUOTE_RUN = '(?:<[^>]*>|[^"<])*'

  # Rental lines the game brackets on their own line after the sentry's
  # speech. The sentry's speech has a quote before its text, so these are
  # what to match; anchoring at line start keeps player text from faking them.
  RENTAL_RENEWED = /#{LINE_START}\[Your [^\]]*rental has been extended until/
  RENTAL_WARNING = /#{LINE_START}\[You have less than \d+ minutes remaining\.\s+If you wish to renew your rental/

  # Unrecognized replies before #work gives up: the crafting command's own
  # miss, then the ANALYZEs sent in its place (#work). A recognized reply to
  # a crafting command starts the count again; one to an ANALYZE does not,
  # so a command whose replies sew never knows cannot cycle through ANALYZE
  # forever.
  MAX_UNMATCHED = 3

  # Seconds #work waits for an ANALYZE's reply after a crafting command got
  # none. A lag on 2026-11-06 held every reply for about 100 seconds; ANALYZE
  # is sent once and waited on, not resent every 15 seconds, so no more
  # commands pile up behind the lag.
  ANALYZE_TIMEOUT = 90

  # The thread the needles take, as the stock room sells it ("100 yards of
  # cotton thread", order 6). Spun spools are thread too ("some heavy silk
  # thread") and spin keeps them in the crafting container, so the thread
  # is always named by its material, never by the bare noun.
  SEWING_THREAD = 'cotton thread'

  def initialize
    @settings = get_settings
    @hometown = @settings.force_crafting_town || @settings.hometown
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb
    @bag = @settings.crafting_container
    @bag_items = @settings.crafting_items_in_container
    @belt = @settings.outfitting_belt
    @stamp = @settings.mark_crafted_goods

    arg_definitions = [
      [
        { name: 'finish', options: %w[hold log stow trash], description: 'What to do with the finished item.' },
        { name: 'type', options: %w[knitting sewing leather], description: 'What tailoring type is this item.' },
        { name: 'chapter', regex: /\d+/i, variable: true, description: 'Chapter containing the item.' },
        { name: 'recipe_name', display: 'recipe name', regex: /^[A-z\s\-']+$/i, variable: true, description: 'Name of the recipe, wrap in double quotes if this is multiple words.' },
        { name: 'material', regex: /\w+/i, variable: true, description: 'Type of material to use.' },
        { name: 'noun', regex: /\w+/i, variable: true, description: 'Noun of item being crafted' },
        { name: 'skip', regex: /skip/i, optional: true, description: 'Optional setting to skip restocking consumables if low (wax/pins/thread)' }
      ],
      [
        { name: 'finish', options: %w[hold stow], description: 'What to do with the finished item.' },
        { name: 'instructions', regex: /instructions/i, description: 'Instructions if using instructions' },
        { name: 'material', regex: /\w+/i, variable: true, description: 'Type of material to use.' },
        { name: 'noun', regex: /\w+/i, variable: true, description: 'Noun of item being crafted' },
        { name: 'knit', regex: /^knit/i, optional: true, description: 'tells sew to do knitting routine' },
        { name: 'skip', regex: /skip/i, optional: true, description: 'Optional setting to skip restocking consumables if low (glue/stain)' }
      ],
      [
        { name: 'recipe_name', display: 'enhancement', options: %w[seal reinforce lighten], description: 'Enhancements to crafted armor/shields' },
        { name: 'noun', regex: /\w+/i, variable: true, description: 'Noun of item being enhanced.' }
      ],
      [
        { name: 'resume', regex: /resume/i },
        { name: 'noun', regex: /\w+/i, variable: true, description: 'Noun of item to resume.' }
      ]
    ]

    args = parse_args(arg_definitions)

    @finish = args.finish || 'hold'
    args.recipe_name.sub!('lighten', 'tailored armor lightening')
    args.recipe_name.sub!('seal', 'tailored armor sealing')
    args.recipe_name.sub!('reinforce', 'tailored armor reinforcing')
    @recipe_name = args.recipe_name
    @cube = @settings.cube_armor_piece
    @noun = args.noun
    @knit = args.knit
    @mat_type = args.material
    @chapter = args.chapter.nil? ? 1 : args.chapter.to_i
    @info = get_data('crafting')['tailoring'][@hometown]
    @instructions = args.instructions
    @cloth = CLOTH
    @pin_pokes = 0

    DRC.wait_for_script_to_complete('buff', ['sew'])

    Flags.add('sew-assembly',
              /#{NO_QUOTE}ready to be #{NO_QUOTE_RUN} with some (small|large) cloth (padding)/i,
              /#{NO_QUOTE}another finished \S+ shield (handle)/i,
              /#{NO_QUOTE}another finished wooden (hilt|haft)/i,
              /#{NO_QUOTE}another finished (long|short|small|large) leather (cord|backing)/i,
              /#{NO_QUOTE}another finished (small|large) cloth (padding)/i,
              /#{NO_QUOTE}another finished (long|short) wooden (pole)/i)
    Flags.add('sew-done',
              /#{NO_QUOTE}The #{NO_QUOTE_RUN} shows improved/i,
              /#{LINE_START}Applying the final touches/i,
              /#{NO_QUOTE}The #{NO_QUOTE_RUN} shows a slightly reduced weight/i,
              /#{LINE_START}You realize that cannot be repaired, and stop/)
    Flags.add('sew-rental-warning', RENTAL_WARNING)

    if args.resume
      Lich::Messaging.msg('plain', "Resuming work on #{@noun} (finish mode: #{@finish}).")
      if DRCI.in_hands?('knitting needles')
        @home_command = 'knit my needles'
      else
        check_hand(@noun) unless DRCI.in_left_hand?(@noun)
        @home_command = "analyze my #{@noun}"
      end
      work(analyze_command)
    end
    # Before the consumables check: its get needs a free hand too.
    clear_hands
    if @recipe_name.include?('seal')
      DRCC.check_consumables('wax', @info['tool-room'], 10, @bag, @bag_items, @belt) unless args.skip
    elsif @chapter != 5
      DRCC.check_consumables('pins', @info['tool-room'], 5, @bag, @bag_items, @belt) unless args.skip
      DRCC.check_consumables(SEWING_THREAD, @info['stock-room'], 6, @bag, @bag_items, @belt) unless args.skip
    end

    check_rental_status
    start_item
  end

  # Readies a new item (prep) and works it. A completion line still on its
  # way from an earlier run sets sew-done while this run starts: on
  # 2026-11-06 a 100-second lag stopped a sew mid-netting, taskmaster started
  # another, and the stopped run's backlogged commands then finished the old
  # netting ("Applying the final touches") during the new run's setup. The
  # new run's first cut then ended in finish, which stowed a netting cut
  # once as done; the unfinished netting rode in the bag for days, and
  # Zasele turned it down at each hand-in. So the flag is cleared once prep
  # is done, right before the first crafting command.
  def start_item
    command = prep
    Flags.reset('sew-done')
    work(command)
  end

  def check_hand(item)
    if DRCI.in_right_hand?(item)
      DRC.bput('swap', 'You move', 'You have nothing')
    else
      Lich::Messaging.msg('bold', "Please hold the item or material you wish to work on. Expected '#{item}' in right hand.")
      magic_cleanup
      exit
    end
  end

  def list_at_feet
    atfeet = Lich::Util.issue_command('inv atfeet', /All of your items lying at your feet/, /Use INVENTORY HELP for more options/, usexml: false)
    Lich::Messaging.msg('plain', "Items at feet: #{atfeet.join(', ')}") if atfeet&.any?
  end

  # A new item starts with empty hands. Anything still held, such as the
  # item a previous run finished with 'hold', blocks every later get.
  # Enhancements work on the held item, so that one stays. DRC.right_hand
  # and DRC.left_hand shorten names of three or more words to the first and
  # last word ("quilted cloth shirt" becomes "quilted shirt"), so the keep
  # matches the noun's last word, the one the shortening leaves in place.
  def clear_hands
    keep = @noun.tr('.', ' ').split.last if @recipe_name.include?('tailored armor')
    [DRC.right_hand, DRC.left_hand].each do |item|
      next if item.nil? || (keep && item.include?(keep))

      DRCC.stow_crafting_item(item, @bag, @belt)
    end
  end

  # The material comes first: each study of the instructions uses one of
  # their uses, so a missing material must stop the run before the study.
  def prep
    DRCA.crafting_magic_routine(@settings)
    if @knit || @chapter == 5 # knitting
      hold_material('yarn', 'yarn')
      read_recipe('yarn')
      swap_tool('knitting needles')
      @home_tool = 'knitting needles'
      @home_command = 'knit my needles'
      'knit my yarn with my knitting needles'
    elsif @recipe_name.include?('tailored armor') # enhancements
      @stamp = false
      check_hand(@noun) unless DRCI.in_left_hand?(@noun)
      read_recipe(nil)
      if @recipe_name.include?('seal')
        swap_tool('sealing wax')
        @home_tool = 'sealing wax'
        @home_command = "apply my wax to my #{@noun}"
        "apply my wax to my #{@noun}"
      else
        swap_tool('scissors')
        @home_tool = 'scissors'
        @home_command = "cut my #{@noun} with my scissors"
        "cut my #{@noun} with my scissors"
      end
    elsif @cloth.include?(@mat_type) # any cloth products
      hold_material("#{@mat_type} cloth", 'cloth')
      read_recipe("#{@mat_type} cloth")
      swap_tool('scissors')
      @home_tool = 'sewing needles'
      @home_command = "push my #{@noun} with my needles"
      @offcut = 'cloth'
      "cut my #{@mat_type} cloth with my scissors"
    else # any leather products
      hold_material("#{@mat_type} leather", 'leather')
      read_recipe("#{@mat_type} leather")
      swap_tool('scissors')
      @home_tool = 'sewing needles'
      @home_command = "push my #{@noun} with my needles"
      @offcut = 'leather'
      "cut my #{@mat_type} leather with my scissors"
    end
  end

  # Gets the material into the left hand, or stops the run when the get
  # fails (missing, or no free hand), before check_hand can blame the hand.
  def hold_material(name, noun)
    unless DRCC.get_crafting_item(name, @bag, @bag_items, @belt, true)
      Lich::Messaging.msg('bold', "sew: Could not get '#{name}'. Stopping before the recipe is studied.")
      magic_cleanup
      exit
    end
    check_hand(noun) unless DRCI.in_left_hand?(noun)
    @material_id = GameObj.left_hand.id
  end

  # Reads the recipe once +material+ is in the left hand. +material+ is
  # nil for an enhancement, whose piece was in hand before the run.
  def read_recipe(material)
    if @instructions
      get_recipe_item("#{@noun} instructions", material)
      if /again/ =~ DRC.bput('study my instructions', 'Roundtime', 'Study them again')
        DRC.bput('study my instructions', 'Roundtime', 'Study them again')
      end
    elsif @settings.master_crafting_book
      DRCC.find_recipe2(@chapter, @recipe_name, @settings.master_crafting_book, 'tailoring')
    else
      get_recipe_item('tailoring book', material)
      Lich::Messaging.msg('bold', 'You will need to upgrade to a journeyman or master book before 176 ranks!') if DRSkill.getrank('Outfitting') == 175
      DRCC.find_recipe2(@chapter, @recipe_name)
      DRCC.stow_crafting_item('tailoring book', @bag, @belt)
    end
  end

  # Gets the instructions or the tailoring book. When the get fails (the
  # item is missing, or the reply times out with no free hand), puts the
  # material back and stops before any study, so the run leaves neither the
  # material in hand nor a study sent with nothing to study.
  #
  # A failed put-back names the hand only while the piece is still in the
  # left hand (material_in_left_hand?): put_away_item? returns false on
  # every failure reply, including "Perhaps you should be holding that
  # first.", which means the piece is no longer held.
  def get_recipe_item(name, material)
    return if DRCC.get_crafting_item(name, @bag, @bag_items, @belt, true)

    message = "sew: Could not get '#{name}'. Stopping before the recipe is studied."
    message += " The #{material} is still in your left hand." if material && !put_back_material(material) && material_in_left_hand?(material)
    Lich::Messaging.msg('bold', message)
    magic_cleanup
    exit
  end

  # Puts the held material back in the bag. By id when hold_material saw
  # one, so the put reaches the piece in hand and a full bag fails at once
  # instead of after a 15 second timeout. Returns false when the put
  # failed; the caller checks the hand to see whether the piece is still
  # held. By name, the stow's result says nothing (it returns true even
  # after its "stow" fallback fails), so the left hand decides.
  def put_back_material(material)
    return DRCI.put_away_item?("##{@material_id}", @bag) if @material_id

    DRCC.stow_crafting_item(material, @bag, @belt)
    !material_in_left_hand?(material)
  end

  # Whether the material is still in the left hand: by the id hold_material
  # saw, or by name when it saw none.
  def material_in_left_hand?(material)
    DRCI.in_left_hand?(@material_id ? "##{@material_id}" : material)
  end

  def assemble_part
    while Flags['sew-assembly']
      tool = DRC.right_hand
      DRCC.stow_crafting_item(tool, @bag, @belt) if tool
      part = Flags['sew-assembly'].to_a[1..-1].join(' ')
      Flags.reset('sew-assembly')
      DRCC.get_crafting_item(part, @bag, @bag_items, @belt)
      DRC.bput("assemble my #{@noun} with my #{part}", 'affix it securely in place', 'and tighten the pommel to secure it', 'carefully mark where it will attach when you continue crafting')
      swap_tool(tool) if tool
    end
  end

  # Cutting cloth or leather leaves the excess at your feet, and prep sets
  # @offcut to its noun. Lift it by that noun so it goes back to the
  # crafting bag: DRCI.lift? sends nothing without one, and 'stow feet'
  # puts the offcut in the default stow container instead.
  def lift_or_stow_feet
    if @offcut && DRCI.lift?(@offcut)
      right = DRC.right_hand
      left = DRC.left_hand
      DRCC.stow_crafting_item(right, @bag, @belt) if right && !right.include?(@noun.tr('.', ' '))
      DRCC.stow_crafting_item(left, @bag, @belt) if left && !left.include?(@noun.tr('.', ' '))
    else
      DRC.bput('stow feet', 'You put', 'Stow what')
    end
  end

  # ANALYZE of the piece being worked: the knitting needles while knitting,
  # else the item. Its reply names the next step in words #work already
  # matches: "The fabric appears ready for more sewing by pushing it with a
  # needle and thread." (Catheroine, 2026-11-02), "The fabric is in need of
  # pinning to help arrange the material for further sewing." (Mahtra,
  # 2026-11-04), and it ends with a Roundtime.
  def analyze_command
    DRCI.in_hands?('knitting needles') ? 'analyze my knitting needles' : "analyze my #{@noun}"
  end

  # Works the item, one command at a time, until a reply ends the run. A
  # crafting command that gets no reply #work knows is not sent again: it
  # may only be held up by a lag, and every resend would be done once the
  # lag clears (on 2026-11-06 three pushes sent into a 100-second lag
  # finished a netting after sew had given up on it). Instead the run
  # finishes if the item was finished meanwhile (sew-done), or else sends
  # ANALYZE, as a resume does, and waits up to ANALYZE_TIMEOUT for it to say
  # what the item needs next. After MAX_UNMATCHED misses it gives up.
  def work(command)
    DRC.bput("touch my #{@cube}", /^Warm vapor swirls around your head in a misty halo/, /^A thin cloud of vapor manifests with no particular effect./, /^Touch what/, /^You reach out and touch/) if @cube
    unmatched = 0
    stalled = nil
    loop do
      DRCA.crafting_magic_routine(@settings)
      renew_rental if Flags['sew-rental-warning']
      assemble_part
      result = DRC.bput(command,
                        *(stalled ? [{ 'timeout' => ANALYZE_TIMEOUT }] : []),
                        'a slip knot in your yarn',
                        'A sufficient quantity of wax exists',
                        'A buildup of wax on .* must now be rubbed',
                        'and could use some pins to',
                        'cutting with some scissors',
                        'deep crease develops along',
                        'Deep creases and wrinkles in the fabric',
                        'dimensions appear to have shifted and could benefit from some remeasuring',
                        'dimensions changed while working on it',
                        'Do you really want to discard',
                        'I could not find what you were',
                        'Ingredients can be added',
                        'is in need of pinning to help arrange the material for further sewing',
                        'need to be turned',
                        'needs holes punched',
                        'New seams must now be sewn to properly fit the lightened material together',
                        'Next the needles must be pushed',
                        'Nothing obstructs the fabric from continued sewing',
                        'now needs some sealing wax applied',
                        'Now the needles must be turned',
                        'pushing it with a needle and thread',
                        'ready to be pushed',
                        'requires some holes punched',
                        'scissor cuts',
                        'Sealing wax now encases the material',
                        'Some purl stitching is',
                        'Some ribbing should be added',
                        'The garment is nearly complete and now must be cast off',
                        'The needles need to have thread put on them before they can be used for sewing',
                        'What were you referring',
                        'With the measuring complete',
                        'wrinkles from all the handling and could use',
                        'You are already knitting',
                        'You carefully thread some cotton thread',
                        'is already threaded with',
                        'You must assemble',
                        'You need another',
                        'You untie and discard',
                        /^The .* needles must be cast to finish binding the knit yarn\.$/,
                        /You need a larger amount of material to continue crafting/,
                        /^Roundtime/,
                        /^You need a free hand to do that/,
                        /^You realize that cannot be repaired, and stop/,
                        /^You must be holding the .* to do that/,
                        /^You cannot do that while engaged!/)
      # bput returns an empty string when no matcher fits.
      if result.empty?
        unmatched += 1
        stalled ||= command
        waitrt?
        finish if Flags['sew-done']
        if unmatched >= MAX_UNMATCHED
          Lich::Messaging.msg('bold', "sew: No recognized response to '#{stalled}', or to ANALYZE after it, in #{MAX_UNMATCHED} tries. Cannot continue crafting.")
          magic_cleanup
          exit
        end
        command = analyze_command
        next
      end
      unmatched = 0 unless stalled
      stalled = nil

      case result
      when /You need a larger amount of material to continue crafting/
        Lich::Messaging.msg('bold', "sew: Not enough material to continue crafting #{@noun}. Exiting.")
        magic_cleanup
        exit
      when /^You must be holding the .* to do that/
        Lich::Messaging.msg('bold', "sew: Required tool not in hand. Cannot continue crafting #{@noun}.")
        magic_cleanup
        exit
      when 'dimensions appear to have shifted and could benefit from some remeasuring', 'dimensions changed while working on it'
        swap_tool('yardstick')
        @home_tool = 'sewing needles'
        @home_command = "push my #{@noun} with my sewing needles"
        command = "measure my #{@noun} with my yardstick"
      when 'With the measuring complete', 'cutting with some scissors', 'scissor cuts'
        swap_tool('scissors')
        command = "cut my #{@noun} with my scissors"
      when 'and could use some pins to', 'is in need of pinning to help arrange the material for further sewing'
        @pin_pokes += 1
        swap_tool('pins', true)
        command = "poke my #{@noun} with my pins"
      when 'deep crease develops along', 'wrinkles from all the handling and could use', 'Deep creases and wrinkles in the fabric'
        swap_tool('slickstone')
        command = "scrape my #{@noun} with my slickstone"
      when 'The needles need to have thread put on them before they can be used for sewing'
        # Take the id while the needles are still in hand. Once they are tied
        # or stowed, "my sewing needles" can pick a spare pair instead.
        needles_id = GameObj.right_hand&.id
        unless needles_id
          Lich::Messaging.msg('bold', 'sew: Could not identify the sewing needles to thread. Cannot continue crafting.')
          magic_cleanup
          exit
        end
        swap_tool(SEWING_THREAD, true)
        command = "put my thread on ##{needles_id}"
      when 'You carefully thread some cotton thread', 'is already threaded with'
        swap_tool('sewing needles')
        command = "push my #{@noun} with my sewing needles"
      when 'What were you referring', 'I could not find what you were'
        list_at_feet
        lift_or_stow_feet
        if command.include?('wax')
          DRCC.check_consumables('wax', @info['tool-room'], 10, @bag, @bag_items, @belt)
          swap_tool('wax')
        elsif command.include?('pins')
          DRCC.check_consumables('pins', @info['tool-room'], 5, @bag, @bag_items, @belt)
          swap_tool('pins')
        elsif command.include?('thread')
          DRCC.check_consumables(SEWING_THREAD, @info['stock-room'], 6, @bag, @bag_items, @belt)
          swap_tool(SEWING_THREAD)
        end
      when 'needs holes punched', 'requires some holes punched'
        @home_tool = 'sewing needles'
        @home_command = "push my #{@noun} with my sewing needles"
        swap_tool('awl')
        command = "poke my #{@noun} with my awl"
      when 'New seams must now be sewn to properly fit the lightened material together'
        @stamp = false
        @home_tool = 'scissors'
        @home_command = "cut my #{@noun} with my scissors"
        swap_tool('sewing needles')
        command = "push my #{@noun} with my sewing needles"
      when 'A sufficient quantity of wax exists', 'Sealing wax now encases the material', 'A buildup of wax on .* must now be rubbed'
        @stamp = false
        @home_tool = 'sealing wax'
        @home_command = "apply my wax to my #{@noun}"
        swap_tool('slickstone')
        command = "scrape my #{@noun} with my slickstone"
      when 'now needs some sealing wax applied'
        @home_tool = 'sealing wax'
        @home_command = "apply my wax to my #{@noun}"
        swap_tool('sealing wax', true)
        command = "apply my wax to my #{@noun}"
      when 'Nothing obstructs the fabric from continued sewing', 'pushing it with a needle and thread'
        @home_tool = 'sewing needles'
        @home_command = "push my #{@noun} with my sewing needles"
        swap_tool('sewing needles')
        command = "push my #{@noun} with my sewing needles"
      when 'Ingredients can be added', 'You must assemble', 'You need another'
        assemble_part
      when 'a slip knot in your yarn'
        DRCC.stow_crafting_item('yarn', @bag, @belt)
        command = 'knit my needles'
      when 'Now the needles must be turned', 'Some ribbing should be added', 'need to be turned'
        command = 'turn my needles'
      when 'Next the needles must be pushed', 'ready to be pushed', 'Some purl stitching is'
        command = 'push my needles'
      when 'The garment is nearly complete and now must be cast off', /^The .* needles must be cast to finish binding the knit yarn\.$/
        command = 'cast my needles'
      when 'You are already knitting', 'Do you really want to discard'
        command = 'pull my needles'
      when 'You untie and discard'
        command = 'knit my yarn with my knitting needles'
      when /^Roundtime/, /^You realize that cannot be repaired, and stop/, /^You need a free hand to do that/
        waitrt?
        finish if Flags['sew-done']
        swap_tool(@home_tool) unless @home_tool.nil?
        command = @home_command.nil? ? command : @home_command
      when /^You cannot do that while engaged!/
        DRC.retreat
        pause 10
      end
    end
  end

  def swap_tool(next_tool, skip = false)
    return if next_tool.nil? || DRC.right_hand&.include?(next_tool)

    DRCC.stow_crafting_item(DRC.right_hand, @bag, @belt)
    DRCC.get_crafting_item(next_tool, @bag, @bag_items, @belt, skip)

    return if DRCI.in_hands?(next_tool)

    Lich::Messaging.msg('bold', "sew: Failed to get '#{next_tool}'. Cannot continue crafting.")
    magic_cleanup
    exit
  end

  def finish
    if @stamp
      swap_tool('stamp', true)
      DRC.bput("mark my #{@noun} with my stamp", 'Roundtime')
      DRCC.stow_crafting_item('stamp', @bag, @belt)
    end

    right = DRC.right_hand
    left = DRC.left_hand
    DRCC.stow_crafting_item(right, @bag, @belt) if right && !right.include?(@noun.tr('.', ' '))
    DRCC.stow_crafting_item(left, @bag, @belt) if left && !left.include?(@noun.tr('.', ' '))

    case @finish
    when /log/
      DRCC.logbook_item('outfitting', @noun, @bag)
    when /stow/
      DRCC.stow_crafting_item(@noun, @bag, @belt)
    when /trash/
      DRCI.dispose_trash(@noun, @worn_trashcan, @worn_trashcan_verb)
    when /hold/
      Lich::Messaging.msg('bold', "#{@noun} complete -- holding in hand.")
    end

    lift_or_stow_feet
    magic_cleanup

    Lich::Messaging.msg('plain', "sew: Completed #{@recipe_name} (chapter #{@chapter}, #{@noun}) - #{@pin_pokes} pin pokes, finish: #{@finish}")
    exit
  end

  def magic_cleanup
    return if @settings.crafting_training_spells.empty?

    DRC.bput('release spell', 'You let your concentration lapse', "You aren't preparing a spell")
    DRC.bput('release mana', 'You release all', "You aren't harnessing any mana")
    DRC.bput('release symb', "But you haven't", 'You release', 'Repeat this command')
  end

  def check_rental_status
    result = DRC.bput('read notice',
                      /It will expire (.+)\./,
                      'I could not find',
                      'What were you referring to')
    return unless result =~ /It will expire (.+)\./

    expire_str = Regexp.last_match(1)
    expire_str_normalized = expire_str.sub(' ET ', ' -0500 ')
    expire_time = Time.parse(expire_str_normalized)
    minutes_remaining = ((expire_time - Time.now) / 60).to_i

    if minutes_remaining < 10
      Lich::Messaging.msg('bold', "*** RENTAL LOW (#{minutes_remaining} min) -- AUTO-RENEWING ***")
      renew_rental
    elsif minutes_remaining < 20
      Lich::Messaging.msg('bold', "*** Rental has #{minutes_remaining} minutes remaining ***")
    end
  rescue ArgumentError
    Lich::Messaging.msg('bold', "Could not parse rental expiry time: #{expire_str}")
  end

  def renew_rental
    Lich::Messaging.msg('bold', '*** RENTAL EXPIRING -- AUTO-RENEWING ***')
    Flags.reset('sew-rental-warning')
    case DRC.bput('mark notice',
                  RENTAL_RENEWED,
                  "You don't have enough",
                  'I could not find')
    when RENTAL_RENEWED
      Lich::Messaging.msg('bold', '*** RENTAL RENEWED ***')
    when "You don't have enough"
      Lich::Messaging.msg('bold', '*** INSUFFICIENT FUNDS TO RENEW RENTAL ***')
    when 'I could not find'
      Lich::Messaging.msg('bold', '*** COULD NOT FIND NOTICE -- CHECK LOCATION ***')
    else
      Lich::Messaging.msg('bold', '*** RENTAL RENEWAL NOT CONFIRMED -- CHECK THE NOTICE ***')
    end
  end
end

before_dying do
  Flags.delete('sew-assembly')
  Flags.delete('sew-done')
  Flags.delete('sew-rental-warning')
end

Sew.new
