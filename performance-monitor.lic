=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#performance-monitor
=end

unless HAVE_GTK
  respond
  respond 'error: ruby-gtk bindings are not installed or failed to load'
  respond
  exit
end

# Ranks each hit with a monitored weapon by its damage phrase and
# averages roundtime and damage per second of roundtime for each weapon.
# The weapons come from the performance_monitor_weapons setting.
class PerformanceFilter
  # Reads the weapon list from the character's settings and sets up empty hit
  # and roundtime records for each weapon, plus the 23 damage phrases with the
  # (n/23) rank tag each is rewritten to.
  #
  # @return [PerformanceFilter]
  def initialize
    @settings = get_settings
    @weapon_hits = {}
    @weapon_rts = {}
    @settings.performance_monitor_weapons.each do |x|
      @weapon_hits[x] = []
      @weapon_rts[x] = []
    end
    @weapon_stats = []
    @pending_weapon = nil
    @pending_ranks = []
    @damage_subs = [
      ['a light hit', 'a light hit (1/23)'],
      ['a good hit', 'a good hit (2/23)'],
      ['a good strike', 'a good strike (3/23)'],
      ['a solid hit', 'a solid hit (4/23)'],
      ['a hard hit', 'a hard hit (5/23)'],
      ['a strong hit', 'a strong hit (6/23)'],
      ['a heavy strike', 'a heavy strike (7/23)'],
      ['a very heavy hit', 'a very heavy hit (8/23)'],
      ['an extremely heavy hit', 'an extremely heavy hit (9/23)'],
      ['a powerful strike', 'a powerful strike (10/23)'],
      ['a massive strike', 'a massive strike (11/23)'],
      ['an awesome strike', 'an awesome strike (12/23)'],
      ['a vicious strike', 'a vicious strike (13/23)'],
      ['an earth-shaking strike', 'an earth-shaking strike (14/23)'],
      ['a demolishing hit', 'a demolishing hit (15/23)'],
      ['a spine-rattling strike', 'a spine-rattling strike (16/23)'],
      [/a devastating hit(?! \(That'll leave a mark!\))/, 'a devastating hit (17/23)'],
      [/a devastating hit \(That'll leave a mark!\)/, "a devastating hit (That'll leave a mark!) (18/23)"],
      ['an overwhelming strike', 'an overwhelming strike (19/23)'],
      ['an obliterating hit', 'an obliterating hit (20/23)'],
      ['an annihilating strike', 'an annihilating strike (21/23)'],
      ['a cataclysmic strike', 'a cataclysmic strike (22/23)'],
      ['an apocalyptic strike', 'an apocalyptic strike (23/23)']
    ]
  end

  # @return [Array<String>, nil] the monitored weapon names, as set in
  #   performance_monitor_weapons (nil when the setting is empty)
  def weapon_list
    @settings.performance_monitor_weapons
  end

  # Tags the damage phrase in a game line with its (n/23) rank and holds the
  # rank of a hit with a monitored weapon until the next roundtime line, which
  # records the held ranks and that roundtime together, then updates the stats.
  # Several hits of one weapon before a roundtime are held together; a hit
  # with a different weapon drops the held ones, whose roundtime is unknown.
  #
  # @param line [String] a game line; changed in place, with each damage
  #   phrase followed by its (n/23) tag
  # @return [Boolean] true when the line gave the roundtime of a hit (the
  #   stats were updated), false otherwise
  def process_line(line)
    @damage_subs.each { |x| line.gsub!(x.first, x.last) }
    weapon_name = @settings.performance_monitor_weapons.find { |name| %r{^<.*\b#{name}\b.*\((\d+)/23\)} =~ line }
    hold_hit(weapon_name, Regexp.last_match(1).to_i) if weapon_name

    return false unless @pending_weapon && /roundtime\D*(\d+)/i =~ line

    record_roundtime(Regexp.last_match(1).to_i)
    true
  end

  # Holds one hit's rank until its roundtime arrives. A hit with a different
  # weapon than the held hits drops them first.
  #
  # @param weapon [String] the monitored weapon the hit names
  # @param rank [Integer] the hit's damage rank, 1 to 23
  # @return [void]
  def hold_hit(weapon, rank)
    @pending_ranks = [] unless weapon == @pending_weapon
    @pending_weapon = weapon
    @pending_ranks.push(rank)
  end

  # Records the held hits and their roundtime under the held weapon, clears
  # the held hits and updates the stats.
  #
  # @param seconds [Integer] the roundtime that followed the held hits
  # @return [void]
  def record_roundtime(seconds)
    @weapon_hits[@pending_weapon].concat(@pending_ranks)
    @weapon_rts[@pending_weapon].push(seconds)
    @pending_weapon = nil
    @pending_ranks = []
    update_stats
  end

  # Rebuilds {#weapon_stats} from the recorded hits and roundtimes. Hits are
  # only recorded with their roundtime, so a weapon with no roundtime recorded
  # yet has no hits either and is left out.
  #
  # @return [void]
  def update_stats
    @weapon_stats = []
    @weapon_hits.each do |weapon, hits|
      next if @weapon_rts[weapon].empty?

      dmg = hits.inject(&:+)
      rt = @weapon_rts[weapon].inject(&:+)
      @weapon_stats.push(weapon: weapon, avgrt: rt * 1.0 / hits.size, avgdps: dmg * 1.0 / rt)
    end
  end

  # @return [Array<Hash{Symbol => Object}>] one entry per weapon with a
  #   roundtime recorded: :weapon (String), :avgrt (Float, the weapon's total
  #   roundtime over its hits that had a roundtime; a roundtime after several
  #   hits of the weapon is spread over them) and :avgdps (Float, total rank
  #   over total roundtime); empty until the first hit's roundtime. A hit
  #   followed by another weapon's hit before any roundtime is not counted.
  attr_reader :weapon_stats
end

# Shows one weapon's averages in its stats entry.
#
# @param entry [Gtk::Entry] the weapon's entry in the window
# @param data [Hash{Symbol => Object}] one {PerformanceFilter#weapon_stats} entry
# @return [void]
def update_stat_bar(entry, data)
  entry.text = "#{data[:weapon]}:\tavg RT:#{data[:avgrt].round(1)}\tavg DPS:#{data[:avgdps].round(1)}"
end

filter = PerformanceFilter.new
window = nil
window_done = false
load_window_position = CharSettings['window_position'] || []
load_window_width    = CharSettings['window_width'] || 300
load_window_height   = CharSettings['window_height'] || 100
window_title = "#{checkname} Performance Monitor"
save_window_position = nil
save_window_width    = nil
save_window_height   = nil

before_dying do
  CharSettings['window_position'] = save_window_position if (save_window_position.class == Array) && (save_window_position[0].to_i >= 0) && (save_window_position[1].to_i >= 0)
  CharSettings['window_width']    = save_window_width    if (save_window_width.class == Integer) && (save_window_width > 100)
  CharSettings['window_height']   = save_window_height   if (save_window_height.class == Integer) && (save_window_height > 100)
  Gtk.queue { window.destroy }
end

begin
  weapon_ets = {}

  Gtk.queue do
    vbox = Gtk::Box.new(:vertical, 0)
    filter.weapon_list.each do |weapon|
      stats_et = Gtk::Entry.new
      stats_et.editable = false
      display_font = Pango::FontDescription.new
      display_font.weight = :bold
      stats_et.override_font(display_font)
      weapon_ets[weapon] = stats_et
      vbox.pack_start(stats_et)
    end

    window              = Gtk::Window.new
    window.title        = window_title
    window.keep_above = true
    window.border_width = 1
    window.resize(load_window_width, load_window_height)
    unless load_window_position.empty?
      window.move(load_window_position[0], load_window_position[1])
    end
    window.add(vbox)

    window.signal_connect('delete_event') do
      save_window_position = window.position
      save_window_width    = window.allocation.width
      save_window_height   = window.allocation.height
      window_done = true
    end
    window.show_all
  end

  # This script used to start textsubs; it no longer does, so tell a player
  # who relied on that how to start it at login instead. Autostart starts
  # scripts one after another without waiting for each, so textsubs may come
  # up just after this script: give it a few seconds before deciding. The
  # window is already queued, so it is not held up; game lines wait in this
  # script's buffer (lich keeps the last 400), so none are lost, though they
  # are handled up to five seconds late.
  10.times do
    break if Script.running?('textsubs')

    pause 0.5
  end
  echo 'performance-monitor no longer starts textsubs. To start textsubs at every login: ;autostart add textsubs' unless Script.running?('textsubs')

  loop do
    line = script.gets?
    break if window_done

    pause 0.05 unless line
    next unless line

    next unless filter.process_line(line)

    filter.weapon_stats.each do |data|
      update_stat_bar(weapon_ets[data[:weapon]], data)
    end
  end
end
