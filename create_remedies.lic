=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#create_remedies
=end

# Makes one remedy from data/base-recipes.yaml by name: forages and prepares
# the herbs it lacks, then runs remedy.lic, in its instructions form for a
# recipe made from instructions and its book form for every other.
class CreateRemedies
  # Reads the arguments, finds the recipe, gets the herbs and runs remedy.lic.
  #
  # @return [void]
  # @raise [SystemExit] when remedy.lic leaves no product in hand (after the
  #   tool store when `tools` is given), or
  #   parse_args matches no form
  def initialize
    arg_definitions = [
      [
        { name: 'target', regex: /\w+/, description: 'Recipe.' },
        { name: 'tools', regex: /tools/i, optional: true, description: 'Use clerk-tools to get and store tools.' },
        { name: 'debug', regex: /debug/i, optional: true, description: 'Debug mode.' },
        { name: 'catalyst', regex: /\w+/i, variable: true, optional: true, description: 'Catalyst to use. Default is coal.' }
      ]
    ]

    args = parse_args(arg_definitions)
    tools = args.tools
    debug = args.debug
    catalyst = args.catalyst || "coal nugget"
    DRC.message("catalyst = #{catalyst}") if debug

    # Get recipe
    recipe = get_data('recipes').crafting_recipes.find { |each_recipe| each_recipe['name'] =~ /#{args.target}/i }
    DRC.message("Recipe is: #{recipe}.") if debug
    # Gather first herb section based on settings
    herb1 = recipe['herb1']
    if herb1 == "red flower"
      DRC.message("In herb1 red flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first dried flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "dried flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    elsif herb1 == "blue flower"
      DRC.message("In herb1 blue flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first crushed flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "crushed flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    else
      get_prep_herb(recipe['herb1']) unless DRC.bput("tap first #{recipe['herb1']}", "You tap", "What were", "I could not") =~ /You tap/
    end
    # Gather second herb if necessary
    get_prep_herb(recipe['herb2']) unless recipe['herb2'].nil? || DRC.bput("tap first #{recipe['herb2']}", "You tap", "What were", "I could not") =~ /You tap/
    # Get tools?
    get_store_tools("get") if tools
    # Craft call section
    DRC.wait_for_script_to_complete('remedy', remedy_args(recipe, herb1, catalyst))
    # Lich gives no exit status: the product in hand is remedy's success
    # signal (remedy.lic header).
    unless DRCI.in_hands?(recipe['noun'])
      DRC.message("CreateRemedies: remedy did not leave #{recipe['name']} (#{recipe['noun']}) in hand. Stopping.")
      get_store_tools("store") if tools
      exit
    end
    # Store tools?
    get_store_tools("store") if tools
  end

  # The arguments remedy.lic is run with for a recipe.
  #
  # A recipe marked `instructions: true` (data/base-recipes.yaml) is made
  # from stand-alone "<noun> instructions", not the crafting book, and has no
  # chapter, so it goes through remedy's instructions form,
  # `instructions <herb1> <catalyst> <container> <noun>` (remedy.lic
  # INSTRUCTIONS_FORM). Every other recipe gets the 8-argument book form, as
  # it always has, with herb2 'na' when the recipe has none.
  #
  # @param recipe [Hash] the base-recipes.yaml entry
  # @param herb1 [String] the first herb, the prepared flower name for a red
  #   or blue flower recipe
  # @param catalyst [String] the catalyst
  # @return [Array<String, Integer, nil>] the list for
  #   DRC.wait_for_script_to_complete
  # @note The instructions form takes no herb2: every instructions recipe has
  #   one herb (spec/base_recipes_remedies_spec.rb checks the data).
  def remedy_args(recipe, herb1, catalyst)
    return ['instructions', herb1, catalyst, recipe['container'], recipe['noun']] if recipe['instructions']

    herb2 = recipe['herb2'].nil? ? 'na' : recipe['herb2']
    ['remedies', recipe['chapter'], recipe['name'], herb1, herb2, catalyst, recipe['container'], recipe['noun']]
  end

  # Forages 25 of a herb and prepares it with alchemy.lic, by its
  # {#forage_name}.
  #
  # @param herb [String] the herb, as the recipe names it
  # @return [void]
  def get_prep_herb(herb)
    ingredient = forage_name(herb)
    DRC.wait_for_script_to_complete('alchemy', [ingredient, 'forage', 25])
    DRC.wait_for_script_to_complete('alchemy', [ingredient, 'prepare'])
  end

  # Gets or stores the alchemy tools with clerk-tools.lic.
  #
  # @param option [String] "get" or "store"
  # @return [void]
  # @note `debug` is a local of {#initialize}, not of this method, so here it
  #   calls Lich's global `debug` (lich-5 480bdee3 lib/global_defs.rb:446-454),
  #   which echoes only when $LICH_DEBUG is set and otherwise returns nil. The
  #   script's own debug argument never shows this line; nothing raises.
  def get_store_tools(option)
    DRC.message("Option for tools is: {option}.") if debug
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'get']) if option == "get"
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'store']) if option == "store"
  end

  # The name alchemy.lic is given to find a recipe herb's
  # data/base-ingredients.yaml entry (`name =~ /<target>/i`, alchemy.lic:35).
  # A herb the recipe names as a prepared output, such as the "dried
  # clubmoss" of an instructions recipe, is foraged and prepared as the raw
  # herb that output comes from, "shining clubmoss". Any other herb (the book
  # recipes' nemoih, red flower, ...; none of them is an output) is passed on
  # as it is.
  #
  # @param herb [String] the herb, as the recipe names it
  # @return [String] the raw herb's ingredient name, or herb
  def forage_name(herb)
    raw = get_data('ingredients').ingredients.find { |ingredient| ingredient['output'].to_s.strip == herb }
    raw ? raw['name'] : herb
  end
end
CreateRemedies.new
