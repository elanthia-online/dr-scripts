# frozen_string_literal: true

=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#enchant
=end

class Enchant
  # Reply patterns that drive a decision only match the game's own line, not
  # other players' speech or ESP: they start the line (`^`), or, where the
  # message may follow other text on the line, no quote may come before it
  # (`^[^"]*?`).

  # Analyze patterns
  ANALYZE_READY_PATTERNS = [
    /^[^"]*?scribing additional sigils onto the fount\./,
    /^[^"]*?ready for additional scribing\./,
    /^[^"]*?free of problems that would impede further sigil scribing\./,
    /^[^"]*?You do not see anything that would prevent scribing additional sigils/
  ].freeze
  ANALYZE_IMBUE_PATTERN = /^[^"]*?application of an imbue spell to advance the enchanting process\./.freeze
  ANALYZE_PATTERNS = (ANALYZE_READY_PATTERNS + [ANALYZE_IMBUE_PATTERN]).freeze

  # Look on brazier
  # Any brazier: your own (`brass brazier`) or the public `enchanter's brazier`.
  BRAZIER_CONTENTS_PATTERN = /^[^"]*?On the .*?brazier you see (?<items>.*)\./.freeze
  BRAZIER_EMPTY = /^[^"]*?There is nothing/i.freeze

  # Wave fount
  WAVE_FOUNT_SUCCESS = /^You slowly wave/.freeze
  WAVE_FOUNT_NOT_NEEDED = /^[^"]*?The fragile mana fount is not required/i.freeze

  # Touch cube
  TOUCH_CUBE_PATTERNS = [
    /^Warm vapor swirls around your head in a misty halo/,
    /^A thin cloud of vapor manifests with no particular effect\./,
    /^Touch what/
  ].freeze

  # Put on brazier
  PUT_BRAZIER_ALREADY_ENCHANTED = /^The totem is already enchanted/.freeze
  PUT_BRAZIER_SUCCESS = [/^With a flick/, /^You put/].freeze
  PUT_BRAZIER_NEEDS_CLEAN = /^You must first clean/.freeze
  PUT_BRAZIER_GLANCE = /^You glance down/.freeze

  # Get item patterns
  GET_SUCCESS = /^You get/.freeze
  GET_DANGEROUS = /^[^"]*?That is far too dangerous/i.freeze

  # Imbue wand
  IMBUE_WAND_SUCCESS = /^Roundtime/.freeze
  IMBUE_WAND_SIGIL_NEEDED = /^You need another .* sigil to continue the enchanting process/.freeze
  IMBUE_WAND_FAILED = /^[^"]*?The streams collide, rending the space before you and disrupting the enchantment/i.freeze

  # Clean brazier
  CLEAN_SUCCESS = /^[^"]*?You prepare to clean off the brazier/i.freeze
  CLEAN_NOTHING = BRAZIER_EMPTY
  CLEAN_NOT_LIT = /^[^"]*?The brazier is not currently lit/i.freeze
  CLEAN_SINGED = 'a massive ball of flame jets forward and singes everything nearby'

  # Sigil study/trace
  SIGIL_STUDY_SUCCESS = /^You study the sigil-scroll and commit the design to memory/.freeze
  SIGIL_TRACE_SUCCESS = /^Recalling the intricacies of the sigil, you trace its form/.freeze

  # Scribe patterns
  SCRIBE_RT_PATTERN = /^Roundtime/.freeze
  SCRIBE_SIGIL_NEEDED = /^You need another .* sigil to continue the enchanting process/.freeze

  # Focus/meditate/push patterns
  FOCUS_IMBUE_NEEDED = /Once finished you sense an imbue spell will be required to continue enchanting/.freeze

  # Stamp patterns
  STAMP_PATTERNS = [
    'carefully hammer the stamp',
    'You cannot figure out how to do that',
    'too badly damaged',
    /You lazily wave the stamp over the freshly enchanted/
  ].freeze

  # Flag names
  FLAG_NAMES = %w[
    enchant-focus enchant-imbue enchant-meditate enchant-push
    enchant-sigil enchant-complete imbue-failed imbue-backlash
  ].freeze

  # What the game asks for next, as the flag it set and the step that
  # answers it, checked in this order before every scribe.
  SCRIBE_STEPS = [
    ['enchant-sigil', :handle_sigil_flag],
    ['enchant-focus', :handle_focus_flag],
    ['enchant-meditate', :handle_meditate_flag],
    ['enchant-push', :handle_push_flag],
    ['enchant-imbue', :handle_imbue_flag],
    ['imbue-backlash', :handle_backlash_flag],
    ['enchant-complete', :handle_complete_flag]
  ].freeze

  # Steps after which the enchant is over.
  FINAL_STEPS = %i[handle_backlash_flag handle_complete_flag].freeze

  # The book the recipes are in.
  BOOK_TYPE = 'artificing'

  ARG_DEFINITIONS = [
    [
      { name: 'chapter', regex: /\d+/i, variable: true, description: 'Required: Chapter containing the item.' },
      { name: 'recipe', display: 'recipe name', regex: /^[A-z\s\-']+$/i, variable: true, description: 'Required: Name of the recipe, wrap in double quotes if this is multiple words.' },
      { name: 'noun', regex: /\w+/i, variable: true, description: 'Required: Noun of finished product, can wrap in double quotes if this is multiple words. Example: "small brazier"' },
      { name: 'base_noun', regex: /\w+/i, variable: true, optional: true, description: 'Optional: Noun of base item that will change once started.  Example: short pole turns into a loop once placed on brazier.' }
    ],
    [
      { name: 'resume', regex: /resume/i },
      { name: 'noun', regex: /\w+/i, variable: true, description: 'Noun of item to resume.' }
    ]
  ].freeze

  def initialize(settings = get_settings)
    @settings = settings
    @cube = @settings.cube_armor_piece
    @bag = @settings.crafting_container
    @bag_items = @settings.crafting_items_in_container
    @belt = @settings.enchanting_belt
    @stamp = @settings.mark_crafted_goods
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb

    @brazier = enchanting_tool(/brazier/, 'brazier')
    @fount = enchanting_tool(/fount/, 'fount')
    @loop = enchanting_tool(/loop/, 'aug loop')
    @imbue_wand = enchanting_tool(/wand|rod/, 'rod')
    @burin = enchanting_tool(/burin/, 'burin')

    @use_own_brazier = DRRoom.room_objs.none? { |obj| obj.include?("enchanter's brazier") }
    @brazier = "enchanter's brazier" unless @use_own_brazier
    @brazier_ref = @use_own_brazier ? "my #{@brazier}" : @brazier

    @equipment_manager = EquipmentManager.new
  end

  def run(args = parse_args(ARG_DEFINITIONS))
    @baseitem = args.base_noun || args.noun
    @item = args.noun
    @chapter = args.chapter
    @recipe = args.recipe
    @resume = args.resume

    setup_flags
    run_enchant
  ensure
    cleanup_flags
  end

  def setup_flags
    # Every matcher only matches the game's own line, not other players' speech
    # or ESP: line start with optional leading tags, or (messages that can
    # follow other text on the line) no quote outside a tag before the message.
    Flags.add('enchant-focus', /^(?:<[^>]*>|[^"<])*?material struggles to accept the sigil scribing/i)
    Flags.add('enchant-meditate', /^(?:<[^>]+>)*The traced sigil pattern blurs before your eyes/i)
    Flags.add('enchant-imbue', /^(?:<[^>]+>)*Once finished you sense an imbue spell will be required to continue enchanting/i)
    Flags.add('enchant-push', /^(?:<[^>]+>)*You notice many of the scribed sigils are slowly merging back/i)
    Flags.add('enchant-sigil', /^(?:<[^>]+>)*You need another (?<type>[\w ]*)(?<order>primary|secondary) sigil to continue the enchanting process/)
    Flags.add('enchant-complete',
              /^(?:<[^>]*>|[^"<])*?With the enchanting process completed, you believe it is safe to collect your things once more\./i,
              /^(?:<[^>]*>|[^"<])*?With the enchantment complete/i,
              /^(?:<[^>]*>|[^"<])*?With enchanting complete/i,
              /^You collect the \w+ and place it at your feet/)
    Flags.add('imbue-failed', /^(?:<[^>]*>|[^"<])*?The streams collide, rending the space before you and disrupting the enchantment/i)
    Flags.add('imbue-backlash', /^(?:<[^>]*>|[^"<])*?Suddenly the streams slip through your grasp and cascade violently against each other/i)
  end

  def cleanup_flags
    FLAG_NAMES.each { |flag| Flags.delete(flag) }
  end

  def run_enchant
    @equipment_manager.empty_hands
    DRC.wait_for_script_to_complete('buff', ['enchant'])

    if @resume
      handle_resume
    else
      handle_new_enchant
    end
  end

  def handle_resume
    get_tool(@brazier) if @use_own_brazier

    result = DRC.bput("analyze #{@item} on #{@brazier_ref}", *ANALYZE_PATTERNS)

    if ANALYZE_READY_PATTERNS.any? { |pat| pat.match?(result) }
      get_tool(@burin)
      scribe
    elsif ANALYZE_IMBUE_PATTERN.match?(result)
      handle_imbue_resume
    else
      Lich::Messaging.msg("bold", "Enchant: Unexpected analyze result: #{result}")
    end
  end

  def handle_imbue_resume
    wave_fount unless fount_on_brazier?
    imbue
  end

  def fount_on_brazier?
    result = DRC.bput("look on #{@brazier_ref}", BRAZIER_CONTENTS_PATTERN, BRAZIER_EMPTY)
    match = BRAZIER_CONTENTS_PATTERN.match(result)
    match ? match[:items].match?(/\bfount\b/) : false
  end

  def handle_new_enchant
    study_recipe
    @item = 'fount' if @item == 'small sphere'

    unless @item == "fount"
      unless DRCI.exists?(@fount)
        Lich::Messaging.msg("bold", "Enchant: #{@fount} not found in inventory. Cannot proceed.")
        cleanup
        return
      end

      wave_fount
    end

    DRC.bput("touch my #{@cube}", *TOUCH_CUBE_PATTERNS) if @cube
    imbue

    get_tool(@burin)
    scribe
  end

  # Gets the fount and waves it at the item, which leaves it on the item.
  # The game may say the item needs none; then it goes back in the bag.
  def wave_fount
    get_tool(@fount)
    wave_result = DRC.bput("wave my #{@fount} at #{@item} on #{@brazier_ref}", WAVE_FOUNT_SUCCESS, WAVE_FOUNT_NOT_NEEDED)
    stow_tool(@fount) if WAVE_FOUNT_NOT_NEEDED.match?(wave_result)
  end

  def study_recipe
    if @settings.master_crafting_book
      DRCC.find_recipe2(@chapter, @recipe, @settings.master_crafting_book, BOOK_TYPE)
    else
      DRCC.get_crafting_item("#{BOOK_TYPE} book", @bag, @bag_items, @forging_belt)
      DRCC.find_recipe2(@chapter, @recipe)
      DRCC.stow_crafting_item("book", @bag, @forging_belt)
    end
    get_tool(@brazier) if @use_own_brazier

    get_result = DRC.bput("get my #{@baseitem} from my #{@bag}", GET_SUCCESS, GET_DANGEROUS)
    if GET_DANGEROUS.match?(get_result)
      clean_brazier
      empty_brazier
      unless DRCI.get_item?(@baseitem, @bag)
        Lich::Messaging.msg("bold", "Enchant: Failed to get #{@baseitem} from #{@bag}.")
        return
      end
    end

    place_item_on_brazier
  end

  def place_item_on_brazier
    2.times do
      all_patterns = [PUT_BRAZIER_ALREADY_ENCHANTED, PUT_BRAZIER_GLANCE, PUT_BRAZIER_NEEDS_CLEAN] + PUT_BRAZIER_SUCCESS
      result = put_item_on_brazier(*all_patterns)

      if PUT_BRAZIER_ALREADY_ENCHANTED.match?(result)
        Lich::Messaging.msg("plain", "Enchant: Totem already enchanted, disposing and retrying.")
        DRCI.dispose_trash('totem', @worn_trashcan, @worn_trashcan_verb)
        study_recipe
        return
      elsif placed?(result)
        waitrt?
        return
      elsif PUT_BRAZIER_NEEDS_CLEAN.match?(result)
        clean_brazier
        empty_brazier
        unless DRCI.get_item?(@baseitem, @bag)
          Lich::Messaging.msg("bold", "Enchant: Failed to get #{@baseitem} from #{@bag} after cleaning.")
          return
        end
        place_item_inner
        return
      end
    end
  end

  def place_item_inner
    2.times do
      result = put_item_on_brazier(PUT_BRAZIER_GLANCE, *PUT_BRAZIER_SUCCESS)
      if placed?(result)
        waitrt?
        return
      end
    end
  end

  def put_item_on_brazier(*patterns)
    DRC.bput("put my #{@baseitem} on #{@brazier_ref}", *patterns)
  end

  def placed?(result)
    PUT_BRAZIER_SUCCESS.any? { |pat| pat.match?(result) }
  end

  def imbue
    spell = imbue_spell
    if spell
      spell['cast'] = "cast #{@item} on #{@brazier_ref}"
      until DRCA.cast_spell?(spell, @settings)
        Lich::Messaging.msg("bold", "Enchant: Casting Imbue failed. Retrying.")
      end
    else
      wave_imbue_wand
    end
    Flags.reset('enchant-imbue')
  end

  # The Imbue entry of the imbue waggle set, or nil to use the imbue wand.
  def imbue_spell
    waggle_sets = @settings['waggle_sets']
    waggle_sets.dig('imbue', 'Imbue') if waggle_sets.respond_to?(:dig)
  end

  def wave_imbue_wand
    while true
      get_tool(@imbue_wand) unless held_in_left_hand?(@imbue_wand)

      result = DRC.bput("wave #{@imbue_wand} at #{@item} on #{@brazier_ref}", IMBUE_WAND_SUCCESS, IMBUE_WAND_SIGIL_NEEDED, IMBUE_WAND_FAILED)
      break unless IMBUE_WAND_FAILED.match?(result)

      Lich::Messaging.msg("bold", "Enchant: Imbue wand failed. Retrying.")
    end

    stow_tool(@imbue_wand) if held_in_left_hand?(@imbue_wand)
  end

  def clean_brazier
    result = DRC.bput("clean #{@brazier_ref}", CLEAN_SUCCESS, CLEAN_NOTHING, CLEAN_NOT_LIT)
    case result
    when CLEAN_SUCCESS
      DRC.bput("clean #{@brazier_ref}", CLEAN_SINGED)
    when CLEAN_NOT_LIT
      stow_tool(DRC.left_hand) if DRC.left_hand
    end
  end

  def empty_brazier
    stow_tool(DRC.left_hand) if DRC.left_hand

    result = DRC.bput("look on #{@brazier_ref}", BRAZIER_CONTENTS_PATTERN, BRAZIER_EMPTY)
    match = BRAZIER_CONTENTS_PATTERN.match(result)
    return unless match

    match[:items].split(' and ').each do |item|
      item_noun = item.split.last
      unless DRCI.get_item?(item_noun, @brazier)
        Lich::Messaging.msg("bold", "Enchant: Failed to get #{item_noun} from #{@brazier}.")
        next
      end
      stow_tool(item_noun)
    end
  end

  def trace_sigil(sigil)
    unless DRCI.get_item?("#{sigil} sigil")
      Lich::Messaging.msg("bold", "Enchant: Failed to get #{sigil} sigil.")
      return
    end
    DRC.bput("study my #{sigil} sigil", SIGIL_STUDY_SUCCESS)
    waitrt?
    DRC.bput("trace #{@item} on #{@brazier_ref}", SIGIL_TRACE_SUCCESS)
  end

  # Answers whatever the game asked for, scribing whenever it asked for
  # nothing, until the enchant completes or backlashes.
  def scribe
    while true
      step = next_scribe_step
      if step
        send(step)
        return if FINAL_STEPS.include?(step)
      else
        DRC.bput("scribe #{@item} on #{@brazier_ref} with my #{@burin}", SCRIBE_RT_PATTERN, SCRIBE_SIGIL_NEEDED)
        waitrt?
      end
    end
  end

  # The step for the first flag the game set, in SCRIBE_STEPS order, or nil.
  def next_scribe_step
    SCRIBE_STEPS.find { |flag, _step| Flags[flag] }&.last
  end

  def handle_sigil_flag
    sigil_type = Flags['enchant-sigil'][:type].delete(' ')
    Flags.reset('enchant-sigil')
    sigil_type = 'congruence' if sigil_type == ''
    stow_tool(@burin)
    trace_sigil(sigil_type)
    get_tool(@burin)
  end

  def handle_focus_flag
    Flags.reset('enchant-focus')
    DRC.bput("focus #{@item} on #{@brazier_ref}", FOCUS_IMBUE_NEEDED, SCRIBE_RT_PATTERN, SCRIBE_SIGIL_NEEDED)
    waitrt?
  end

  def handle_meditate_flag
    Flags.reset('enchant-meditate')
    DRC.bput("meditate fount on #{@brazier_ref}", SCRIBE_RT_PATTERN, SCRIBE_SIGIL_NEEDED)
    waitrt?
  end

  def handle_push_flag
    Flags.reset('enchant-push')
    stow_tool(@burin) if held_in_left_hand?('burin')
    get_tool(@loop)
    DRC.bput("push #{@item} on #{@brazier_ref} with my #{@loop}", SCRIBE_RT_PATTERN, SCRIBE_SIGIL_NEEDED)
    waitrt?
    stow_tool(@loop)
    get_tool(@burin)
  end

  def handle_imbue_flag
    Flags.reset('enchant-imbue')
    stow_tool(@burin) if held_in_left_hand?('burin')
    imbue
    get_tool(@burin)
  end

  def handle_backlash_flag
    Lich::Messaging.msg("bold", "Enchant: Imbue backlash occurred! Cleaning up and heading to safe room.")
    stow_held_items
    cleanup
    DRC.wait_for_script_to_complete('safe-room', ['force'])
  end

  def handle_complete_flag
    Lich::Messaging.msg("plain", "Enchant: Enchanting complete!")
    stow_held_items
    cleanup
    stamp_item(@item) if @stamp
  end

  def stamp_item(noun)
    get_tool('stamp')
    DRC.bput("mark my #{noun} with my stamp", *STAMP_PATTERNS)
    stow_tool('stamp')
  end

  def cleanup
    stow_held_items
    unless @item == 'fount'
      get_tool(@fount)
      stow_tool(@fount)
    end
    if DRCI.get_item?(@item)
      stow_tool(@item)
      DRCI.get_item?(@item)
    end
  end

  private

  # The enchanting_tools entry matching pattern, or default.
  def enchanting_tool(pattern, default)
    @settings.enchanting_tools.find { |item| pattern =~ item } || default
  end

  def get_tool(name)
    DRCC.get_crafting_item(name, @bag, @bag_items, @belt)
  end

  def stow_tool(name)
    DRCC.stow_crafting_item(name, @bag, @belt)
  end

  # Puts whatever is in either hand in the bag, right hand first.
  def stow_held_items
    stow_tool(DRC.right_hand) if DRC.right_hand
    stow_tool(DRC.left_hand) if DRC.left_hand
  end

  def held_in_left_hand?(noun)
    DRC.left_hand.to_s.include?(noun)
  end
end

Enchant.new.run
