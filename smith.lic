=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#smith
=end

# Makes one blacksmithing, weaponsmithing or armorsmithing item from start to
# finish, wrapped around forge.lic.
#
# smith buys what the recipe needs (parts, and the ingot with 'buy'), gets the
# character to a workplace, restocks oil, then runs forge.lic for the item and
# once more for each enhancement. It stamps the item if asked, then keeps a
# bought bulk ingot's leftover or disposes of a smaller remainder. After a
# failed forge run it stops: the remaining steps would act on an item that was
# never made.
#
# A recipe marked `instructions: true` in base-recipes.yaml is made from a
# loose set of instructions instead of the master book; smith checks the
# character carries that set before buying anything.
#
# With use_private_forge, forge.lic walks to and rents the private forge itself.
# smith only finds a public anvil, and only when that setting is off. With
# 'here', smith forges in the room it started in: when a part or the ingot
# must be bought it walks to the shops and comes back first, and when nothing
# is missing it does not move.
#
# Entry points are #initialize and #smith. The step methods stay public so
# the spec can drive each one on its own; only setup is private.
#
# @example Make a steel morning star, then temper and balance it
#   ;smith steel "metal morning star" temper balance
# @example Buy a steel ingot that fits, then come back and forge where you stood
#   ;smith steel "metal awl pike" buy here
# @example In the rented private forge: buy the missing haft, come back, forge, temper
#   ;smith steel "metal morning star" here temper
# @example From instructions, in the rented private forge: buy the long pole, come back, forge, temper
#   ;smith telothian "Imperial spear" here temper
class Smith
  # Recipe types smith can make.
  SMITHING_TYPES = /blacksmithing|weaponsmithing|armorsmithing/i

  # Enhancements forge.lic can apply, in the order smith runs them.
  ENHANCEMENTS = %w[temper hone balance lighten reinforce].freeze

  # The extra part a reinforce run needs.
  REINFORCE_PART = 'leather strip'

  # Copper to carry for parts and oil when not buying an ingot.
  PARTS_COPPER = 3000

  # Each part smith buys, as lich-5's inventory feed names it. The feed sends
  # an item's name as "article,adjective,noun" (Kurtus' and Saelia's feed:
  # "a,short,pole" for a short oak pole, "some,large cloth,padding",
  # "a,shield,handle" for an iron shield handle), so a part is told by the
  # game's own noun, never by the words of its description. A part sold in
  # more than one kind also needs its kind word before the noun: a short
  # pole and a long pole are both poles. A part missing from this list never
  # counts as carried, so it is always bought.
  PART_NOUNS = {
    'hilt'          => { nouns: %w[hilt].freeze },
    'haft'          => { nouns: %w[haft].freeze },
    'long pole'     => { nouns: %w[pole].freeze, kind: 'long' },
    'short pole'    => { nouns: %w[pole].freeze, kind: 'short' },
    'long cord'     => { nouns: %w[cord].freeze, kind: 'long' },
    'short cord'    => { nouns: %w[cord].freeze, kind: 'short' },
    'small padding' => { nouns: %w[padding].freeze, kind: 'small' },
    'large padding' => { nouns: %w[padding].freeze, kind: 'large' },
    'small backing' => { nouns: %w[backing].freeze, kind: 'small' },
    'large backing' => { nouns: %w[backing].freeze, kind: 'large' },
    'shield handle' => { nouns: %w[handle].freeze, kind: 'shield' },
    # forge.lic asks for "some leather strips"; no feed capture of one yet.
    'leather strip' => { nouns: %w[strip strips].freeze, kind: 'leather' }
  }.freeze

  # Ingots this size and larger are sold at the town's bulk materials shop
  # (bingots-room), not the stock shop. Shard's Supply Stand lists only the
  # small sizes (tiny, huge, massive); its Bulk Materials lists immense (50),
  # gigantic (100) and colossal (200), numbered as in base-crafting's stock.
  BULK_INGOT_VOLUME = 50

  ARG_DEFINITIONS = [
    [
      { name: 'material', regex: /\w+/, description: 'Metal type of the ingot' },
      { name: 'item_name', display: 'recipe name', regex: /^[a-z\s\-']+$/i, variable: true, description: 'Name of the recipe, wrap in double quotes if this is multiple words.' },
      { name: 'stamp', regex: /^stamp/i, optional: true, description: 'To stamp completed items' },
      { name: 'here', regex: /^here/i, optional: true, description: 'Forge in the room you are in (a rented private forge, a forge wand); missing parts and a bought ingot are fetched first, then smith comes back' },
      { name: 'temper', regex: /^temper/i, optional: true, description: 'Tempers crafted item, boost durability' },
      { name: 'hone', regex: /^hone/i, optional: true, description: 'Hones crafted item(weapon only), reducing weight and impact' },
      { name: 'balance', regex: /^balance/i, optional: true, description: 'Balance crafted item (weapon only), increasing balance at the cost of suitability' },
      { name: 'lighten', regex: /^lighten/i, optional: true, description: 'Lightens crafted armor or shield, reducing weight only' },
      { name: 'reinforce', regex: /^reinforce/i, optional: true, description: 'Improves some absorption/protection stats at the cost of increased weight and hinderance' },
      { name: 'buy', regex: /^buy/i, optional: true, description: 'Used to purchase the ingot' }
    ]
  ].freeze

  def initialize
    args = parse_args(ARG_DEFINITIONS)
    load_settings
    exit_unless_private_forge_exists

    recipe = find_recipe(args.item_name)
    return unless recipe

    smith(args, recipe)
  end

  # Make the item: buy, get to a workplace, forge, enhance, clean up.
  #
  # @param args [OpenStruct] parsed arguments (see ARG_DEFINITIONS)
  # @param recipe [Hash] the base-recipes entry
  # @return [void]
  def smith(args, recipe)
    return if recipe['instructions'] && !instructions_carried?(recipe)

    parts = parts_for(recipe, args)
    ingot = nil
    if args.buy
      ingot = ingot_to_buy(args.material, recipe['volume'])
      return unless ingot
      return if ingot_already_carried?(args.material)
    end
    # forge.lic needs a free hand, and a stowed part is still counted.
    DRCI.stow_hands
    to_buy = parts_to_buy(parts)
    buying_parts = !to_buy.empty?
    if args.here && (ingot || buying_parts)
      return_room = Room.current.id
      return unless return_room_known?(return_room)
    end
    # Away from 'here' the parts budget is carried even with every part in
    # hand: it pays for the oil too.
    fund_run(recipe, parts, ingot, buying_parts || !args.here)

    # Come back after a failed purchase too: 'here' means forge where you stood.
    bought = (!buying_parts || buy_parts(to_buy)) && (!ingot || buy_ingot(ingot))
    back = return_room.nil? || walked_back?(return_room)
    return unless bought && back

    go_to_workplace(args.here)
    restock_oil
    DRC.wait_for_script_to_complete('buff', ['smith'])
    return unless craft(args, recipe)

    handle_leftover(recipe, ingot) if ingot
  end

  # Run forge.lic for the item, stamp it if asked, then run it for each
  # enhancement. Stops at the first run that doesn't finish the item.
  #
  # @param args [OpenStruct] parsed arguments
  # @param recipe [Hash] the base-recipes entry
  # @return [Boolean] true when every forge run finished the item
  def craft(args, recipe)
    noun = recipe['noun']
    # 'here': forge.lic neither restocks consumables nor walks to the private forge.
    stay_args = args.here ? %w[skip here] : []
    return false unless forge_finished?(noun, [*item_run_args(recipe, args.material), *stay_args])

    stamp_item(noun) if args.stamp
    enhancements(args).all? { |enhancement| forge_finished?(noun, [enhancement, noun, *stay_args]) }
  end

  # forge.lic's arguments for the item run: the book form, or its
  # instructions form for a recipe made from loose instructions. forge.lic
  # studies "<noun> instructions" in that form (#instructions_carried?).
  #
  # @param recipe [Hash] the base-recipes entry
  # @param material [String] metal name as typed
  # @return [Array<String, Integer>] the recipe chapter is an Integer
  def item_run_args(recipe, material)
    return ['instructions', material, recipe['noun']] if recipe['instructions']

    [recipe['type'], recipe['chapter'], recipe['name'], material, recipe['noun']]
  end

  # Whether the character carries the instructions for this recipe, checked
  # before anything is bought. forge.lic gets "<noun> instructions", and
  # some instructions share a noun (serrated and long-handled naginata). A
  # GET by that name takes the set 'tap my <noun> instructions' names, so
  # the tapped set must name the recipe: its name less the article and
  # "metal", e.g. "serrated naginata" for "a metal serrated naginata". DRCC
  # can instead get the one matching set in the crafting container by its
  # id, so for a shared noun that container must hold no set of the other
  # kind. Not covered: a set of the other kind that DRCC remembers by id
  # from an earlier run and that has since left the container.
  #
  # @param recipe [Hash] a base-recipes entry marked instructions: true
  # @return [Boolean] false (with a message) when the set is missing or another kind
  def instructions_carried?(recipe)
    reference = "#{recipe['noun']} instructions"
    kind = /\b#{Regexp.escape(instructions_kind(recipe))}\b.*\binstructions\b/i
    tapped = DRCI.tap(reference).to_s.strip
    unless tapped =~ kind
      if tapped =~ /\binstructions\b/i
        Lich::Messaging.msg('bold', "smith: 'my #{reference}' is another kind (#{tapped}), and forge would study it instead. Put the other #{reference} away from your inventory, then run smith again.")
      else
        Lich::Messaging.msg('bold', "smith: You don't carry any #{reference}, which forge needs to make #{recipe['name']}. Stopping before buying anything.")
      end
      return false
    end
    return true unless shared_instructions_noun?(recipe)

    other = (DRCI.get_item_list(@bag) || []).find { |item| item =~ /\b#{Regexp.escape(reference)}\b/i && item !~ kind }
    return true unless other

    Lich::Messaging.msg('bold', "smith: Your #{@bag} also holds #{other}, and forge may take that set instead. Put it away from your #{@bag}, then run smith again.")
    false
  end

  # @param recipe [Hash] an instructions recipe
  # @return [String] the words its instructions are named by, e.g. "serrated naginata"
  def instructions_kind(recipe)
    recipe['name'].sub(/\A(?:an?|some)\s+/i, '').sub(/\Ametal\s+/i, '')
  end

  # @param recipe [Hash] an instructions recipe
  # @return [Boolean] true when another instructions recipe uses its noun
  def shared_instructions_noun?(recipe)
    get_data('recipes').crafting_recipes.count { |other| other['instructions'] && other['noun'] == recipe['noun'] } > 1
  end

  # @param args [OpenStruct] parsed arguments
  # @return [Array<String>] the enhancements asked for, in ENHANCEMENTS order
  def enhancements(args)
    ENHANCEMENTS.select { |enhancement| args[enhancement] }
  end

  # Run forge.lic and report whether it finished the item.
  #
  # forge.lic leaves the finished item in hand (its default 'hold' finish),
  # and its cleanup_and_exit stows both hands, so the hands tell smith whether
  # the run worked. On a failed run smith stops: stamping, more forge runs
  # or disposal would act on an item that was never made.
  #
  # Limits: an exit through DRCC's missing-tool check (crafting_item_failed)
  # doesn't stow. Forge's own tool left in hand isn't mistaken for the item
  # (see #forging_tool?), but an enhancement run that exits that way looks
  # finished, because the item was already in hand when it started. A recipe
  # for a tool also listed in forging_tools (a ball-peen hammer, with
  # 'ball-peen hammer' there) can't be told from that tool, so smith stops
  # after the item run and says so, even when forge made it. Workorders for
  # pliers and the metal rod hit this on every good run when forging_tools
  # lists bare 'pliers' or 'rod'; those recipes have no parts, and workorders
  # passes no stamp, buy or enhancement, so only the message is wrong.
  #
  # @param noun [String] the recipe's item noun
  # @param args [Array<String, Integer>] forge.lic arguments (the recipe chapter is an Integer)
  # @return [Boolean] true when the finished item is in hand
  def forge_finished?(noun, args)
    DRC.wait_for_script_to_complete('forge', args)
    return true if finished_item_in_hand?(noun)

    tool = finished_items_in_hand(noun).find { |held| forging_tool?(held) }
    if tool
      Lich::Messaging.msg('bold', "smith: The #{tool} in hand is named like one of your forging_tools, so smith can't tell whether forge finished the #{noun}. Stopping before stamping, enhancements and cleanup.")
    else
      Lich::Messaging.msg('bold', "smith: forge did not finish the #{noun}. Stopping before stamping, enhancements and cleanup.")
    end
    false
  end

  # @param noun [String] the recipe's item noun
  # @return [Boolean] true when a hand holds the item, finished, and it isn't
  #   one of the character's own forging tools
  def finished_item_in_hand?(noun)
    finished_items_in_hand(noun).any? { |held| !forging_tool?(held) }
  end

  # @param noun [String] the recipe's item noun
  # @return [Array<String>] held items named with the noun and not unfinished
  def finished_items_in_hand(noun)
    item = /\b#{Regexp.escape(noun)}\b/i
    [DRC.right_hand, DRC.left_hand].compact.select { |held| held =~ item && held !~ /\bunfinished\b/i }
  end

  # Whether a held item is one of the forging_tools from settings. forge.lic
  # can exit holding one, e.g. its hammer while making a hammer.
  #
  # @param held [String] a hand's item name
  # @return [Boolean]
  def forging_tool?(held)
    (@settings.forging_tools || []).any? do |tool|
      held =~ /\b#{tool.split.map { |word| Regexp.escape(word) }.join('\b.*\b')}\b/i
    end
  end

  # The recipe's parts, plus a leather strip for reinforce.
  #
  # @param recipe [Hash] the base-recipes entry
  # @param args [OpenStruct] parsed arguments
  # @return [Array<String>] part names (may repeat)
  def parts_for(recipe, args)
    (recipe['part'] || []) + (args.reinforce ? [REINFORCE_PART] : [])
  end

  # Carry enough coin for this run before buying anything.
  #
  # @param recipe [Hash] the base-recipes entry
  # @param parts [Array<String>] part names
  # @param ingot [Hash, nil] the stock entry to buy, or nil
  # @param buying_parts [Boolean] whether smith goes to the part shops
  # @return [void]
  def fund_run(recipe, parts, ingot, buying_parts)
    return unless ingot || buying_parts

    copper = ingot ? [PARTS_COPPER, DRCC.crafting_cost(recipe, @hometown, parts, 1, ingot)].max : PARTS_COPPER
    DRCM.ensure_copper_on_hand(copper, @settings, @hometown)
  end

  # Buy the parts worked out by parts_to_buy, stowing each in the crafting
  # container. A part bought for a run that failed stays there, so the next
  # run uses it instead of buying another. Hands are already empty (#smith).
  #
  # @param to_buy [Array<String>] part names to buy (may repeat)
  # @return [Boolean] false when a purchase failed
  def buy_parts(to_buy)
    to_buy.all? do |part|
      data = get_data('crafting')['recipe_parts'][part][@hometown]
      if data['part-number']
        DRCT.order_item(data['part-room'], data['part-number'])
      else
        DRCT.buy_item(data['part-room'], part)
      end
      next false unless bought?(part)

      DRCC.stow_crafting_item(part, @bag, @belt)
      true
    end
  end

  # The recipe's parts not yet carried, one entry per part still needed.
  # forge.lic gets each part with 'get my <part>', so a part counts when it
  # is in a hand or directly inside a worn container that is open: the
  # crafting container or any other. lich-5's inventory feed lists both,
  # with each item's noun as the game sends it. An unfinished part doesn't
  # count, since forge.lic asks for a finished one.
  #
  # Without an answer from the feed nothing counts as carried and every
  # part is bought: a spare part costs a few hundred coins, while a part
  # wrongly counted stops forge.lic at assembly on every run.
  #
  # @param parts [Array<String>] part names from the recipe (may repeat)
  # @return [Array<String>] the parts to buy (empty for a recipe without parts)
  def parts_to_buy(parts)
    return [] if parts.empty?

    carried = reachable_items
    unless carried
      Lich::Messaging.msg('bold', "smith: The inventory feed didn't answer, so smith can't tell which parts you carry and will buy them all.")
      return parts.dup
    end

    parts.reject do |part|
      index = carried.index { |item| part_item?(item, part) }
      carried.delete_at(index) if index
    end
  end

  # What 'get my <part>' can reach, from a fresh inventory feed snapshot:
  # what is held, and what lies directly inside a worn container that is
  # open. A container the feed gives an in_selector is reached another way
  # (an eddy's is "my watery portal in #<id>", in Kurtus' and Saelia's feed),
  # so its contents are left out, as are items deeper down: a part there is
  # bought again rather than counted when forge.lic might not find it.
  #
  # @return [Array<Lich::Common::Inventory::Item>, nil] nil when the feed
  #   didn't answer
  def reachable_items
    snapshot = Lich::Common::Inventory.refresh
    return nil unless snapshot

    held = [snapshot.right_hand, snapshot.left_hand].compact
    open = snapshot.worn.reject { |container| container.closed? || container.in_selector }
    held + open.flat_map { |container| container.contents(:in) }
  end

  # Whether a feed item is this part: its noun is the part's noun, its words
  # before the noun hold the part's kind word (if it has one), and it isn't
  # unfinished.
  #
  # @param item [Lich::Common::Inventory::Item] a feed item
  # @param part [String] a part name, e.g. "short cord"
  # @return [Boolean]
  def part_item?(item, part)
    known = PART_NOUNS[part]
    return false unless known && known[:nouns].include?(item.noun.to_s.downcase)

    words = "#{item.article} #{item.adjective}".downcase.split
    !words.include?('unfinished') && (known[:kind].nil? || words.include?(known[:kind]))
  end

  # The smallest ingot of the material on sale in this town that holds the
  # recipe's volume. Bulk sizes only count where the town has a bulk shop.
  #
  # @param material [String] metal name as typed (e.g. "steel")
  # @param volume [Integer] the recipe's volume
  # @return [Hash, nil] the base-crafting stock entry, or nil (with a message)
  #   when that metal isn't sold or no size is large enough
  def ingot_to_buy(material, volume)
    sizes = get_data('crafting')['stock'].values.select do |stock|
      stock['stock-name'] == material && (stock['stock-volume'] < BULK_INGOT_VOLUME || @discipline['bingots-room'])
    end
    if sizes.empty?
      Lich::Messaging.msg('bold', "smith: #{material} ingots aren't sold here, so 'buy' can't be used for #{material}.")
      return nil
    end

    ingot = sizes.select { |stock| stock['stock-volume'] >= volume }.min_by { |stock| stock['stock-volume'] }
    return ingot if ingot

    largest = sizes.map { |stock| stock['stock-volume'] }.max
    Lich::Messaging.msg('bold', "smith: The largest #{material} ingot sold holds #{largest} volume; this recipe needs #{volume}.")
    Lich::Messaging.msg('bold', "smith: Combine ingots by smelting, then run smith without 'buy'.")
    nil
  end

  # forge.lic takes the first "<metal> ingot" it finds, so with one already
  # carried a newly bought ingot might not be the one it uses.
  #
  # @param material [String] metal name as typed
  # @return [Boolean] true (with a message) when an ingot of that metal is carried
  def ingot_already_carried?(material)
    return false unless DRCI.exists?("#{material} ingot")

    Lich::Messaging.msg('bold', "smith: You already carry a #{material} ingot (a leftover from an earlier run counts), and forge would use it rather than a new one. Run smith without 'buy' to forge from it, or move it out of your inventory before buying.")
    true
  end

  # Buying with 'here' walks to the shops, so smith needs the room to come
  # back to.
  #
  # @param room [Integer, nil] the current room id
  # @return [Boolean] false (with a message) when the room is unknown
  def return_room_known?(room)
    return true if room

    Lich::Messaging.msg('bold', "smith: Buying with 'here' needs a known room to come back to. Buy the missing parts or the ingot first, then run smith with 'here'.")
    false
  end

  # Walk back to the room 'here' started in. forge.lic is told to stay put,
  # so smith stops rather than forge wherever the walk ended. Back into the
  # town's private forge, DRCC.go_to_private_forge carries the rental cost
  # (the entrance charges it again once the rental has lapsed), walks, and
  # tries the door when the walk ends outside, as forge.lic does.
  #
  # @param room [Integer] the room id 'here' started in
  # @return [Boolean] false (with a message) when the walk didn't get there
  def walked_back?(room)
    back = if room == DRCC.private_forge_room(@hometown)
             DRCC.go_to_private_forge(@hometown, @settings)
           else
             DRCT.walk_to(room)
           end
    return true if back

    Lich::Messaging.msg('bold', "smith: Could not get back to room #{room} after shopping, so smith stops rather than forge somewhere else. Go back and run smith with 'here' again; what was bought is in your #{@bag}.")
    false
  end

  # @param ingot [Hash] the stock entry to order
  # @return [Boolean] false when the purchase failed
  def buy_ingot(ingot)
    DRCT.order_item(ingot_shop(ingot), ingot['stock-number'])
    return false unless bought?("#{ingot['stock-name']} ingot")

    DRCC.stow_crafting_item('ingot', @bag, @belt)
    DRCI.stow_hands
    true
  end

  # @param ingot [Hash] a stock entry
  # @return [Integer] the room of the shop that sells it
  def ingot_shop(ingot)
    ingot['stock-volume'] >= BULK_INGOT_VOLUME ? @discipline['bingots-room'] : @discipline['stock-room']
  end

  # Whether a purchase left the item in hand; says so when it didn't.
  #
  # @param item [String] the item bought
  # @return [Boolean]
  def bought?(item)
    return true if DRCI.in_hands?(item)

    Lich::Messaging.msg('bold', "smith: Could not buy a #{item} (not enough coin, or the shop is closed). Stopping.")
    false
  end

  # Get to a public anvil, unless forging here or in the private forge
  # (forge.lic walks to and rents that itself on every run).
  #
  # @param here [String, nil] the 'here' argument
  # @return [void]
  def go_to_workplace(here)
    DRCC.find_anvil(@hometown) unless here || @use_private_forge
  end

  # Top up the oil flask from the town's finisher shop. forge.lic leaves oil
  # to smith while smith is running.
  #
  # @return [void]
  def restock_oil
    DRCC.check_consumables('oil', @discipline['finisher-room'], @discipline['finisher-number'], @bag, @bag_items, @belt)
  end

  # Put the maker's mark on the finished item.
  #
  # @param noun [String] the recipe's item noun
  # @return [void]
  def stamp_item(noun)
    DRCC.get_crafting_item('stamp', @bag, @bag_items, @belt)
    # The maker's mark belongs on the object right after its initial creation.
    # forge.lic already stamps it then (when mark_crafted_goods is set), so the
    # mark may already be present here -- treat "already a maker's mark" as a
    # success instead of retrying the command until it times out.
    DRC.bput("mark my #{noun} with my stamp", 'carefully hammer the stamp', 'already a maker\'s mark', 'You cannot figure out how to do that', 'too badly damaged')
    DRCC.stow_crafting_item('stamp', @bag, @belt)
  end

  # Deal with what is left of a bought ingot. forge.lic puts the unused part
  # in the container. A bulk ingot's leftover is kept and reported, since it
  # is worth more than the item. A stock-shop remainder is disposed of, as
  # before: it is worth little, and a kept one would make the next 'buy' of
  # that metal refuse (#ingot_already_carried?), which stalls callers that
  # buy every run, such as craft.lic's Forging training. If the disposal
  # fails and the remainder is still carried, smith says so.
  #
  # @param recipe [Hash] the base-recipes entry
  # @param ingot [Hash] the stock entry that was bought
  # @return [void]
  def handle_leftover(recipe, ingot)
    leftover = ingot['stock-volume'] - recipe['volume']
    return unless leftover.positive?

    if ingot['stock-volume'] >= BULK_INGOT_VOLUME
      Lich::Messaging.msg('plain', "smith: About #{leftover} volumes of #{ingot['stock-name']} ingot are left over in your #{@bag}.")
      return
    end

    name = "#{ingot['stock-name']} ingot"
    return if DRCT.dispose(name, @discipline['trash-room'], @settings.worn_trashcan, @settings.worn_trashcan_verb)
    return unless DRCI.exists?(name)

    Lich::Messaging.msg('bold', "smith: Could not dispose of the leftover #{name}, so the next 'buy' of #{ingot['stock-name']} will refuse. Run smith without 'buy' to forge from it, or get rid of it by hand.")
  end

  private

  # @return [void]
  def load_settings
    @settings = get_settings
    @hometown = DRCC.crafting_hometown(@settings)
    @discipline = get_data('crafting')['blacksmithing'][@hometown]
    @bag = @settings.crafting_container
    @bag_items = @settings.crafting_items_in_container
    @belt = @settings.forging_belt
    @use_private_forge = DRCC.use_private_forge?(@settings)
  end

  # Stop early, before buying anything, when use_private_forge is on in a
  # town without a private forge.
  #
  # @return [void]
  def exit_unless_private_forge_exists
    return unless @use_private_forge
    return if DRCC.private_forge_room(@hometown)

    Lich::Messaging.msg('bold', "smith: use_private_forge is enabled, but '#{@hometown}' has no private forge.")
    Lich::Messaging.msg('bold', "smith: Towns with private forges: #{DRCC.towns_with_private_forge.join(', ')}")
    Lich::Messaging.msg('bold', "smith: Either set use_private_forge: false, or change hometown/force_crafting_town.")
    exit
  end

  # Book recipes come first: a name that matches any of them is looked up
  # among them only, so a bare noun such as "glaive" finds the book glaive
  # as it did before the instructions recipes ("short-hafted glaive") were
  # added. Any other name is looked up among the instructions recipes.
  #
  # @param item_name [String] the recipe name as typed
  # @return [Hash, nil] the recipe, or nil when none matches (DRCC says so)
  def find_recipe(item_name)
    recipes = get_data('recipes').crafting_recipes.select { |recipe| recipe['type'] =~ SMITHING_TYPES }
    book, instructions = recipes.partition { |recipe| !recipe['instructions'] }
    DRCC.recipe_lookup(book.any? { |recipe| recipe['name'] =~ /#{item_name}/i } ? book : instructions, item_name)
  end
end

Smith.new
